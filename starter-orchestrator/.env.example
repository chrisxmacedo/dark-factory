# Database
DATABASE_URL=postgresql://{USER}:{PASSWORD}@{HOST}:{PORT}/{DATABASE}

# Redis
REDIS_URL=redis://{HOST}:{PORT}

# Health endpoint
HEALTH_PORT=8080

# API server (workflow trigger + status + signal endpoints)
API_PORT=3000

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME={project-name}-orchestrator

# Workflow configuration
WORKFLOW_POLL_INTERVAL_MS=5000
STEP_DEFAULT_TIMEOUT_MS=300000
WORKFLOW_DEFAULT_MAX_DURATION_MS=86400000
SHUTDOWN_TIMEOUT_MS=30000

# Redis queue names
WORKFLOW_TRIGGER_QUEUE={project-name}:workflow:trigger
WORKFLOW_EVENT_CHANNEL={project-name}:workflow:events

# Logging
LOG_LEVEL=info
