{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event-catalogue.schema.json",
  "title": "Event Catalogue",
  "type": "object",
  "required": ["journey_id", "events"],
  "properties": {
    "journey_id": { "type": "string", "pattern": "^JRN-\\d{3}$" },
    "document_version": { "type": "string" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "name", "source_service", "trigger", "journey_phase", "payload_schema", "consumers", "topic"],
        "properties": {
          "event_id": { "type": "string", "pattern": "^EVT-\\d{3}$" },
          "name": { "type": "string" },
          "source_service": { "type": "string", "pattern": "^SVC-\\d{3}$" },
          "source_entity": { "type": "string" },
          "trigger": { "type": "string" },
          "journey_phase": { "type": "string", "pattern": "^PH-\\d{3}$" },
          "payload_schema": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "type": "string" },
                "description": { "type": "string" },
                "derived_from": { "type": "string" }
              }
            }
          },
          "consumers": { "type": "array" },
          "ordering_guarantees": { "type": "string" },
          "topic": { "type": "string" },
          "data_classification": { "type": "string" },
          "worm_audit_pipeline": { "type": "boolean" },
          "retention": { "type": "string" },
          "cloudevents_type": { "type": "string" }
        }
      }
    }
  }
}
