#!/usr/bin/env bash
# envctl — manage Docker environments
#
# Usage:
#   ./envctl up ci          Start CI environment (ci branch)
#   ./envctl up rc          Start RC environment (release-rc-* branch)
#   ./envctl up prod        Start prod-parity environment (main branch)
#   ./envctl up all         Start all three
#   ./envctl down ci|rc|prod|all      (prod keeps its volumes; add --wipe to delete them)
#   ./envctl rebuild ci|rc|prod|all   Build :env images from the env's branch, then start
#   ./envctl rebuild-local ci|rc|prod Build from the working tree instead (first Deliverable,
#                                     before the env's branch has code; or local debugging)
#   ./envctl test ci|rc|prod [suite]  Boot, run tests, tear down
#   ./envctl status         Show which environments are running
#   ./envctl logs ci|rc|prod          Tail logs
#   ./envctl urls           Show browsable URLs
#
# Branch per environment: ci → ci, rc → newest release-rc-*, prod → main.
# Override with REBUILD_BRANCH=<branch> (pipelinectl ci-gate uses
# REBUILD_BRANCH=ci to build the fixture-seeded rc stack from ci).
#
# Requires Docker Compose >= 2.24.4 (`ports: !override` in docker-compose.test.yml).
# Replace {PLACEHOLDERS} with your project-specific values before use.
#
# six-field spec (per .claude/context/process-spec.md)
#   inputs         subcommand (up/down/rebuild/status/logs/urls/test) + env
#                  (ci/rc/prod/all); reads SERVICE_REPOS + port config
#   outputs        docker-compose up/down/build; stdout status; exit 0/1
#   preconditions  Docker running; SERVICE_REPOS exist; branches checked out
#   postconditions requested environment is running / stopped / rebuilt;
#                  _audit.jsonl has one line per state transition
#   idempotency    idempotent — up on an already-running env is a no-op
#   audit events   {script:"envctl <sub>", args, exit_code, meta:{env}}

set -euo pipefail
cd "$(dirname "$0")"

# shellcheck source=audit.sh
source "$(pwd)/audit.sh"
audit_capture_args "$@"
_ENVCTL_SUB="${1:-unknown}"
_ENVCTL_ENV="${2:-}"
trap 'code=$?; audit_log "envctl $_ENVCTL_SUB" "$code" 0 0 "{\"env\":\"$_ENVCTL_ENV\"}"; exit $code' EXIT

PROJECT_ROOT="$(cd .. && pwd)"

# ── Project-specific config — replace these ─────────────────────────────────
# List all service repos that need branch checkout
SERVICE_REPOS=("$PROJECT_ROOT/{service-1}" "$PROJECT_ROOT/{service-2}")
# Port allocation: CI base ports, RC = +100, Prod = +200
WEB_PORT_CI={WEB_PORT}
WEB_PORT_RC=$(( WEB_PORT_CI + 100 ))
WEB_PORT_PROD=$(( WEB_PORT_CI + 200 ))
DASHBOARD_PORT=4400
DASHBOARD_PID_FILE="/tmp/envctl-dashboard.pid"

# Test suites for `envctl test`. Run from the project root with BASE_URL
# exported for the environment under test. Defaults run the Python suites in
# tests/; replace for other stacks, e.g.
#   INTEGRATION_TEST_CMD="cd {service-1} && npm run --silent test:integration"
INTEGRATION_TEST_CMD="python3 -m pytest tests/integration/ -v"
E2E_TEST_CMD="python3 -m pytest tests/e2e/ -v"
SMOKE_TEST_CMD="python3 -m pytest tests/smoke/ -v"
# Installed before the suite runs; skipped when the file doesn't exist.
TEST_REQUIREMENTS="tests/requirements.txt"

# ── Preconditions ───────────────────────────────────────────────────────────

require_compose() {
  local v
  v=$(docker compose version --short 2>/dev/null | sed 's/^v//') || true
  [ -z "$v" ] && { echo "ERROR: docker compose not found. Install Docker Desktop." >&2; exit 1; }
  # Compare against 2.24.4 (first release with `!override`).
  if [ "$(printf '%s\n%s\n' "2.24.4" "$v" | sort -V | head -1)" != "2.24.4" ]; then
    echo "ERROR: Docker Compose $v is too old — need >= 2.24.4 for 'ports: !override'." >&2
    exit 1
  fi
}

require_env_file() {
  local env="$1"
  if [ "$env" = "prod" ] && [ ! -f .env.prod-parity ]; then
    echo "ERROR: infra/.env.prod-parity is missing." >&2
    echo "  cp infra/.env.prod-parity.example infra/.env.prod-parity  # then fill in real values" >&2
    exit 1
  fi
}

web_port_for() {
  case "$1" in
    ci)   echo "$WEB_PORT_CI" ;;
    rc)   echo "$WEB_PORT_RC" ;;
    prod) echo "$WEB_PORT_PROD" ;;
  esac
}

# ── Compose commands per environment ────────────────────────────────────────

ci_compose() {
  docker compose \
    -f docker-compose.base.yml \
    -f docker-compose.ci.yml \
    --env-file .env.ci \
    "$@"
}

rc_compose() {
  docker compose \
    -f docker-compose.base.yml \
    -f docker-compose.ci.yml \
    -f docker-compose.test.yml \
    --env-file .env.test \
    "$@"
}

prod_compose() {
  docker compose \
    -f docker-compose.base.yml \
    -f docker-compose.prod-parity.yml \
    --env-file .env.prod-parity \
    "$@"
}

# ── Checkout the right branch for each environment ──────────────────────────

checkout_branch() {
  local env="$1"
  case "$env" in
    ci)
      echo "Checking out ci branch..."
      for repo in "${SERVICE_REPOS[@]}"; do
        (cd "$repo" && git checkout ci && git pull origin ci)
      done
      ;;
    rc)
      local rc_branch
      rc_branch=$(cd "${SERVICE_REPOS[0]}" && git branch -r --sort=-committerdate | grep 'origin/release-rc-' | head -1 | tr -d ' ' | sed 's|origin/||')
      if [ -z "$rc_branch" ]; then
        echo "No release-rc-* branch found. Using ci instead."
        rc_branch="ci"
      fi
      echo "Checking out $rc_branch..."
      for repo in "${SERVICE_REPOS[@]}"; do
        (cd "$repo" && git checkout "$rc_branch" 2>/dev/null && git pull origin "$rc_branch" 2>/dev/null || echo "  $(basename "$repo"): $rc_branch not found, staying on current branch")
      done
      ;;
    prod)
      echo "Checking out main branch..."
      for repo in "${SERVICE_REPOS[@]}"; do
        (cd "$repo" && git checkout main && git pull origin main)
      done
      ;;
  esac
}

# ── Dashboard management ────────────────────────────────────────────────────

ensure_dashboard() {
  if [ -f "$DASHBOARD_PID_FILE" ] && kill -0 "$(cat "$DASHBOARD_PID_FILE")" 2>/dev/null; then
    return 0  # already running
  fi
  echo "Starting dashboard on http://localhost:$DASHBOARD_PORT ..."
  nohup python3 "$(dirname "$0")/dashboard.py" --port "$DASHBOARD_PORT" \
    > /tmp/envctl-dashboard.log 2>&1 &
  echo $! > "$DASHBOARD_PID_FILE"
  sleep 1
  if kill -0 "$(cat "$DASHBOARD_PID_FILE")" 2>/dev/null; then
    echo "Dashboard running (PID $(cat "$DASHBOARD_PID_FILE"))."
  else
    echo "Warning: dashboard failed to start. Check /tmp/envctl-dashboard.log"
  fi
}

cmd_dashboard() {
  local action="${1:-start}"
  case "$action" in
    start)
      ensure_dashboard
      ;;
    stop)
      if [ -f "$DASHBOARD_PID_FILE" ]; then
        local pid; pid=$(cat "$DASHBOARD_PID_FILE")
        kill "$pid" 2>/dev/null && echo "Dashboard stopped (PID $pid)." || echo "Dashboard not running."
        rm -f "$DASHBOARD_PID_FILE"
      else
        echo "Dashboard not running."
      fi
      ;;
    restart)
      cmd_dashboard stop
      cmd_dashboard start
      ;;
    status)
      if [ -f "$DASHBOARD_PID_FILE" ] && kill -0 "$(cat "$DASHBOARD_PID_FILE")" 2>/dev/null; then
        echo "Dashboard running on http://localhost:$DASHBOARD_PORT (PID $(cat "$DASHBOARD_PID_FILE"))"
      else
        echo "Dashboard not running."
      fi
      ;;
    *)
      echo "Usage: envctl dashboard start|stop|restart|status"
      ;;
  esac
}

# ── Commands ────────────────────────────────────────────────────────────────

cmd_up() {
  local env="$1"
  if [ "$env" = "all" ]; then
    cmd_up ci; cmd_up rc; cmd_up prod; return
  fi
  require_compose; require_env_file "$env"
  ensure_dashboard

  # Start from the :$env images. If any is missing, build it from the env's
  # branch first — never let Compose fall back to building from whatever
  # branch happens to be checked out in the working tree.
  local repo
  for repo in "${SERVICE_REPOS[@]}"; do
    if ! docker image inspect "$(basename "$repo"):${env}" >/dev/null 2>&1; then
      echo "No $(basename "$repo"):${env} image yet — building from the $env branch."
      cmd_rebuild "$env"
      return
    fi
  done

  echo "Starting $env environment from :$env images..."
  ${env}_compose up -d --wait --wait-timeout 120
  echo "$env environment is up."
}

cmd_down() {
  local env="$1" wipe="${2:-}"
  if [ "$env" = "all" ]; then
    cmd_down ci; cmd_down rc; cmd_down prod "$wipe"; return
  fi
  if [ "$env" = "prod" ] && [ ! -f .env.prod-parity ]; then
    echo "prod: no .env.prod-parity — nothing to stop."; return 0
  fi
  echo "Stopping $env environment..."
  if [ "$env" = "prod" ] && [ "$wipe" != "--wipe" ]; then
    # Prod-parity holds persisted data — keep named volumes unless asked.
    ${env}_compose down --remove-orphans
    echo "  (volumes kept — use 'envctl down prod --wipe' to delete them)"
  else
    ${env}_compose down -v --remove-orphans
  fi
}

# ── Test command ───────────────────────────────────────────────────────────
# Deterministic: boot environment, install deps, run suite, capture result,
# tear down. Saves Claude tokens — agents call this instead of writing
# raw docker compose + pip + pytest sequences.
#
# Usage:
#   ./envctl test ci integration    Run integration tests against CI env
#   ./envctl test rc e2e            Run E2E tests against RC env
#   ./envctl test prod smoke        Run smoke tests against prod-parity env
#   ./envctl test ci                Run default suite for CI env

cmd_test() {
  local env="$1"
  local suite="${2:-all}"
  local result=0

  if [ "$suite" = "all" ]; then
    case "$env" in
      ci)   suite=integration ;;
      rc)   suite=e2e ;;
      prod) suite=smoke ;;
    esac
  fi
  local test_cmd
  case "$suite" in
    integration) test_cmd="$INTEGRATION_TEST_CMD" ;;
    e2e)         test_cmd="$E2E_TEST_CMD" ;;
    smoke)       test_cmd="$SMOKE_TEST_CMD" ;;
    *) echo "Unknown suite: $suite. Use: integration, e2e, smoke, or all."; return 1 ;;
  esac

  echo "=== envctl test $env $suite ==="

  # 1. Boot environment (builds :$env images from the env's branch if missing)
  echo "[1/4] Booting $env environment..."
  cmd_up "$env" || { echo "FAIL: environment failed to start"; return 1; }

  # 2. Install test dependencies (only if the project has a requirements file)
  echo "[2/4] Installing test dependencies..."
  if [ -f "$PROJECT_ROOT/$TEST_REQUIREMENTS" ]; then
    python3 -m pip install -q -r "$PROJECT_ROOT/$TEST_REQUIREMENTS" || {
      echo "FAIL: could not install test dependencies"; cmd_down "$env"; return 1
    }
  else
    echo "  ($TEST_REQUIREMENTS not found — skipping)"
  fi

  # 3. Run the suite against this environment's web port
  local base_url="http://localhost:$(web_port_for "$env")"
  echo "[3/4] Running $suite tests against $base_url..."
  (cd "$PROJECT_ROOT" && BASE_URL="$base_url" bash -c "$test_cmd") || result=1

  # 4. Tear down
  echo "[4/4] Tearing down $env environment..."
  cmd_down "$env"

  if [ $result -eq 0 ]; then
    echo "=== PASSED: envctl test $env $suite ==="
  else
    echo "=== FAILED: envctl test $env $suite ==="
  fi
  return $result
}

cmd_rebuild() {
  local env="$1"
  if [ "$env" = "all" ]; then
    cmd_rebuild ci; cmd_rebuild rc; cmd_rebuild prod; return
  fi

  require_compose; require_env_file "$env"

  # Determine which branch to build from (without checking it out).
  # REBUILD_BRANCH overrides — e.g. pipelinectl ci-gate builds the
  # fixture-seeded rc stack from ci before any RC has been cut.
  local branch
  if [ -n "${REBUILD_BRANCH:-}" ]; then
    branch="$REBUILD_BRANCH"
  else
    case "$env" in
      ci)   branch="ci" ;;
      rc)
        branch=$( (cd "${SERVICE_REPOS[0]}" && git branch -r --sort=-committerdate 2>/dev/null | grep 'origin/release-rc-' | head -1 | tr -d ' ' | sed 's|origin/||') || true )
        [ -z "$branch" ] && branch="ci"
        ;;
      prod) branch="main" ;;
    esac
  fi

  # Map env name to build arg values (customize per project)
  local build_env
  case "$env" in
    ci)   build_env="ci" ;;
    rc)   build_env="test" ;;
    prod) build_env="prod-parity" ;;
  esac

  echo "Building :$env images from branch $branch (no checkout)..."

  # Build from git archive — extracts the branch into a temp dir so the
  # working tree is untouched. Dev team can stay on their feature branch.
  # The images are tagged {repo}:{env}, which is what the compose files'
  # `image: {service}:${IMAGE_TAG}` lines start.
  for repo in "${SERVICE_REPOS[@]}"; do
    local name; name=$(basename "$repo")
    local tmpdir; tmpdir=$(mktemp -d)

    export_source "$repo" "$branch" "$tmpdir"

    docker build -t "${name}:${env}" \
      --build-arg "NEXT_PUBLIC_ENVIRONMENT=${build_env}" \
      "$tmpdir"

    # Migrate image — only when the Dockerfile defines an `AS migrate`
    # stage. Apps that migrate on startup don't need one (and should drop
    # the db-migrate service from the compose files).
    if grep -qiE '^FROM[[:space:]].*[[:space:]]AS[[:space:]]+migrate[[:space:]]*$' "$tmpdir/Dockerfile" 2>/dev/null; then
      docker build -t "${name}-migrate:${env}" --target migrate "$tmpdir"
    fi

    rm -rf "$tmpdir"
  done

  # Prune dangling images and build cache to prevent disk exhaustion.
  # Only removes untagged images and unused build layers — safe to run.
  docker image prune -f > /dev/null 2>&1
  docker builder prune -f --keep-storage=5GB > /dev/null 2>&1

  echo "Starting $env environment with :$env images..."
  ${env}_compose up -d --wait --wait-timeout 120
  echo "$env environment started."
}

# Copy a repo's source for $branch into $dest. Falls back to the working tree
# when the branch doesn't exist yet or has no Dockerfile — the normal state for
# the first Deliverable, before anything has been merged to ci.
export_source() {
  local repo="$1" branch="$2" dest="$3" ref=""
  if (cd "$repo" && git rev-parse --verify -q "origin/$branch" >/dev/null); then
    ref="origin/$branch"
  elif (cd "$repo" && git rev-parse --verify -q "$branch" >/dev/null); then
    ref="$branch"
  fi
  if [ -n "$ref" ] && (cd "$repo" && git cat-file -e "$ref:Dockerfile" 2>/dev/null); then
    (cd "$repo" && git archive "$ref") | tar -x -C "$dest"
  else
    echo "  WARNING: $(basename "$repo"): '$branch' has no Dockerfile yet — building from the working tree." >&2
    tar -C "$repo" --exclude=.git --exclude=node_modules --exclude=.next --exclude=.venv -cf - . | tar -x -C "$dest"
  fi
}

# Build straight from the working tree (whatever branch is checked out).
# For the first Deliverable and for local debugging — pipeline stages use
# `rebuild`, which builds from the environment's branch.
cmd_rebuild_local() {
  local env="$1"
  require_compose; require_env_file "$env"
  echo "Building $env from the working tree (not the $env branch)..."
  ${env}_compose up -d --wait --wait-timeout 120 --build
  echo "$env environment started from working tree."
}

cmd_status() {
  echo "=== CI — http://localhost:$WEB_PORT_CI ==="
  ci_compose ps --format "table {{.Name}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null || echo "  Not running"
  echo ""
  echo "=== RC — http://localhost:$WEB_PORT_RC ==="
  rc_compose ps --format "table {{.Name}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null || echo "  Not running"
  echo ""
  echo "=== Prod-parity — http://localhost:$WEB_PORT_PROD ==="
  prod_compose ps --format "table {{.Name}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null || echo "  Not running"
}

cmd_logs() {
  local env="$1"
  ${env}_compose logs -f --tail=50
}

cmd_urls() {
  echo "Browsable environments:"
  echo ""
  echo "  CI (ci branch):              http://localhost:$WEB_PORT_CI"
  echo "  RC (release-rc-* branch):    http://localhost:$WEB_PORT_RC"
  echo "  Prod-parity (main branch):   http://localhost:$WEB_PORT_PROD"
  echo ""
}

# ── Main ────────────────────────────────────────────────────────────────────

case "${1:-}" in
  up)        cmd_up "${2:?Usage: envctl up ci|rc|prod|all}" ;;
  down)      cmd_down "${2:?Usage: envctl down ci|rc|prod|all [--wipe]}" "${3:-}" ;;
  rebuild)   cmd_rebuild "${2:?Usage: envctl rebuild ci|rc|prod|all}" ;;
  rebuild-local) cmd_rebuild_local "${2:?Usage: envctl rebuild-local ci|rc|prod}" ;;
  test)      cmd_test "${2:?Usage: envctl test ci|rc|prod [integration|e2e|smoke]}" "${3:-all}" ;;
  status)    cmd_status ;;
  logs)      cmd_logs "${2:?Usage: envctl logs ci|rc|prod}" ;;
  urls)      cmd_urls ;;
  dashboard) cmd_dashboard "${2:-start}" ;;
  *)
    echo "Usage: envctl <command> [environment]"
    echo ""
    echo "Commands:"
    echo "  up        ci|rc|prod|all                      Start environment (auto-starts dashboard)"
    echo "  down      ci|rc|prod|all [--wipe]             Stop environment (prod keeps volumes unless --wipe)"
    echo "  rebuild   ci|rc|prod|all                      Build :env images from the env's branch + start"
    echo "  rebuild-local ci|rc|prod                      Build from the working tree + start"
    echo "  test      ci|rc|prod [integration|e2e|smoke]  Boot, test, tear down (saves Claude tokens)"
    echo "  status                                        Show running environments"
    echo "  logs      ci|rc|prod                          Tail logs"
    echo "  urls                                          Show browsable URLs"
    echo "  dashboard start|stop|restart|status           Manage environment dashboard (port \$DASHBOARD_PORT)"
    ;;
esac
