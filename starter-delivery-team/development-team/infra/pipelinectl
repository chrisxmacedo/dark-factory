#!/usr/bin/env bash
# pipelinectl — mechanical pipeline operations without Claude tokens
#
# Handles: Jira polling, CI gates, ticket transitions, branch operations.
# Only invokes Claude for reasoning tasks (development, analysis, review).
#
# Usage:
#   ./pipelinectl poll                    Find and process next ready ticket
#   ./pipelinectl ci-gate {KEY}-22        Run CI gates
#   ./pipelinectl local-gate {KEY}-22     Run local test gates
#   ./pipelinectl merge-to-ci {KEY}-22    Merge feature → ci
#   ./pipelinectl cut-rc {KEY}-22         Cut release-rc-{n} fresh from ci HEAD
#   ./pipelinectl merge-rc {KEY}-22 N     Merge RC → main, tag, back-merge
#   ./pipelinectl needs-claude {KEY}-22   Check if Claude is needed
#
# Replace {PLACEHOLDERS} with project-specific values.
# Requires: jiractl configured with .env.jira
#
# six-field spec (per .claude/context/process-spec.md)
#   inputs         subcommand + ticket key; reads infra/.env.jira; reads SERVICE_REPOS
#   outputs        Jira transitions, git operations, stdout log; exit 0 pass / 1 fail
#   preconditions  infra/.env.jira present; Docker running for gate commands; target
#                  repos clean for merge commands
#   postconditions ticket is in expected target state; _audit.jsonl has one line per
#                  gate or transition operation
#   idempotency    idempotent where the target state equals the current state
#                  (e.g. merge-to-ci on an already-merged branch is a no-op);
#                  non-idempotent for cut-rc (creates a new RC number each time)
#   audit events   {script:"pipelinectl <sub>", args, exit_code, blockers, warnings}

set -euo pipefail
INFRA_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$INFRA_DIR"

# Audit helper — every subcommand outcome writes one JSONL line via EXIT trap.
# shellcheck source=audit.sh
source "$INFRA_DIR/audit.sh"
audit_capture_args "$@"
_PCTL_SUB="${1:-unknown}"
_PCTL_KEY="${2:-}"
trap 'code=$?; audit_log "pipelinectl $_PCTL_SUB" "$code" 0 0 "{\"ticket\":\"$_PCTL_KEY\"}"; exit $code' EXIT

PROJECT_ROOT="$(cd .. && pwd)"
JIRACTL="$INFRA_DIR/jiractl"
ENVCTL="$INFRA_DIR/envctl"

# ── Config — replace these ──────────────────────────────────────────────────

PROJECT_KEY="{PROJECT_KEY}"
SERVICE_REPOS=("$PROJECT_ROOT/{service-1}" "$PROJECT_ROOT/{service-2}")

# Transition IDs — update after Jira setup
T_BACKLOG={TBC}
T_IN_REFINEMENT={TBC}
T_IN_DEV={TBC}
T_IN_LOCAL={TBC}
T_IN_INTEGRATION={TBC}
T_IN_E2E={TBC}
T_IN_REGRESSION={TBC}
T_RELEASE={TBC}
T_DONE={TBC}

# Local gate commands, run in every service repo that has the feature branch.
# "auto" picks them per repo from its stack:
#   package.json   → npm ci (if no node_modules), then each of lint,
#                    format:check, typecheck, build, test that the repo defines
#   pyproject.toml → uv sync (if no .venv), ruff check, ruff format --check,
#                    mypy src (if [tool.mypy]), pytest
# Or list explicit "label|command" pairs (applied to every repo), e.g.
#   LOCAL_GATE_CMDS=("lint|npm run lint" "build|npm run build" "test|npm test")
LOCAL_GATE_CMDS=(auto)

# ── Helpers ─────────────────────────────────────────────────────────────────

log() { echo "[pipelinectl] $*"; }
err() { echo "[pipelinectl] ERROR: $*" >&2; }

get_ticket_status() {
  "$JIRACTL" status "$1" 2>/dev/null | grep "Status:" | sed 's/.*Status: *//'
}

get_feature_branch() {
  local key="$1"
  # Strip the "* " marker git puts on the currently checked-out branch.
  (cd "${SERVICE_REPOS[0]}" && git branch -a | grep "feature/${key}/" | head -1 | sed 's|^[* ]*||' | tr -d ' ' | sed 's|remotes/origin/||') || echo ""
}

next_rc_number() {
  local max=0
  for repo in "${SERVICE_REPOS[@]}"; do
    local n
    # sed, not `grep -oP` — macOS (BSD) grep has no -P, and under
    # `set -euo pipefail` that failure silently returned "" here.
    n=$( (cd "$repo" && git branch -a 2>/dev/null | sed -nE 's|^.*release-rc-([0-9]+).*$|\1|p' | sort -n | tail -1) || true )
    [ -n "$n" ] && [ "$n" -gt "$max" ] && max=$n
  done
  echo $((max + 1))
}

# Print "label|command" lines for a repo's local gate (see LOCAL_GATE_CMDS).
local_gate_cmds() {
  local repo="$1"
  if [ "${LOCAL_GATE_CMDS[0]}" != "auto" ]; then
    printf '%s\n' "${LOCAL_GATE_CMDS[@]}"
    return
  fi
  if [ -f "$repo/package.json" ]; then
    [ -d "$repo/node_modules" ] || echo "install|npm ci --silent"
    local script
    for script in $(python3 -c "import json,sys; print(' '.join(json.load(open(sys.argv[1])).get('scripts', {})))" "$repo/package.json"); do
      case "$script" in
        lint|format:check|typecheck|build) echo "$script|npm run --silent $script" ;;
        test) echo "test|npm test --silent" ;;
      esac
    done
  elif [ -f "$repo/pyproject.toml" ]; then
    [ -d "$repo/.venv" ] || echo "install|uv sync --quiet"
    echo "lint|uv run ruff check ."
    echo "format|uv run ruff format --check ."
    grep -q '^\[tool\.mypy\]' "$repo/pyproject.toml" && echo "typecheck|uv run mypy src"
    echo "test|uv run pytest -q"
  fi
}

# ── CI Gate ─────────────────────────────────────────────────────────────────

cmd_ci_gate() {
  local key="$1"
  log "Running CI gates for $key..."

  # Unit tests, lint and format already ran in local-gate and run again in the
  # GitHub CI workflow; this gate is the Docker integration suite.
  #
  # Integration tests run against the rc (Test) stack — CI services plus
  # fixture seeding — so tests can rely on known records. The images are
  # built from the ci branch without touching anyone's working tree.
  local all_pass=true
  log "[1/2] Building the Test stack from ci..."
  if ! REBUILD_BRANCH=ci "$ENVCTL" rebuild rc; then
    err "Test stack failed to build or start from ci."
    all_pass=false
  else
    log "[2/2] Running integration tests..."
    "$ENVCTL" test rc integration || all_pass=false
  fi

  if $all_pass; then
    "$JIRACTL" comment "$key" "CI PASSED. Integration suite green against the fixture-seeded Test stack built from ci. Run by pipelinectl."
  else
    "$JIRACTL" comment "$key" "CI FAILED. See pipelinectl output. Run by pipelinectl."
  fi
  # The EXIT trap records the final exit code; $all_pass determines it.
  $all_pass
}

# ── Local Test Gate ─────────────────────────────────────────────────────────

cmd_local_gate() {
  local key="$1"
  log "Running local test gates for $key..."
  local branch; branch=$(get_feature_branch "$key")
  [ -z "$branch" ] && { err "No feature branch for $key"; return 1; }

  local all_pass=true summary="" repo
  for repo in "${SERVICE_REPOS[@]}"; do
    local name; name=$(basename "$repo")
    if ! (cd "$repo" && git rev-parse --verify -q "$branch" >/dev/null); then
      log "  $name: no $branch — skipping"; continue
    fi
    (cd "$repo" && git checkout -q "$branch") || { err "$name: cannot check out $branch"; all_pass=false; continue; }

    local gates; gates=$(local_gate_cmds "$repo")
    if [ -z "$gates" ]; then
      err "$name: no gate commands — no package.json/pyproject.toml; set LOCAL_GATE_CMDS"
      all_pass=false; continue
    fi
    local label cmd
    while IFS='|' read -r label cmd; do
      [ -z "$label" ] && continue
      log "  $name: $label"
      # </dev/null so a command reading stdin can't swallow the gate list.
      if (cd "$repo" && bash -c "$cmd" </dev/null); then
        summary+="$name $label: pass. "
      else
        err "  $name: $label FAILED"
        summary+="$name $label: FAIL. "
        all_pass=false
      fi
    done <<< "$gates"
  done

  if $all_pass; then
    "$JIRACTL" comment "$key" "Local gate PASSED on $branch. $summary"
    log "Local gate PASS."
  else
    "$JIRACTL" comment "$key" "Local gate FAILED on $branch. $summary"
    err "Local gate FAIL."
  fi
  $all_pass
}

# ── Merge Feature to CI ────────────────────────────────────────────────────
# HARD GATE: production build must pass before merge.

cmd_merge_to_ci() {
  local key="$1"
  local branch
  branch=$(get_feature_branch "$key")
  [ -z "$branch" ] && { err "No feature branch for $key"; return 1; }

  # Hard gate: verify production build passes on feature branch
  log "Build gate: verifying production build on $branch..."
  if ! (cd "${SERVICE_REPOS[0]}" && git checkout "$branch" 2>/dev/null && {BUILD_COMMAND} 2>&1); then
    err "BLOCKED: build fails on $branch. Fix before merging."
    "$JIRACTL" comment "$key" "MERGE BLOCKED. Build fails on $branch."
    return 1
  fi
  log "Build gate passed."

  for repo in "${SERVICE_REPOS[@]}"; do
    local name; name=$(basename "$repo")
    if ! (cd "$repo" && git rev-parse --verify "$branch" 2>/dev/null); then
      log "  $name: $branch not found, skipping"; continue
    fi
    log "  $name: rebasing $branch onto ci, merging..."
    (cd "$repo" && git checkout "$branch" && git fetch origin ci && \
     git rebase origin/ci && \
     # Annotate the branch-off point (where feature diverged from ci)
     git notes append -m "branch-off: $branch from ci — $key" "$(git merge-base ci "$branch")" 2>/dev/null && log "  note created." || log "  WARNING: git note failed." && \
     git checkout ci && git pull origin ci && \
     git merge --no-ff "$branch" -m "Merge $branch into ci — $key" && \
     # Annotate the merge commit
     git notes append -m "merge: $branch into ci — $key" HEAD 2>/dev/null && log "  note created." || log "  WARNING: git note failed." && \
     git push origin ci && \
     git push origin refs/notes/commits 2>/dev/null || true)
  done

  "$JIRACTL" comment "$key" "Feature merged into ci. Branch: $branch."
  "$JIRACTL" transition "$key" "$T_IN_INTEGRATION"
}

# ── Cut RC from CI HEAD ────────────────────────────────────────────────────
# CRITICAL: Always from ci HEAD. Never from a previous RC.
# HARD GATE: ci must build successfully before cutting.

cmd_cut_rc() {
  local key="$1"

  log "Build gate: verifying ci branch builds..."
  if ! (cd "${SERVICE_REPOS[0]}" && git checkout ci 2>/dev/null && git pull origin ci --quiet 2>/dev/null && docker build -t {PROJECT_SLUG}-verify . 2>&1); then
    err "BLOCKED: ci Docker build fails. Fix before cutting RC."
    "$JIRACTL" comment "$key" "RC CUT BLOCKED. Docker build fails on ci."
    docker rmi {PROJECT_SLUG}-verify 2>/dev/null
    return 1
  fi
  docker rmi {PROJECT_SLUG}-verify 2>/dev/null
  log "Build gate passed."

  local rc_num; rc_num=$(next_rc_number)
  local rc_branch="release-rc-${rc_num}"

  log "Cutting $rc_branch from ci HEAD (skipping repos with no changes since last RC)..."
  local cut_repos=""
  local skipped_repos=""

  for repo in "${SERVICE_REPOS[@]}"; do
    local name; name=$(basename "$repo")

    # Only cut a new RC if ci has non-merge commits since the last RC.
    # Back-merges from main don't represent new work.
    local last_rc; last_rc=$(cd "$repo" && git branch -a --sort=-committerdate | grep -o 'release-rc-[0-9]*' | head -1 || true)
    if [ -n "$last_rc" ]; then
      local new_commits; new_commits=$(cd "$repo" && git log "origin/ci" --not "origin/$last_rc" --oneline --no-merges 2>/dev/null | wc -l | tr -d ' ')
      if [ "$new_commits" = "0" ]; then
        log "  $name: no new non-merge commits since $last_rc — skipping."
        skipped_repos="${skipped_repos}, ${name}"
        continue
      fi
    fi

    (cd "$repo" && git fetch origin ci && git checkout ci && git pull origin ci && \
     git checkout -b "$rc_branch" ci && \
     # Annotate the RC branch-off point on ci
     git notes append -m "branch-off: $rc_branch from ci — $key" "$(git rev-parse ci)" 2>/dev/null && log "  note created." || log "  WARNING: git note failed." && \
     git push -u origin "$rc_branch" && \
     git push origin refs/notes/commits 2>/dev/null || true)
    log "  $name: $rc_branch created."
    cut_repos="${cut_repos}, ${name}"
  done

  # Trim leading ", "
  cut_repos="${cut_repos#, }"
  skipped_repos="${skipped_repos#, }"

  local comment="RC cut: $rc_branch."
  [ -n "$cut_repos" ] && comment="${comment} Repos included: ${cut_repos}."
  [ -n "$skipped_repos" ] && comment="${comment} Repos skipped (no changes): ${skipped_repos}."
  "$JIRACTL" comment "$key" "$comment"
  "$JIRACTL" transition "$key" "$T_IN_REGRESSION"
}

# ── Merge RC to Main ───────────────────────────────────────────────────────
# HARD GATE: RC must build successfully before merging to main.

cmd_merge_rc() {
  local key="$1" rc_num="$2"
  local rc_branch="release-rc-${rc_num}"

  # Build gate: verify Docker build passes on every repo that has the RC branch.
  log "Build gate: verifying $rc_branch builds..."
  local gate_failed=false
  for repo in "${SERVICE_REPOS[@]}"; do
    local name; name=$(basename "$repo")
    if ! (cd "$repo" && git rev-parse --verify "origin/$rc_branch" 2>/dev/null); then
      continue  # repo doesn't have this RC — skip
    fi
    log "  $name: building from $rc_branch..."
    if ! (cd "$repo" && git fetch origin "$rc_branch" && docker build -t "${name}-verify" . 2>&1); then
      err "BLOCKED: $rc_branch Docker build fails in $name. Fix before merging to main."
      "$JIRACTL" comment "$key" "MERGE TO MAIN BLOCKED. Docker build fails on $rc_branch in $name."
      gate_failed=true
    fi
    docker rmi "${name}-verify" 2>/dev/null
  done
  if [ "$gate_failed" = true ]; then
    return 1
  fi
  log "Build gate passed."

  for repo in "${SERVICE_REPOS[@]}"; do
    local name; name=$(basename "$repo")
    if ! (cd "$repo" && git rev-parse --verify "origin/$rc_branch" 2>/dev/null); then
      log "  $name: $rc_branch not found, skipping"; continue
    fi

    (cd "$repo" && git fetch origin && git checkout main && git pull origin main && \
     git merge --no-ff "origin/$rc_branch" -m "Merge $rc_branch into main — $key" && \
     # Annotate the RC→main merge
     git notes append -m "merge: $rc_branch into main — $key" HEAD 2>/dev/null || true)

    # Tag
    # Portable grep (BSD grep has no -P); `|| true` so "no tags yet" isn't fatal.
    local ver; ver=$( (cd "$repo" && git tag 2>/dev/null | grep -Eo '^v[0-9]+\.[0-9]+(\.[0-9]+)?$' | sort -V | tail -1) || true )
    [ -z "$ver" ] && ver="v0.0"
    local major minor new_tag
    major=$(echo "$ver" | cut -d. -f1)
    minor=$(echo "$ver" | cut -d. -f2)
    new_tag="${major}.$((minor + 1)).0"

    (cd "$repo" && git tag "$new_tag" -m "$new_tag: $key" && \
     git push origin main --tags && \
     git checkout ci && git pull origin ci && \
     git merge --no-ff main -m "Back-merge main ($new_tag) into ci — $key" && \
     # Annotate the back-merge
     git notes append -m "merge: main ($new_tag) back-merge into ci — $key" HEAD 2>/dev/null && log "  note created." || log "  WARNING: git note failed." && \
     git push origin ci && \
     git push origin refs/notes/commits 2>/dev/null || true)

    log "  $name: merged, tagged $new_tag, back-merged."
  done

  "$JIRACTL" comment "$key" "Released. RC: $rc_branch → main. Tagged. Back-merged to ci."
  "$JIRACTL" transition "$key" "$T_RELEASE"
}

# ── Needs Claude? ───────────────────────────────────────────────────────────

cmd_needs_claude() {
  local status; status=$(get_ticket_status "$1")
  case "$status" in
    "In Refinement")               echo "YES — needs Development Team for refinement" ;;
    "In Development")              echo "YES — needs Development Team" ;;
    "In Local Test")               echo "MAYBE — run pipelinectl local-gate first. Claude only if it fails." ;;
    "In Integration Test")         echo "PARTIAL — run pipelinectl ci-gate, then Claude for analysis." ;;
    "In E2E Impact Test")          echo "YES — needs Impact Analyst + E2E Runner" ;;
    "In Full E2E Regression")      echo "PARTIAL — run envctl test rc, then Claude for readiness." ;;
    "Release / Production")        echo "NO — run pipelinectl merge-rc" ;;
    *) echo "Status: $status — check manually." ;;
  esac
}

cmd_poll() {
  "$JIRACTL" poll
  echo ""
  echo "Run: ./pipelinectl needs-claude {KEY}-{N} to see what's needed."
}

case "${1:-}" in
  poll)         cmd_poll ;;
  ci-gate)      cmd_ci_gate "${2:?}" ;;
  local-gate)   cmd_local_gate "${2:?}" ;;
  merge-to-ci)  cmd_merge_to_ci "${2:?}" ;;
  cut-rc)       cmd_cut_rc "${2:?}" ;;
  merge-rc)     cmd_merge_rc "${2:?}" "${3:?}" ;;
  needs-claude) cmd_needs_claude "${2:?}" ;;
  *)
    echo "pipelinectl — mechanical pipeline ops (no Claude tokens)"
    echo ""
    echo "  poll / needs-claude / local-gate / ci-gate"
    echo "  merge-to-ci / cut-rc / merge-rc"
    ;;
esac
