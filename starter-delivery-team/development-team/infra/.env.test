# infra/.env.test
# Committed to repo — no secrets
ENVIRONMENT=test
POSTGRES_PASSWORD=ci-password
MINIO_ROOT_USER={PROJECT_SLUG}
MINIO_ROOT_PASSWORD=ci-password
# LLM API — routed to stub server or fixture mode
# Anthropic: CLAUDE_API_KEY=stub-key-not-real
# OpenAI:    OPENAI_API_KEY=stub-key-not-real
SENTRY_DSN=
OTEL_ENDPOINT=stdout
# info, not warn — see .env.ci
LOG_LEVEL=info
LOG_FORMAT=json
SERVICE_VERSION=test
# Image tag for application services (docker-compose image: {service}:${IMAGE_TAG}).
# envctl rebuild builds these tags from the environment's branch.
IMAGE_TAG=rc
