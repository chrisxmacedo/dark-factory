# infra/.env.prod-parity
# NEVER committed — add to .gitignore
# Copy this file to .env.prod-parity and fill in real values
ENVIRONMENT=prod-parity
POSTGRES_PASSWORD=<strong-password>
MINIO_ROOT_USER={PROJECT_SLUG}
MINIO_ROOT_PASSWORD=<strong-password>
REDIS_PASSWORD=<strong-password>
# LLM API — REAL key, costs real money
# Anthropic: CLAUDE_API_KEY=<real-api-key>
# OpenAI:    OPENAI_API_KEY=<real-api-key>
GRAFANA_PASSWORD=<strong-password>
SERVICE_VERSION=<git-commit-sha>
LOG_LEVEL=info
LOG_FORMAT=json
# Image tag for application services (docker-compose image: {service}:${IMAGE_TAG}).
# envctl rebuild builds these tags from the environment's branch.
IMAGE_TAG=prod
