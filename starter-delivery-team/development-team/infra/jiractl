#!/usr/bin/env bash
# jiractl — Jira REST API operations without Claude tokens
#
# Usage:
#   ./jiractl poll                         Find tickets ready for action
#   ./jiractl transition {PROJECT_KEY}-22 51       Transition ticket (by ID)
#   ./jiractl comment {PROJECT_KEY}-22 "message"   Add comment
#   ./jiractl components {PROJECT_KEY}-22 treemail-web treemail-sync
#   ./jiractl status {PROJECT_KEY}-22              Show ticket status
#
# Requires: JIRA_EMAIL and JIRA_API_TOKEN in infra/.env.jira
# Create token at: https://id.atlassian.com/manage-profile/security/api-tokens
#
# six-field spec (per .claude/context/process-spec.md)
#   inputs         subcommand + positional args; reads infra/.env.jira;
#                  reads JIRA_SITE, CLOUD_ID, PROJECT_KEY from config block
#   outputs        Jira REST calls; stdout per-subcommand text; exit 0/1
#   preconditions  infra/.env.jira present; target ticket exists for
#                  status/transition/comment/components
#   postconditions for mutating subcommands: remote Jira state updated;
#                  _audit.jsonl has one line describing the call
#   idempotency    idempotent when the remote already equals the target state
#                  (re-transitioning to the same status is a no-op)
#   audit events   {script:"jiractl <sub>", args, exit_code, meta:{ticket?}}

set -euo pipefail
INFRA_DIR="$(cd "$(dirname "$0")" && pwd)"

# shellcheck source=audit.sh
source "$INFRA_DIR/audit.sh"
audit_capture_args "$@"
_JIRACTL_SUB="${1:-unknown}"
_JIRACTL_TICKET="${2:-}"
trap 'code=$?; audit_log "jiractl $_JIRACTL_SUB" "$code" 0 0 "{\"ticket\":\"$_JIRACTL_TICKET\"}"; exit $code' EXIT

# ── Config ──────────────────────────────────────────────────────────────────

JIRA_SITE="{JIRA_SITE}"
CLOUD_ID="{CLOUD_ID}"
PROJECT_KEY="{PROJECT_KEY}"
JIRA_API="https://${JIRA_SITE}/rest/api/3"

# Load credentials
if [ -f "$INFRA_DIR/.env.jira" ]; then
  # shellcheck source=/dev/null
  source "$INFRA_DIR/.env.jira"
fi

if [ -z "${JIRA_EMAIL:-}" ] || [ -z "${JIRA_API_TOKEN:-}" ]; then
  echo "Error: JIRA_EMAIL and JIRA_API_TOKEN must be set in infra/.env.jira"
  echo ""
  echo "Create an API token at: https://id.atlassian.com/manage-profile/security/api-tokens"
  echo "Then create infra/.env.jira:"
  echo '  JIRA_EMAIL=you@example.com'
  echo '  JIRA_API_TOKEN=your-api-token'
  exit 1
fi

JIRA_AUTH="${JIRA_EMAIL}:${JIRA_API_TOKEN}"

# ── Helpers ─────────────────────────────────────────────────────────────────

# Retry wrapper for rate limits (HTTP 429) with pre-emptive pause at 98%
jira_request() {
  local method="$1"
  shift
  local max_retries=3
  local attempt=0

  while [ $attempt -lt $max_retries ]; do
    local tmpfile tmpheaders
    tmpfile=$(mktemp)
    tmpheaders=$(mktemp)

    local http_code
    http_code=$(curl -s -o "$tmpfile" -D "$tmpheaders" -w "%{http_code}" \
      -X "$method" -u "$JIRA_AUTH" \
      -H "Content-Type: application/json" \
      "$@")

    # Check rate limit headers before processing response
    local rl_limit rl_remaining
    rl_limit=$(grep -i 'x-ratelimit-limit' "$tmpheaders" 2>/dev/null | tr -dc '0-9' | head -c 10) || true
    rl_remaining=$(grep -i 'x-ratelimit-remaining' "$tmpheaders" 2>/dev/null | tr -dc '0-9' | head -c 10) || true

    if [ -n "$rl_limit" ] && [ -n "$rl_remaining" ] && [ "$rl_limit" -gt 0 ] 2>/dev/null; then
      local pct_used=$(( (rl_limit - rl_remaining) * 100 / rl_limit ))
      if [ "$pct_used" -ge 98 ]; then
        echo "[jiractl] ⚠️  Rate limit at ${pct_used}% (${rl_remaining}/${rl_limit} remaining). Pausing 60s to avoid 429." >&2
        echo "[jiractl] Will resume automatically. Tell the Team Lead to wait." >&2
        sleep 60
      elif [ "$pct_used" -ge 90 ]; then
        echo "[jiractl] Rate limit at ${pct_used}% (${rl_remaining}/${rl_limit} remaining)." >&2
      fi
    fi

    if [ "$http_code" = "429" ]; then
      attempt=$((attempt + 1))
      local retry_after
      retry_after=$(grep -i 'retry-after' "$tmpheaders" 2>/dev/null | tr -dc '0-9' | head -c 10) || true
      retry_after=${retry_after:-30}
      echo "[jiractl] Rate limited (429). Retry $attempt/$max_retries in ${retry_after}s..." >&2
      sleep "$retry_after"
      rm -f "$tmpfile" "$tmpheaders"
      continue
    fi

    rm -f "$tmpheaders"

    if [ "$http_code" -ge 400 ]; then
      cat "$tmpfile"
      rm -f "$tmpfile"
      return 1
    fi

    cat "$tmpfile"
    rm -f "$tmpfile"
    return 0
  done

  echo "[jiractl] Rate limit exhausted after $max_retries retries." >&2
  return 1
}

jira_get() {
  jira_request GET "$JIRA_API$1"
}

jira_post() {
  jira_request POST -d "$2" "$JIRA_API$1"
}

jira_put() {
  jira_request PUT -d "$2" "$JIRA_API$1"
}

jira_search() {
  local jql="$1"
  local fields="${2:-summary,status}"
  # Build JSON payload via Python to avoid shell escaping issues
  local payload
  payload=$(python3 -c "
import json
fields = '$fields'.split(',')
print(json.dumps({'jql': '''$jql''', 'fields': fields, 'maxResults': 50}))
")
  jira_post "/search/jql" "$payload"
}

# ── Commands ────────────────────────────────────────────────────────────────

cmd_poll() {
  echo "Polling $PROJECT_KEY for actionable tickets..."
  echo ""

  local queries=(
    "In Refinement"
    "In Development"
    "In Local Test"
    "In Integration Test"
    "In E2E Impact Test"
    "In Full E2E Regression"
    "Release / Production"
  )

  local found=false
  for status in "${queries[@]}"; do
    local result
    result=$(jira_search "project = $PROJECT_KEY AND status = \"$status\" ORDER BY priority ASC, created ASC" "summary,status,issuetype")
    local count
    count=$(echo "$result" | python3 -c "import sys,json; d=json.load(sys.stdin); print(len(d.get('issues',[])))" 2>/dev/null)

    if [ "$count" != "0" ] && [ -n "$count" ]; then
      found=true
      echo "=== $status ($count) ==="
      echo "$result" | python3 -c "
import sys, json
data = json.load(sys.stdin)
for issue in data.get('issues', []):
    key = issue['key']
    summary = issue['fields']['summary']
    itype = issue['fields']['issuetype']['name']
    print(f'  {key}: [{itype}] {summary}')
" 2>/dev/null
      echo ""
    fi
  done

  if [ "$found" = false ]; then
    echo "No tickets ready. Waiting for work."
  fi
}

cmd_transition() {
  local issue="$1"
  local transition_id="$2"

  echo "Transitioning $issue → transition $transition_id..."
  jira_post "/issue/$issue/transitions" "{\"transition\":{\"id\":\"$transition_id\"}}" > /dev/null
  echo "Done."

  # Auto-update PIPELINE-STATE.md if it exists
  local state_file="$INFRA_DIR/../PIPELINE-STATE.md"
  if [ -f "$state_file" ]; then
    local status_name
    status_name=$(jira_get "/issue/$issue?fields=status" | python3 -c "import sys,json; print(json.load(sys.stdin)['fields']['status']['name'])" 2>/dev/null)
    local summary
    summary=$(jira_get "/issue/$issue?fields=summary" | python3 -c "import sys,json; print(json.load(sys.stdin)['fields']['summary'])" 2>/dev/null)
    local timestamp; timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

    cat > "$state_file" << EOF
# Pipeline State — $PROJECT_KEY

## Active ticket

- **Key:** $issue
- **Title:** $summary
- **Status:** $status_name
- **Stage started:** $timestamp

## Last action

Transitioned $issue to $status_name at $timestamp.
EOF
    echo "  PIPELINE-STATE.md updated."
  fi
}

cmd_comment() {
  local issue="$1"
  shift
  local body="$*"

  echo "Adding comment to $issue..."
  jira_post "/issue/$issue/comment" "{\"body\":{\"type\":\"doc\",\"version\":1,\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"$body\"}]}]}}" > /dev/null
  echo "Done."
}

cmd_components() {
  local issue="$1"
  shift
  local components=("$@")

  # Look up component IDs by name
  local comp_json="["
  local first=true
  for comp_name in "${components[@]}"; do
    local comp_id
    comp_id=$(jira_get "/project/$PROJECT_KEY/components" | python3 -c "
import sys, json
target = '$comp_name'.lower().replace('-', ' ').replace('_', ' ')
for c in json.load(sys.stdin):
    if c['name'].lower().replace('-', ' ').replace('_', ' ') == target:
        print(c['id'])
        break
" 2>/dev/null)
    if [ -n "$comp_id" ]; then
      if [ "$first" = true ]; then first=false; else comp_json+=","; fi
      comp_json+="{\"id\":\"$comp_id\"}"
    else
      echo "Warning: component '$comp_name' not found"
    fi
  done
  comp_json+="]"

  echo "Setting components on $issue: ${components[*]}..."
  jira_put "/issue/$issue" "{\"fields\":{\"components\":$comp_json}}" > /dev/null
  echo "Done."
}

cmd_status() {
  local issue="$1"
  jira_get "/issue/$issue?fields=summary,status,issuetype,components" | python3 -c "
import sys, json
data = json.load(sys.stdin)
f = data['fields']
print(f\"{data['key']}: {f['summary']}\")
print(f\"  Type:       {f['issuetype']['name']}\")
print(f\"  Status:     {f['status']['name']}\")
comps = [c['name'] for c in f.get('components', [])]
print(f\"  Components: {', '.join(comps) if comps else 'none'}\")
" 2>/dev/null
}

# ── Create issue ────────────────────────────────────────────────────────────
# Unified create command. Description can be:
#   - A file path (.md file)
#   - "-" to read from stdin
#   - Omitted: auto-loads the template for the issue type
#   - An inline string (if not a file and not "-")

cmd_create() {
  local issue_type="$1"
  local summary="$2"
  local desc_source="${3:-}"
  local components="${4:-}"
  local parent="${5:-}"

  # Validate issue type
  case "$issue_type" in
    Deliverable|Issue|Task|Initiative) ;;
    *)
      echo "Error: issue type must be one of: Deliverable, Issue, Task, Initiative"
      return 1
      ;;
  esac

  # Components are set by the Implementer during development, not at creation.
  # The Implementer knows which repos they commit to — jiractl components sets them.

  # Resolve description from: file, stdin, template, or inline text
  local description
  local template_dir="$INFRA_DIR/ticket-templates"
  if [ "$desc_source" = "-" ]; then
    description=$(cat)
  elif [ -f "$desc_source" ]; then
    description=$(cat "$desc_source")
  elif [ -z "$desc_source" ]; then
    # Auto-load template for the issue type
    local template_name
    case "$issue_type" in
      Deliverable) template_name="deliverable.md" ;;
      Issue)       template_name="issue.md" ;;
      Task)        template_name="task.md" ;;
      *)           template_name="" ;;
    esac
    if [ -n "$template_name" ] && [ -f "$template_dir/$template_name" ]; then
      description=$(cat "$template_dir/$template_name")
      echo "Using template: $template_name"
    else
      description=""
    fi
  else
    description="$desc_source"
  fi

  # Strip HTML comments (template instructions) from description
  if [ -n "$description" ]; then
    description=$(echo "$description" | sed 's/<!--[^>]*-->//g' | sed '/^[[:space:]]*$/d')
  fi

  # Validate required sections per issue type
  if [ -n "$description" ]; then
    local missing=""
    case "$issue_type" in
      Deliverable)
        for section in "Problem" "Business Rules" "Acceptance Criteria"; do
          if ! echo "$description" | grep -q "## $section"; then
            missing="$missing $section"
          fi
        done
        if [ -n "$missing" ]; then
          echo "Error: Deliverable is missing required sections:$missing"
          echo "  Required: Problem, Business Rules, Acceptance Criteria"
          echo "  Run without description to auto-load template."
          return 1
        fi
        ;;
      Issue)
        for section in "Symptom" "Evidence"; do
          if ! echo "$description" | grep -q "## $section"; then
            missing="$missing $section"
          fi
        done
        if [ -n "$missing" ]; then
          echo "Error: Issue is missing required sections:$missing"
          echo "  Required: Symptom, Evidence"
          echo "  Run without description to auto-load template."
          return 1
        fi
        ;;
    esac

    # Check for unfilled template placeholders (empty sections with only headings)
    local empty_sections
    empty_sections=$(echo "$description" | python3 -c "
import sys
lines = sys.stdin.read().strip().split('\n')
empty = []
for i, line in enumerate(lines):
    if line.startswith('## '):
        section = line[3:].strip()
        # Check if next non-blank line is another heading or end of file
        j = i + 1
        has_content = False
        while j < len(lines):
            if lines[j].strip() == '':
                j += 1
                continue
            if lines[j].startswith('## '):
                break
            has_content = True
            break
        if not has_content:
            empty.append(section)
if empty:
    print(' '.join(empty))
" 2>/dev/null)
    if [ -n "$empty_sections" ]; then
      echo "Warning: Empty sections (template not filled in): $empty_sections"
    fi
  fi

  # Convert markdown to Atlassian Document Format via Python
  local payload
  payload=$(python3 -c "
import json, sys, re

summary = '''$summary'''
issue_type = '$issue_type'
project_key = '$PROJECT_KEY'
desc = sys.stdin.read()

# Simple markdown to ADF conversion
content = []
for line in desc.split('\n'):
    line_stripped = line.strip()
    if not line_stripped:
        continue
    if line_stripped.startswith('## '):
        content.append({
            'type': 'heading', 'attrs': {'level': 2},
            'content': [{'type': 'text', 'text': line_stripped[3:]}]
        })
    elif line_stripped.startswith('### '):
        content.append({
            'type': 'heading', 'attrs': {'level': 3},
            'content': [{'type': 'text', 'text': line_stripped[4:]}]
        })
    elif line_stripped.startswith('- '):
        # Collect consecutive list items
        if not content or content[-1].get('type') != 'bulletList':
            content.append({'type': 'bulletList', 'content': []})
        content[-1]['content'].append({
            'type': 'listItem',
            'content': [{'type': 'paragraph', 'content': [{'type': 'text', 'text': line_stripped[2:]}]}]
        })
    elif line_stripped.startswith('Feature:') or line_stripped.startswith('Scenario:') or line_stripped.startswith('Given ') or line_stripped.startswith('When ') or line_stripped.startswith('Then ') or line_stripped.startswith('And '):
        # Gherkin lines as code block
        if not content or content[-1].get('type') != 'codeBlock':
            content.append({'type': 'codeBlock', 'attrs': {'language': 'gherkin'}, 'content': []})
        existing = content[-1]['content']
        text = (existing[0]['text'] + '\n' + line_stripped) if existing else line_stripped
        content[-1]['content'] = [{'type': 'text', 'text': text}]
    else:
        content.append({
            'type': 'paragraph',
            'content': [{'type': 'text', 'text': line_stripped}]
        })

if not content:
    content = [{'type': 'paragraph', 'content': [{'type': 'text', 'text': 'No description provided.'}]}]

fields = {
    'project': {'key': project_key},
    'issuetype': {'name': issue_type},
    'summary': summary,
    'description': {
        'type': 'doc',
        'version': 1,
        'content': content
    }
}

parent_key = '$parent'
if parent_key:
    fields['parent'] = {'key': parent_key}

print(json.dumps({'fields': fields}))
" <<< "$description")

  echo "Creating $issue_type: $summary..."
  local result
  result=$(jira_post "/issue" "$payload")

  local key
  key=$(echo "$result" | python3 -c "import sys,json; print(json.load(sys.stdin).get('key','FAILED'))" 2>/dev/null)

  if [ "$key" = "FAILED" ] || [ -z "$key" ]; then
    echo "Error creating issue:"
    echo "$result" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('errors',d))" 2>/dev/null
    return 1
  fi

  echo "Created: $key"
  echo "  URL: https://${JIRA_SITE}/browse/$key"

  # Set components if provided
  if [ -n "$components" ]; then
    cmd_components "$key" $(echo "$components" | tr ',' ' ')
  fi
}

# ── Transition ID reference ─────────────────────────────────────────────────

cmd_backlog() {
  echo "Querying $PROJECT_KEY Backlog for next Deliverable..."
  echo ""

  local result
  result=$(jira_search "project = $PROJECT_KEY AND issuetype = Deliverable AND status = \"Backlog\" ORDER BY priority ASC, created ASC" "summary,status,priority")
  local count
  count=$(echo "$result" | python3 -c "import sys,json; d=json.load(sys.stdin); print(len(d.get('issues',[])))" 2>/dev/null)

  if [ "$count" = "0" ] || [ -z "$count" ]; then
    echo "No Deliverables in Backlog. Waiting for work."
    return 0
  fi

  echo "=== Backlog ($count Deliverables) ==="
  echo "$result" | python3 -c "
import sys, json
data = json.load(sys.stdin)
for i, issue in enumerate(data.get('issues', [])):
    key = issue['key']
    summary = issue['fields']['summary']
    priority = issue['fields'].get('priority', {}).get('name', 'None')
    marker = '  → ' if i == 0 else '    '
    print(f'{marker}{key}: {summary} (priority: {priority})')
    if i == 0:
        print(f'      ↑ Next ticket to pick up')
" 2>/dev/null
  echo ""
}

cmd_transitions() {
  echo "{PROJECT_KEY} transition IDs:"
  echo ""
  echo "  11   Backlog"
  echo "  51   In Refinement"
  echo "  61   In Development"
  echo "  71   In Local Test"
  echo "  81   In Integration Test"
  echo "  91   In E2E Impact Test"
  echo "  101  In Full E2E Regression"
  echo "  111  Release / Production"
  echo "  41   Done"
}

# ── Main ────────────────────────────────────────────────────────────────────

case "${1:-}" in
  poll)        cmd_poll ;;
  backlog)     cmd_backlog ;;
  create)      cmd_create "${2:?Usage: jiractl create TYPE SUMMARY [desc.md|-|text] [COMPONENTS] [PARENT]}" "${3:?Missing summary}" "${4:-}" "${5:-}" "${6:-}" ;;
  create-md)   cmd_create "${2:?Usage: jiractl create TYPE SUMMARY [desc.md|-|text] [COMPONENTS] [PARENT]}" "${3:?Missing summary}" "${4:-}" "${5:-}" "${6:-}" ;; # alias
  transition)  cmd_transition "${2:?Usage: jiractl transition ISSUE-KEY TRANSITION_ID}" "${3:?Missing transition ID}" ;;
  comment)     cmd_comment "${2:?Usage: jiractl comment ISSUE-KEY message}" "${@:3}" ;;
  components)  cmd_components "${2:?Usage: jiractl components ISSUE-KEY comp1 comp2}" "${@:3}" ;;
  status)      cmd_status "${2:?Usage: jiractl status ISSUE-KEY}" ;;
  transitions) cmd_transitions ;;
  *)
    echo "Usage: jiractl <command> [args]"
    echo ""
    echo "Commands:"
    echo "  poll                                       Find tickets ready for action"
    echo "  backlog                                    Show next Deliverable in Backlog"
    echo "  create TYPE SUMMARY [desc|-|text] [COMPS] [PARENT]"
    echo "                                             Create issue. Description from:"
    echo "                                               file.md — markdown file"
    echo "                                               -       — stdin"
    echo "                                               text    — inline string"
    echo "                                               omitted — auto-loads template"
    echo "  transition ISSUE-KEY ID                    Transition ticket"
    echo "  comment ISSUE-KEY message                  Add comment to ticket"
    echo "  components ISSUE-KEY c1 c2                 Set components on ticket"
    echo "  status ISSUE-KEY                           Show ticket status"
    echo "  transitions                                List transition IDs"
    echo ""
    echo "Issue types: Deliverable, Issue, Task, Initiative"
    echo ""
    echo "Examples:"
    echo "  jiractl create Deliverable 'App Shell' 'Main layout and navigation' 'treemail-web'"
    echo "  jiractl create Task 'Add search route' 'Implement search API' 'treemail-web' {PROJECT_KEY}-42"
    echo "  jiractl create-md Deliverable 'Thread Search' desc.md 'treemail-web'"
    echo "  echo '## Summary' | jiractl create-md Task 'Add index' - '' {PROJECT_KEY}-42"
    ;;
esac
