#!/usr/bin/env bash
# repomap — generate REPO_MAP.md for a service repository
#
# Usage:
#   ./repomap ../my-service            Generate map for my-service
#   ./repomap all                      Generate maps for all service repos
#
# Output: REPO_MAP.md in the repo root
# Called automatically after each Deliverable completes (by Team Lead).
#
# Supports:
#   - Python / FastAPI services (detected by main.py at repo root)
#   - Next.js / TypeScript services (detected by src/ + package.json)

set -euo pipefail
INFRA_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$INFRA_DIR/.." && pwd)"

generate_map() {
  local repo_path="$1"
  local repo_name
  repo_name=$(basename "$repo_path")
  local output="$repo_path/REPO_MAP.md"

  echo "Generating REPO_MAP.md for $repo_name..."

  python3 << 'PYEOF'
import os
import re
from pathlib import Path
from datetime import datetime, timezone

repo_path = os.environ["_REPOMAP_REPO_PATH"]
repo_name = os.environ["_REPOMAP_REPO_NAME"]
output_path = os.environ["_REPOMAP_OUTPUT"]

SKIP_DIRS = {
    "__pycache__", ".venv", "venv", "node_modules", ".next", "coverage",
    "__tests__", ".git", ".mypy_cache", ".pytest_cache", ".ruff_cache",
    "dist", "build", ".tox", ".github", ".githooks", ".idea",
}

# ── Detect project type ────────────────────────────────────────────────
src_root = os.path.join(repo_path, "src")
has_src = os.path.isdir(src_root)
has_main_py = os.path.isfile(os.path.join(repo_path, "main.py"))
has_package_json = os.path.isfile(os.path.join(repo_path, "package.json"))

is_nextjs = has_src and has_package_json
is_python = has_main_py

lines = []
lines.append(f"# Repository Map — {repo_name}")
lines.append("")
lines.append("Auto-generated by `infra/repomap`. Updated after each Deliverable completes.")
lines.append(f"Last updated: {datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M UTC')}")
lines.append("")

# ── Directory tree ─────────────────────────────────────────────────────
lines.append("## Directory structure")
lines.append("")
lines.append("```")

scan_root = src_root if is_nextjs else repo_path
extensions = ('.ts', '.tsx') if is_nextjs else ('.py',)

for dirpath, dirnames, filenames in os.walk(scan_root):
    dirnames[:] = [d for d in sorted(dirnames) if d not in SKIP_DIRS]
    rel = os.path.relpath(dirpath, repo_path)
    depth = rel.count(os.sep)
    indent = "  " * depth
    dirname = os.path.basename(dirpath)
    lines.append(f"{indent}{dirname}/")
    for f in sorted(filenames):
        if f.endswith(extensions) or f.endswith('.prisma'):
            lines.append(f"{indent}  {f}")

lines.append("```")
lines.append("")


# ═══════════════════════════════════════════════════════════════════════
# Python / FastAPI service
# ═══════════════════════════════════════════════════════════════════════
if is_python:
    # ── FastAPI endpoints ──────────────────────────────────────────────
    main_py = os.path.join(repo_path, "main.py")
    try:
        content = open(main_py).read()
        # Match @app.get("/path"), @app.post("/path"), etc.
        endpoints = re.findall(
            r'@app\.(get|post|put|patch|delete)\(\s*["\']([^"\']+)["\']',
            content,
        )
        if endpoints:
            lines.append("## API endpoints")
            lines.append("")
            lines.append("| Method | Path | Handler |")
            lines.append("|--------|------|---------|")

            for method, path in endpoints:
                # Find the function name on the next def line after the decorator
                pattern = rf'@app\.{method}\(\s*["\']' + re.escape(path) + r'["\'].*?\)\s*\n\s*async\s+def\s+(\w+)'
                func_match = re.search(pattern, content, re.DOTALL)
                func_name = func_match.group(1) if func_match else "?"
                lines.append(f"| {method.upper()} | `{path}` | `{func_name}` |")
            lines.append("")
    except Exception:
        pass

    # ── Pydantic models ────────────────────────────────────────────────
    try:
        content = open(main_py).read()
        models = re.findall(r'class\s+(\w+)\(BaseModel\)', content)
        if models:
            lines.append("## Request/Response models")
            lines.append("")
            for m in models:
                lines.append(f"- `{m}`")
            lines.append("")
    except Exception:
        pass

    # ── Python package modules ─────────────────────────────────────────
    package_dirs = []
    for item in sorted(os.listdir(repo_path)):
        item_path = os.path.join(repo_path, item)
        if (
            os.path.isdir(item_path)
            and os.path.isfile(os.path.join(item_path, "__init__.py"))
            and item not in ("observability", "tests", "alembic", "__pycache__", ".venv", "venv")
        ):
            package_dirs.append(item)

    for pkg in package_dirs:
        pkg_path = os.path.join(repo_path, pkg)
        lines.append(f"## Package: `{pkg}/`")
        lines.append("")
        lines.append("| Module | Purpose |")
        lines.append("|--------|---------|")

        for f in sorted(os.listdir(pkg_path)):
            if not f.endswith(".py") or f == "__init__.py":
                continue
            filepath = os.path.join(pkg_path, f)
            purpose = ""
            try:
                with open(filepath) as fh:
                    first_lines = fh.read(500)
                    # Try module docstring
                    m = re.match(r'^(?:from\s|import\s|#.*\n)*"""(.+?)"""', first_lines, re.DOTALL)
                    if m:
                        purpose = m.group(1).strip().split("\n")[0][:80]
                    if not purpose:
                        # Try first comment
                        m = re.search(r'^#\s*(.+)', first_lines, re.MULTILINE)
                        if m:
                            purpose = m.group(1).strip()[:80]
                    if not purpose:
                        purpose = f.replace(".py", "").replace("_", " ").title()
            except Exception:
                purpose = ""
            lines.append(f"| `{f}` | {purpose} |")
        lines.append("")

    # ── Observability module ───────────────────────────────────────────
    obs_path = os.path.join(repo_path, "observability")
    if os.path.isdir(obs_path):
        obs_files = [f for f in sorted(os.listdir(obs_path)) if f.endswith(".py") and f != "__init__.py"]
        if obs_files:
            lines.append("## Observability")
            lines.append("")
            for f in obs_files:
                lines.append(f"- `observability/{f}`")
            lines.append("")

    # ── Alembic migrations ─────────────────────────────────────────────
    alembic_path = os.path.join(repo_path, "alembic", "versions")
    if os.path.isdir(alembic_path):
        migrations = sorted(
            f for f in os.listdir(alembic_path)
            if f.endswith(".py") and not f.startswith("__")
        )
        if migrations:
            lines.append("## Database migrations (Alembic)")
            lines.append("")
            for m in migrations:
                lines.append(f"- `alembic/versions/{m}`")
            lines.append("")

    # ── Root-level Python files (non-main.py) ──────────────────────────
    root_py = sorted(
        f for f in os.listdir(repo_path)
        if f.endswith(".py") and f != "main.py" and os.path.isfile(os.path.join(repo_path, f))
    )
    if root_py:
        lines.append("## Root modules")
        lines.append("")
        for f in root_py:
            lines.append(f"- `{f}`")
        lines.append("")


# ═══════════════════════════════════════════════════════════════════════
# Next.js / TypeScript service
# ═══════════════════════════════════════════════════════════════════════
if is_nextjs:
    # ── API routes ─────────────────────────────────────────────────────
    api_dir = os.path.join(src_root, "app", "api")
    if os.path.exists(api_dir):
        lines.append("## API routes")
        lines.append("")
        lines.append("| Method(s) | Path | Handler |")
        lines.append("|-----------|------|---------|")

        for dirpath, dirnames, filenames in sorted(os.walk(api_dir)):
            for f in sorted(filenames):
                if f == "route.ts":
                    rel = os.path.relpath(dirpath, os.path.join(src_root, "app"))
                    route_path = "/" + rel.replace("[", ":").replace("]", "").replace("\\", "/")

                    filepath = os.path.join(dirpath, f)
                    try:
                        content = open(filepath).read()
                        methods = []
                        for m in ["GET", "POST", "PUT", "PATCH", "DELETE"]:
                            if re.search(rf'export\s+(async\s+)?function\s+{m}', content):
                                methods.append(m)
                        methods_str = ", ".join(methods) if methods else "?"
                    except Exception:
                        methods_str = "?"

                    handler_rel = os.path.relpath(filepath, repo_path)
                    lines.append(f"| {methods_str} | `{route_path}` | `{handler_rel}` |")
        lines.append("")

    # ── Pages ──────────────────────────────────────────────────────────
    app_dir = os.path.join(src_root, "app")
    if os.path.exists(app_dir):
        pages = []
        for dirpath, dirnames, filenames in sorted(os.walk(app_dir)):
            for f in filenames:
                if f == "page.tsx":
                    rel = os.path.relpath(dirpath, app_dir)
                    route = "/" + rel.replace("(app)/", "").replace("[", ":").replace("]", "")
                    if route == "/.":
                        route = "/"
                    pages.append((route, os.path.relpath(os.path.join(dirpath, f), repo_path)))

        if pages:
            lines.append("## Pages")
            lines.append("")
            lines.append("| Route | File |")
            lines.append("|-------|------|")
            for route, filepath in sorted(pages):
                lines.append(f"| `{route}` | `{filepath}` |")
            lines.append("")

    # ── Lib modules ────────────────────────────────────────────────────
    lib_dir = os.path.join(src_root, "lib")
    if os.path.exists(lib_dir):
        lines.append("## Library modules")
        lines.append("")
        lines.append("| Module | Purpose |")
        lines.append("|--------|---------|")

        for f in sorted(os.listdir(lib_dir)):
            if not f.endswith(('.ts', '.tsx')):
                continue
            filepath = os.path.join(lib_dir, f)
            if os.path.isdir(filepath):
                continue
            purpose = ""
            try:
                content = open(filepath).read()
                m = re.search(r'(?://|/\*\*?)\s*(.+?)(?:\n|\*/)', content)
                if m:
                    purpose = m.group(1).strip()[:80]
                if not purpose:
                    purpose = f.replace('.ts', '').replace('.tsx', '').replace('-', ' ').replace('_', ' ').title()
            except Exception:
                purpose = ""
            lines.append(f"| `{f}` | {purpose} |")
        lines.append("")

    # ── Components ─────────────────────────────────────────────────────
    comp_dir = os.path.join(src_root, "components")
    if os.path.exists(comp_dir):
        components = [
            f for f in sorted(os.listdir(comp_dir))
            if f.endswith(('.tsx', '.ts')) and not f.startswith('__')
        ]
        if components:
            lines.append("## Components")
            lines.append("")
            lines.append(f"{len(components)} React components in `src/components/`:")
            lines.append("")
            for c in components:
                lines.append(f"- `{c}`")
            lines.append("")


# ═══════════════════════════════════════════════════════════════════════
# Common sections (both project types)
# ═══════════════════════════════════════════════════════════════════════

# ── Workers / Consumers (Next.js src/ pattern) ────────────────────────
if is_nextjs:
    for dirname in ["workers", "consumers", "jobs"]:
        worker_dir = os.path.join(src_root, dirname)
        if os.path.exists(worker_dir):
            files = [f for f in os.listdir(worker_dir) if f.endswith(('.ts', '.py'))]
            if files:
                lines.append(f"## {dirname.title()}")
                lines.append("")
                for f in sorted(files):
                    lines.append(f"- `src/{dirname}/{f}`")
                lines.append("")

# ── Database models (Prisma) ──────────────────────────────────────────
prisma_dir = os.path.join(repo_path, "prisma")
schema_file = os.path.join(prisma_dir, "schema.prisma")
if os.path.exists(schema_file):
    lines.append("## Database models (Prisma)")
    lines.append("")
    lines.append("| Model | Table | Key fields |")
    lines.append("|-------|-------|------------|")

    try:
        content = open(schema_file).read()
        models = re.findall(r'model\s+(\w+)\s*\{([^}]+)\}', content, re.DOTALL)
        for model_name, model_body in models:
            table_match = re.search(r'@@map\("(\w+)"\)', model_body)
            table = table_match.group(1) if table_match else model_name.lower() + "s"
            fields = re.findall(r'^\s+(\w+)\s+(\w+)', model_body, re.MULTILINE)
            field_list = ", ".join(f"{n}: {t}" for n, t in fields[:5])
            if len(fields) > 5:
                field_list += f", +{len(fields)-5} more"
            lines.append(f"| {model_name} | {table} | {field_list} |")
    except Exception:
        lines.append("| (parse error) | | |")

    lines.append("")

# ── Tests ──────────────────────────────────────────────────────────────
test_dir = os.path.join(repo_path, "tests")
test_files = []
if os.path.isdir(test_dir):
    for dirpath, dirnames, filenames in os.walk(test_dir):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
        for f in filenames:
            if f.endswith(".py") and f.startswith("test_"):
                rel = os.path.relpath(os.path.join(dirpath, f), repo_path)
                test_files.append(rel)
            elif ('.test.' in f or '.spec.' in f) and f.endswith(('.ts', '.tsx')):
                rel = os.path.relpath(os.path.join(dirpath, f), repo_path)
                test_files.append(rel)

# Also check src/ for inline test files (Next.js pattern)
if is_nextjs and os.path.isdir(src_root):
    for dirpath, dirnames, filenames in os.walk(src_root):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
        for f in filenames:
            if ('.test.' in f or '.spec.' in f) and f.endswith(('.ts', '.tsx')):
                rel = os.path.relpath(os.path.join(dirpath, f), repo_path)
                test_files.append(rel)

if test_files:
    lines.append("## Tests")
    lines.append("")
    for tf in sorted(test_files):
        lines.append(f"- `{tf}`")
    lines.append("")

# ── Dockerfile ─────────────────────────────────────────────────────────
dockerfile = os.path.join(repo_path, "Dockerfile")
if os.path.isfile(dockerfile):
    lines.append("## Dockerfile")
    lines.append("")
    try:
        content = open(dockerfile).read()
        # Extract base image
        base = re.search(r'^FROM\s+(\S+)', content, re.MULTILINE)
        if base:
            lines.append(f"- Base image: `{base.group(1)}`")
        # Extract exposed port
        port = re.search(r'^EXPOSE\s+(\d+)', content, re.MULTILINE)
        if port:
            lines.append(f"- Exposed port: {port.group(1)}")
        # Extract entrypoint/cmd
        cmd = re.search(r'^(?:CMD|ENTRYPOINT)\s+(.+)', content, re.MULTILINE)
        if cmd:
            lines.append(f"- Entrypoint: `{cmd.group(1).strip()}`")
    except Exception:
        pass
    lines.append("")

# ── Summary stats ──────────────────────────────────────────────────────
total_py = 0
total_ts = 0
scan_dirs = [repo_path] if is_python else [src_root] if is_nextjs else [repo_path]

for sd in scan_dirs:
    if not os.path.isdir(sd):
        continue
    for dirpath, dirnames, filenames in os.walk(sd):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
        for f in filenames:
            if f.endswith('.py'):
                total_py += 1
            elif f.endswith(('.ts', '.tsx')):
                total_ts += 1

lines.append("## Summary")
lines.append("")
parts = []
if total_py:
    parts.append(f"{total_py} Python")
if total_ts:
    parts.append(f"{total_ts} TypeScript")
lines.append(f"- Source files: {total_py + total_ts} ({', '.join(parts)})")
lines.append(f"- Test files: {len(test_files)}")
lines.append("")

with open(output_path, "w") as f:
    f.write("\n".join(lines))

print(f"  Written to {output_path}")
print(f"  {total_py + total_ts} source files, {len(test_files)} test files")
PYEOF
}

case "${1:-}" in
  all)
    # Find all service directories (contain a Dockerfile)
    for repo in "$PROJECT_ROOT"/*/; do
      if [ -f "$repo/Dockerfile" ]; then
        _REPOMAP_REPO_PATH="$repo" \
        _REPOMAP_REPO_NAME="$(basename "$repo")" \
        _REPOMAP_OUTPUT="$repo/REPO_MAP.md" \
        generate_map "$repo"
      fi
    done
    ;;
  *)
    repo="${1:?Usage: repomap <repo-path|all>}"
    # Handle relative paths
    if [[ "$repo" != /* ]]; then
      repo="$INFRA_DIR/$repo"
    fi
    _REPOMAP_REPO_PATH="$repo" \
    _REPOMAP_REPO_NAME="$(basename "$repo")" \
    _REPOMAP_OUTPUT="$repo/REPO_MAP.md" \
    generate_map "$repo"
    ;;
esac
