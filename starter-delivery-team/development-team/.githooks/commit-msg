#!/usr/bin/env bash
# Validate commit message format: {PROJECT_KEY}-{N}: description
# or conventional prefixes: chore:, fix:, feat:, etc.
#
# Installed via: git config core.hooksPath .githooks

COMMIT_MSG_FILE="$1"
MSG=$(head -1 "$COMMIT_MSG_FILE")

# Allow merge commits (generated by git)
if echo "$MSG" | grep -qE "^Merge |^Back-merge "; then
  exit 0
fi

# Allow conventional commits: chore:, fix:, feat:, docs:, refactor:, test:
if echo "$MSG" | grep -qE "^(chore|fix|feat|docs|refactor|test|ci|build|style|perf)\b"; then
  exit 0
fi

# Require ticket key prefix: XXXX-NNN: or XXXX-NNN T{N}:
if echo "$MSG" | grep -qE "^[A-Z]+-[0-9]+"; then
  exit 0
fi

echo ""
echo "  BLOCKED: Commit message must start with a ticket key or conventional prefix."
echo ""
echo "  Valid formats:"
echo "    SENT-42: Add search endpoint"
echo "    SENT-42: T3: Implement search API route"
echo "    fix(SENT-42): correct search pagination"
echo "    chore: update dependencies"
echo ""
echo "  Your message: $MSG"
echo ""
exit 1
