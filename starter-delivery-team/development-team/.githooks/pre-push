#!/usr/bin/env bash
# Prevent direct pushes to main and ci. Only merge commits are allowed.
# main receives --no-ff merges from release branches (RC → main).
# ci receives --no-ff merges from feature branches and back-merges from main.
# No one pushes feature work or direct commits to either branch.

current_branch=$(git symbolic-ref --short HEAD 2>/dev/null)

check_merge_only() {
  local branch="$1"
  # Check if the latest commit is a merge commit (has 2+ parents)
  parent_count=$(git cat-file -p HEAD | grep -c '^parent ')
  if [ "$parent_count" -lt 2 ]; then
    echo ""
    echo "  BLOCKED: Direct push to $branch is not allowed."
    echo "  $branch only receives --no-ff merges."
    echo "  See .claude/CLAUDE.md → Branching structure."
    echo ""
    exit 1
  fi
}

case "$current_branch" in
  main) check_merge_only "main" ;;
  ci)   check_merge_only "ci" ;;
esac

exit 0
