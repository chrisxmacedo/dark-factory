{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Distributed request flow — trace waterfall, service dependency graph, cross-service latency",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Trace Search",
      "type": "traces",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "queryType": "traceqlSearch",
          "filters": [
            {
              "id": "service-name",
              "tag": "resource.service.name",
              "operator": "=",
              "value": ["$service"],
              "valueType": "string",
              "scope": "resource"
            },
            {
              "id": "environment",
              "tag": "resource.deployment.environment",
              "operator": "=",
              "value": ["$environment"],
              "valueType": "string",
              "scope": "resource"
            }
          ],
          "limit": 20,
          "refId": "A"
        }
      ],
      "options": {}
    },
    {
      "title": "Service Dependency Graph",
      "type": "nodeGraph",
      "gridPos": { "h": 12, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "queryType": "serviceMap",
          "filters": [
            {
              "id": "environment",
              "tag": "resource.deployment.environment",
              "operator": "=",
              "value": ["$environment"],
              "valueType": "string",
              "scope": "resource"
            }
          ],
          "refId": "A"
        }
      ],
      "options": {
        "nodes": {
          "mainStatUnit": "ms"
        },
        "edges": {
          "mainStatUnit": "reqps"
        }
      }
    },
    {
      "title": "Cross-Service Latency (by upstream → downstream)",
      "type": "timeseries",
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(traces_service_graph_request_server_seconds_bucket{deployment_environment=~\"$environment\"}[5m])) by (le, client, server))",
          "legendFormat": "{{ client }} → {{ server }} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["observability", "request-flow", "traces"],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_server_request_duration_seconds_count, service_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_server_request_duration_seconds_count, deployment_environment)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Request Flow",
  "uid": "request-flow",
  "version": 1
}
