# ─── Grafana ────────────────────────────────────
GF_SECURITY_ADMIN_PASSWORD=changeme

# ─── Ports ──────────────────────────────────────
GRAFANA_PORT=4000
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
PROMETHEUS_PORT=9090
POSTGRES_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121

# ─── OTel Collector ────────────────────────────
DEPLOYMENT_ENVIRONMENT=local
SERVICE_VERSION=0.0.0

# ─── Database exporter ─────────────────────────
# POSTGRES_EXPORTER_DSN=postgresql://{DB_USER}:{DB_PASSWORD}@{DB_HOST}:5432/{DB_NAME}?sslmode=disable

# ─── Redis exporter ───────────────────────────
# REDIS_EXPORTER_ADDR=redis://{REDIS_HOST}:6379

# ─── Grafana Cloud (uncomment for cloud export) ─
# GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-{REGION}.grafana.net/otlp
# GRAFANA_CLOUD_INSTANCE_ID=
# GRAFANA_CLOUD_API_KEY=

# ─── Datadog (uncomment for Datadog export) ────
# DATADOG_API_KEY=
# DATADOG_SITE=datadoghq.com

# ─── AWS (uncomment for CloudWatch/X-Ray export)
# AWS_REGION=eu-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_CLOUDWATCH_NAMESPACE={PROJECT_NAME}
# AWS_CLOUDWATCH_LOG_GROUP=/otel/{PROJECT_NAME}
