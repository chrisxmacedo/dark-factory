# Redis (also used for pub/sub)
REDIS_URL=redis://{HOST}:{PORT}

# Server
PORT=8080

# JWT
JWT_SECRET={SECRET}

# WebSocket
HEARTBEAT_INTERVAL_MS=30000
HEARTBEAT_TIMEOUT_MS=10000
MAX_SEND_BUFFER=64

# Backpressure — max queued messages per client before dropping
MAX_BUFFERED_AMOUNT=65536

# Graceful shutdown
SHUTDOWN_TIMEOUT_MS=30000

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME={project-name}-realtime

# Logging
LOG_LEVEL=info
