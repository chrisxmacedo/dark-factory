#!/usr/bin/env bash
# envctl — manage Docker environments
#
# Usage:
#   ./envctl up ci          Start CI environment (ci branch)
#   ./envctl up rc          Start RC environment (release-rc-* branch)
#   ./envctl up prod        Start prod-parity environment (main branch)
#   ./envctl up all         Start all three
#   ./envctl down ci|rc|prod|all
#   ./envctl rebuild ci|rc|prod|all   Pull latest + rebuild
#   ./envctl status         Show which environments are running
#   ./envctl logs ci|rc|prod          Tail logs
#   ./envctl urls           Show browsable URLs
#
# Replace {PLACEHOLDERS} with your project-specific values before use.

set -euo pipefail
cd "$(dirname "$0")"

PROJECT_ROOT="$(cd .. && pwd)"

# ── Project-specific config — replace these ─────────────────────────────────
# List all service repos that need branch checkout
SERVICE_REPOS=("$PROJECT_ROOT/{service-1}" "$PROJECT_ROOT/{service-2}")
# Port allocation: CI base ports, RC = +100, Prod = +200
WEB_PORT_CI={WEB_PORT}
WEB_PORT_RC=$(( WEB_PORT_CI + 100 ))
WEB_PORT_PROD=$(( WEB_PORT_CI + 200 ))
DASHBOARD_PORT=4400
DASHBOARD_PID_FILE="/tmp/envctl-dashboard.pid"

# ── Compose commands per environment ────────────────────────────────────────

ci_compose() {
  docker compose \
    -f docker-compose.base.yml \
    -f docker-compose.ci.yml \
    --env-file .env.ci \
    "$@"
}

rc_compose() {
  docker compose \
    -f docker-compose.base.yml \
    -f docker-compose.ci.yml \
    -f docker-compose.test.yml \
    --env-file .env.test \
    "$@"
}

prod_compose() {
  docker compose \
    -f docker-compose.base.yml \
    -f docker-compose.prod-parity.yml \
    --env-file .env.prod-parity \
    "$@"
}

# ── Checkout the right branch for each environment ──────────────────────────

checkout_branch() {
  local env="$1"
  case "$env" in
    ci)
      echo "Checking out ci branch..."
      for repo in "${SERVICE_REPOS[@]}"; do
        (cd "$repo" && git checkout ci && git pull origin ci)
      done
      ;;
    rc)
      local rc_branch
      rc_branch=$(cd "${SERVICE_REPOS[0]}" && git branch -r --sort=-committerdate | grep 'origin/release-rc-' | head -1 | tr -d ' ' | sed 's|origin/||')
      if [ -z "$rc_branch" ]; then
        echo "No release-rc-* branch found. Using ci instead."
        rc_branch="ci"
      fi
      echo "Checking out $rc_branch..."
      for repo in "${SERVICE_REPOS[@]}"; do
        (cd "$repo" && git checkout "$rc_branch" 2>/dev/null && git pull origin "$rc_branch" 2>/dev/null || echo "  $(basename "$repo"): $rc_branch not found, staying on current branch")
      done
      ;;
    prod)
      echo "Checking out main branch..."
      for repo in "${SERVICE_REPOS[@]}"; do
        (cd "$repo" && git checkout main && git pull origin main)
      done
      ;;
  esac
}

# ── Dashboard management ────────────────────────────────────────────────────

ensure_dashboard() {
  if [ -f "$DASHBOARD_PID_FILE" ] && kill -0 "$(cat "$DASHBOARD_PID_FILE")" 2>/dev/null; then
    return 0  # already running
  fi
  echo "Starting dashboard on http://localhost:$DASHBOARD_PORT ..."
  nohup python3 "$(dirname "$0")/dashboard.py" --port "$DASHBOARD_PORT" \
    > /tmp/envctl-dashboard.log 2>&1 &
  echo $! > "$DASHBOARD_PID_FILE"
  sleep 1
  if kill -0 "$(cat "$DASHBOARD_PID_FILE")" 2>/dev/null; then
    echo "Dashboard running (PID $(cat "$DASHBOARD_PID_FILE"))."
  else
    echo "Warning: dashboard failed to start. Check /tmp/envctl-dashboard.log"
  fi
}

cmd_dashboard() {
  local action="${1:-start}"
  case "$action" in
    start)
      ensure_dashboard
      ;;
    stop)
      if [ -f "$DASHBOARD_PID_FILE" ]; then
        local pid; pid=$(cat "$DASHBOARD_PID_FILE")
        kill "$pid" 2>/dev/null && echo "Dashboard stopped (PID $pid)." || echo "Dashboard not running."
        rm -f "$DASHBOARD_PID_FILE"
      else
        echo "Dashboard not running."
      fi
      ;;
    restart)
      cmd_dashboard stop
      cmd_dashboard start
      ;;
    status)
      if [ -f "$DASHBOARD_PID_FILE" ] && kill -0 "$(cat "$DASHBOARD_PID_FILE")" 2>/dev/null; then
        echo "Dashboard running on http://localhost:$DASHBOARD_PORT (PID $(cat "$DASHBOARD_PID_FILE"))"
      else
        echo "Dashboard not running."
      fi
      ;;
    *)
      echo "Usage: envctl dashboard start|stop|restart|status"
      ;;
  esac
}

# ── Commands ────────────────────────────────────────────────────────────────

cmd_up() {
  local env="$1"
  if [ "$env" = "all" ]; then
    cmd_up ci; cmd_up rc; cmd_up prod; return
  fi
  ensure_dashboard
  echo "Starting $env environment from pre-built :$env images..."
  ${env}_compose up -d --wait --wait-timeout 120
  echo "$env environment is up."
}

cmd_down() {
  local env="$1"
  if [ "$env" = "all" ]; then
    cmd_down ci; cmd_down rc; cmd_down prod; return
  fi
  echo "Stopping $env environment..."
  ${env}_compose down -v --remove-orphans
}

# ── Test command ───────────────────────────────────────────────────────────
# Deterministic: boot environment, install deps, run suite, capture result,
# tear down. Saves Claude tokens — agents call this instead of writing
# raw docker compose + pip + pytest sequences.
#
# Usage:
#   ./envctl test ci integration    Run integration tests against CI env
#   ./envctl test rc e2e            Run E2E tests against RC env
#   ./envctl test prod smoke        Run smoke tests against prod-parity env
#   ./envctl test ci                Run default suite for CI env

cmd_test() {
  local env="$1"
  local suite="${2:-all}"
  local tests_dir="$PROJECT_ROOT/tests"
  local result=0

  echo "=== envctl test $env $suite ==="

  # 1. Boot environment (handles branch checkout + dashboard)
  echo "[1/4] Booting $env environment..."
  cmd_up "$env" || { echo "FAIL: environment failed to start"; return 1; }

  # 2. Install test dependencies
  echo "[2/4] Installing test dependencies..."
  pip install -q -r "$tests_dir/requirements.txt" 2>/dev/null || {
    echo "FAIL: could not install test dependencies"; cmd_down "$env"; return 1
  }

  # 3. Run test suite(s)
  echo "[3/4] Running $suite tests..."
  case "$suite" in
    integration)
      python -m pytest "$tests_dir/integration/" -v 2>&1 || result=1
      ;;
    e2e)
      python -m pytest "$tests_dir/e2e/" -v 2>&1 || result=1
      ;;
    smoke)
      python -m pytest "$tests_dir/smoke/" -v 2>&1 || result=1
      ;;
    all)
      case "$env" in
        ci)   python -m pytest "$tests_dir/integration/" -v 2>&1 || result=1 ;;
        rc)   python -m pytest "$tests_dir/e2e/" -v 2>&1 || result=1 ;;
        prod) python -m pytest "$tests_dir/smoke/" -v 2>&1 || result=1 ;;
      esac
      ;;
    *)
      echo "Unknown suite: $suite. Use: integration, e2e, smoke, or all."
      result=1
      ;;
  esac

  # 4. Tear down
  echo "[4/4] Tearing down $env environment..."
  cmd_down "$env"

  if [ $result -eq 0 ]; then
    echo "=== PASSED: envctl test $env $suite ==="
  else
    echo "=== FAILED: envctl test $env $suite ==="
  fi
  return $result
}

cmd_rebuild() {
  local env="$1"
  if [ "$env" = "all" ]; then
    cmd_rebuild ci; cmd_rebuild rc; cmd_rebuild prod; return
  fi

  # Determine which branch to build from (without checking it out)
  local branch
  case "$env" in
    ci)   branch="ci" ;;
    rc)
      branch=$(cd "${SERVICE_REPOS[0]}" && git branch -r --sort=-committerdate | grep 'origin/release-rc-' | head -1 | tr -d ' ' | sed 's|origin/||')
      [ -z "$branch" ] && branch="ci"
      ;;
    prod) branch="main" ;;
  esac

  # Map env name to build arg values (customize per project)
  local build_env
  case "$env" in
    ci)   build_env="ci" ;;
    rc)   build_env="test" ;;
    prod) build_env="prod-parity" ;;
  esac

  echo "Building :$env images from branch $branch (no checkout)..."

  # Build from git archive — extracts the branch into a temp dir so the
  # working tree is untouched. Dev team can stay on their feature branch.
  for repo in "${SERVICE_REPOS[@]}"; do
    local name; name=$(basename "$repo")
    local tmpdir; tmpdir=$(mktemp -d)

    (cd "$repo" && git archive "origin/$branch" 2>/dev/null || git archive "$branch") | tar -x -C "$tmpdir"

    docker build -t "${name}:${env}" \
      --build-arg "NEXT_PUBLIC_ENVIRONMENT=${build_env}" \
      "$tmpdir"

    rm -rf "$tmpdir"
  done

  # Build migrate image from primary service (if it has migrations)
  local primary_name; primary_name=$(basename "${SERVICE_REPOS[0]}")
  local tmpdir; tmpdir=$(mktemp -d)
  (cd "${SERVICE_REPOS[0]}" && git archive "origin/$branch" 2>/dev/null || git archive "$branch") | tar -x -C "$tmpdir"
  docker build -t "${primary_name}-migrate:${env}" \
    --target migrate \
    "$tmpdir"
  rm -rf "$tmpdir"

  # Prune dangling images and build cache to prevent disk exhaustion.
  # Only removes untagged images and unused build layers — safe to run.
  docker image prune -f > /dev/null 2>&1
  docker builder prune -f --keep-storage=5GB > /dev/null 2>&1

  echo "Starting $env environment with :$env images..."
  ${env}_compose up -d
  echo "$env environment started."
}

cmd_status() {
  echo "=== CI — http://localhost:$WEB_PORT_CI ==="
  ci_compose ps --format "table {{.Name}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null || echo "  Not running"
  echo ""
  echo "=== RC — http://localhost:$WEB_PORT_RC ==="
  rc_compose ps --format "table {{.Name}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null || echo "  Not running"
  echo ""
  echo "=== Prod-parity — http://localhost:$WEB_PORT_PROD ==="
  prod_compose ps --format "table {{.Name}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null || echo "  Not running"
}

cmd_logs() {
  local env="$1"
  ${env}_compose logs -f --tail=50
}

cmd_urls() {
  echo "Browsable environments:"
  echo ""
  echo "  CI (ci branch):              http://localhost:$WEB_PORT_CI"
  echo "  RC (release-rc-* branch):    http://localhost:$WEB_PORT_RC"
  echo "  Prod-parity (main branch):   http://localhost:$WEB_PORT_PROD"
  echo ""
}

# ── Main ────────────────────────────────────────────────────────────────────

case "${1:-}" in
  up)        cmd_up "${2:?Usage: envctl up ci|rc|prod|all}" ;;
  down)      cmd_down "${2:?Usage: envctl down ci|rc|prod|all}" ;;
  rebuild)   cmd_rebuild "${2:?Usage: envctl rebuild ci|rc|prod|all}" ;;
  test)      cmd_test "${2:?Usage: envctl test ci|rc|prod [integration|e2e|smoke]}" "${3:-all}" ;;
  status)    cmd_status ;;
  logs)      cmd_logs "${2:?Usage: envctl logs ci|rc|prod}" ;;
  urls)      cmd_urls ;;
  dashboard) cmd_dashboard "${2:-start}" ;;
  *)
    echo "Usage: envctl <command> [environment]"
    echo ""
    echo "Commands:"
    echo "  up        ci|rc|prod|all                      Start environment (auto-starts dashboard)"
    echo "  down      ci|rc|prod|all                      Stop environment"
    echo "  rebuild   ci|rc|prod|all                      Pull latest + rebuild"
    echo "  test      ci|rc|prod [integration|e2e|smoke]  Boot, test, tear down (saves Claude tokens)"
    echo "  status                                        Show running environments"
    echo "  logs      ci|rc|prod                          Tail logs"
    echo "  urls                                          Show browsable URLs"
    echo "  dashboard start|stop|restart|status           Manage environment dashboard (port \$DASHBOARD_PORT)"
    ;;
esac
