# infra/.env.ci
# Committed to repo — no secrets, everything is throwaway
ENVIRONMENT=ci
POSTGRES_PASSWORD=ci-password
MINIO_ROOT_USER={PROJECT_SLUG}
MINIO_ROOT_PASSWORD=ci-password
# LLM API — routed to stub server, not real
# Anthropic: CLAUDE_API_KEY=stub-key-not-real
# OpenAI:    OPENAI_API_KEY=stub-key-not-real
SENTRY_DSN=
OTEL_ENDPOINT=stdout
LOG_LEVEL=warn
LOG_FORMAT=json
SERVICE_VERSION=ci
