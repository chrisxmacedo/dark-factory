# Copy to config/ara.env and set the caps your organisation approved.
# The numbers below are examples from the role description, not an approval.
# Do not put tokens in this file. Export GITHUB_TOKEN, JIRA_API_TOKEN, and
# LINEAR_API_KEY in the environment or a secret store.

OFFICE_TZ=Europe/London
SPEND_CURRENCY=GBP
SPEND_CAP_ITEM=10000
SPEND_CAP_ANNUAL=40000
SPEND_CAP_CONSULTANT=25000
SPEND_CAP_CONSULTANT_MONTHS=3

# Calendar days before a quarter start. The job moves to the previous working day
# when that date is a weekend or a holiday.
QUARTER_LEAD_DAYS=7

# ISO dates of board meetings, comma-separated. Empty disables the board job.
BOARD_DATES=

# How many days ahead an open action is "due soon".
CHASE_WITHIN_DAYS=2

# Per-run ceiling passed to claude -p --max-budget-usd. This is model spend,
# not the office tooling cap above.
CLAUDE_MAX_BUDGET_USD=2.00

# Trackers. Hostnames and ids only. Tokens stay in the environment.
# JIRA_SITE is the hostname, with no scheme and no path.
GITHUB_REPOS=
JIRA_SITE=
JIRA_EMAIL=
JIRA_PROJECTS=
LINEAR_TEAM_IDS=
