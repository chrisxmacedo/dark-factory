# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database (Supabase Postgres — direct connection)
DATABASE_URL=postgresql+asyncpg://postgres:password@db.PROJECT_REF.supabase.co:5432/postgres

# Supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# ── Test environment ──────────────────────────────────────────────────────────
# These point to the SHARED ClauseHub test Supabase project.
# SUPABASE_TEST_URL and TEST_SUPABASE_JWT_SECRET are the same for all APIs.
# TEST_SCHEMA must be unique per API project (e.g. clausehub_api, another_api).

SUPABASE_TEST_URL=postgresql+asyncpg://postgres:password@db.TEST_PROJECT_REF.supabase.co:5432/postgres
TEST_SUPABASE_JWT_SECRET=your-shared-test-jwt-secret
TEST_SCHEMA=your_api_name
