{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bank.internal/schemas/observability-model.schema.json",
  "title": "ObservabilityModel",
  "description": "Schema for the bank's observability model: log routing, instrumentation standards, logging schema taxonomy, data freshness contracts, and architecture design decisions.",
  "type": "object",
  "required": [
    "$schema",
    "document_version",
    "status",
    "log_routing_architecture",
    "per_service_instrumentation_checklist",
    "logging_schema_by_category",
    "data_freshness",
    "design_decisions"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "document_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["Draft", "Review", "Approved", "Superseded"] },
    "log_routing_architecture": {
      "type": "object",
      "required": ["ingestion_layer", "pii_scrubbing", "fan_out_stores"],
      "additionalProperties": false,
      "properties": {
        "ingestion_layer": {
          "type": "object",
          "required": ["component", "protocol", "rationale"],
          "additionalProperties": false,
          "properties": {
            "component": { "type": "string" },
            "protocol": { "type": "string" },
            "rationale": { "type": "string" }
          }
        },
        "pii_scrubbing": {
          "type": "object",
          "required": ["stage", "mechanism", "fields_scrubbed", "enforcement"],
          "additionalProperties": false,
          "properties": {
            "stage": { "type": "string" },
            "mechanism": { "type": "string" },
            "fields_scrubbed": { "type": "array", "items": { "type": "string" } },
            "enforcement": { "type": "string" }
          }
        },
        "fan_out_stores": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "purpose", "retention", "access_control"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "purpose": { "type": "string" },
              "retention": { "type": "string" },
              "access_control": { "type": "string" },
              "worm": { "type": "boolean" },
              "technology_options": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "per_service_instrumentation_checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "mandatory"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "mandatory": { "type": "boolean" },
          "standards_reference": { "type": "string" }
        }
      }
    },
    "logging_schema_by_category": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["category_id", "category_name", "applies_to_services", "required_fields", "extension_fields", "critical_rules"],
        "additionalProperties": false,
        "properties": {
          "category_id": { "type": "string" },
          "category_name": { "type": "string" },
          "applies_to_services": { "type": "array", "items": { "type": "string" } },
          "required_fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["field", "type", "description"],
              "additionalProperties": false,
              "properties": {
                "field": { "type": "string" },
                "type": { "type": "string" },
                "description": { "type": "string" },
                "example": {}
              }
            }
          },
          "extension_fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["field", "type", "description"],
              "additionalProperties": false,
              "properties": {
                "field": { "type": "string" },
                "type": { "type": "string" },
                "description": { "type": "string" },
                "example": {}
              }
            }
          },
          "critical_rules": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "data_freshness": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["contract_id", "signal_name", "source", "max_staleness", "alert_threshold", "rationale"],
        "additionalProperties": false,
        "properties": {
          "contract_id": { "type": "string" },
          "signal_name": { "type": "string" },
          "source": { "type": "string" },
          "max_staleness": { "type": "string" },
          "alert_threshold": { "type": "string" },
          "rationale": { "type": "string" }
        }
      }
    },
    "design_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "decision", "rationale", "alternatives_considered", "rejected_because"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "decision": { "type": "string" },
          "rationale": { "type": "string" },
          "alternatives_considered": { "type": "array", "items": { "type": "string" } },
          "rejected_because": { "type": "string" }
        }
      }
    }
  }
}
