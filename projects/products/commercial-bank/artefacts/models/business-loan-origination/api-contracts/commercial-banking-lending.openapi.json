{
  "openapi": "3.1.0",
  "info": {
    "title": "Commercial Banking Lending API",
    "description": "SVC-005 (Commercial Banking Core) API for SME term loan origination and account management. Owned by CAP-002 (Commercial Banking). Exposes endpoints for loan application creation, credit assessment status, drawdown instruction, and loan account covenant monitoring. All endpoints require Bearer JWT issued by SVC-100 (IAM). Cross-capability: SVC-012 (Risk Engine) communicates exclusively via async events — it does not call these endpoints.",
    "version": "1.0.0",
    "contact": {
      "name": "Commercial Banking Core Team",
      "email": "commercial-core@bank.internal"
    }
  },
  "servers": [
    {
      "url": "https://api.internal.bank/commercial/v1",
      "description": "Internal API Gateway (SVC-101) — commercial banking lending namespace"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/loan-applications": {
      "post": {
        "operationId": "createLoanApplication",
        "summary": "Submit a new SME term loan application",
        "description": "Creates a LoanApplication (ENT-017) with status = submitted. Publishes EVT-031 (LoanApplicationSubmitted) and EVT-032 (CreditAssessmentRequested) to SVC-102. Called by the RM origination UI or business portal in PH-017. Requires the business_customer_id to reference an active BusinessCustomer (ENT-B001) created in JRN-004.",
        "tags": ["Loan Applications"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLoanApplicationRequest"
              },
              "example": {
                "business_customer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                "requested_amount": 500000.00,
                "term_months": 60,
                "purpose": "Purchase of new CNC manufacturing equipment to expand production capacity for automotive sector contracts",
                "security_type": "fixed_charge_property",
                "relationship_manager_id": "rm-uuid-1234-5678-90ab-cdef01234567"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Loan application successfully created. EVT-031 and EVT-032 published.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoanApplicationCreatedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error — missing required fields, invalid security_type enum, requested_amount below minimum.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "BusinessCustomer not found or not in active status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "An active loan application already exists for this business_customer_id and the same requested_amount + purpose (duplicate submission guard).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/loan-applications/{application_id}": {
      "get": {
        "operationId": "getLoanApplication",
        "summary": "Retrieve a loan application by ID",
        "description": "Returns the full LoanApplication (ENT-017) record including current status, assessment_id reference (once available from EVT-033), and approval details. Used by RM UI and business portal to track origination progress.",
        "tags": ["Loan Applications"],
        "parameters": [
          {
            "name": "application_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "LoanApplication.application_id (UUID v4)"
          }
        ],
        "responses": {
          "200": {
            "description": "Loan application record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoanApplicationResponse"
                }
              }
            }
          },
          "404": {
            "description": "Loan application not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/loan-applications/{application_id}/drawdown": {
      "post": {
        "operationId": "instructDrawdown",
        "summary": "Instruct a loan drawdown",
        "description": "Validates all pre-conditions (FacilityAgreed, all conditions_precedent satisfied, drawdown_amount <= remaining undrawn facility) and instructs SVC-009 to credit the drawdown amount to the specified BusinessAccount via CHAPS. Creates LoanAccount (ENT-020) on first drawdown. Publishes EVT-037 (LoanDrawnDown) and EVT-038 (LoanAccountOpened) on first drawdown. Idempotent on drawdown_instruction_id. CHAPS cut-off applies: instructions after 14:00 London time are deferred to next business day.",
        "tags": ["Drawdown"],
        "parameters": [
          {
            "name": "application_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DrawdownInstructionRequest"
              },
              "example": {
                "drawdown_instruction_id": "dd-uuid-1234-5678-90ab-cdef01234567",
                "drawdown_amount": 500000.00,
                "destination_account_id": "ba-uuid-1234-5678-90ab-cdef01234567",
                "payment_rail": "chaps",
                "requested_value_date": "2025-06-15"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Drawdown instructed successfully. CHAPS payment submitted to SVC-009. LoanAccount created/updated. EVT-037 and EVT-038 published.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DrawdownResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error — drawdown_amount exceeds remaining facility, conditions_precedent not all satisfied, or invalid payment_rail.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency conflict — drawdown_instruction_id already processed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Business rule violation — FacilityAgreed event not yet received for this application_id, or LoanApplication.status != facility_agreed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/loan-accounts/{account_id}": {
      "get": {
        "operationId": "getLoanAccount",
        "summary": "Retrieve a loan account by ID",
        "description": "Returns the LoanAccount (ENT-020) record with current outstanding_balance, next_payment_date, status, drawn_down_amount, and maturity_date. The primary endpoint for in-life loan account management by the business portal and RM system.",
        "tags": ["Loan Accounts"],
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "LoanAccount.account_id (UUID v4)"
          }
        ],
        "responses": {
          "200": {
            "description": "Loan account record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoanAccountResponse"
                }
              }
            }
          },
          "404": {
            "description": "Loan account not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/loan-accounts/{account_id}/covenants": {
      "get": {
        "operationId": "getLoanAccountCovenants",
        "summary": "Retrieve covenant monitoring records for a loan account",
        "description": "Returns all CovenantMonitoring (ENT-021) records for the specified loan account, ordered by review_date descending. Used by RM and Credit Analyst (PER-056) to review covenant compliance history and current status. Query parameter filter by compliance_status to retrieve only breached covenants.",
        "tags": ["Covenant Monitoring"],
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "LoanAccount.account_id (UUID v4)"
          },
          {
            "name": "compliance_status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["compliant", "breached", "waived", "not_yet_tested"]
            },
            "description": "Filter by compliance status. Omit to return all covenant test records."
          },
          {
            "name": "covenant_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["dscr_min", "leverage_max", "interest_cover_min", "tangible_net_worth_min", "other"]
            },
            "description": "Filter by covenant type."
          }
        ],
        "responses": {
          "200": {
            "description": "List of covenant monitoring records for the loan account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CovenantMonitoringListResponse"
                }
              }
            }
          },
          "404": {
            "description": "Loan account not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Bearer token issued by SVC-100 (Identity & Access Management). Required scopes: commercial:lending:read for GET endpoints; commercial:lending:write for POST endpoints. RM and Credit Analyst roles include commercial:lending:write by default. Business customer portal access includes commercial:lending:read scoped to their own business_customer_id."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid Bearer token.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Forbidden": {
        "description": "Token lacks required scope or the requesting principal is not authorised to access the specified business_customer_id or account_id.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "InternalServerError": {
        "description": "Unexpected internal server error. SVC-005 internal error logged to SVC-103. Retry with exponential back-off.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    },
    "schemas": {
      "CreateLoanApplicationRequest": {
        "type": "object",
        "required": ["business_customer_id", "requested_amount", "term_months", "purpose", "security_type", "relationship_manager_id"],
        "properties": {
          "business_customer_id": {
            "type": "string",
            "format": "uuid",
            "description": "FK to ENT-B001 (BusinessCustomer). Must reference an active BusinessCustomer."
          },
          "requested_amount": {
            "type": "number",
            "format": "double",
            "minimum": 10000,
            "description": "Loan amount requested in GBP. Minimum £10,000. Maximum per credit policy."
          },
          "term_months": {
            "type": "integer",
            "minimum": 12,
            "maximum": 120,
            "description": "Loan term in months. Range 12–120 (1–10 years)."
          },
          "purpose": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000,
            "description": "Description of loan purpose. Required for credit paper and GOV-002-R05 disclosure."
          },
          "security_type": {
            "type": "string",
            "enum": ["unsecured", "fixed_charge_property", "floating_charge_debenture", "personal_guarantee", "mixed"],
            "description": "Type of security offered. Input to LGD calculation in SVC-012."
          },
          "relationship_manager_id": {
            "type": "string",
            "format": "uuid",
            "description": "FK to Staff.staff_id for the originating RM (PER-050)."
          }
        }
      },
      "LoanApplicationCreatedResponse": {
        "type": "object",
        "properties": {
          "application_id": {
            "type": "string",
            "format": "uuid",
            "description": "System-assigned LoanApplication.application_id."
          },
          "status": {
            "type": "string",
            "enum": ["submitted"],
            "description": "Initial status on creation."
          },
          "business_customer_id": {
            "type": "string",
            "format": "uuid"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 UTC timestamp of application submission."
          },
          "events_published": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["EVT-031", "EVT-032"],
            "description": "Event IDs published to SVC-102 as a result of this request."
          }
        }
      },
      "LoanApplicationResponse": {
        "type": "object",
        "properties": {
          "application_id": { "type": "string", "format": "uuid" },
          "business_customer_id": { "type": "string", "format": "uuid" },
          "relationship_manager_id": { "type": "string", "format": "uuid" },
          "requested_amount": { "type": "number", "format": "double" },
          "term_months": { "type": "integer" },
          "purpose": { "type": "string" },
          "security_type": {
            "type": "string",
            "enum": ["unsecured", "fixed_charge_property", "floating_charge_debenture", "personal_guarantee", "mixed"]
          },
          "status": {
            "type": "string",
            "enum": ["submitted", "under_assessment", "approved", "approved_with_conditions", "declined", "withdrawn", "facility_agreed", "drawn_down", "completed"]
          },
          "assessment_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "FK to ENT-018 in SVC-012. Populated after EVT-033 received. Null until credit assessment completes."
          },
          "approved_amount": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Approved facility amount. Null until EVT-034 received."
          },
          "submitted_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "DrawdownInstructionRequest": {
        "type": "object",
        "required": ["drawdown_instruction_id", "drawdown_amount", "destination_account_id", "payment_rail"],
        "properties": {
          "drawdown_instruction_id": {
            "type": "string",
            "format": "uuid",
            "description": "Client-generated idempotency key. Duplicate requests with the same drawdown_instruction_id return 409 after first successful processing."
          },
          "drawdown_amount": {
            "type": "number",
            "format": "double",
            "minimum": 0.01,
            "description": "Amount to draw in GBP. Must be <= (FacilityAgreement.approved_amount - previously_drawn_amount)."
          },
          "destination_account_id": {
            "type": "string",
            "format": "uuid",
            "description": "FK to ENT-B002 (BusinessAccount.business_account_id). The BusinessAccount to receive the drawdown credit."
          },
          "payment_rail": {
            "type": "string",
            "enum": ["chaps", "bacs", "fps"],
            "description": "Payment rail for disbursement. CHAPS recommended for amounts >= £250,000 to guarantee same-day settlement."
          },
          "requested_value_date": {
            "type": "string",
            "format": "date",
            "description": "ISO 8601 date of requested value date. Must be a business day. CHAPS cut-off 14:00 London time for same-day value."
          }
        }
      },
      "DrawdownResponse": {
        "type": "object",
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid",
            "description": "LoanAccount.account_id (created on first drawdown, reused on subsequent drawdowns)."
          },
          "drawdown_amount": { "type": "number", "format": "double" },
          "outstanding_balance": {
            "type": "number",
            "format": "double",
            "description": "Updated outstanding_balance after this drawdown."
          },
          "payment_rail": { "type": "string" },
          "settlement_reference": {
            "type": "string",
            "description": "CHAPS/BACS settlement reference from SVC-009."
          },
          "drawdown_date": { "type": "string", "format": "date" },
          "first_payment_date": {
            "type": "string",
            "format": "date",
            "description": "Date of first scheduled repayment per amortisation schedule."
          },
          "events_published": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["EVT-037", "EVT-038"]
          }
        }
      },
      "LoanAccountResponse": {
        "type": "object",
        "properties": {
          "account_id": { "type": "string", "format": "uuid" },
          "business_customer_id": { "type": "string", "format": "uuid" },
          "facility_id": {
            "type": "string",
            "format": "uuid",
            "description": "FK to FacilityAgreement.agreement_id (ENT-019)."
          },
          "outstanding_balance": {
            "type": "number",
            "format": "double",
            "description": "Current outstanding principal balance in GBP."
          },
          "drawn_down_amount": {
            "type": "number",
            "format": "double",
            "description": "Cumulative total drawn to date."
          },
          "next_payment_date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "drawdown_date": { "type": "string", "format": "date" },
          "maturity_date": { "type": "string", "format": "date" },
          "status": {
            "type": "string",
            "enum": ["active", "arrears", "default", "watch_list", "repaid", "closed"]
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "CovenantMonitoringListResponse": {
        "type": "object",
        "properties": {
          "account_id": { "type": "string", "format": "uuid" },
          "total_count": { "type": "integer" },
          "covenants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CovenantMonitoringRecord"
            }
          }
        }
      },
      "CovenantMonitoringRecord": {
        "type": "object",
        "properties": {
          "monitoring_id": { "type": "string", "format": "uuid" },
          "loan_account_id": { "type": "string", "format": "uuid" },
          "covenant_type": {
            "type": "string",
            "enum": ["dscr_min", "leverage_max", "interest_cover_min", "tangible_net_worth_min", "other"]
          },
          "target_value": { "type": "number", "format": "double" },
          "actual_value": { "type": "number", "format": "double" },
          "compliance_status": {
            "type": "string",
            "enum": ["compliant", "breached", "waived", "not_yet_tested"]
          },
          "review_date": { "type": "string", "format": "date" },
          "test_period_end_date": { "type": "string", "format": "date" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error_code", "message"],
        "properties": {
          "error_code": {
            "type": "string",
            "description": "Machine-readable error code. Examples: LOAN_APP_NOT_FOUND, CUSTOMER_NOT_ACTIVE, DRAWDOWN_AMOUNT_EXCEEDS_FACILITY, IDEMPOTENCY_CONFLICT, FACILITY_NOT_AGREED."
          },
          "message": {
            "type": "string",
            "description": "Human-readable error description."
          },
          "field": {
            "type": "string",
            "nullable": true,
            "description": "For validation errors: the field name that failed validation."
          },
          "request_id": {
            "type": "string",
            "description": "Unique request identifier for SVC-103 audit log correlation."
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Loan Applications",
      "description": "Loan origination lifecycle: application creation and status tracking (ENT-017, PH-017 through PH-020)"
    },
    {
      "name": "Drawdown",
      "description": "Loan drawdown instruction and LoanAccount creation (ENT-020, PH-021)"
    },
    {
      "name": "Loan Accounts",
      "description": "In-life loan account management (ENT-020, PH-021 through PH-022)"
    },
    {
      "name": "Covenant Monitoring",
      "description": "Covenant compliance testing and breach tracking (ENT-021, PH-022)"
    }
  ]
}
