{
  "openapi": "3.1.0",
  "info": {
    "title": "CAP-005 Compliance API",
    "description": "CAP-005 — Compliance and Regulatory capability API surface for JRN-001 (Personal Current Account Opening). This is the published API surface of the Compliance capability — channels and CAP-001 Retail Banking call this capability API; they never address internal services (SVC-050 Customer Onboarding, SVC-014 KYC/AML Service, SVC-051 Sanctions Screening Service) directly.\n\nCAP-005 exposes three logical endpoint groups:\n- /identity-verifications — digital identity verification orchestration (owned internally by SVC-050)\n- /kyc-assessments — CDD assessment lifecycle including PEP, adverse media, and risk scoring (owned internally by SVC-014)\n- /sanctions/screen — stateless real-time sanctions screening (provided internally by SVC-051)\n\nInternal routing from CAP-005 API to the appropriate internal service is an L3 concern not documented here.\n\nRegulatory context: MLR 2017 Regulations 27–35 govern CDD requirements. Identity verification outcome is UK GDPR Article 9 Special Category data — biometric templates are never stored. Hard latency limit on sanctions screening: <3,000ms (GOV-005-R02). Starling Bank FCA enforcement action (£29m, October 2024) establishes 100% applicant coverage as mandatory.",
    "version": "1.0.0",
    "contact": {
      "name": "Compliance Capability Team",
      "email": "cap-005-team@bank.internal"
    }
  },
  "servers": [
    {
      "url": "https://api.bank.internal/compliance/v1",
      "description": "Internal production"
    },
    {
      "url": "https://api.staging.bank.internal/compliance/v1",
      "description": "Staging"
    }
  ],
  "security": [
    { "BearerAuth": [] }
  ],
  "tags": [
    {
      "name": "IdentityVerifications",
      "description": "Digital identity verification lifecycle. Orchestrates document authentication, biometric liveness check, and address verification via Onfido/Jumio vendor SDK. Owns ENT-002 (IdentityVerification). Internal service: SVC-050 Customer Onboarding."
    },
    {
      "name": "KYCAssessments",
      "description": "CDD assessment lifecycle. Manages PEP screening, adverse media screening, risk scoring, and EDD escalation. Owns ENT-003 (KycAssessment). Sanctions screening is performed internally within CAP-005. Internal service: SVC-014 KYC/AML Service."
    },
    {
      "name": "Sanctions",
      "description": "Synchronous real-time sanctions screening. Stateless — results are not persisted by this endpoint; caller is responsible for persisting results. Hard SLA: <3,000ms. Internal service: SVC-051 Sanctions Screening Service."
    }
  ],
  "paths": {
    "/identity-verifications": {
      "post": {
        "operationId": "initiateIdentityVerification",
        "summary": "Initiate identity verification",
        "description": "Creates a new IdentityVerification record (ENT-002) and initiates the identity verification workflow with the vendor (Onfido/Jumio). Called by CAP-001 Retail Banking (or the channel SVC-017) after ApplicationStarted is received.\n\nThe response includes a vendor_session_token that the client-side SDK uses to present document capture and liveness check UI directly to the customer. The SDK communicates directly with the vendor; CAP-005 receives the result via a vendor webhook.\n\nPhase: PH-002 (Identity Verification)\nGovernance: MLR 2017 Reg 27, UK GDPR Article 9, GOV-005-R01.",
        "tags": ["IdentityVerifications"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/InitiateVerificationRequest" },
              "examples": {
                "mobile_passport": {
                  "summary": "Initiate passport verification via mobile app",
                  "value": {
                    "application_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                    "customer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                    "channel": "mobile_app",
                    "document_type": "passport",
                    "customer_name": {
                      "first_name": "Amara",
                      "last_name": "Okonkwo"
                    },
                    "date_of_birth": "1992-07-15",
                    "address": {
                      "line1": "14 Thornfield Road",
                      "city": "Manchester",
                      "postcode": "M14 7PJ",
                      "country_code": "GB"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "IdentityVerification initiated. Returns vendor SDK token for client-side document/liveness capture.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VerificationInitiatedResponse" },
                "examples": {
                  "initiated": {
                    "value": {
                      "verification_id": "f1e2d3c4-b5a6-7890-1234-567890abcdef",
                      "application_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "status": "pending",
                      "vendor_sdk_token": "onfido-sdk-token-xyz",
                      "sdk_expiry": "2026-04-15T10:12:01Z"
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/identity-verifications/{id}": {
      "get": {
        "operationId": "getIdentityVerification",
        "summary": "Get identity verification result",
        "description": "Returns the current state of an IdentityVerification (ENT-002). Poll this endpoint after SDK completion or subscribe to IdentityVerificationCompleted event on the Event Bus.\n\nPhase: PH-002 (Identity Verification)",
        "tags": ["IdentityVerifications"],
        "parameters": [
          { "$ref": "#/components/parameters/VerificationId" }
        ],
        "responses": {
          "200": {
            "description": "Verification found.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VerificationResponse" },
                "examples": {
                  "passed": {
                    "value": {
                      "verification_id": "f1e2d3c4-b5a6-7890-1234-567890abcdef",
                      "application_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "customer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                      "status": "pass",
                      "document_type": "passport",
                      "biometric_match_score": 0.96,
                      "address_verification": "confirmed",
                      "completed_at": "2026-04-15T09:13:05Z"
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/kyc-assessments": {
      "post": {
        "operationId": "initiateKycAssessment",
        "summary": "Initiate CDD assessment",
        "description": "Creates a new KycAssessment record (ENT-003) and initiates the full CDD workflow: (1) sanctions screening (synchronous internally, hard 3,000ms limit per GOV-005-R02), (2) PEP screening via ComplyAdvantage/Refinitiv World-Check, (3) adverse media screening, (4) automated risk scoring. Triggered by IdentityVerificationCompleted event or called directly.\n\nPoll GET /kyc-assessments/{id} or subscribe to KYCClearanceGranted / KYCReferralRaised / SanctionsHitDetected events on the Event Bus.\n\nPhase: PH-003 (KYC/CDD Assessment)\nGovernance: MLR 2017 Regs 27–35, GOV-005-R01, GOV-005-R02.",
        "tags": ["KYCAssessments"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/InitiateKycAssessmentRequest" },
              "examples": {
                "standard_cdd": {
                  "summary": "Standard CDD assessment for UK national",
                  "value": {
                    "application_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                    "customer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                    "identity_verification_id": "f1e2d3c4-b5a6-7890-1234-567890abcdef",
                    "verified_identity": {
                      "first_name": "Amara",
                      "last_name": "Okonkwo",
                      "date_of_birth": "1992-07-15",
                      "nationality": ["GB"],
                      "document_type": "passport",
                      "address": {
                        "line1": "14 Thornfield Road",
                        "city": "Manchester",
                        "postcode": "M14 7PJ",
                        "country_code": "GB"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "KYC assessment initiated.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/KycAssessmentInitiatedResponse" },
                "examples": {
                  "initiated": {
                    "value": {
                      "assessment_id": "kyc-20260415-0042",
                      "application_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "status": "in_progress",
                      "initiated_at": "2026-04-15T09:13:10Z"
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/kyc-assessments/{id}": {
      "get": {
        "operationId": "getKycAssessment",
        "summary": "Get KYC assessment result",
        "description": "Returns the current state of a KycAssessment (ENT-003). On completion, status will be: cleared, referred, blocked.\n\nPhase: PH-003 (KYC/CDD Assessment)",
        "tags": ["KYCAssessments"],
        "parameters": [
          { "$ref": "#/components/parameters/AssessmentId" }
        ],
        "responses": {
          "200": {
            "description": "Assessment found.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/KycAssessmentResponse" },
                "examples": {
                  "cleared": {
                    "value": {
                      "assessment_id": "kyc-20260415-0042",
                      "customer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                      "status": "cleared",
                      "sanctions_result": "clear",
                      "pep_result": "clear",
                      "adverse_media_result": "clear",
                      "risk_score": 22,
                      "risk_category": "simplified",
                      "next_review_date": "2031-04-15",
                      "completed_at": "2026-04-15T09:13:40Z"
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/sanctions/screen": {
      "post": {
        "operationId": "screenForSanctions",
        "summary": "Synchronous real-time sanctions screening",
        "description": "Screens an individual or entity against all configured sanctions lists (OFSI, OFAC, UN, EU) in a single synchronous call. Returns a result within the 3,000ms hard limit (GOV-005-R02). Stateless — results are not persisted; the caller is responsible for persisting the result.\n\nScreening covers: OFSI Consolidated List (HM Treasury UK), OFAC SDN List (US Treasury), UN Consolidated List (UN Security Council), EU Financial Sanctions List. Additional vendor-supplied lists (ComplyAdvantage/Refinitiv World-Check) may supplement.\n\nA 'blocked' result must be acted upon immediately. The tipping-off prohibition (POCA 2002 s333A) requires that no indication of the screening result is disclosed to the screened individual.\n\nPhase: PH-003 (KYC/CDD Assessment) — called internally within CAP-005\nGovernance: GOV-005-R02, OFSI regulations, POCA 2002 s333A.",
        "tags": ["Sanctions"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SanctionsScreenRequest" },
              "examples": {
                "individual_standard": {
                  "summary": "Screen individual — standard CDD (UK national)",
                  "value": {
                    "screening_request_id": "scr-20260415-0042391",
                    "entity_type": "individual",
                    "individual": {
                      "first_name": "Amara",
                      "last_name": "Okonkwo",
                      "date_of_birth": "1992-07-15",
                      "nationality": ["GB"]
                    },
                    "lists": ["OFSI", "OFAC", "UN", "EU"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Screening completed within 3,000ms SLA.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SanctionsScreenResponse" },
                "examples": {
                  "clear": {
                    "value": {
                      "screening_request_id": "scr-20260415-0042391",
                      "status": "clear",
                      "lists_checked": ["OFSI", "OFAC", "UN", "EU"],
                      "processing_time_ms": 312,
                      "screened_at": "2026-04-15T09:13:12Z"
                    }
                  },
                  "blocked": {
                    "value": {
                      "screening_request_id": "scr-20260415-0099001",
                      "status": "blocked",
                      "lists_checked": ["OFSI", "OFAC", "UN", "EU"],
                      "processing_time_ms": 287,
                      "screened_at": "2026-04-15T09:13:12Z"
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "408": {
            "description": "Request timeout — screening did not complete within 3,000ms hard SLA.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "timeout": {
                    "value": {
                      "error_code": "SCREENING_TIMEOUT",
                      "message": "Sanctions screening did not complete within 3,000ms SLA. Fail-closed: treat as error.",
                      "correlation_id": "req-abc-999"
                    }
                  }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT issued by SVC-100 (IAM). Must include appropriate scope claims for compliance endpoints."
      }
    },
    "parameters": {
      "VerificationId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" },
        "description": "IdentityVerification ID (ENT-002)"
      },
      "AssessmentId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "KycAssessment ID (ENT-003)"
      }
    },
    "schemas": {
      "InitiateVerificationRequest": {
        "type": "object",
        "required": ["application_id", "customer_id", "channel", "document_type"],
        "properties": {
          "application_id": { "type": "string", "format": "uuid" },
          "customer_id": { "type": "string", "format": "uuid" },
          "channel": { "type": "string", "enum": ["mobile_app", "web_portal", "branch"] },
          "document_type": { "type": "string", "enum": ["passport", "driving_licence", "national_id"] },
          "customer_name": {
            "type": "object",
            "properties": {
              "first_name": { "type": "string" },
              "last_name": { "type": "string" }
            }
          },
          "date_of_birth": { "type": "string", "format": "date" },
          "address": {
            "type": "object",
            "properties": {
              "line1": { "type": "string" },
              "city": { "type": "string" },
              "postcode": { "type": "string" },
              "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" }
            }
          }
        }
      },
      "VerificationInitiatedResponse": {
        "type": "object",
        "properties": {
          "verification_id": { "type": "string", "format": "uuid" },
          "application_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["pending", "in_progress", "pass", "fail", "expired"] },
          "vendor_sdk_token": { "type": "string", "description": "Token for initialising the Onfido/Jumio SDK on the client side." },
          "sdk_expiry": { "type": "string", "format": "date-time" }
        }
      },
      "VerificationResponse": {
        "type": "object",
        "properties": {
          "verification_id": { "type": "string", "format": "uuid" },
          "application_id": { "type": "string", "format": "uuid" },
          "customer_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["pending", "in_progress", "pass", "fail", "expired"] },
          "document_type": { "type": "string" },
          "biometric_match_score": { "type": "number", "minimum": 0, "maximum": 1, "description": "Vendor biometric match score. Biometric template not stored — UK GDPR Art.9." },
          "address_verification": { "type": "string", "enum": ["confirmed", "unconfirmed", "failed"] },
          "completed_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "InitiateKycAssessmentRequest": {
        "type": "object",
        "required": ["application_id", "customer_id", "identity_verification_id", "verified_identity"],
        "properties": {
          "application_id": { "type": "string", "format": "uuid" },
          "customer_id": { "type": "string", "format": "uuid" },
          "identity_verification_id": { "type": "string", "format": "uuid" },
          "verified_identity": {
            "type": "object",
            "required": ["first_name", "last_name", "date_of_birth", "nationality"],
            "properties": {
              "first_name": { "type": "string" },
              "last_name": { "type": "string" },
              "date_of_birth": { "type": "string", "format": "date" },
              "nationality": { "type": "array", "items": { "type": "string" } },
              "document_type": { "type": "string" },
              "address": {
                "type": "object",
                "properties": {
                  "line1": { "type": "string" },
                  "city": { "type": "string" },
                  "postcode": { "type": "string" },
                  "country_code": { "type": "string" }
                }
              }
            }
          }
        }
      },
      "KycAssessmentInitiatedResponse": {
        "type": "object",
        "properties": {
          "assessment_id": { "type": "string" },
          "application_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["in_progress"] },
          "initiated_at": { "type": "string", "format": "date-time" }
        }
      },
      "KycAssessmentResponse": {
        "type": "object",
        "properties": {
          "assessment_id": { "type": "string" },
          "customer_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["in_progress", "cleared", "referred", "blocked"] },
          "sanctions_result": { "type": "string", "enum": ["clear", "blocked", "error"] },
          "pep_result": { "type": "string", "enum": ["clear", "hit", "error"] },
          "adverse_media_result": { "type": "string", "enum": ["clear", "hit", "error"] },
          "risk_score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "risk_category": { "type": "string", "enum": ["simplified", "standard", "enhanced"] },
          "edd_required": { "type": "boolean" },
          "next_review_date": { "type": "string", "format": "date", "nullable": true },
          "completed_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "SanctionsScreenRequest": {
        "type": "object",
        "required": ["screening_request_id", "entity_type"],
        "properties": {
          "screening_request_id": { "type": "string", "description": "Caller-assigned unique ID for idempotency and audit." },
          "entity_type": { "type": "string", "enum": ["individual", "company"] },
          "individual": {
            "type": "object",
            "description": "Required when entity_type = individual",
            "properties": {
              "first_name": { "type": "string" },
              "last_name": { "type": "string" },
              "date_of_birth": { "type": "string", "format": "date" },
              "nationality": { "type": "array", "items": { "type": "string" } }
            }
          },
          "company": {
            "type": "object",
            "description": "Required when entity_type = company",
            "properties": {
              "company_name": { "type": "string" },
              "registration_number": { "type": "string" },
              "jurisdiction": { "type": "string" }
            }
          },
          "lists": {
            "type": "array",
            "items": { "type": "string", "enum": ["OFSI", "OFAC", "UN", "EU"] },
            "minItems": 1,
            "description": "Sanctions lists to screen against. All four are required for regulatory compliance."
          }
        }
      },
      "SanctionsScreenResponse": {
        "type": "object",
        "properties": {
          "screening_request_id": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["clear", "blocked", "error"],
            "description": "clear: no match found. blocked: match found — halt processing immediately. error: screening failed — fail-closed, treat as blocked."
          },
          "lists_checked": { "type": "array", "items": { "type": "string" } },
          "processing_time_ms": { "type": "integer", "description": "Must be < 3,000ms per GOV-005-R02." },
          "screened_at": { "type": "string", "format": "date-time" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error_code": { "type": "string" },
          "message": { "type": "string" },
          "detail": { "type": "string" },
          "correlation_id": { "type": "string" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request — validation failure.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "Unauthorized": {
        "description": "Unauthorized — missing or invalid Bearer token.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "Forbidden": {
        "description": "Forbidden — insufficient scope.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "NotFound": {
        "description": "Resource not found.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "InternalServerError": {
        "description": "Internal server error.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      }
    }
  }
}
