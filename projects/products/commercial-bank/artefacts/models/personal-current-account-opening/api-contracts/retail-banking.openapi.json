{
  "openapi": "3.1.0",
  "info": {
    "title": "CAP-001 Retail Banking API",
    "description": "CAP-001 — Retail Banking capability API surface. Exposes the account opening application lifecycle, account provisioning, and credential management endpoints for JRN-001 (Personal Current Account Opening). This is the published API surface of the Retail Banking capability — channels (SVC-017 Digital Channels, internal tooling) call this capability API; they never address internal services directly.\n\nInternal services within CAP-001 (SVC-001 Retail Banking Core, SVC-002 Mortgage Service, SVC-004 Insurance Distribution Service) communicate by whatever means the capability decides. Internal routing is an L3 concern not documented here.\n\nRegulatory context: ApplicationRecord decisions are Consumer Duty evidence (retained 6–7 years, PS22/9). Account records feed the FSCS Single Customer View (SCV) — producible within 24 hours of a payout trigger. All endpoints are UK-data-residency only.",
    "version": "1.0.0",
    "contact": {
      "name": "Retail Banking Capability Team",
      "email": "cap-001-team@bank.internal"
    }
  },
  "servers": [
    {
      "url": "https://api.bank.internal/retail-banking/v1",
      "description": "Internal production"
    },
    {
      "url": "https://api.staging.bank.internal/retail-banking/v1",
      "description": "Staging"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Applications",
      "description": "Account opening application lifecycle. ApplicationRecord (ENT-007) is owned within CAP-001 and is the Consumer Duty evidence record for all account opening decisions."
    },
    {
      "name": "Accounts",
      "description": "Account provisioning and retrieval. Account (ENT-004) is the FSCS Single Customer View record owned within CAP-001."
    },
    {
      "name": "Credentials",
      "description": "Customer credential management and FIDO2/WebAuthn device registration for digital channel activation (PH-006)."
    }
  ],
  "paths": {
    "/applications": {
      "post": {
        "operationId": "createApplication",
        "summary": "Start account opening application",
        "description": "Creates a new ApplicationRecord (ENT-007) and Customer prospect record (ENT-001) for a personal current account opening request. Publishes ApplicationStarted domain event to the event bus on successful creation. Performs preliminary eligibility checks: age >= 18, UK residency, deduplication against existing active accounts.\n\nPhase: PH-001 (Application Initiation)\nGovernance: GOV-001-R01, GOV-005-R04, Consumer Duty PS22/9.",
        "tags": ["Applications"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApplicationRequest"
              },
              "examples": {
                "standard_current_account": {
                  "summary": "Standard current account — new UK customer",
                  "value": {
                    "account_type": "standard_current",
                    "channel": "mobile_app",
                    "applicant": {
                      "title": "Ms",
                      "first_name": "Amara",
                      "last_name": "Okonkwo",
                      "date_of_birth": "1992-07-15",
                      "nationality": ["GB"],
                      "tax_residency": ["GB"],
                      "email": "amara.okonkwo@example.com",
                      "phone": "+447700900123",
                      "addresses": [
                        {
                          "line1": "14 Thornfield Road",
                          "city": "Manchester",
                          "postcode": "M14 7PJ",
                          "country_code": "GB",
                          "address_type": "residential",
                          "valid_from": "2021-03-01"
                        }
                      ]
                    },
                    "switching": false,
                    "consent": {
                      "terms_accepted": true,
                      "terms_version": "v2.4",
                      "accepted_at": "2026-04-15T09:12:00Z",
                      "marketing_opt_in": false
                    }
                  }
                },
                "switching_application": {
                  "summary": "CASS switching application",
                  "value": {
                    "account_type": "standard_current",
                    "channel": "web_portal",
                    "applicant": {
                      "title": "Mr",
                      "first_name": "James",
                      "last_name": "Patel",
                      "date_of_birth": "1985-11-03",
                      "nationality": ["GB"],
                      "tax_residency": ["GB"],
                      "email": "james.patel@example.com",
                      "phone": "+447911123456",
                      "addresses": [
                        {
                          "line1": "22 Birchwood Avenue",
                          "city": "Bristol",
                          "postcode": "BS8 2TQ",
                          "country_code": "GB",
                          "address_type": "residential",
                          "valid_from": "2019-06-15"
                        }
                      ]
                    },
                    "switching": true,
                    "cass_switch": {
                      "intended_switch_date": "2026-04-24",
                      "previous_bank_name": "Barclays Bank plc",
                      "previous_sort_code": "20-00-00",
                      "previous_account_number": "12345678"
                    },
                    "consent": {
                      "terms_accepted": true,
                      "terms_version": "v2.4",
                      "accepted_at": "2026-04-15T14:00:00Z",
                      "marketing_opt_in": false
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Application created. ApplicationStarted event published. Customer directed to identity verification (PH-002).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApplicationResponse" },
                "examples": {
                  "created": {
                    "value": {
                      "application_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "application_ref": "APP-2026-0042391",
                      "customer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                      "status": "in_progress",
                      "current_phase": "PH-002",
                      "account_type": "standard_current",
                      "channel": "mobile_app",
                      "switching": false,
                      "created_at": "2026-04-15T09:12:01Z"
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": {
            "description": "Conflict. An active application or account already exists for this identity.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "duplicate": {
                    "value": {
                      "error_code": "DUPLICATE_APPLICATION",
                      "message": "An active application or account already exists for this identity.",
                      "correlation_id": "req-abc-123"
                    }
                  }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/applications/{id}": {
      "get": {
        "operationId": "getApplication",
        "summary": "Get application status",
        "description": "Returns the current state of an ApplicationRecord (ENT-007). Used by the channel (SVC-017) to drive the customer-facing application journey state machine. Sensitive fields (decline_reason, decision_basis_ref) are restricted to compliance roles.\n\nPhase: PH-001 through PH-007",
        "tags": ["Applications"],
        "parameters": [
          { "$ref": "#/components/parameters/ApplicationId" }
        ],
        "responses": {
          "200": {
            "description": "Application found.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApplicationResponse" },
                "examples": {
                  "approved": {
                    "value": {
                      "application_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "application_ref": "APP-2026-0042391",
                      "status": "approved",
                      "current_phase": "PH-005",
                      "decided_at": "2026-04-15T09:14:22Z"
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/accounts/{id}": {
      "get": {
        "operationId": "getAccount",
        "summary": "Get account details",
        "description": "Returns the current state of an Account (ENT-004). Includes sort code, account number, IBAN, balance, status, product type, and FSCS eligibility flag. Used by the channel (SVC-017) to display account details to the customer after provisioning (PH-005) and during digital channel activation (PH-006).\n\nPhase: PH-005 (Account Provisioning), PH-006 (Digital Channel Activation)\nGovernance: FSCS SCV obligation.",
        "tags": ["Accounts"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" }
        ],
        "responses": {
          "200": {
            "description": "Account found.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AccountResponse" },
                "examples": {
                  "active_account": {
                    "value": {
                      "account_id": "acc-20260415-87654321",
                      "customer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                      "sort_code": "40-47-84",
                      "account_number": "87654321",
                      "iban": "GB29NWBK40474887654321",
                      "account_type": "standard_current",
                      "product_type": "standard",
                      "status": "active",
                      "available_balance": 0.00,
                      "cleared_balance": 0.00,
                      "currency": "GBP",
                      "fscs_eligible": true,
                      "cass_registered": false,
                      "opened_at": "2026-04-15T09:14:30Z"
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/customers/{id}/credentials": {
      "post": {
        "operationId": "createCredentials",
        "summary": "Create customer credentials and register FIDO2 device",
        "description": "Creates username/password credentials and registers a FIDO2/WebAuthn device for a customer. Called by the channel (SVC-017) during digital channel activation (PH-006). Biometric templates are never transmitted or stored — only the FIDO2 credential ID and device attestation are registered.\n\nPhase: PH-006 (Digital Channel Activation)\nGovernance: UK GDPR data minimisation (Art.5), FIDO2/WebAuthn CTAP2.",
        "tags": ["Credentials"],
        "parameters": [
          { "$ref": "#/components/parameters/CustomerId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateCredentialsRequest" },
              "examples": {
                "mobile_biometric": {
                  "value": {
                    "hashed_password": "<bcrypt-hash>",
                    "fido2_credential_id": "credId-abc123",
                    "device_id": "device-uuid-4321",
                    "device_type": "ios_faceid",
                    "registered_at": "2026-04-15T09:30:00Z"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Credentials created; FIDO2 device registered.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CredentialsResponse" },
                "examples": {
                  "created": {
                    "value": {
                      "customer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                      "credential_id": "cred-uuid-9988",
                      "fido2_registered": true,
                      "registered_at": "2026-04-15T09:30:01Z"
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": {
            "description": "Credentials already exist for this customer.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/auth/verify-sca": {
      "post": {
        "operationId": "verifySCA",
        "summary": "Verify SCA (FIDO2/WebAuthn assertion)",
        "description": "Validates a FIDO2/WebAuthn SCA assertion from the customer's registered device. Called by the channel (SVC-017) during first login (PH-006) and before sensitive operations. The biometric assertion is validated by the FIDO2 server — no biometric data is transmitted beyond the assertion.\n\nPhase: PH-006 (Digital Channel Activation)\nGovernance: PSR 2017 SCA requirements, UK GDPR Art.9 data minimisation.",
        "tags": ["Credentials"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VerifySCARequest" },
              "examples": {
                "faceid_assertion": {
                  "value": {
                    "customer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                    "fido2_assertion": "<WebAuthn assertion object>",
                    "device_id": "device-uuid-4321",
                    "assertion_type": "authentication"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SCA verified.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SCAVerificationResponse" },
                "examples": {
                  "verified": {
                    "value": {
                      "customer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                      "verified": true,
                      "sca_method": "fido2_faceid",
                      "verified_at": "2026-04-15T09:31:00Z"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "SCA verification failed.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT issued by SVC-100 (IAM). Must include customer_id and appropriate scope claims."
      }
    },
    "parameters": {
      "ApplicationId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" },
        "description": "ApplicationRecord ID (ENT-007)"
      },
      "AccountId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "Account ID (ENT-004)"
      },
      "CustomerId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" },
        "description": "Customer ID (ENT-001)"
      }
    },
    "schemas": {
      "CreateApplicationRequest": {
        "type": "object",
        "required": ["account_type", "channel", "applicant", "consent"],
        "properties": {
          "account_type": {
            "type": "string",
            "enum": ["standard_current", "premier_current", "basic_account"],
            "description": "Type of personal current account being applied for."
          },
          "channel": {
            "type": "string",
            "enum": ["mobile_app", "web_portal", "branch", "telephony"]
          },
          "applicant": {
            "type": "object",
            "required": ["first_name", "last_name", "date_of_birth", "nationality", "email"],
            "properties": {
              "title": { "type": "string" },
              "first_name": { "type": "string", "minLength": 1 },
              "last_name": { "type": "string", "minLength": 1 },
              "date_of_birth": { "type": "string", "format": "date" },
              "nationality": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "tax_residency": { "type": "array", "items": { "type": "string" } },
              "email": { "type": "string", "format": "email" },
              "phone": { "type": "string" },
              "addresses": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["line1", "city", "postcode", "country_code", "address_type"],
                  "properties": {
                    "line1": { "type": "string" },
                    "line2": { "type": "string", "nullable": true },
                    "city": { "type": "string" },
                    "county": { "type": "string" },
                    "postcode": { "type": "string" },
                    "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" },
                    "address_type": { "type": "string", "enum": ["residential", "correspondence"] },
                    "valid_from": { "type": "string", "format": "date" },
                    "valid_to": { "type": "string", "format": "date", "nullable": true }
                  }
                }
              }
            }
          },
          "switching": { "type": "boolean", "default": false },
          "cass_switch": {
            "type": "object",
            "description": "Required when switching=true",
            "properties": {
              "intended_switch_date": { "type": "string", "format": "date" },
              "previous_bank_name": { "type": "string" },
              "previous_sort_code": { "type": "string", "pattern": "^\\d{2}-\\d{2}-\\d{2}$" },
              "previous_account_number": { "type": "string", "pattern": "^\\d{8}$" }
            }
          },
          "consent": {
            "type": "object",
            "required": ["terms_accepted", "terms_version", "accepted_at"],
            "properties": {
              "terms_accepted": { "type": "boolean", "enum": [true] },
              "terms_version": { "type": "string" },
              "accepted_at": { "type": "string", "format": "date-time" },
              "marketing_opt_in": { "type": "boolean", "default": false }
            }
          }
        }
      },
      "ApplicationResponse": {
        "type": "object",
        "properties": {
          "application_id": { "type": "string", "format": "uuid" },
          "application_ref": { "type": "string" },
          "customer_id": { "type": "string", "format": "uuid" },
          "status": {
            "type": "string",
            "enum": ["in_progress", "approved", "declined", "referred", "withdrawn", "expired"]
          },
          "current_phase": { "type": "string" },
          "account_type": { "type": "string" },
          "channel": { "type": "string" },
          "switching": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "decided_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "AccountResponse": {
        "type": "object",
        "properties": {
          "account_id": { "type": "string" },
          "customer_id": { "type": "string", "format": "uuid" },
          "sort_code": { "type": "string", "pattern": "^\\d{2}-\\d{2}-\\d{2}$" },
          "account_number": { "type": "string", "pattern": "^\\d{8}$" },
          "iban": { "type": "string" },
          "account_type": { "type": "string" },
          "product_type": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "frozen", "dormant", "closed"] },
          "available_balance": { "type": "number", "format": "double" },
          "cleared_balance": { "type": "number", "format": "double" },
          "currency": { "type": "string", "enum": ["GBP"] },
          "fscs_eligible": { "type": "boolean" },
          "cass_registered": { "type": "boolean" },
          "opened_at": { "type": "string", "format": "date-time" }
        }
      },
      "CreateCredentialsRequest": {
        "type": "object",
        "required": ["hashed_password", "fido2_credential_id", "device_id"],
        "properties": {
          "hashed_password": { "type": "string", "description": "bcrypt hash of customer's chosen password." },
          "fido2_credential_id": { "type": "string" },
          "device_id": { "type": "string", "format": "uuid" },
          "device_type": { "type": "string", "enum": ["ios_faceid", "ios_touchid", "android_fingerprint", "android_faceid", "hardware_key"] },
          "registered_at": { "type": "string", "format": "date-time" }
        }
      },
      "CredentialsResponse": {
        "type": "object",
        "properties": {
          "customer_id": { "type": "string", "format": "uuid" },
          "credential_id": { "type": "string" },
          "fido2_registered": { "type": "boolean" },
          "registered_at": { "type": "string", "format": "date-time" }
        }
      },
      "VerifySCARequest": {
        "type": "object",
        "required": ["customer_id", "fido2_assertion", "device_id"],
        "properties": {
          "customer_id": { "type": "string", "format": "uuid" },
          "fido2_assertion": { "type": "string", "description": "Base64-encoded WebAuthn assertion object." },
          "device_id": { "type": "string", "format": "uuid" },
          "assertion_type": { "type": "string", "enum": ["authentication", "transaction_signing"] }
        }
      },
      "SCAVerificationResponse": {
        "type": "object",
        "properties": {
          "customer_id": { "type": "string", "format": "uuid" },
          "verified": { "type": "boolean" },
          "sca_method": { "type": "string" },
          "verified_at": { "type": "string", "format": "date-time" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error_code": { "type": "string" },
          "message": { "type": "string" },
          "detail": { "type": "string" },
          "correlation_id": { "type": "string" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request — validation failure.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized — missing or invalid Bearer token.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Forbidden": {
        "description": "Forbidden — insufficient scope.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "InternalServerError": {
        "description": "Internal server error.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    }
  }
}
