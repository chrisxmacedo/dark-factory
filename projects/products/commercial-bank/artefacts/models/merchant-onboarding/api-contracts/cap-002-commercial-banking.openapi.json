{
  "openapi": "3.1.0",
  "info": {"title": "Commercial Banking Capability API — Merchant Onboarding Extensions", "version": "1.0.0", "description": "API surface for CAP-002 Commercial Banking relevant to JRN-018 Merchant Onboarding. Consumed by web portal (CH-001) for merchant self-service and internal tooling (CH-005) for bank staff."},
  "paths": {
    "/merchant-applications": {
      "post": {"operationId": "submitMerchantApplication", "summary": "Submit a new merchant acquiring application", "tags": ["Merchant"], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"company_name": {"type": "string"}, "company_registration_number": {"type": "string"}, "trading_name": {"type": "string"}, "mcc_code": {"type": "string"}, "estimated_monthly_volume": {"type": "number"}, "average_ticket_size": {"type": "number"}, "directors": {"type": "array"}, "ubos": {"type": "array"}, "settlement_account": {"type": "object"}, "terminal_type": {"type": "string"}}, "required": ["company_name", "company_registration_number", "mcc_code", "estimated_monthly_volume", "average_ticket_size"]}}}}, "responses": {"201": {"description": "Application created", "content": {"application/json": {"schema": {"type": "object", "properties": {"application_id": {"type": "string"}, "status": {"type": "string"}}}}}}, "400": {"description": "Validation error"}}},
      "get": {"operationId": "listMerchantApplications", "summary": "List merchant applications", "tags": ["Merchant"], "parameters": [{"name": "status", "in": "query", "schema": {"type": "string"}}], "responses": {"200": {"description": "List of applications"}}}
    },
    "/merchant-applications/{application_id}": {
      "get": {"operationId": "getMerchantApplication", "summary": "Get merchant application detail", "tags": ["Merchant"], "parameters": [{"name": "application_id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Application detail"}, "404": {"description": "Not found"}}}
    },
    "/merchant-applications/{application_id}/approve": {
      "post": {"operationId": "approveMerchant", "summary": "Approve a merchant application", "tags": ["Merchant"], "parameters": [{"name": "application_id", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"approved_by": {"type": "string"}, "notes": {"type": "string"}}}}}}, "responses": {"200": {"description": "Merchant approved"}, "400": {"description": "Prerequisites not met"}}}
    },
    "/merchant-applications/{application_id}/provision": {
      "post": {"operationId": "provisionTerminal", "summary": "Trigger terminal provisioning for an approved merchant", "tags": ["Merchant"], "parameters": [{"name": "application_id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"202": {"description": "Provisioning initiated"}, "400": {"description": "Merchant not in correct status"}}}
    }
  }
}
