{
  "openapi": "3.1.0",
  "info": {
    "title": "Payment Operations — International Payments API",
    "description": "International wire transfer API exposed by CAP-003 (Payment Operations) via SVC-010 (International Payments) for the JRN-009 International Wire Transfer journey. Consumed by the channel (SVC-017 Digital Channels / CH-003 Corporate Portal). Authentication via OAuth 2.0 with PKCE — the channel passes the corporate user's authenticated session token with dynamic linking (beneficiary IBAN, amount, currency embedded in the SCA assertion). Dual-authorisation flows require the second authoriser to call the same endpoints with their own SCA assertion.",
    "version": "1.0.0",
    "contact": {
      "name": "Payment Operations Team",
      "email": "payment-operations-api@bank.internal"
    },
    "x-service-id": "SVC-010",
    "x-capability-id": "CAP-003",
    "x-journey-ids": ["JRN-009"],
    "x-is-new-service": true
  },
  "servers": [
    {
      "url": "https://api.bank.internal/payment-operations/v1",
      "description": "Internal API gateway — channel-to-capability"
    }
  ],
  "security": [
    {
      "oauth2": ["transfers:write", "transfers:read"]
    }
  ],
  "x-event-driven-responsibilities": {
    "publishes": [
      "EVT-049 InternationalTransferInitiated — triggers concurrent sanctions (SVC-051) and fraud (SVC-013) checks",
      "EVT-050 FXQuoteProvided — cross-currency transfers only; quote presented to corporate user for acceptance",
      "EVT-053 TransferCleared — compliance checks passed; correspondent routing assembled; pacs.008 ready",
      "EVT-054 SWIFTMessageSent — pacs.008 submitted to SWIFT network via SAA Cloud",
      "EVT-055 CorrespondentAcknowledged — correspondent bank ACK received via gpi tracker",
      "EVT-056 TransferCompleted — SWIFT gpi ACCC confirmation received; beneficiary credited",
      "EVT-057 TransferFailed — transfer blocked (sanctions, fraud, FPS rejection, timeout)"
    ],
    "consumes": [
      "EVT-051 TransferSanctionsScreened (from SVC-051) — sanctions outcome for beneficiary and correspondent chain",
      "EVT-052 TransferFraudScored (from SVC-013) — corporate wire fraud score and risk level"
    ]
  },
  "paths": {
    "/international-transfers": {
      "post": {
        "operationId": "createInternationalTransfer",
        "summary": "Initiate an international wire transfer",
        "description": "Creates an InternationalTransfer (ENT-026) in status pending_compliance. SCA must have been completed by the channel before calling this endpoint — the channel passes the SCA assertion reference in the X-SCA-Token header. SVC-010 validates the SCA assertion against the transfer parameters (beneficiary IBAN, amount, currency) via SVC-100 before creating the transfer. On creation, publishes EVT-049 (InternationalTransferInitiated) to trigger concurrent compliance checks. For cross-currency transfers, returns an FX quotation that must be accepted before the transfer proceeds.",
        "tags": ["International Transfers"],
        "security": [{"oauth2": ["transfers:write"]}],
        "parameters": [
          {
            "name": "X-SCA-Token",
            "in": "header",
            "required": true,
            "description": "FIDO2/WebAuthn SCA assertion with dynamic linking (beneficiary IBAN, amount, currency bound to the assertion). Validated against SVC-100 before transfer creation.",
            "schema": {"type": "string"}
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Client-generated UUID v4. SVC-010 returns the same response for duplicate requests with the same key within 24 hours.",
            "schema": {"type": "string", "format": "uuid"}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/CreateInternationalTransferRequest"},
              "example": {
                "business_account_id": "7f3a1b2c-4d5e-6f7a-8b9c-0d1e2f3a4b5c",
                "beneficiary_name": "Müller GmbH",
                "beneficiary_iban": "DE89370400440532013000",
                "beneficiary_bic": "DEUTDEDB370",
                "beneficiary_bank_name": "Deutsche Bank AG",
                "beneficiary_bank_address": "Theodor-Heuss-Allee 70, 60486 Frankfurt, Germany",
                "amount": "50000.00",
                "currency": "EUR",
                "purpose_code": "SUPP",
                "payment_reference": "INV-2026-04-001",
                "charges_type": "SHA",
                "channel_session_id": "ch-sess-abc123"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transfer created — compliance checks in progress",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/InternationalTransferResponse"},
                "example": {
                  "transfer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                  "status": "pending_compliance",
                  "amount": "50000.00",
                  "currency": "EUR",
                  "gbp_equivalent": null,
                  "fx_quotation": null,
                  "beneficiary_name": "Müller GmbH",
                  "beneficiary_iban": "DE89370400440532013000",
                  "created_at": "2026-04-15T10:30:00Z",
                  "estimated_completion": "2026-04-16T17:00:00Z"
                }
              }
            }
          },
          "400": {
            "description": "Validation error — invalid IBAN, unsupported currency, amount exceeds limit",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}
          },
          "401": {
            "description": "SCA validation failed or session expired",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}
          },
          "409": {
            "description": "Duplicate idempotency key with conflicting parameters",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}
          },
          "422": {
            "description": "Business rule violation — insufficient funds, account not active, daily limit exceeded",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}
          }
        }
      },
      "get": {
        "operationId": "listInternationalTransfers",
        "summary": "List international transfers for the authenticated business account",
        "description": "Returns a paginated list of international transfers for the business account associated with the authenticated session. Supports filtering by status, date range, and currency.",
        "tags": ["International Transfers"],
        "security": [{"oauth2": ["transfers:read"]}],
        "parameters": [
          {
            "name": "business_account_id",
            "in": "query",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {"$ref": "#/components/schemas/TransferStatus"}
          },
          {
            "name": "from_date",
            "in": "query",
            "required": false,
            "schema": {"type": "string", "format": "date"}
          },
          {
            "name": "to_date",
            "in": "query",
            "required": false,
            "schema": {"type": "string", "format": "date"}
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Pagination cursor from previous response",
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of transfers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "transfers": {
                      "type": "array",
                      "items": {"$ref": "#/components/schemas/InternationalTransferSummary"}
                    },
                    "next_cursor": {"type": "string", "nullable": true},
                    "total_count": {"type": "integer"}
                  }
                }
              }
            }
          },
          "401": {"description": "Unauthorised", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
        }
      }
    },
    "/international-transfers/{transfer_id}": {
      "get": {
        "operationId": "getInternationalTransfer",
        "summary": "Get international transfer details and current status",
        "description": "Returns the full InternationalTransfer record including current status, FX quotation (if applicable), SWIFT reference, gpi UETR, and tracking information. Used by the channel to poll for compliance check completion and display transfer status to the corporate user.",
        "tags": ["International Transfers"],
        "security": [{"oauth2": ["transfers:read"]}],
        "parameters": [
          {
            "name": "transfer_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          }
        ],
        "responses": {
          "200": {
            "description": "Transfer details",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/InternationalTransferDetailResponse"},
                "example": {
                  "transfer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                  "status": "completed",
                  "amount": "50000.00",
                  "currency": "EUR",
                  "gbp_equivalent": "43250.00",
                  "fx_rate": "1.1560",
                  "beneficiary_name": "Müller GmbH",
                  "beneficiary_iban": "DE89370400440532013000",
                  "beneficiary_bic": "DEUTDEDB370",
                  "purpose_code": "SUPP",
                  "payment_reference": "INV-2026-04-001",
                  "charges_type": "SHA",
                  "swift_reference": "BKENGB21XXX2026041500001",
                  "gpi_uetr": "97ed4827-7b6f-4491-a06f-b548d5a7512d",
                  "created_at": "2026-04-15T10:30:00Z",
                  "compliance_cleared_at": "2026-04-15T10:30:12Z",
                  "swift_sent_at": "2026-04-15T10:30:45Z",
                  "completed_at": "2026-04-16T09:15:00Z"
                }
              }
            }
          },
          "404": {"description": "Transfer not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "401": {"description": "Unauthorised", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
        }
      }
    },
    "/international-transfers/{transfer_id}/cancel": {
      "post": {
        "operationId": "cancelInternationalTransfer",
        "summary": "Cancel an international transfer",
        "description": "Cancels an InternationalTransfer if it has not yet been submitted to SWIFT. Cancellation is only possible while status is pending_compliance or pending_fx_acceptance. Once status is swift_submitted or beyond, cancellation must follow the SWIFT gpi recall procedure (not covered by this endpoint). Requires SCA re-validation.",
        "tags": ["International Transfers"],
        "security": [{"oauth2": ["transfers:write"]}],
        "parameters": [
          {
            "name": "transfer_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          },
          {
            "name": "X-SCA-Token",
            "in": "header",
            "required": true,
            "description": "SCA assertion for the cancellation action",
            "schema": {"type": "string"}
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cancellation_reason": {"type": "string", "maxLength": 200}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transfer cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "transfer_id": {"type": "string", "format": "uuid"},
                    "status": {"type": "string", "enum": ["cancelled"]},
                    "cancelled_at": {"type": "string", "format": "date-time"}
                  }
                }
              }
            }
          },
          "409": {
            "description": "Transfer cannot be cancelled in its current status (already submitted to SWIFT)",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}
          },
          "401": {"description": "Unauthorised", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
        }
      }
    },
    "/international-transfers/{transfer_id}/tracking": {
      "get": {
        "operationId": "getTransferTracking",
        "summary": "Get SWIFT gpi tracking status for a submitted transfer",
        "description": "Returns SWIFT gpi tracker updates for a transfer that has been submitted to the SWIFT network. Provides the current gpi status code (ACSP — accepted and settled by correspondent; ACCC — confirmed credit to beneficiary; RJCT — rejected), each tracker update timestamp, and the correspondent chain processing status. Only available once status is swift_submitted or beyond.",
        "tags": ["International Transfers"],
        "security": [{"oauth2": ["transfers:read"]}],
        "parameters": [
          {
            "name": "transfer_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          }
        ],
        "responses": {
          "200": {
            "description": "SWIFT gpi tracking information",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/TransferTrackingResponse"},
                "example": {
                  "transfer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                  "gpi_uetr": "97ed4827-7b6f-4491-a06f-b548d5a7512d",
                  "current_status_code": "ACCC",
                  "tracking_updates": [
                    {"status_code": "ACSP", "agent_bic": "DEUTDEDB370", "timestamp": "2026-04-15T11:00:00Z", "description": "Accepted and processing by correspondent"},
                    {"status_code": "ACCC", "agent_bic": "DEUTDEDB370", "timestamp": "2026-04-16T09:15:00Z", "description": "Final credit confirmed to beneficiary"}
                  ],
                  "estimated_arrival": "2026-04-16T17:00:00Z"
                }
              }
            }
          },
          "404": {"description": "Transfer not found or not yet submitted to SWIFT", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
        }
      }
    },
    "/fx-quotations/{quote_id}": {
      "get": {
        "operationId": "getFXQuotation",
        "summary": "Get an FX quotation",
        "description": "Returns the FX quotation (ENT-027) for a cross-currency transfer. The quote includes the exchange rate, GBP equivalent, and validity period. The channel must display the quote to the corporate user before calling the accept endpoint.",
        "tags": ["FX Quotations"],
        "security": [{"oauth2": ["transfers:read"]}],
        "parameters": [
          {
            "name": "quote_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          }
        ],
        "responses": {
          "200": {
            "description": "FX quotation",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/FXQuotationResponse"},
                "example": {
                  "quote_id": "b2c3d4e5-f6a7-8901-bcde-f01234567891",
                  "transfer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                  "sell_currency": "GBP",
                  "buy_currency": "EUR",
                  "rate": "1.1560",
                  "gbp_amount": "43250.00",
                  "eur_amount": "50000.00",
                  "status": "pending_acceptance",
                  "valid_until": "2026-04-15T10:35:00Z",
                  "validity_seconds": 300,
                  "created_at": "2026-04-15T10:30:00Z"
                }
              }
            }
          },
          "404": {"description": "Quotation not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
        }
      }
    },
    "/fx-quotations/{quote_id}/accept": {
      "post": {
        "operationId": "acceptFXQuotation",
        "summary": "Accept an FX quotation to proceed with a cross-currency transfer",
        "description": "Accepts an FX quotation and binds the exchange rate to the InternationalTransfer. Must be called before the quote expires (validity_seconds from creation). Once accepted, the transfer proceeds to compliance checks and SWIFT submission using the accepted rate. If the quote has expired, a new quote is automatically generated and returned for re-acceptance.",
        "tags": ["FX Quotations"],
        "security": [{"oauth2": ["transfers:write"]}],
        "parameters": [
          {
            "name": "quote_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          }
        ],
        "responses": {
          "200": {
            "description": "Quotation accepted — transfer proceeds to compliance checks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "quote_id": {"type": "string", "format": "uuid"},
                    "transfer_id": {"type": "string", "format": "uuid"},
                    "status": {"type": "string", "enum": ["accepted"]},
                    "accepted_at": {"type": "string", "format": "date-time"},
                    "transfer_status": {"$ref": "#/components/schemas/TransferStatus"}
                  }
                }
              }
            }
          },
          "409": {
            "description": "Quote expired — new quotation generated",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {"$ref": "#/components/schemas/ErrorResponse"},
                    {
                      "type": "object",
                      "properties": {
                        "new_quotation": {"$ref": "#/components/schemas/FXQuotationResponse"}
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {"description": "Quotation not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://iam.bank.internal/oauth2/authorize",
            "tokenUrl": "https://iam.bank.internal/oauth2/token",
            "scopes": {
              "transfers:write": "Create and cancel international transfers",
              "transfers:read": "Read international transfer details and status"
            }
          }
        }
      }
    },
    "schemas": {
      "CreateInternationalTransferRequest": {
        "type": "object",
        "required": ["business_account_id", "beneficiary_name", "beneficiary_iban", "beneficiary_bic", "amount", "currency", "purpose_code", "charges_type"],
        "properties": {
          "business_account_id": {
            "type": "string",
            "format": "uuid",
            "description": "The originating BusinessAccount (ENT-080) identifier — must belong to the authenticated business customer"
          },
          "beneficiary_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140,
            "description": "Full legal name of the beneficiary — used for sanctions screening"
          },
          "beneficiary_iban": {
            "type": "string",
            "pattern": "^[A-Z]{2}[0-9]{2}[A-Z0-9]{1,30}$",
            "description": "Beneficiary IBAN — validated against ISO 13616 check digit algorithm"
          },
          "beneficiary_bic": {
            "type": "string",
            "pattern": "^[A-Z]{4}[A-Z]{2}[A-Z0-9]{2}([A-Z0-9]{3})?$",
            "description": "Beneficiary bank BIC (SWIFT code) — 8 or 11 characters"
          },
          "beneficiary_bank_name": {
            "type": "string",
            "maxLength": 140,
            "description": "Beneficiary bank name — included in pacs.008 CreditorAgent"
          },
          "beneficiary_bank_address": {
            "type": "string",
            "maxLength": 350,
            "description": "Beneficiary bank address — included in pacs.008 where required by SWIFT rulebook"
          },
          "amount": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "description": "Transfer amount as decimal string — in the requested currency"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "ISO 4217 currency code (e.g. EUR, USD, CHF)"
          },
          "purpose_code": {
            "type": "string",
            "maxLength": 4,
            "description": "ISO 20022 purpose code (e.g. SUPP for supplier payment, SALA for salary, TRAD for trade)"
          },
          "payment_reference": {
            "type": "string",
            "maxLength": 35,
            "description": "Unstructured payment reference included in pacs.008 RemittanceInformation"
          },
          "charges_type": {
            "type": "string",
            "enum": ["SHA", "OUR", "BEN"],
            "description": "SWIFT charges bearer: SHA (shared), OUR (originator bears all charges), BEN (beneficiary bears charges)"
          },
          "channel_session_id": {
            "type": "string",
            "description": "Channel session identifier — passed for fraud scoring behavioural context"
          }
        }
      },
      "InternationalTransferResponse": {
        "type": "object",
        "properties": {
          "transfer_id": {"type": "string", "format": "uuid"},
          "status": {"$ref": "#/components/schemas/TransferStatus"},
          "amount": {"type": "string", "description": "Transfer amount in requested currency"},
          "currency": {"type": "string"},
          "gbp_equivalent": {"type": "string", "nullable": true, "description": "GBP equivalent — populated after FX quotation"},
          "fx_quotation": {
            "nullable": true,
            "allOf": [{"$ref": "#/components/schemas/FXQuotationResponse"}],
            "description": "Present for cross-currency transfers; null for GBP transfers"
          },
          "beneficiary_name": {"type": "string"},
          "beneficiary_iban": {"type": "string"},
          "created_at": {"type": "string", "format": "date-time"},
          "estimated_completion": {"type": "string", "format": "date-time", "nullable": true}
        }
      },
      "InternationalTransferDetailResponse": {
        "allOf": [
          {"$ref": "#/components/schemas/InternationalTransferResponse"},
          {
            "type": "object",
            "properties": {
              "beneficiary_bic": {"type": "string"},
              "purpose_code": {"type": "string"},
              "payment_reference": {"type": "string"},
              "charges_type": {"type": "string", "enum": ["SHA", "OUR", "BEN"]},
              "fx_rate": {"type": "string", "nullable": true},
              "swift_reference": {"type": "string", "nullable": true, "description": "SWIFT end-to-end reference assigned by the SWIFT network"},
              "gpi_uetr": {"type": "string", "format": "uuid", "nullable": true, "description": "SWIFT gpi Unique End-to-End Transaction Reference"},
              "compliance_cleared_at": {"type": "string", "format": "date-time", "nullable": true},
              "swift_sent_at": {"type": "string", "format": "date-time", "nullable": true},
              "completed_at": {"type": "string", "format": "date-time", "nullable": true},
              "failure_reason": {
                "type": "string",
                "nullable": true,
                "enum": ["sanctions_review", "fraud_blocked", "swift_rejection", "compliance_timeout", null],
                "description": "Present on failed transfers. sanctions_review must not be surfaced as a customer-facing message — channel must map to generic decline text."
              }
            }
          }
        ]
      },
      "InternationalTransferSummary": {
        "type": "object",
        "properties": {
          "transfer_id": {"type": "string", "format": "uuid"},
          "status": {"$ref": "#/components/schemas/TransferStatus"},
          "beneficiary_name": {"type": "string"},
          "beneficiary_iban": {"type": "string"},
          "amount": {"type": "string"},
          "currency": {"type": "string"},
          "gbp_equivalent": {"type": "string", "nullable": true},
          "created_at": {"type": "string", "format": "date-time"},
          "completed_at": {"type": "string", "format": "date-time", "nullable": true}
        }
      },
      "FXQuotationResponse": {
        "type": "object",
        "properties": {
          "quote_id": {"type": "string", "format": "uuid"},
          "transfer_id": {"type": "string", "format": "uuid"},
          "sell_currency": {"type": "string", "description": "Currency being sold (typically GBP for UK-originating transfers)"},
          "buy_currency": {"type": "string", "description": "Currency being purchased (the transfer currency)"},
          "rate": {"type": "string", "description": "Exchange rate as decimal string — sell_currency per buy_currency"},
          "gbp_amount": {"type": "string", "description": "GBP debit amount"},
          "eur_amount": {"type": "string", "description": "Foreign currency credit amount"},
          "status": {"type": "string", "enum": ["pending_acceptance", "accepted", "expired"]},
          "valid_until": {"type": "string", "format": "date-time"},
          "validity_seconds": {"type": "integer", "description": "Quote validity window in seconds from creation"},
          "created_at": {"type": "string", "format": "date-time"},
          "accepted_at": {"type": "string", "format": "date-time", "nullable": true}
        }
      },
      "TransferTrackingResponse": {
        "type": "object",
        "properties": {
          "transfer_id": {"type": "string", "format": "uuid"},
          "gpi_uetr": {"type": "string", "format": "uuid"},
          "current_status_code": {
            "type": "string",
            "enum": ["ACSP", "ACCC", "RJCT"],
            "description": "ISO 20022 status code: ACSP (accepted, settled, processing); ACCC (accepted credit confirmation); RJCT (rejected)"
          },
          "tracking_updates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "status_code": {"type": "string"},
                "agent_bic": {"type": "string", "description": "BIC of the correspondent agent reporting this update"},
                "timestamp": {"type": "string", "format": "date-time"},
                "description": {"type": "string"}
              }
            }
          },
          "estimated_arrival": {"type": "string", "format": "date-time", "nullable": true}
        }
      },
      "TransferStatus": {
        "type": "string",
        "enum": [
          "pending_compliance",
          "pending_fx_acceptance",
          "compliance_cleared",
          "swift_submitted",
          "correspondent_acknowledged",
          "completed",
          "failed",
          "cancelled",
          "compliance_timeout"
        ],
        "description": "InternationalTransfer lifecycle status"
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error_code", "message"],
        "properties": {
          "error_code": {"type": "string", "description": "Machine-readable error code"},
          "message": {"type": "string", "description": "Human-readable error message"},
          "field_errors": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "object",
              "properties": {
                "field": {"type": "string"},
                "message": {"type": "string"}
              }
            }
          },
          "correlation_id": {"type": "string", "format": "uuid", "description": "Request correlation ID for support tracing"}
        }
      }
    }
  }
}
