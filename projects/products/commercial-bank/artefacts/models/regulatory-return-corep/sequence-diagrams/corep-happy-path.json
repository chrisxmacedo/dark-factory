{
  "journey_id": "JRN-017",
  "diagram_id": "SEQ-JRN017-001",
  "name": "COREP Capital Return — Happy Path (PH-088 through PH-092)",
  "description": "End-to-end sequence for the quarterly COREP capital adequacy return submission. Shows the cross-capability data flow from Risk Management (CAP-004) to Compliance & Regulatory (CAP-005) via domain events, the internal validation and sign-off workflow, and submission to PRA RegData.",
  "phases_covered": ["PH-088", "PH-089", "PH-090", "PH-091", "PH-092"],
  "participants": [
    {"id": "HEAD_REG_REPORTING", "type": "persona", "name": "Head of Regulatory Reporting (PER-059)", "channel": "CH-005"},
    {"id": "CRO", "type": "persona", "name": "CRO (PER-059 / SMF4)", "channel": "CH-005"},
    {"id": "CFO", "type": "persona", "name": "CFO (PER-059 / SMF2)", "channel": "CH-005"},
    {"id": "CH_005", "type": "channel", "name": "Internal Tooling (CH-005)"},
    {"id": "CAP_004", "type": "capability_api", "name": "CAP-004 Risk Management API"},
    {"id": "CAP_005", "type": "capability_api", "name": "CAP-005 Compliance & Regulatory API"},
    {"id": "EVENT_BUS", "type": "platform", "name": "Event Bus"},
    {"id": "SVC_103", "type": "platform", "name": "Audit & Logging (SVC-103)"},
    {"id": "SVC_111", "type": "platform", "name": "WORM Audit Store (SVC-111)"},
    {"id": "PRA_REGDATA", "type": "external", "name": "PRA RegData"}
  ],
  "steps": [
    {
      "step": 1,
      "phase": "PH-088",
      "from": "HEAD_REG_REPORTING",
      "to": "CH_005",
      "action": "Initiates COREP reporting cycle",
      "type": "user_action"
    },
    {
      "step": 2,
      "phase": "PH-088",
      "from": "CH_005",
      "to": "CAP_004",
      "action": "POST /capital-data-packages/{id}/trigger-extraction",
      "type": "sync_request",
      "data": "reporting_period, quarter_end_date"
    },
    {
      "step": 3,
      "phase": "PH-088",
      "from": "CAP_004",
      "to": "CH_005",
      "action": "202 Accepted — extraction initiated",
      "type": "sync_response"
    },
    {
      "step": 4,
      "phase": "PH-088",
      "from": "CAP_004",
      "to": "EVENT_BUS",
      "action": "Publish CapitalDataExtractionRequested (EVT-119)",
      "type": "async_event"
    },
    {
      "step": 5,
      "phase": "PH-088",
      "from": "CAP_004",
      "to": "SVC_103",
      "action": "Log extraction start with data lineage",
      "type": "platform_call"
    },
    {
      "step": 6,
      "phase": "PH-088",
      "from": "CAP_004",
      "to": "EVENT_BUS",
      "action": "Publish CreditRiskRWACalculated (EVT-120)",
      "type": "async_event",
      "note": "After credit risk calculation completes (~4 hours)"
    },
    {
      "step": 7,
      "phase": "PH-088",
      "from": "CAP_004",
      "to": "EVENT_BUS",
      "action": "Publish MarketRiskRWACalculated (EVT-121)",
      "type": "async_event",
      "note": "After market risk calculation completes (~2 hours)"
    },
    {
      "step": 8,
      "phase": "PH-088",
      "from": "CAP_004",
      "to": "EVENT_BUS",
      "action": "Publish OperationalRiskRWACalculated (EVT-122)",
      "type": "async_event",
      "note": "After operational risk calculation completes (~1 hour)"
    },
    {
      "step": 9,
      "phase": "PH-088",
      "from": "CAP_004",
      "to": "EVENT_BUS",
      "action": "Publish CapitalDataPackageAssembled (EVT-123)",
      "type": "async_event",
      "note": "Aggregate package with all RWA figures and data lineage"
    },
    {
      "step": 10,
      "phase": "PH-088",
      "from": "CRO",
      "to": "CH_005",
      "action": "Reviews RWA calculation outputs",
      "type": "user_action"
    },
    {
      "step": 11,
      "phase": "PH-088",
      "from": "CH_005",
      "to": "CAP_004",
      "action": "GET /capital-data-packages/{id}",
      "type": "sync_request"
    },
    {
      "step": 12,
      "phase": "PH-088",
      "from": "CAP_004",
      "to": "CH_005",
      "action": "200 OK — capital data package detail",
      "type": "sync_response"
    },
    {
      "step": 13,
      "phase": "PH-089",
      "from": "EVENT_BUS",
      "to": "CAP_005",
      "action": "Deliver CapitalDataPackageAssembled (EVT-123)",
      "type": "async_event",
      "note": "Cross-capability data flow: CAP-004 → Event Bus → CAP-005"
    },
    {
      "step": 14,
      "phase": "PH-089",
      "from": "CAP_005",
      "to": "SVC_103",
      "action": "Log capital data receipt and consolidation start",
      "type": "platform_call"
    },
    {
      "step": 15,
      "phase": "PH-089",
      "from": "CAP_005",
      "to": "EVENT_BUS",
      "action": "Publish COREPReturnDraftGenerated (EVT-124)",
      "type": "async_event",
      "note": "After automated mapping + manual classification complete"
    },
    {
      "step": 16,
      "phase": "PH-090",
      "from": "HEAD_REG_REPORTING",
      "to": "CH_005",
      "action": "Triggers validation",
      "type": "user_action"
    },
    {
      "step": 17,
      "phase": "PH-090",
      "from": "CH_005",
      "to": "CAP_005",
      "action": "POST /corep-returns/{id}/validate",
      "type": "sync_request"
    },
    {
      "step": 18,
      "phase": "PH-090",
      "from": "CAP_005",
      "to": "CH_005",
      "action": "202 Accepted — validation initiated",
      "type": "sync_response"
    },
    {
      "step": 19,
      "phase": "PH-090",
      "from": "CAP_005",
      "to": "SVC_103",
      "action": "Log validation results (XBRL, variance, GL reconciliation)",
      "type": "platform_call"
    },
    {
      "step": 20,
      "phase": "PH-090",
      "from": "CAP_005",
      "to": "EVENT_BUS",
      "action": "Publish COREPValidationCompleted (EVT-125) — outcome: PASS",
      "type": "async_event"
    },
    {
      "step": 21,
      "phase": "PH-091",
      "from": "CFO",
      "to": "CH_005",
      "action": "Reviews return and signs attestation",
      "type": "user_action"
    },
    {
      "step": 22,
      "phase": "PH-091",
      "from": "CH_005",
      "to": "CAP_005",
      "action": "POST /corep-returns/{id}/signoff",
      "type": "sync_request",
      "data": "signer_identity, attestation_statement"
    },
    {
      "step": 23,
      "phase": "PH-091",
      "from": "CAP_005",
      "to": "SVC_111",
      "action": "Store CFO attestation in WORM audit store",
      "type": "platform_call"
    },
    {
      "step": 24,
      "phase": "PH-091",
      "from": "CAP_005",
      "to": "CH_005",
      "action": "200 OK — sign-off recorded",
      "type": "sync_response"
    },
    {
      "step": 25,
      "phase": "PH-091",
      "from": "CAP_005",
      "to": "EVENT_BUS",
      "action": "Publish COREPReturnApproved (EVT-126)",
      "type": "async_event"
    },
    {
      "step": 26,
      "phase": "PH-091",
      "from": "HEAD_REG_REPORTING",
      "to": "CH_005",
      "action": "Triggers PRA submission",
      "type": "user_action"
    },
    {
      "step": 27,
      "phase": "PH-091",
      "from": "CH_005",
      "to": "CAP_005",
      "action": "POST /corep-returns/{id}/submit",
      "type": "sync_request"
    },
    {
      "step": 28,
      "phase": "PH-091",
      "from": "CAP_005",
      "to": "PRA_REGDATA",
      "action": "Submit COREP XBRL return",
      "type": "external_call"
    },
    {
      "step": 29,
      "phase": "PH-091",
      "from": "PRA_REGDATA",
      "to": "CAP_005",
      "action": "Submission acknowledgement with reference number",
      "type": "external_response"
    },
    {
      "step": 30,
      "phase": "PH-091",
      "from": "CAP_005",
      "to": "SVC_111",
      "action": "Store submission confirmation in WORM audit store",
      "type": "platform_call"
    },
    {
      "step": 31,
      "phase": "PH-091",
      "from": "CAP_005",
      "to": "EVENT_BUS",
      "action": "Publish COREPReturnSubmitted (EVT-127)",
      "type": "async_event"
    },
    {
      "step": 32,
      "phase": "PH-091",
      "from": "CAP_005",
      "to": "EVENT_BUS",
      "action": "Publish COREPReturnAcknowledged (EVT-128)",
      "type": "async_event"
    },
    {
      "step": 33,
      "phase": "PH-092",
      "from": "CAP_005",
      "to": "SVC_103",
      "action": "Log post-submission monitoring period start",
      "type": "platform_call",
      "note": "Monitoring continues until next quarter submission"
    }
  ]
}
