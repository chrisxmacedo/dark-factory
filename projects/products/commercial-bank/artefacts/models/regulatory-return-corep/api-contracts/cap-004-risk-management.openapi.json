{
  "openapi": "3.1.0",
  "info": {
    "title": "Risk Management Capability API — COREP Capital Extensions",
    "version": "1.0.0",
    "description": "API surface for the Risk Management capability (CAP-004) relevant to the COREP regulatory return journey (JRN-017). This API is consumed by internal tooling channels (CH-005) for monitoring RWA calculation progress and reviewing capital data packages. Cross-capability data flow to CAP-005 is exclusively via domain events, not this API."
  },
  "servers": [
    {
      "url": "https://api.internal.bank.example/risk-management/v1",
      "description": "Internal API — not externally accessible"
    }
  ],
  "paths": {
    "/capital-data-packages": {
      "get": {
        "operationId": "listCapitalDataPackages",
        "summary": "List capital data packages",
        "description": "Returns a list of capital data packages filtered by reporting period. Used by the CRO and Head of Regulatory Reporting to review RWA calculation outputs.",
        "tags": ["Capital Data"],
        "parameters": [
          {
            "name": "reporting_period",
            "in": "query",
            "required": false,
            "schema": {"type": "string", "example": "2026-Q1"},
            "description": "Filter by reporting period"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {"type": "string", "enum": ["CALCULATING", "ASSEMBLED", "SUBMITTED_TO_REPORTING", "SUPERSEDED"]}
          }
        ],
        "responses": {
          "200": {
            "description": "List of capital data packages",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {"$ref": "#/components/schemas/CapitalDataPackageSummary"}
                },
                "example": [
                  {
                    "package_id": "cdp-2026-q1-001",
                    "reporting_period": "2026-Q1",
                    "quarter_end_date": "2026-03-31",
                    "total_rwa": 18500000000.00,
                    "status": "ASSEMBLED",
                    "created_at": "2026-04-02T06:30:00Z"
                  }
                ]
              }
            }
          },
          "401": {"description": "Unauthorized — valid internal service token required"},
          "403": {"description": "Forbidden — caller does not have risk-management.capital-data.read permission"}
        },
        "security": [{"internalMTLS": []}]
      }
    },
    "/capital-data-packages/{package_id}": {
      "get": {
        "operationId": "getCapitalDataPackage",
        "summary": "Get capital data package detail",
        "description": "Returns the full detail of a capital data package including RWA breakdown by risk type, output floor analysis, and data lineage. Used by the CRO for review before handover to Regulatory Reporting.",
        "tags": ["Capital Data"],
        "parameters": [
          {
            "name": "package_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "Capital data package detail",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/CapitalDataPackage"},
                "example": {
                  "package_id": "cdp-2026-q1-001",
                  "reporting_period": "2026-Q1",
                  "quarter_end_date": "2026-03-31",
                  "credit_risk_rwa": 12000000000.00,
                  "credit_risk_approach": "MIXED",
                  "output_floor_applied": true,
                  "output_floor_percentage": 55.0,
                  "market_risk_rwa": 1500000000.00,
                  "operational_risk_capital": 400000000.00,
                  "total_rwa": 18500000000.00,
                  "data_lineage": {
                    "loan_book_extract_id": "ext-lb-2026q1-001",
                    "trading_book_extract_id": "ext-tb-2026q1-001",
                    "op_loss_extract_id": "ext-ol-2026q1-001",
                    "extraction_timestamp": "2026-04-01T22:00:00Z"
                  },
                  "status": "ASSEMBLED",
                  "created_at": "2026-04-02T06:30:00Z"
                }
              }
            }
          },
          "404": {"description": "Capital data package not found"},
          "401": {"description": "Unauthorized"},
          "403": {"description": "Forbidden"}
        },
        "security": [{"internalMTLS": []}]
      }
    },
    "/capital-data-packages/{package_id}/trigger-extraction": {
      "post": {
        "operationId": "triggerCapitalDataExtraction",
        "summary": "Trigger capital data extraction and RWA calculation",
        "description": "Initiates the quarterly capital data extraction and RWA calculation pipeline. Called by the Head of Regulatory Reporting via internal tooling to start the reporting cycle. Publishes a CapitalDataExtractionRequested event.",
        "tags": ["Capital Data"],
        "parameters": [
          {
            "name": "package_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reporting_period": {"type": "string", "example": "2026-Q1"},
                  "quarter_end_date": {"type": "string", "format": "date", "example": "2026-03-31"},
                  "requested_by": {"type": "string", "description": "Identity of the requesting user"}
                },
                "required": ["reporting_period", "quarter_end_date", "requested_by"]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Extraction accepted — processing asynchronously",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "package_id": {"type": "string"},
                    "status": {"type": "string", "enum": ["CALCULATING"]},
                    "estimated_completion_hours": {"type": "integer"}
                  }
                }
              }
            }
          },
          "409": {"description": "Extraction already in progress for this reporting period"},
          "401": {"description": "Unauthorized"},
          "403": {"description": "Forbidden — caller does not have risk-management.capital-data.trigger permission"}
        },
        "security": [{"internalMTLS": []}]
      }
    }
  },
  "components": {
    "schemas": {
      "CapitalDataPackageSummary": {
        "type": "object",
        "properties": {
          "package_id": {"type": "string"},
          "reporting_period": {"type": "string"},
          "quarter_end_date": {"type": "string", "format": "date"},
          "total_rwa": {"type": "number"},
          "status": {"type": "string", "enum": ["CALCULATING", "ASSEMBLED", "SUBMITTED_TO_REPORTING", "SUPERSEDED"]},
          "created_at": {"type": "string", "format": "date-time"}
        }
      },
      "CapitalDataPackage": {
        "type": "object",
        "properties": {
          "package_id": {"type": "string"},
          "reporting_period": {"type": "string"},
          "quarter_end_date": {"type": "string", "format": "date"},
          "credit_risk_rwa": {"type": "number"},
          "credit_risk_approach": {"type": "string", "enum": ["STANDARDISED", "IRB_FOUNDATION", "IRB_ADVANCED", "MIXED"]},
          "output_floor_applied": {"type": "boolean"},
          "output_floor_percentage": {"type": "number"},
          "market_risk_rwa": {"type": "number"},
          "operational_risk_capital": {"type": "number"},
          "total_rwa": {"type": "number"},
          "data_lineage": {
            "type": "object",
            "properties": {
              "loan_book_extract_id": {"type": "string"},
              "trading_book_extract_id": {"type": "string"},
              "op_loss_extract_id": {"type": "string"},
              "extraction_timestamp": {"type": "string", "format": "date-time"}
            }
          },
          "status": {"type": "string"},
          "created_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "securitySchemes": {
      "internalMTLS": {
        "type": "mutualTLS",
        "description": "Internal service-to-service authentication via mutual TLS. Only internal tooling channels (CH-005) and authorised services may call this API."
      }
    }
  }
}
