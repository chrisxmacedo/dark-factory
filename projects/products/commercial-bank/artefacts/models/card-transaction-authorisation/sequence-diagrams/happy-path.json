{
  "diagram_id": "SEQ-JRN011-001",
  "journey_id": "JRN-011",
  "name": "Card Transaction Authorisation — Happy Path",
  "description": "Happy path sequence for an approved debit card transaction. Cardholder presents card at merchant. Card network sends ISO 8583 authorisation request. SVC-011 makes local decision using cached balance, card status, and fraud rules. Decision: APPROVED. Response returned to card network within 500ms. Post-auth: balance reservation applied by SVC-001 asynchronously. End of day: clearing matched, CardSettlement created, final ledger debit posted.",
  "phases_covered": ["PH-041", "PH-042", "PH-043", "PH-044", "PH-045"],
  "participants": [
    {"id": "CN", "label": "Card Network (PER-009 / Visa/MC)", "type": "external_system"},
    {"id": "SVC011", "label": "SVC-011 Card Processing", "type": "service"},
    {"id": "CACHE", "label": "SVC-011 Local Cache", "type": "internal_component"},
    {"id": "BUS", "label": "SVC-102 Event Bus", "type": "infrastructure"},
    {"id": "SVC013", "label": "SVC-013 Fraud Detection", "type": "service"},
    {"id": "SVC001", "label": "SVC-001 Retail Banking Core", "type": "service"},
    {"id": "SVC003", "label": "SVC-003 Credit Card Service", "type": "service"},
    {"id": "SVC103", "label": "SVC-103 Audit & Logging", "type": "service"},
    {"id": "SVC009", "label": "SVC-009 Domestic Payments", "type": "service"}
  ],
  "steps": [
    {"step": 1, "phase": "PH-041", "from": "CN", "to": "SVC011", "type": "sync", "label": "ISO 8583 / ISO 20022 Auth Request (PAN encrypted in transit)", "latency_ms": 10},
    {"step": 2, "phase": "PH-041", "from": "SVC011", "to": "SVC011", "type": "internal", "label": "Tokenise PAN → card_number_token (PAN stays in PCI CDE only)"},
    {"step": 3, "phase": "PH-041", "from": "SVC011", "to": "BUS", "type": "async", "label": "EVT-064 CardAuthorisationRequested (card_number_token, NOT PAN)"},
    {"step": 4, "phase": "PH-041", "from": "BUS", "to": "SVC103", "type": "async", "label": "EVT-064 (audit log — WORM)"},
    {"step": 5, "phase": "PH-042", "from": "SVC011", "to": "CACHE", "type": "sync", "label": "Lookup card_status[card_number_token]", "latency_ms": 2},
    {"step": 6, "phase": "PH-042", "from": "CACHE", "to": "SVC011", "type": "sync", "label": "status = active ✓"},
    {"step": 7, "phase": "PH-042", "from": "SVC011", "to": "CACHE", "type": "sync", "label": "Lookup balance[account_id]", "latency_ms": 2},
    {"step": 8, "phase": "PH-042", "from": "CACHE", "to": "SVC011", "type": "sync", "label": "available_balance = £1,200 (> £42.50) ✓"},
    {"step": 9, "phase": "PH-042", "from": "SVC011", "to": "CACHE", "type": "sync", "label": "Evaluate fraud rules[card_number_token, MCC, velocity]", "latency_ms": 30},
    {"step": 10, "phase": "PH-042", "from": "CACHE", "to": "SVC011", "type": "sync", "label": "All rules PASS ✓"},
    {"step": 11, "phase": "PH-042", "from": "SVC011", "to": "SVC011", "type": "internal", "label": "Check 3DS result from request = authenticated ✓"},
    {"step": 12, "phase": "PH-042", "from": "SVC011", "to": "SVC011", "type": "internal", "label": "Decision: APPROVED. Generate auth_code, record processing_time_ms"},
    {"step": 13, "phase": "PH-043", "from": "SVC011", "to": "CN", "type": "sync", "label": "ISO 8583 Response: Action Code 00, auth_code = 'A1B2C3'", "cumulative_latency_note": "< 500ms elapsed"},
    {"step": 14, "phase": "PH-043", "from": "SVC011", "to": "BUS", "type": "async", "label": "EVT-065 CardAuthorisationCompleted (auth_id, card_number_token, customer_id, card_type=debit, amount=42.50, auth_code)"},
    {"step": 15, "phase": "PH-043", "from": "BUS", "to": "SVC103", "type": "async", "label": "EVT-065 (WORM audit)"},
    {"step": 16, "phase": "PH-044", "from": "BUS", "to": "SVC013", "type": "async", "label": "EVT-065 (fraud pattern learning)"},
    {"step": 17, "phase": "PH-044", "from": "SVC013", "to": "SVC013", "type": "internal", "label": "Update velocity counters, enrich behaviour model → No anomaly detected"},
    {"step": 18, "phase": "PH-044", "from": "BUS", "to": "SVC001", "type": "async", "label": "EVT-065 (card_type=debit → balance reservation)"},
    {"step": 19, "phase": "PH-044", "from": "SVC001", "to": "SVC001", "type": "internal", "label": "Decrement Account.available_balance by £42.50. Create balance reservation (auth_id key). Within 2 seconds ✓"},
    {"step": 20, "phase": "PH-045", "from": "CN", "to": "SVC011", "type": "async_batch", "label": "End-of-day clearing file (settled transactions)"},
    {"step": 21, "phase": "PH-045", "from": "SVC011", "to": "SVC011", "type": "internal", "label": "Match clearing item → ENT-032 (auth_id). Create ENT-033 CardSettlement (settlement_amount, interchange_fee, scheme_fee)"},
    {"step": 22, "phase": "PH-045", "from": "SVC011", "to": "BUS", "type": "async", "label": "EVT-067 CardSettlementProcessed (settlement_id, auth_id, card_number_token, settlement_amount)"},
    {"step": 23, "phase": "PH-045", "from": "BUS", "to": "SVC001", "type": "async", "label": "EVT-067 (card_type=debit → final ledger debit)"},
    {"step": 24, "phase": "PH-045", "from": "SVC001", "to": "SVC001", "type": "internal", "label": "Post final debit to Account ledger. Release balance reservation. Update available_balance."},
    {"step": 25, "phase": "PH-045", "from": "BUS", "to": "SVC103", "type": "async", "label": "EVT-067 (WORM audit)"},
    {"step": 26, "phase": "PH-045", "from": "SVC011", "to": "SVC009", "type": "sync", "label": "POST /payments (CHAPS/BACS settlement — intra-capability sync CAP-003 → CAP-003)"},
    {"step": 27, "phase": "PH-045", "from": "SVC009", "to": "SVC011", "type": "sync", "label": "Settlement funds movement confirmed"}
  ],
  "timing_notes": {
    "sync_authorisation_path_p99": "< 500ms (steps 1-13)",
    "balance_reservation_p99": "< 2 seconds after step 14 (step 19)",
    "fraud_model_update_p99": "< 5 seconds after step 14 (step 17)",
