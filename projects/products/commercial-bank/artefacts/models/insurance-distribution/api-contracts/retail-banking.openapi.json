{
  "openapi": "3.1.0",
  "info": {
    "title": "Retail Banking — Insurance Distribution API",
    "description": "Insurance product distribution API exposed by SVC-004 (Insurance Distribution Service) for JRN-030. Consumed by SVC-017 (Digital Channels) on behalf of authenticated customers. Requires insurance:write scope.",
    "version": "1.0.0",
    "x-service-id": "SVC-004",
    "x-capability-id": "CAP-001",
    "x-journey-ids": ["JRN-030"]
  },
  "servers": [{"url": "https://api.bank.internal/retail/v1", "description": "Internal — production"}],
  "security": [{"BearerAuth": []}],
  "paths": {
    "/insurance/target-market-assessment": {
      "post": {
        "operationId": "runTargetMarketAssessment",
        "summary": "Perform target market and fair value assessment",
        "description": "Evaluates whether the customer is within the defined target market for the insurance product and whether the product provides fair value (FCA PROD). Returns IPID and Key Features Document reference.",
        "tags": ["Insurance Distribution"],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TargetMarketAssessmentRequest"}}}},
        "responses": {
          "200": {"description": "Assessment complete", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TargetMarketAssessmentResponse"}}}},
          "400": {"description": "Validation error"}
        }
      }
    },
    "/insurance/policies": {
      "post": {
        "operationId": "bindInsurancePolicy",
        "summary": "Bind insurance policy with underwriter",
        "description": "Customer accepts IPID and Key Features Document. Policy bound with underwriter. InsurancePolicy created. Publishes InsurancePolicyBound (EVT-167). Returns policy number and certificate.",
        "tags": ["Insurance Distribution"],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BindPolicyRequest"}}}},
        "responses": {
          "201": {"description": "Policy bound", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PolicyBindingResponse"}}}},
          "422": {"description": "Customer outside target market — cannot bind policy"},
          "503": {"description": "Underwriter API unavailable"}
        }
      }
    },
    "/insurance/policies/{policy_id}": {
      "delete": {
        "operationId": "cancelInsurancePolicy",
        "summary": "Cancel insurance policy (customer-initiated)",
        "description": "Customer cancels insurance policy. Policy status set to cancelled. Account fee reverted.",
        "tags": ["Insurance Distribution"],
        "parameters": [{"name": "policy_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
        "responses": {
          "204": {"description": "Policy cancelled"},
          "404": {"description": "Policy not found"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TargetMarketAssessmentRequest": {
        "type": "object",
        "required": ["customer_id", "account_id", "product_type"],
        "properties": {
          "customer_id": {"type": "string", "format": "uuid"},
          "account_id": {"type": "string", "format": "uuid"},
          "product_type": {"type": "string", "enum": ["travel", "home_buildings", "home_contents", "life_term", "packaged_bundle"]}
        }
      },
      "TargetMarketAssessmentResponse": {
        "type": "object",
        "properties": {
          "target_market_result": {"type": "string", "enum": ["within_target_market", "outside_target_market"]},
          "fair_value_result": {"type": "string", "enum": ["fair_value", "insufficient_value"]},
          "ipid_document_ref": {"type": "string", "description": "Reference to IPID document for customer review"},
          "key_features_doc_ref": {"type": "string"},
          "annual_premium_indicative": {"type": "string", "nullable": true}
        }
      },
      "BindPolicyRequest": {
        "type": "object",
        "required": ["customer_id", "account_id", "product_type", "ipid_acknowledged"],
        "properties": {
          "customer_id": {"type": "string", "format": "uuid"},
          "account_id": {"type": "string", "format": "uuid"},
          "product_type": {"type": "string", "enum": ["travel", "home_buildings", "home_contents", "life_term", "packaged_bundle"]},
          "ipid_acknowledged": {"type": "boolean", "description": "Customer confirmed they have read and understood the IPID — required for ICOBS compliance"}
        }
      },
      "PolicyBindingResponse": {
        "type": "object",
        "properties": {
          "policy_id": {"type": "string", "format": "uuid"},
          "underwriter_policy_ref": {"type": "string"},
          "status": {"type": "string", "enum": ["active"]},
          "start_date": {"type": "string", "format": "date"},
          "end_date": {"type": "string", "format": "date"},
          "certificate_url": {"type": "string", "description": "Secure URL for certificate of insurance download"}
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}
    }
  }
}
