        {
          "step": 11,
          "from": "CAP001",
          "to": "EB",
          "type": "async",
          "label": "Publish EVT-167 InsurancePolicyBound",
          "data": {
            "event_id": "EVT-167",
            "insurance_policy_id": "pol-20260415-8841293",
            "customer_id": "cust-99012",
            "policy_number": "AVP-2026-8841293",
            "underwriter": "Aviva",
            "product_id": "PREM-TRAVEL-001",
            "status": "active",
            "bound_at": "2026-04-15T10:22:51Z"
          }
        },
        {
          "step": 12,
          "from": "CAP001",
          "to": "Channel",
          "type": "response",
          "label": "201 Created { policy_id, policy_number, status: active }",
          "data": {
            "policy_id": "pol-20260415-8841293",
            "policy_number": "AVP-2026-8841293",
            "status": "active"
          }
        },
        {
          "step": 13,
          "from": "Channel",
          "to": "PER001",
          "type": "response",
          "label": "Policy confirmed — certificate of insurance will be sent by email"
        }
      ]
    },
    {
      "phase_id": "PH-138",
      "name": "Account Fee Update and Consumer Duty Recording",
      "steps": [
        {
          "step": 14,
          "from": "EB",
          "to": "CAP001",
          "type": "async",
          "label": "Consume EVT-167 InsurancePolicyBound (intra-CAP-001: SVC-001 upgrades account fee)",
          "note": "SVC-001 and SVC-004 are both within CAP-001 — intra-capability event consumption"
        },
        {
          "step": 15,
          "from": "CAP001",
          "to": "CAP001",
          "type": "internal",
          "label": "Upgrade account to Premier: set monthly_fee=18.50, product_type=premier_bundle; save Consumer Duty evidence trail",
          "data": {
            "account_id": "acc-cust-99012-001",
            "product_type": "premier_bundle",
            "monthly_fee_gbp": 18.50,
            "consumer_duty_evidence": {
              "target_market_assessment": "within_target_market",
              "fair_value_assessment": "pass",
              "ipid_acknowledged": true,
              "policy_binding_ref": "AVP-2026-8841293",
              "evidence_ref": "FV-2026-04-15-0042"
            }
          }
        },
        {
          "step": 16,
          "from": "EB",
          "to": "Channel",
          "type": "async",
          "label": "Consume EVT-167 InsurancePolicyBound (CAP-007: display active insurance in app)"
        },
        {
          "step": 17,
          "from": "EB",
          "to": "EB",
          "type": "async",
          "label": "Route EVT-167 to Notifications (SVC-053): dispatch certificate of insurance email to customer",
          "note": "Platform service (notifications) — not a cross-capability violation"
        },
        {
          "step": 18,
          "from": "EB",
          "to": "EB",
          "type": "async",
          "label": "Route EVT-167 to Audit & Logging (SVC-103): write immutable insurance distribution record (FCA PROD Consumer Duty evidence)"
        }
      ]
    }
  ],
  "exit_state": {
    "InsurancePolicy_status": "active",
    "policy_number": "AVP-2026-8841293",
    "account_product_type": "premier_bundle",
