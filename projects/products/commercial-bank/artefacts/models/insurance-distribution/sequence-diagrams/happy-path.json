{
  "journey_id": "JRN-030",
  "diagram_id": "JRN-030-SEQ-001",
  "name": "Insurance Product Distribution (Packaged Account) — Happy Path",
  "path_type": "happy_path",
  "description": "Personal customer selects Premier Account upgrade (including Aviva travel insurance) in the mobile app. Target market assessment and fair value check pass. Customer reviews IPID and Key Features Document and accepts. Policy is bound with Aviva. Account is upgraded to Premier with insurance bundle fee. Consumer Duty evidence trail is saved.",
  "participants": [
    {
      "id": "PER001",
      "label": "PER-001\nPersonal Customer",
      "type": "actor"
    },
    {
      "id": "Channel",
      "label": "Channel\nMobile App (CAP-007)",
      "type": "participant"
    },
    {
      "id": "CAP001",
      "label": "CAP-001 API\nRetail Banking",
      "type": "participant"
    },
    {
      "id": "EB",
      "label": "Event Bus\nSVC-102",
      "type": "participant"
    }
  ],
  "phases": [
    {
      "phase_id": "PH-136",
      "name": "Target Market Assessment and Fair Value Check",
      "steps": [
        {
          "step": 1,
          "from": "PER001",
          "to": "Channel",
          "type": "sync",
          "label": "Select Premier Account upgrade in mobile app",
          "data": {
            "account_type": "premier",
            "customer_id": "cust-99012"
          }
        },
        {
          "step": 2,
          "from": "Channel",
          "to": "CAP001",
          "type": "sync",
          "label": "POST /insurance/target-market-assessment",
          "data": {
            "customer_id": "cust-99012",
            "product_id": "PREM-TRAVEL-001",
            "underwriter": "Aviva"
          }
        },
        {
          "step": 3,
          "from": "CAP001",
          "to": "CAP001",
          "type": "internal",
          "label": "Run FCA PROD target market assessment: age 18-75, UK resident, frequent traveller criteria",
          "data": {
            "customer_age": 34,
            "residency": "UK",
            "travel_frequency": "frequent",
            "assessment_result": "within_target_market"
          }
        },
        {
          "step": 4,
          "from": "CAP001",
          "to": "CAP001",
          "type": "internal",
          "label": "Run fair value assessment: premium vs cover ratio check",
          "data": {
            "annual_premium_gbp": 180.00,
            "cover_value_gbp": 10000000,
            "fair_value_result": "pass",
            "consumer_duty_evidence_ref": "FV-2026-04-15-0042"
          }
        },
        {
          "step": 5,
          "from": "CAP001",
          "to": "Channel",
          "type": "response",
          "label": "200 OK { assessment_result: within_target_market, fair_value: pass, ipid_url, kfd_url }",
          "data": {
            "assessment_result": "within_target_market",
            "fair_value": "pass",
            "ipid_url": "https://docs.bank.internal/ipid/PREM-TRAVEL-001.pdf",
            "kfd_url": "https://docs.bank.internal/kfd/PREM-TRAVEL-001.pdf",
            "consumer_duty_evidence_ref": "FV-2026-04-15-0042"
          }
        },
        {
          "step": 6,
          "from": "Channel",
          "to": "PER001",
          "type": "response",
          "label": "Display IPID and Key Features Document for review",
          "note": "Customer must review IPID per ICOBS. Confirmation of understanding required before acceptance."
        }
      ]
    },
    {
      "phase_id": "PH-137",
      "name": "Customer Acceptance and Policy Binding",
      "steps": [
        {
          "step": 7,
          "from": "PER001",
          "to": "Channel",
          "type": "sync",
          "label": "Confirm acceptance of insurance terms (IPID acknowledged)",
          "data": {
            "ipid_acknowledged": true,
            "kfd_acknowledged": true,
            "accepted_at": "2026-04-15T10:22:34Z"
          }
        },
        {
          "step": 8,
          "from": "Channel",
          "to": "CAP001",
          "type": "sync",
          "label": "POST /insurance/policies { customer_id, product_id, ipid_acknowledged: true }",
          "data": {
            "customer_id": "cust-99012",
            "product_id": "PREM-TRAVEL-001",
            "ipid_acknowledged": true,
            "accepted_at": "2026-04-15T10:22:34Z"
          }
        },
        {
          "step": 9,
          "from": "CAP001",
          "to": "CAP001",
          "type": "internal",
          "label": "Bind policy with Aviva (external API call — internal to CAP-001)",
          "data": {
            "underwriter": "Aviva",
            "policy_holder": "cust-99012",
            "product": "PREM-TRAVEL-001",
            "aviva_policy_number": "AVP-2026-8841293",
            "status": "active"
          }
        },
        {
          "step": 10,
          "from": "CAP001",
          "to": "CAP001",
          "type": "internal",
          "label": "Create InsurancePolicy (ENT-078): status=active, policy_number=AVP-2026-8841293"
