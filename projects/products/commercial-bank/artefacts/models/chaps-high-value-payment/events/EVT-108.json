{
  "event_id": "EVT-108",
  "name": "CHAPSPaymentIntentCreated",
  "source_service": "SVC-001",
  "source_service_name": "Retail Banking Core",
  "source_entity": "ENT-053",
  "source_entity_name": "CHAPSPaymentIntent",
  "trigger": "PER-001 submits a CHAPS payment instruction via CH-001 or CH-002. SVC-001 creates CHAPSPaymentIntent (ENT-053) with status=initiated. Published immediately on creation before CoP check.",
  "journey_phase": "PH-077",
  "journey_phase_name": "Payment Initiation",
  "capability_scope": "cross-capability",
  "capability_scope_rationale": "Published by CAP-001 (SVC-001); consumed by CAP-003 (SVC-009) for CoP orchestration and CAP-005 (SVC-014) for sanctions screening. Crosses CAP-001 → CAP-003 and CAP-001 → CAP-005.",
  "payload_schema": {
    "chaps_intent_id": "string (UUID v4) — CHAPSPaymentIntent identifier",
    "customer_id": "string (UUID v4)",
    "account_id": "string (UUID v4) — source account (ENT-004)",
    "beneficiary_sort_code": "string — 6-digit sort code",
    "beneficiary_account_number": "string — 8-digit account number",
    "beneficiary_name": "string — max 140 chars",
    "beneficiary_lei": "string (nullable) — ISO 17442 LEI for corporate beneficiaries",
    "amount_gbp": "decimal — payment amount",
    "purpose_code": "string — ISO 20022 ExternalPurpose1Code (e.g. PROP)",
    "payment_reference": "string — max 35 chars",
    "is_mortgage_completion_payment": "boolean",
    "mortgage_account_id": "string (UUID v4, nullable)",
    "enhanced_monitoring_flag": "boolean — true when amount_gbp >= 10000",
    "initiated_at": "string (ISO 8601 UTC)",
    "channel": "string enum (web | mobile)"
  },
  "derived_from": {
    "entity": "ENT-053",
    "field_mappings": [
      {"entity_field": "chaps_intent_id", "payload_field": "chaps_intent_id"},
      {"entity_field": "customer_id", "payload_field": "customer_id"},
      {"entity_field": "account_id", "payload_field": "account_id"},
      {"entity_field": "beneficiary_sort_code", "payload_field": "beneficiary_sort_code"},
      {"entity_field": "beneficiary_account_number", "payload_field": "beneficiary_account_number"},
      {"entity_field": "beneficiary_name", "payload_field": "beneficiary_name"},
      {"entity_field": "beneficiary_lei", "payload_field": "beneficiary_lei", "masking": "included only if not null"},
      {"entity_field": "amount_gbp", "payload_field": "amount_gbp"},
      {"entity_field": "purpose_code", "payload_field": "purpose_code"},
      {"entity_field": "payment_reference", "payload_field": "payment_reference"},
      {"entity_field": "is_mortgage_completion_payment", "payload_field": "is_mortgage_completion_payment"},
      {"entity_field": "mortgage_account_id", "payload_field": "mortgage_account_id"},
      {"entity_field": "enhanced_monitoring_flag", "payload_field": "enhanced_monitoring_flag"},
      {"entity_field": "initiated_at", "payload_field": "initiated_at"},
      {"entity_field": "channel", "payload_field": "channel"}
    ],
    "excluded_fields": ["status", "reserved_funds_at", "sca_reference", "cop_result", "cop_checked_at", "customer_cop_confirmation"]
  },
  "consumers": [
    {
      "service": "SVC-009",
      "service_name": "Domestic Payments",
      "action": "Initiates CoP check against Pay.UK CoP service using beneficiary_sort_code, beneficiary_account_number, beneficiary_name"
    },
    {
      "service": "SVC-014",
      "service_name": "KYC/AML Service",
      "action": "Initiates real-time sanctions screening of beneficiary via SVC-051. If enhanced_monitoring_flag=true, triggers enhanced AML monitoring."
    },
    {
      "service": "SVC-103",
      "service_name": "Audit & Logging",
      "action": "Creates immutable audit record of CHAPS payment initiation"
    }
  ],
  "ordering_guarantees": "Per-customer strict ordering via customer_id partition key on topic payments.chaps",
  "topic": "payments.chaps",
  "data_classification": "financial + pii",
  "worm_audit_pipeline": true,
  "worm_rationale": "Contains customer_id, account_id, and full beneficiary details (PII + financial). CHAPS payment audit trail required for GOV-003-R03 data quality programme and FCA Consumer Duty. 7-year retention.",
  "retention": "7 years (WORM audit pipeline — SVC-111)",
  "cloudevents_type": "uk.bank.payments.chaps.intent.created",
  "governance_references": ["GOV-003-R02", "GOV-003-R03", "GOV-005-R02"],
  "source_journeys": ["JRN-028"]
}
