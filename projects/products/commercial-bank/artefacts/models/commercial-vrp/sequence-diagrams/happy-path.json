{
  "diagram_id": "SEQ-JRN029-001",
  "name": "Happy Path — VRP Consent Grant and First Payment Execution",
  "journey_id": "JRN-029",
  "scenario": "happy-path",
  "description": "PISP submits VRP consent request for a £500/month subscription. Customer authenticates via SCA and grants consent. PISP immediately submits first VRP payment of £49.99 within consent limits. Payment executed as Faster Payment.",
  "participants": [
    {"id": "TPP", "label": "PER-006 (PISP)", "type": "actor"},
    {"id": "Customer", "label": "PER-001 (Customer)", "type": "actor"},
    {"id": "Channel", "label": "SVC-017 (Digital Channels)", "type": "service"},
    {"id": "IAM", "label": "SVC-100 (IAM)", "type": "service"},
    {"id": "DomPay", "label": "SVC-009 (Domestic Payments)", "type": "service"},
    {"id": "Fraud", "label": "SVC-013 (Fraud Detection)", "type": "service"},
    {"id": "EventBus", "label": "SVC-102 (Event Bus)", "type": "infrastructure"},
    {"id": "Retail", "label": "SVC-001 (Retail Banking Core)", "type": "service"},
    {"id": "Notifications", "label": "SVC-053 (Notifications)", "type": "service"},
    {"id": "Audit", "label": "SVC-103 (Audit & Logging)", "type": "service"}
  ],
  "steps": [
    {"step": 1, "from": "TPP", "to": "Channel", "type": "sync", "action": "POST /consents {payee, max_single: 500, max_monthly: 500, category: subscription, valid_to: 2027-04-15}", "phase": "PH-115"},
    {"step": 2, "from": "Channel", "to": "IAM", "type": "sync", "action": "POST /token/validate {tpp_access_token, scope: vrp:consent}", "phase": "PH-115"},
    {"step": 3, "from": "IAM", "to": "Channel", "type": "sync-return", "action": "200 OK {valid: true, tpp_client_id}", "phase": "PH-115"},
    {"step": 4, "from": "Channel", "to": "DomPay", "type": "sync", "action": "Create VrpConsent {status: pending_authorisation}", "phase": "PH-115"},
    {"step": 5, "from": "DomPay", "to": "DomPay", "type": "internal", "action": "Create VrpConsent (ENT-070) status=pending_authorisation", "phase": "PH-115"},
    {"step": 6, "from": "DomPay", "to": "Channel", "type": "sync-return", "action": "consent_id, redirect_uri", "phase": "PH-115"},
    {"step": 7, "from": "Channel", "to": "TPP", "type": "sync-return", "action": "201 Created {consent_id, redirect_uri}", "phase": "PH-115"},
    {"step": 8, "from": "TPP", "to": "Customer", "type": "ui", "action": "Redirect customer to bank's VRP consent portal", "phase": "PH-116"},
    {"step": 9, "from": "Customer", "to": "Channel", "type": "sync", "action": "Complete SCA (biometric)", "phase": "PH-116"},
    {"step": 10, "from": "Channel", "to": "IAM", "type": "sync", "action": "POST /sca/validate {assertion}", "phase": "PH-116"},
    {"step": 11, "from": "IAM", "to": "Channel", "type": "sync-return", "action": "200 OK {valid: true}", "phase": "PH-116"},
    {"step": 12, "from": "Channel", "to": "Customer", "type": "ui", "action": "Display consent parameters: max £500/payment, £500/month, subscription, expires 2027-04-15", "phase": "PH-116"},
    {"step": 13, "from": "Customer", "to": "Channel", "type": "sync", "action": "Confirm consent grant", "phase": "PH-116"},
    {"step": 14, "from": "Channel", "to": "DomPay", "type": "sync", "action": "Activate VrpConsent {consent_id, sca_assertion_ref}", "phase": "PH-116"},
    {"step": 15, "from": "DomPay", "to": "DomPay", "type": "internal", "action": "Update VrpConsent status=active; store sca_assertion_ref", "phase": "PH-116"},
    {"step": 16, "from": "DomPay", "to": "EventBus", "type": "async-publish", "action": "Publish VrpConsentGranted (EVT-156)", "phase": "PH-116"},
    {"step": 17, "from": "EventBus", "to": "Notifications", "type": "async-consume", "action": "Consume EVT-156 → Send consent confirmation to customer", "phase": "PH-116"},
    {"step": 18, "from": "EventBus", "to": "Audit", "type": "async-consume", "action": "Consume EVT-156 → Write immutable consent grant record", "phase": "PH-116"},
    {"step": 19, "from": "DomPay", "to": "Channel", "type": "sync-return", "action": "consent active; authorisation_code", "phase": "PH-116"},
    {"step": 20, "from": "Channel", "to": "TPP", "type": "sync-return", "action": "Redirect to PISP redirect_uri with authorisation_code", "phase": "PH-116"},
    {"step": 21, "from": "TPP", "to": "Channel", "type": "sync", "action": "POST /consents/{consent_id}/payments {amount: 49.99, end_to_end_id, reference: 'Netflix subscription'}", "phase": "PH-117"},
    {"step": 22, "from": "Channel", "to": "IAM", "type": "sync", "action": "POST /token/validate {tpp_access_token, scope: vrp:payment}", "phase": "PH-117"},
    {"step": 23, "from": "IAM", "to": "Channel", "type": "sync-return", "action": "200 OK {valid: true}", "phase": "PH-117"},
    {"step": 24, "from": "Channel", "to": "DomPay", "type": "sync", "action": "Process VRP payment {consent_id, amount: 49.99}", "phase": "PH-117"},
    {"step": 25, "from": "DomPay", "to": "DomPay", "type": "internal", "action": "Validate: amount 49.99 ≤ max_single 500 ✓; monthly_aggregate 49.99 ≤ max_monthly 500 ✓; consent active ✓", "phase": "PH-117"},
    {"step": 26, "from": "DomPay", "to": "Fraud", "type": "sync", "action": "Score VRP payment (inline fraud check)", "phase": "PH-117"},
    {"step": 27, "from": "Fraud", "to": "DomPay", "type": "sync-return", "action": "fraud_score: 0.12 (below threshold)", "phase": "PH-117"},
    {"step": 28, "from": "DomPay", "to": "DomPay", "type": "internal", "action": "Execute FPS payment; create VrpPayment (ENT-071) status=executed; increment current_month_aggregate", "phase": "PH-117"},
    {"step": 29, "from": "DomPay", "to": "EventBus", "type": "async-publish", "action": "Publish VrpPaymentExecuted (EVT-157)", "phase": "PH-117"},
    {"step": 30, "from": "EventBus", "to": "Retail", "type": "async-consume", "action": "Consume EVT-157 → Debit source account; record transaction", "phase": "PH-117"},
    {"step": 31, "from": "EventBus", "to": "Notifications", "type": "async-consume", "action": "Consume EVT-157 → Send payment confirmation to customer", "phase": "PH-117"},
    {"step": 32, "from": "EventBus", "to": "Audit", "type": "async-consume", "action": "Consume EVT-157 → Write payment audit record", "phase": "PH-117"},
    {"step": 33, "from": "DomPay", "to": "Channel", "type": "sync-return", "action": "vrp_payment_id, fps_end_to_end_id, status: executed", "phase": "PH-117"},
    {"step": 34, "from": "Channel", "to": "TPP", "type": "sync-return", "action": "201 Created {vrp_payment_id, fps_end_to_end_id, executed_at}", "phase": "PH-117"}
  ]
}
