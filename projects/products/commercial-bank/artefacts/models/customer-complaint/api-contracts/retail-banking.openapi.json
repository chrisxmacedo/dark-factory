{
  "openapi": "3.1.0",
  "info": {
    "title": "Retail Banking — Complaint Management API",
    "description": "Complaint submission and status API exposed by SVC-001 (Retail Banking Core) for the JRN-019 Customer Complaint Handling journey. Consumed by channel services (SVC-017). Authentication via OAuth 2.0 Bearer token — the channel passes the customer's authenticated session token. Complaint submission requires the complaints:write scope; status retrieval requires complaints:read.",
    "version": "1.0.0",
    "x-service-id": "SVC-001",
    "x-capability-id": "CAP-001",
    "x-journey-ids": ["JRN-019"]
  },
  "servers": [
    {
      "url": "https://api.bank.internal/retail/v1",
      "description": "Internal API gateway — production"
    }
  ],
  "security": [{"BearerAuth": []}],
  "paths": {
    "/complaints": {
      "post": {
        "operationId": "submitComplaint",
        "summary": "Submit a customer complaint",
        "description": "Creates a ComplaintCase and initiates the complaint handling workflow. Customer must be authenticated. Returns a ComplaintCase reference and acknowledgement details immediately.\n\n**Publishes:** ComplaintReceived (EVT-138)",
        "tags": ["Complaints"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/SubmitComplaintRequest"}
            }
          }
        },
        "responses": {
          "201": {
            "description": "Complaint created. Acknowledgement notification dispatched.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ComplaintCaseSummary"}
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ErrorResponse"}
              }
            }
          },
          "401": {"description": "Unauthenticated"},
          "422": {
            "description": "Business rule violation",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ErrorResponse"}
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listComplaints",
        "summary": "List complaints for the authenticated customer",
        "description": "Returns a paginated list of ComplaintCase summaries for the authenticated customer. Ordered by received_at descending.",
        "tags": ["Complaints"],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {"type": "string", "enum": ["received","in_triage","triaged","under_investigation","resolved","closed","fos_referred"]},
            "description": "Filter by complaint status"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {"type": "integer", "default": 1}
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {"type": "integer", "default": 20, "maximum": 100}
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of complaint summaries",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ComplaintListResponse"}
              }
            }
          },
          "401": {"description": "Unauthenticated"}
        }
      }
    },
    "/complaints/{complaint_id}": {
      "get": {
        "operationId": "getComplaint",
        "summary": "Get complaint details",
        "description": "Returns the full ComplaintCase details for the authenticated customer. Internal investigation notes are excluded from the customer projection.",
        "tags": ["Complaints"],
        "parameters": [
          {
            "name": "complaint_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          }
        ],
        "responses": {
          "200": {
            "description": "Complaint details",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ComplaintCaseDetail"}
              }
            }
          },
          "401": {"description": "Unauthenticated"},
          "403": {"description": "Forbidden — complaint does not belong to authenticated customer"},
          "404": {"description": "Complaint not found"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SubmitComplaintRequest": {
        "type": "object",
        "required": ["affected_product_type", "complaint_type", "subject", "description"],
        "properties": {
          "affected_product_type": {
            "type": "string",
            "enum": ["current_account","savings","mortgage","personal_loan","credit_card","payment","insurance","other"],
            "description": "Product category the complaint relates to"
          },
          "affected_account_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Specific account affected, if applicable"
          },
          "complaint_type": {
            "type": "string",
            "enum": ["conduct","service","product","fraud","pricing","other"],
            "description": "Nature of the complaint"
          },
          "subject": {
            "type": "string",
            "maxLength": 200,
            "description": "Brief complaint subject line"
          },
          "description": {
            "type": "string",
            "maxLength": 5000,
            "description": "Full complaint description"
          },
          "desired_outcome": {
            "type": "string",
            "maxLength": 1000,
            "nullable": true,
            "description": "Customer's stated desired resolution"
          }
        },
        "x-transformation-notes": "channel_received is inferred from the channel service making the request (set by API gateway header X-Channel-Id)"
      },
      "ComplaintCaseSummary": {
        "type": "object",
        "properties": {
          "complaint_id": {"type": "string", "format": "uuid"},
          "complaint_reference": {"type": "string", "example": "COMP-20260415-0042", "description": "Human-readable reference to share with customer"},
          "status": {"type": "string", "enum": ["received","in_triage","triaged","under_investigation","resolved","closed","fos_referred"]},
          "affected_product_type": {"type": "string"},
          "complaint_type": {"type": "string"},
          "received_at": {"type": "string", "format": "date-time"},
          "acknowledgement_message": {"type": "string", "description": "Regulatory acknowledgement text including expected resolution timelines"},
          "fos_information_url": {"type": "string", "description": "URL to FOS information page"}
        }
      },
      "ComplaintCaseDetail": {
        "type": "object",
        "properties": {
          "complaint_id": {"type": "string", "format": "uuid"},
          "complaint_reference": {"type": "string"},
          "status": {"type": "string"},
          "affected_product_type": {"type": "string"},
          "affected_account_id": {"type": "string", "format": "uuid", "nullable": true},
          "complaint_type": {"type": "string"},
          "subject": {"type": "string"},
          "description": {"type": "string"},
          "desired_outcome": {"type": "string", "nullable": true},
          "channel_received": {"type": "string"},
          "severity": {"type": "string", "nullable": true},
          "target_resolution_date": {"type": "string", "format": "date", "nullable": true},
          "outcome": {"type": "string", "nullable": true, "enum": ["upheld","partially_upheld","rejected","withdrawn"]},
          "redress_amount": {"type": "string", "nullable": true, "description": "GBP amount as string, e.g. '50.00'"},
          "response_type": {"type": "string", "nullable": true},
          "response_sent_at": {"type": "string", "format": "date-time", "nullable": true},
          "received_at": {"type": "string", "format": "date-time"},
          "resolved_at": {"type": "string", "format": "date-time", "nullable": true},
          "closed_at": {"type": "string", "format": "date-time", "nullable": true},
          "fos_referred": {"type": "boolean"},
          "fos_referral_deadline": {"type": "string", "format": "date", "nullable": true, "description": "6-month FOS referral deadline — populated once Final Response issued"},
          "x-projection-notes": "investigation_notes, root_cause_analysis, and assigned_to are excluded from customer projection"
        }
      },
      "ComplaintListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/ComplaintCaseSummary"}
          },
          "pagination": {
            "type": "object",
            "properties": {
              "page": {"type": "integer"},
              "per_page": {"type": "integer"},
              "total": {"type": "integer"},
              "total_pages": {"type": "integer"}
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error_code": {"type": "string"},
          "message": {"type": "string"},
          "field_errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {"type": "string"},
                "message": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "OAuth 2.0 Bearer token. Required scopes: complaints:write (POST), complaints:read (GET)"
      }
    }
  }
}
