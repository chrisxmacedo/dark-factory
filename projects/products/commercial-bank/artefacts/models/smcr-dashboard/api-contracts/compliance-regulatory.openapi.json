{
  "openapi": "3.1.0",
  "info": {
    "title": "Compliance & Regulatory — SM&CR Review API",
    "description": "SM&CR quarterly review management API exposed by SVC-015 (Compliance Core) for JRN-024. Internal API consumed by the SM&CR compliance dashboard. Requires compliance:write scope. Not customer-facing.",
    "version": "1.0.0",
    "x-service-id": "SVC-015",
    "x-capability-id": "CAP-005",
    "x-journey-ids": ["JRN-024"]
  },
  "servers": [{"url": "https://api.bank.internal/compliance/v1", "description": "Internal — production"}],
  "security": [{"BearerAuth": []}],
  "paths": {
    "/smcr/reviews": {
      "post": {
        "operationId": "createSmscrReview",
        "summary": "Initiate quarterly SM&CR review",
        "description": "Creates SmscrReview record for the current quarter. Generates conduct monitoring report.",
        "tags": ["SM&CR"],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateSmscrReviewRequest"}}}},
        "responses": {
          "201": {"description": "Review created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SmscrReviewDetail"}}}},
          "400": {"description": "Validation error"},
          "403": {"description": "Insufficient permissions — requires SMF16 authentication"}
        }
      }
    },
    "/smcr/reviews/{review_id}/close": {
      "post": {
        "operationId": "closeSmscrReview",
        "summary": "Close SM&CR review with SMF attestation",
        "description": "SMF16 signs off the quarterly review. Publishes SmscrReviewCompleted (EVT-165). Updates status to closed.",
        "tags": ["SM&CR"],
        "parameters": [{"name": "review_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CloseReviewRequest"}}}},
        "responses": {
          "200": {"description": "Review closed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SmscrReviewDetail"}}}},
          "409": {"description": "Review already closed or has unresolved conduct breaches"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateSmscrReviewRequest": {
        "type": "object",
        "required": ["review_quarter"],
        "properties": {
          "review_quarter": {"type": "string", "description": "e.g. Q1-2026"},
          "notes": {"type": "string", "nullable": true}
        }
      },
      "CloseReviewRequest": {
        "type": "object",
        "required": ["smf16_attestation_ref"],
        "properties": {
          "smf16_attestation_ref": {"type": "string", "description": "SMF16 holder's attestation reference for this review"}
        }
      },
      "SmscrReviewDetail": {
        "type": "object",
        "properties": {
          "review_id": {"type": "string", "format": "uuid"},
          "review_quarter": {"type": "string"},
          "status": {"type": "string"},
          "conduct_alerts_count": {"type": "integer"},
          "training_completion_rate": {"type": "string"},
          "accountability_changes_count": {"type": "integer"},
          "fca_register_updates_required": {"type": "boolean"},
          "closed_at": {"type": "string", "format": "date-time", "nullable": true}
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}
    }
  }
}
