{
  "openapi": "3.1.0",
  "info": {
    "title": "Mortgage Service API",
    "description": "SVC-002 Mortgage Service — API for the residential mortgage application journey (JRN-006). Covers mortgage application lifecycle from enquiry through to account opening. All cross-capability integrations (credit checks via SVC-012, KYC via SVC-014) are mediated via async events and are not exposed as synchronous API endpoints.",
    "version": "1.0.0",
    "contact": {
      "name": "Mortgage Engineering Team",
      "email": "mortgage-engineering@bank.internal"
    }
  },
  "servers": [
    {
      "url": "https://api.bank.internal/v1",
      "description": "Internal API Gateway — Production"
    },
    {
      "url": "https://api.staging.bank.internal/v1",
      "description": "Internal API Gateway — Staging"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "mortgage-applications",
      "description": "Mortgage application lifecycle — from enquiry through to offer acceptance"
    },
    {
      "name": "mortgage-accounts",
      "description": "Mortgage account management — created at completion"
    }
  ],
  "paths": {
    "/mortgage-applications": {
      "post": {
        "operationId": "createMortgageApplication",
        "tags": ["mortgage-applications"],
        "summary": "Create a new mortgage application",
        "description": "Initiates a new mortgage application at PH-009 (Mortgage Enquiry). Creates an ENT-012 MortgageApplication record with status = 'enquiry'. Runs the affordability pre-check and returns an indicative borrowing result. Publishes MortgageEnquiryStarted (EVT-020). No credit check is performed at this stage.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMortgageApplicationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Mortgage application created. Affordability pre-check result included.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MortgageApplicationResponse"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "URL of the created mortgage application resource",
                "schema": {
                  "type": "string",
                  "example": "/v1/mortgage-applications/3fa85f64-5717-4562-b3fc-2c963f66afa6"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/mortgage-applications/{id}": {
      "get": {
        "operationId": "getMortgageApplication",
        "tags": ["mortgage-applications"],
        "summary": "Get a mortgage application by ID",
        "description": "Returns the full state of a MortgageApplication (ENT-012) including current status, phase, linked affordability assessments, valuation status, and offer details. Used by the customer portal and internal underwriting workflow.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ApplicationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Mortgage application found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MortgageApplicationResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/mortgage-applications/{id}/dip": {
      "post": {
        "operationId": "submitDIP",
        "tags": ["mortgage-applications"],
        "summary": "Submit a Decision in Principle (DIP) request",
        "description": "Initiates the DIP process at PH-010. Accepts confirmed income and employment details. Publishes CreditCheckRequested (EVT-022) with check_type = 'soft' to SVC-012 via event bus. SVC-012 returns CreditCheckCompleted (EVT-023) asynchronously. Affordability assessment (ENT-013) created. If automated path passes, publishes DIPIssued (EVT-021). Response is synchronous with the initial submission — DIP result is delivered asynchronously via webhook or polling on GET /mortgage-applications/{id}.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ApplicationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DIPRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "DIP request accepted and processing initiated. Poll GET /mortgage-applications/{id} or subscribe to webhook for DIP result (DIPIssued or DIPDeclined event). Target: DIP result within 15 minutes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DIPAcceptedResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Conflict — DIP already in progress or already issued for this application.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/mortgage-applications/{id}/full-application": {
      "post": {
        "operationId": "submitFullApplication",
        "tags": ["mortgage-applications"],
        "summary": "Submit a full mortgage application",
        "description": "Submits the formal full mortgage application at PH-011. Requires a valid DIP (status = 'dip_issued' and dip_expiry in the future). Transitions MortgageApplication.status to 'full_application_submitted'. Publishes CreditCheckRequested (EVT-022) with check_type = 'hard' to SVC-012. Accepts document references (income documents, bank statements uploaded separately via document upload endpoint). Application enters underwriting queue after all documents received.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ApplicationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FullApplicationRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Full application accepted. Application status transitions to 'full_application_submitted'. Credit check initiated. Decision within 5 business days of complete document receipt.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FullApplicationAcceptedResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Conflict — DIP has expired or full application already submitted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/mortgage-applications/{id}/offer": {
      "post": {
        "operationId": "acceptMortgageOffer",
        "tags": ["mortgage-applications"],
        "summary": "Accept a mortgage offer",
        "description": "Records the customer's formal acceptance of the mortgage offer at PH-014. Validates the 7-day reflection period has elapsed since offer_date (MCOB 6.7). Transitions MortgageApplication.status to 'offer_accepted'. Publishes MortgageOfferAccepted (EVT-028). Application proceeds to completion queue.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ApplicationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptOfferRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Offer accepted. Application status transitions to 'offer_accepted'.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MortgageApplicationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Conflict — offer already accepted, offer expired, or reflection period not yet elapsed (MCOB 6.7 violation).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/mortgage-accounts": {
      "post": {
        "operationId": "createMortgageAccount",
        "tags": ["mortgage-accounts"],
        "summary": "Open a mortgage account at completion",
        "description": "Creates a MortgageAccount (ENT-016) at PH-015 (Completion). Called by the SVC-002 completion processing service after CHAPS funds are confirmed as released. Transitions MortgageApplication.status to 'completed'. Publishes MortgageCompleted (EVT-029) and MortgageAccountOpened (EVT-030). Sets up direct debit mandate for monthly payment collection.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMortgageAccountRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Mortgage account created. MortgageCompleted and MortgageAccountOpened events published.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MortgageAccountResponse"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "URL of the created mortgage account resource",
                "schema": {
                  "type": "string",
                  "example": "/v1/mortgage-accounts/7ab85f64-5717-4562-b3fc-2c963f66ab12"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Conflict — mortgage account already exists for this application, or application is not in 'offer_accepted' status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT issued by SVC-100 (Identity & Access Management). Must include customer_id or staff_id claim. Validated at API gateway."
      }
    },
    "parameters": {
      "ApplicationId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Mortgage application UUID (ENT-012 application_id)",
        "schema": {
          "type": "string",
          "format": "uuid",
          "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
        }
      }
    },
    "schemas": {
      "CreateMortgageApplicationRequest": {
        "type": "object",
        "required": ["customer_id", "property_address", "purchase_price", "deposit_amount", "term_years", "rate_type", "product_id", "application_type"],
        "properties": {
          "customer_id": {
            "type": "string",
            "format": "uuid",
            "description": "FK to Customer.customer_id (ENT-001, SVC-001)"
          },
          "property_address": {
            "$ref": "#/components/schemas/UKAddress"
          },
          "purchase_price": {
            "type": "number",
            "format": "double",
            "minimum": 1,
            "description": "Property purchase price in GBP"
          },
          "deposit_amount": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "description": "Customer deposit amount in GBP. Must be >= 5% of purchase_price."
          },
          "term_years": {
            "type": "integer",
            "minimum": 5,
            "maximum": 40,
            "description": "Mortgage term in years"
          },
          "rate_type": {
            "type": "string",
            "enum": ["fixed", "variable", "tracker"],
            "description": "Mortgage rate type"
          },
          "product_id": {
            "type": "string",
            "description": "Selected mortgage product ID from SVC-002 product catalogue"
          },
          "application_type": {
            "type": "string",
            "enum": ["purchase", "remortgage", "buy_to_let", "shared_ownership"],
            "description": "Type of mortgage application"
          },
          "gross_income": {
            "type": "number",
            "format": "double",
            "description": "Customer gross annual income in GBP (used for affordability pre-check at enquiry stage)"
          }
        }
      },
      "DIPRequest": {
        "type": "object",
        "required": ["employment_status", "gross_income", "net_income", "committed_expenditure", "employer_name"],
        "properties": {
          "employment_status": {
            "type": "string",
            "enum": ["employed", "self_employed", "contractor", "retired", "other"],
            "description": "Customer employment status"
          },
          "employer_name": {
            "type": "string",
            "maxLength": 200,
            "description": "Current employer name (or 'Self-employed' for self-employed applicants)"
          },
          "gross_income": {
            "type": "number",
            "format": "double",
            "description": "Confirmed gross annual income in GBP"
          },
          "net_income": {
            "type": "number",
            "format": "double",
            "description": "Confirmed net annual income in GBP after tax, NI, and pension"
          },
          "committed_expenditure": {
            "type": "number",
            "format": "double",
            "description": "Total monthly committed expenditure in GBP (existing loans, credit cards, etc.)"
          },
          "soft_credit_check_consent": {
            "type": "boolean",
            "description": "Customer consent to soft credit check. Must be true to proceed.",
            "default": false
          }
        }
      },
      "DIPAcceptedResponse": {
        "type": "object",
        "properties": {
          "application_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "example": "dip_pending"
          },
          "message": {
            "type": "string",
            "example": "DIP request accepted. Credit check in progress. Result expected within 15 minutes."
          },
          "polling_url": {
            "type": "string",
            "example": "/v1/mortgage-applications/3fa85f64-5717-4562-b3fc-2c963f66afa6"
          },
          "accepted_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FullApplicationRequest": {
        "type": "object",
        "required": ["hard_credit_check_consent", "income_document_references", "bank_statement_references"],
        "properties": {
          "hard_credit_check_consent": {
            "type": "boolean",
            "description": "Customer consent to hard credit check (visible footprint on credit file). Must be true.",
            "default": false
          },
          "income_document_references": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "References to uploaded income documents (payslips, P60, SA302). Documents uploaded via document upload endpoint separately."
          },
          "bank_statement_references": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 3,
            "description": "References to uploaded bank statements. Minimum 3 months required."
          },
          "additional_income_sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdditionalIncomeSource"
            },
            "description": "Optional additional income sources (rental income, benefits, investments)"
          }
        }
      },
      "FullApplicationAcceptedResponse": {
        "type": "object",
        "properties": {
          "application_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "example": "full_application_submitted"
          },
          "full_application_date": {
            "type": "string",
            "format": "date"
          },
          "decision_sla": {
            "type": "string",
            "example": "Decision expected within 5 business days of complete document receipt."
          }
        }
      },
      "AcceptOfferRequest": {
        "type": "object",
        "required": ["offer_id", "acceptance_confirmed"],
        "properties": {
          "offer_id": {
            "type": "string",
            "format": "uuid",
            "description": "The offer_id from MortgageOffer (ENT-015)"
          },
          "acceptance_confirmed": {
            "type": "boolean",
            "description": "Customer explicit acceptance of the mortgage offer terms. Must be true.",
            "default": false
          },
          "solicitor_details": {
            "$ref": "#/components/schemas/SolicitorDetails"
          }
        }
      },
      "CreateMortgageAccountRequest": {
        "type": "object",
        "required": ["application_id", "offer_id", "chaps_payment_reference", "completion_date", "direct_debit_sort_code", "direct_debit_account_number", "first_payment_date"],
        "properties": {
          "application_id": {
            "type": "string",
            "format": "uuid",
            "description": "FK to MortgageApplication.application_id (ENT-012)"
          },
          "offer_id": {
            "type": "string",
            "format": "uuid",
            "description": "FK to MortgageOffer.offer_id (ENT-015)"
          },
          "chaps_payment_reference": {
            "type": "string",
            "maxLength": 35,
            "description": "CHAPS payment reference for funds released to solicitor on completion day"
          },
          "completion_date": {
            "type": "string",
            "format": "date",
            "description": "Legal completion date"
          },
          "direct_debit_sort_code": {
            "type": "string",
            "pattern": "^[0-9]{2}-[0-9]{2}-[0-9]{2}$",
            "description": "Sort code of customer's nominated direct debit account (UK format XX-XX-XX)"
          },
          "direct_debit_account_number": {
            "type": "string",
            "pattern": "^[0-9]{8}$",
            "description": "Account number of customer's nominated direct debit account"
          },
          "first_payment_date": {
            "type": "string",
            "format": "date",
            "description": "Date of first monthly mortgage payment"
          }
        }
      },
      "MortgageApplicationResponse": {
        "type": "object",
        "properties": {
          "application_id": {
            "type": "string",
            "format": "uuid"
          },
          "customer_id": {
            "type": "string",
            "format": "uuid"
          },
          "property_address": {
            "$ref": "#/components/schemas/UKAddress"
          },
          "purchase_price": {
            "type": "number",
            "format": "double"
          },
          "deposit_amount": {
            "type": "number",
            "format": "double"
          },
          "loan_amount": {
            "type": "number",
            "format": "double"
          },
          "ltv_ratio": {
            "type": "number",
            "format": "double",
            "description": "LTV as percentage to 2 decimal places"
          },
          "term_years": {
            "type": "integer"
          },
          "rate_type": {
            "type": "string",
            "enum": ["fixed", "variable", "tracker"]
          },
          "product_id": {
            "type": "string"
          },
          "application_type": {
            "type": "string",
            "enum": ["purchase", "remortgage", "buy_to_let", "shared_ownership"]
          },
          "status": {
            "type": "string",
            "description": "Current application status"
          },
          "dip_date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "dip_expiry": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "full_application_date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "affordability_pre_check": {
            "$ref": "#/components/schemas/AffordabilityPreCheckResult"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MortgageAccountResponse": {
        "type": "object",
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid"
          },
          "customer_id": {
            "type": "string",
            "format": "uuid"
          },
          "mortgage_offer_id": {
            "type": "string",
            "format": "uuid"
          },
          "property_address": {
            "$ref": "#/components/schemas/UKAddress"
          },
          "outstanding_balance": {
            "type": "number",
            "format": "double"
          },
          "monthly_payment": {
            "type": "number",
            "format": "double"
          },
          "rate": {
            "type": "number",
            "format": "double"
          },
          "term_remaining": {
            "type": "integer",
            "description": "Remaining term in months"
          },
          "status": {
            "type": "string",
            "enum": ["active", "arrears", "redeemed"]
          },
          "opened_date": {
            "type": "string",
            "format": "date"
          },
          "next_payment_date": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "AffordabilityPreCheckResult": {
        "type": "object",
        "properties": {
          "indicative_borrowing_amount": {
            "type": "number",
            "format": "double",
            "description": "Indicative maximum borrowing amount based on income declared"
          },
          "indicative_monthly_payment": {
            "type": "number",
            "format": "double",
            "description": "Estimated monthly payment at selected product rate"
          },
          "indicative_ltv": {
            "type": "number",
            "format": "double"
          },
          "result": {
            "type": "string",
            "enum": ["indicative_pass", "indicative_fail"],
            "description": "Indicative only — not a credit decision"
          }
        }
      },
      "UKAddress": {
        "type": "object",
        "required": ["line1", "city", "postcode", "country_code"],
        "properties": {
          "line1": {
            "type": "string",
            "maxLength": 100
          },
          "line2": {
            "type": "string",
            "maxLength": 100,
            "nullable": true
          },
          "city": {
            "type": "string",
            "maxLength": 100
          },
          "county": {
            "type": "string",
            "maxLength": 100,
            "nullable": true
          },
          "postcode": {
            "type": "string",
            "pattern": "^[A-Z]{1,2}[0-9][0-9A-Z]?\\s[0-9][A-Z]{2}$",
            "description": "UK postcode (Royal Mail PAF format)"
          },
          "country_code": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "ISO 3166-1 alpha-2 country code. Must be GB for UK residential mortgage."
          }
        }
      },
      "SolicitorDetails": {
        "type": "object",
        "properties": {
          "firm_name": {
            "type": "string",
            "maxLength": 200
          },
          "contact_name": {
            "type": "string",
            "maxLength": 200
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
