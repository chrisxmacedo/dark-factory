        {"service": "SVC-103", "service_name": "Audit & Logging Service", "action": "Write immutable record of risk rating change."}
      ],
      "ordering_guarantees": "Per-client ordering.",
      "topic": "compliance.cdd-reviews",
      "data_classification": "Confidential",
      "worm_audit_pipeline": false,
      "retention": "7 years",
      "cloudevents_type": "uk.bank.compliance.cdd.risk_rating_changed",
