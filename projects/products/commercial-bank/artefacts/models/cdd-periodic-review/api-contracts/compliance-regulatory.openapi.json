{
  "openapi": "3.1.0",
  "info": {
    "title": "Compliance & Regulatory — CDD Review API",
    "description": "CDD review management API exposed by SVC-015 (Compliance Core Service) for the JRN-020 CDD Periodic Review journey. Consumed by internal compliance tooling (CH-005). Authentication via OAuth 2.0 Bearer token with compliance:read and compliance:write scopes. This is an internal API — not exposed to channels or external consumers.",
    "version": "1.0.0",
    "x-service-id": "SVC-015",
    "x-capability-id": "CAP-005",
    "x-journey-ids": ["JRN-020"]
  },
  "servers": [
    {"url": "https://api.bank.internal/compliance/v1", "description": "Internal API gateway — production"}
  ],
  "security": [{"BearerAuth": []}],
  "paths": {
    "/cdd-reviews": {
      "get": {
        "operationId": "listCddReviews",
        "summary": "List CDD review cases",
        "description": "Returns paginated list of CDD review cases. Filtered by status, risk_tier, and due_date range. For PER-052 queue management.",
        "tags": ["CDD Reviews"],
        "parameters": [
          {"name": "status", "in": "query", "schema": {"type": "string", "enum": ["triggered","assigned","documents_requested","documents_under_review","documents_verified","risk_assessed","decision_made","archived"]}},
          {"name": "due_before", "in": "query", "schema": {"type": "string", "format": "date"}},
          {"name": "risk_tier", "in": "query", "schema": {"type": "string", "enum": ["low","medium","high","pep"]}},
          {"name": "page", "in": "query", "schema": {"type": "integer", "default": 1}},
          {"name": "per_page", "in": "query", "schema": {"type": "integer", "default": 50, "maximum": 200}}
        ],
        "responses": {
          "200": {"description": "List of CDD review cases", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CddReviewListResponse"}}}},
          "401": {"description": "Unauthenticated"},
          "403": {"description": "Insufficient scope"}
        }
      }
    },
    "/cdd-reviews/{review_id}": {
      "get": {
        "operationId": "getCddReview",
        "summary": "Get CDD review case details",
        "tags": ["CDD Reviews"],
        "parameters": [{"name": "review_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
        "responses": {
          "200": {"description": "CDD review case detail", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CddReviewDetail"}}}},
          "404": {"description": "Review not found"}
        }
      },
      "patch": {
        "operationId": "updateCddReview",
        "summary": "Update CDD review case (triage, decision)",
        "description": "Updates the review case status, assignment, decision, or documents. Used by PER-052 and KYC analysts throughout the review lifecycle.",
        "tags": ["CDD Reviews"],
        "parameters": [{"name": "review_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UpdateCddReviewRequest"}}}},
        "responses": {
          "200": {"description": "Updated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CddReviewDetail"}}}},
          "400": {"description": "Validation error"},
          "403": {"description": "Action not permitted at current status"},
          "404": {"description": "Review not found"}
        }
      }
    },
    "/cdd-reviews/{review_id}/decision": {
      "post": {
        "operationId": "recordReviewDecision",
        "summary": "Record review decision",
        "description": "Records the PER-052 review decision. Publishes CddReviewCompleted (EVT-146) and CddExitEscalated (EVT-147) if applicable. Requires compliance:write scope.",
        "tags": ["CDD Reviews"],
        "parameters": [{"name": "review_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RecordDecisionRequest"}}}
        },
        "responses": {
          "200": {"description": "Decision recorded. Events published.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CddReviewDetail"}}}},
          "400": {"description": "Validation error — missing rationale or next_review_date"},
          "409": {"description": "Decision already recorded for this review"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CddReviewListResponse": {
        "type": "object",
        "properties": {
          "data": {"type": "array", "items": {"$ref": "#/components/schemas/CddReviewSummary"}},
          "pagination": {"type": "object", "properties": {"page": {"type": "integer"}, "per_page": {"type": "integer"}, "total": {"type": "integer"}}}
        }
      },
      "CddReviewSummary": {
        "type": "object",
        "properties": {
          "review_id": {"type": "string", "format": "uuid"},
          "client_id": {"type": "string", "format": "uuid"},
          "client_name": {"type": "string"},
          "review_type": {"type": "string", "enum": ["periodic","event_triggered"]},
          "risk_tier": {"type": "string"},
          "status": {"type": "string"},
          "due_date": {"type": "string", "format": "date"},
          "assigned_to": {"type": "string", "format": "uuid", "nullable": true},
          "triggered_at": {"type": "string", "format": "date-time"}
        }
      },
      "CddReviewDetail": {
        "type": "object",
        "properties": {
          "review_id": {"type": "string", "format": "uuid"},
          "client_id": {"type": "string", "format": "uuid"},
          "review_type": {"type": "string"},
          "trigger_reason": {"type": "string"},
          "risk_tier": {"type": "string"},
          "due_date": {"type": "string", "format": "date"},
          "status": {"type": "string"},
          "assigned_to": {"type": "string", "format": "uuid", "nullable": true},
          "documents_received": {"type": "array", "items": {"type": "object"}},
          "ubo_structure": {"type": "object", "nullable": true},
          "screening_results": {"type": "object", "nullable": true},
          "risk_rating": {"type": "string", "nullable": true},
          "edd_required": {"type": "boolean"},
          "review_decision": {"type": "string", "nullable": true},
          "decision_rationale": {"type": "string", "nullable": true},
          "next_review_date": {"type": "string", "format": "date", "nullable": true},
          "triggered_at": {"type": "string", "format": "date-time"},
          "decision_made_at": {"type": "string", "format": "date-time", "nullable": true}
        }
      },
      "UpdateCddReviewRequest": {
        "type": "object",
        "properties": {
          "assigned_to": {"type": "string", "format": "uuid"},
          "status": {"type": "string"},
          "documents_received": {"type": "array", "items": {"type": "object"}}
        }
      },
      "RecordDecisionRequest": {
        "type": "object",
        "required": ["review_decision", "decision_rationale", "next_review_date"],
        "properties": {
          "review_decision": {"type": "string", "enum": ["continue","continue_with_edd","escalate_to_exit","suspend_account"]},
          "decision_rationale": {"type": "string", "minLength": 50, "description": "Mandatory rationale — minimum 50 characters"},
          "next_review_date": {"type": "string", "format": "date"},
          "senior_manager_approval_id": {"type": "string", "format": "uuid", "description": "Required if review_decision = escalate_to_exit"}
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}
    }
  }
}
