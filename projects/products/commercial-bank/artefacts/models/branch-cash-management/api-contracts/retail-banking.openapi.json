{
  "openapi": "3.1.0",
  "info": {
    "title": "Retail Banking — Branch Cash Deposit API",
    "description": "Branch cash deposit submission API exposed by SVC-001 (Retail Banking Core) for JRN-025. Internal API consumed by branch point-of-sale systems. Requires branch:write scope. Not customer-facing.",
    "version": "1.0.0",
    "x-service-id": "SVC-001",
    "x-capability-id": "CAP-001",
    "x-journey-ids": ["JRN-025"]
  },
  "servers": [{"url": "https://api.bank.internal/retail/v1", "description": "Internal — production"}],
  "security": [{"BearerAuth": []}],
  "paths": {
    "/branch/cash-deposits": {
      "post": {
        "operationId": "submitCashDeposit",
        "summary": "Submit a branch cash deposit transaction",
        "description": "Creates a CashDepositTransaction. Credits customer account. If amount exceeds £10,000, generates AML threshold report reference and publishes CashDepositAboveThreshold (EVT-166).",
        "tags": ["Branch Operations"],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CashDepositRequest"}}}},
        "responses": {
          "201": {"description": "Deposit submitted and account credited", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CashDepositResponse"}}}},
          "400": {"description": "Validation error"},
          "409": {"description": "Cash count discrepancy — deposit held pending resolution"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CashDepositRequest": {
        "type": "object",
        "required": ["customer_id", "account_id", "amount", "branch_id", "staff_id", "identity_verification_method", "cash_count_verified"],
        "properties": {
          "customer_id": {"type": "string", "format": "uuid"},
          "account_id": {"type": "string", "format": "uuid"},
          "amount": {"type": "number", "minimum": 0.01},
          "branch_id": {"type": "string"},
          "staff_id": {"type": "string", "format": "uuid"},
          "identity_verification_method": {"type": "string"},
          "cash_count_verified": {"type": "boolean", "description": "Branch staff confirms cash machine count matches stated amount"}
        }
      },
      "CashDepositResponse": {
        "type": "object",
        "properties": {
          "transaction_id": {"type": "string", "format": "uuid"},
          "amount": {"type": "string"},
          "status": {"type": "string", "enum": ["credited"]},
          "aml_threshold_exceeded": {"type": "boolean"},
          "aml_report_ref": {"type": "string", "nullable": true},
          "credited_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}
    }
  }
}
