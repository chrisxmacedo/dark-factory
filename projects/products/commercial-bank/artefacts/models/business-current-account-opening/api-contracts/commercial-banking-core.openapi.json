{
  "openapi": "3.1.0",
  "info": {
    "title": "Commercial Banking Core API",
    "description": "SVC-005 — Commercial Banking Core. Exposes business account opening application lifecycle, business account provisioning, UBO identification, and director record endpoints for JRN-004 (Business Current Account Opening). This service is the authoritative commercial ledger for BusinessCustomer, BusinessAccount, UltimateBeneficialOwner, and DirectorRecord entities. All mutations to commercial account-related state must flow through this API.\n\nRegulatory context: BusinessApplicationRecord decisions are compliance evidence retained for 5+ years per MLR 2017 Regulation 40. UBO records are the bank's MLR 2017 Regulation 28(3)(a) audit trail. All endpoints are UK-data-residency only. Companies House verification is performed server-side; the CH API is never called directly from client applications.",
    "version": "1.0.0",
    "contact": {
      "name": "Commercial Banking Core Team",
      "email": "svc-005-team@bank.internal"
    }
  },
  "servers": [
    {
      "url": "https://api.bank.internal/commercial-core/v1",
      "description": "Internal production"
    },
    {
      "url": "https://api.staging.bank.internal/commercial-core/v1",
      "description": "Staging"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Business Applications",
      "description": "Business account opening application lifecycle. BusinessApplicationRecord is the compliance evidence record."
    },
    {
      "name": "Business Accounts",
      "description": "Business account provisioning and retrieval. BusinessAccount is the commercial ledger entity."
    },
    {
      "name": "UBOs",
      "description": "Ultimate Beneficial Owner identification and management. MLR 2017 Regulation 5 compliance."
    }
  ],
  "paths": {
    "/business-applications": {
      "post": {
        "operationId": "createBusinessApplication",
        "summary": "Start business account opening application",
        "description": "Creates a new BusinessApplicationRecord and BusinessCustomer prospect record for a business current account opening request. Triggers Companies House API lookup (async if CH API is slow). Publishes BusinessApplicationStarted domain event to the event bus (SVC-102) on successful creation. Performs preliminary eligibility checks: entity type supported, company number format valid, deduplication against existing active business accounts.\n\nPhase: PH-139 (Application Initiation)\nGovernance: GOV-005-R01, GOV-002-R03, MLR 2017 Regulation 28.",
        "tags": ["Business Applications"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBusinessApplicationRequest"
              },
              "examples": {
                "limited_company": {
                  "summary": "Standard limited company application",
                  "value": {
                    "entity_type": "limited_company",
                    "company_number": "12345678",
                    "account_type": "business_current",
                    "channel": "web_portal",
                    "applicant": {
                      "first_name": "Sarah",
                      "last_name": "Thornton",
                      "email": "sarah.thornton@example-tech.co.uk",
                      "phone": "+447700900456",
                      "role_at_company": "director"
                    },
                    "declared_trading_name": "Example Tech Solutions"
                  }
                },
                "sole_trader": {
                  "summary": "Sole trader application (simplified path)",
                  "value": {
                    "entity_type": "sole_trader",
                    "company_number": null,
                    "account_type": "business_current",
                    "channel": "web_portal",
                    "applicant": {
                      "first_name": "Marcus",
                      "last_name": "Webb",
                      "date_of_birth": "1985-04-22",
                      "email": "marcus.webb.plumbing@example.com",
                      "phone": "+447700900789",
                      "role_at_company": "sole_trader"
                    },
                    "declared_trading_name": "Webb Plumbing Services"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Application created successfully. Companies House verification initiated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateBusinessApplicationResponse"
                },
                "example": {
                  "application_id": "a9f3c2e1-4b5d-4e6f-8a7b-9c0d1e2f3a4b",
                  "business_customer_id": "b8e7d6c5-3a2b-4c5d-6e7f-8a9b0c1d2e3f",
                  "application_ref": "BCA-2025-00421",
                  "status": "in_progress",
                  "current_phase": "PH-140",
                  "companies_house_verification_status": "pending",
                  "created_at": "2025-06-15T09:23:11Z",
                  "estimated_completion_business_days": "3-5"
                }
              }
            }
          },
          "400": {
            "description": "Validation error — invalid entity type, invalid company number format, or missing required fields.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict — an active business account application or account already exists for this company number.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Entity type not supported without RM assistance, or company eligibility check failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/business-applications/{application_id}": {
      "get": {
        "operationId": "getBusinessApplication",
        "summary": "Retrieve business application status and details",
        "description": "Returns the current state of a business account opening application, including: current phase, Companies House verification status, director/UBO identification completeness, overall verification status summary, KYC assessment status, and application decision. Sensitive CDD data (PEP results, risk scores) is omitted from this response — accessible only via SVC-014 to authorised compliance staff.\n\nPhase: All phases\nGovernance: MLR 2017 Regulation 40 (record-keeping).",
        "tags": ["Business Applications"],
        "parameters": [
          {
            "name": "application_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID of the business account opening application"
          }
        ],
        "responses": {
          "200": {
            "description": "Application found and returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusinessApplicationStatusResponse"
                },
                "example": {
                  "application_id": "a9f3c2e1-4b5d-4e6f-8a7b-9c0d1e2f3a4b",
                  "business_customer_id": "b8e7d6c5-3a2b-4c5d-6e7f-8a9b0c1d2e3f",
                  "application_ref": "BCA-2025-00421",
                  "status": "in_progress",
                  "current_phase": "PH-142",
                  "companies_house_verification": {
                    "status": "verified",
                    "legal_name": "Example Tech Solutions Ltd",
                    "company_number": "12345678",
                    "verified_at": "2025-06-15T09:23:44Z"
                  },
                  "ubo_identification": {
                    "status": "complete",
                    "ubo_count": 2,
                    "ubos_identified_at": "2025-06-15T09:35:00Z"
                  },
                  "director_count": 2,
                  "identity_verifications": {
                    "required": 3,
                    "completed": 1,
                    "pending": 2,
                    "failed": 0
                  },
                  "kyc_status": "awaiting_verifications",
                  "application_decision": null,
                  "created_at": "2025-06-15T09:23:11Z",
                  "updated_at": "2025-06-15T09:35:00Z"
                }
              }
            }
          },
          "403": {
            "description": "Caller does not have permission to view this application.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Application not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/business-accounts": {
      "post": {
        "operationId": "createBusinessAccount",
        "summary": "Provision a business current account",
        "description": "Creates a BusinessAccount entity for an approved business application. Allocates a business sort code and account number from the commercial banking range. Writes the multi-signatory configuration (authorised users, payment approval threshold, payment rails). Promotes BusinessCustomer.status from 'prospect' to 'active'. Publishes BusinessAccountOpened and BusinessAccountProvisioned domain events. This endpoint is called internally by the SVC-005 decision engine after receiving BusinessKYCCleared — it is NOT called directly by SVC-017 or external services.\n\nPhase: PH-145 (Account Provisioning)\nGovernance: GOV-002-R06, GOV-005-R01.\nIdempotency: Requests with the same application_id return the existing BusinessAccount — no duplicate accounts created.",
        "tags": ["Business Accounts"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBusinessAccountRequest"
              },
              "examples": {
                "standard_provisioning": {
                  "summary": "Standard business account provisioning with dual-authorisation",
                  "value": {
                    "application_id": "a9f3c2e1-4b5d-4e6f-8a7b-9c0d1e2f3a4b",
                    "business_customer_id": "b8e7d6c5-3a2b-4c5d-6e7f-8a9b0c1d2e3f",
                    "account_type": "business_current",
                    "payment_approval_threshold": 5000.00,
                    "authorised_users": [
                      {
                        "email": "sarah.thornton@example-tech.co.uk",
                        "name": "Sarah Thornton",
                        "role": "dual_authoriser"
                      },
                      {
                        "email": "james.chen@example-tech.co.uk",
                        "name": "James Chen",
                        "role": "dual_authoriser"
                      }
                    ],
                    "payment_rails_enabled": ["bacs", "fps", "chaps"],
                    "daily_payment_limit": 250000.00
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Business account provisioned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateBusinessAccountResponse"
                },
                "example": {
                  "business_account_id": "c7d8e9f0-1a2b-3c4d-5e6f-7a8b9c0d1e2f",
                  "business_customer_id": "b8e7d6c5-3a2b-4c5d-6e7f-8a9b0c1d2e3f",
                  "account_number": "62345678",
                  "sort_code": "60-83-21",
                  "iban": "GB29BANK60832162345678",
                  "bic": "BANKGB2L",
                  "account_type": "business_current",
                  "status": "active",
                  "opened_date": "2025-06-18",
                  "payment_approval_threshold": 5000.00,
                  "payment_rails_enabled": ["bacs", "fps", "chaps"],
                  "daily_payment_limit": 250000.00,
                  "fscs_eligible": false,
                  "authorised_users_count": 2
                }
              }
            }
          },
          "400": {
            "description": "Validation error — invalid authorised user configuration or missing required fields.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Application not found or BusinessCustomer record not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Business account already exists for this application (idempotency — returns existing account).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateBusinessAccountResponse"
                }
              }
            }
          },
          "422": {
            "description": "Application not in approved state — account provisioning not permitted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/business-accounts/{account_id}": {
      "get": {
        "operationId": "getBusinessAccount",
        "summary": "Retrieve business account details",
        "description": "Returns business account details including sort code, account number, IBAN, BIC, account status, payment approval configuration, and authorised user count. Does not return the full authorised_users array — use GET /business-accounts/{id}/authorised-users for the full list.\n\nPhase: PH-145 onwards.",
        "tags": ["Business Accounts"],
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Business account found and returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusinessAccountResponse"
                }
              }
            }
          },
          "403": {
            "description": "Caller does not have permission to view this account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Account not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT bearer token issued by SVC-100 (Identity & Access Management). Required for all endpoints. Token must include the calling service's service account claim or an authenticated user session claim."
      }
    },
    "schemas": {
      "CreateBusinessApplicationRequest": {
        "type": "object",
        "required": ["entity_type", "account_type", "channel", "applicant"],
        "properties": {
          "entity_type": {
            "type": "string",
            "enum": ["limited_company", "llp", "partnership", "sole_trader", "charity", "other"],
            "description": "Legal entity type. Determines which verification path is followed."
          },
          "company_number": {
            "type": "string",
            "nullable": true,
            "pattern": "^[A-Z0-9]{8}$",
            "description": "Companies House registration number. Required for limited_company, llp. Null for sole_trader, partnership."
          },
          "account_type": {
            "type": "string",
            "enum": ["business_current", "business_current_multicurrency"],
            "description": "Type of business account being applied for."
          },
          "channel": {
            "type": "string",
            "enum": ["web_portal", "mobile_app", "rm_assisted"],
            "description": "Application channel."
          },
          "applicant": {
            "type": "object",
            "required": ["first_name", "last_name", "email", "phone", "role_at_company"],
            "properties": {
              "first_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "last_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "date_of_birth": {
                "type": "string",
                "format": "date",
                "description": "Required for sole traders and partners. ISO 8601 YYYY-MM-DD."
              },
              "email": {
                "type": "string",
                "format": "email",
                "maxLength": 254
              },
              "phone": {
                "type": "string",
                "pattern": "^\\+[1-9]\\d{6,14}$",
                "description": "E.164 format including country code."
              },
              "role_at_company": {
                "type": "string",
                "enum": ["director", "company_secretary", "sole_trader", "partner", "authorised_signatory"],
                "description": "Applicant's role at the business entity."
              }
            }
          },
          "declared_trading_name": {
            "type": "string",
            "nullable": true,
            "maxLength": 200,
            "description": "Trading name if different from registered legal name."
          }
        }
      },
      "CreateBusinessApplicationResponse": {
        "type": "object",
        "properties": {
          "application_id": {
            "type": "string",
            "format": "uuid"
          },
          "business_customer_id": {
            "type": "string",
            "format": "uuid"
          },
          "application_ref": {
            "type": "string",
            "description": "Human-readable application reference (e.g. BCA-2025-00421). Displayed to PER-002."
          },
          "status": {
            "type": "string",
            "enum": ["in_progress", "pending_verification", "referred", "approved", "declined", "blocked"]
          },
          "current_phase": {
            "type": "string",
            "enum": ["PH-139", "PH-140", "PH-141", "PH-142", "PH-143", "PH-144", "PH-145", "PH-146", "AP-B001"]
          },
          "companies_house_verification_status": {
            "type": "string",
            "enum": ["pending", "verified", "failed", "not_applicable"]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "estimated_completion_business_days": {
            "type": "string",
            "description": "Estimated SLA range for customer communication purposes."
          }
        }
      },
      "BusinessApplicationStatusResponse": {
        "type": "object",
        "properties": {
          "application_id": {
            "type": "string",
            "format": "uuid"
          },
          "business_customer_id": {
            "type": "string",
            "format": "uuid"
          },
          "application_ref": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["in_progress", "pending_verification", "referred", "approved", "declined", "blocked"]
          },
          "current_phase": {
            "type": "string"
          },
          "companies_house_verification": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": ["pending", "verified", "failed", "not_applicable"]
              },
              "legal_name": {
                "type": "string",
                "nullable": true
              },
              "company_number": {
                "type": "string",
                "nullable": true
              },
              "verified_at": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              }
            }
          },
          "ubo_identification": {
            "type": "object",
            "nullable": true,
            "properties": {
              "status": {
                "type": "string",
                "enum": ["pending", "in_progress", "complete"]
              },
              "ubo_count": {
                "type": "integer"
              },
              "ubos_identified_at": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              }
            }
          },
          "director_count": {
            "type": "integer",
            "nullable": true
          },
          "identity_verifications": {
            "type": "object",
            "properties": {
              "required": {
                "type": "integer"
              },
              "completed": {
                "type": "integer"
              },
              "pending": {
                "type": "integer"
              },
              "failed": {
                "type": "integer"
              }
            }
          },
          "kyc_status": {
            "type": "string",
            "enum": ["awaiting_verifications", "in_assessment", "cleared", "referred", "blocked"],
            "description": "High-level KYC status — does not include detail of specific CDD findings."
          },
          "application_decision": {
            "type": "string",
            "nullable": true,
            "enum": ["approved", "declined", "referred"]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateBusinessAccountRequest": {
        "type": "object",
        "required": ["application_id", "business_customer_id", "account_type", "payment_approval_threshold", "authorised_users", "payment_rails_enabled", "daily_payment_limit"],
        "properties": {
          "application_id": {
            "type": "string",
            "format": "uuid",
            "description": "Idempotency key — duplicate requests with the same application_id return the existing account."
          },
          "business_customer_id": {
            "type": "string",
            "format": "uuid"
          },
          "account_type": {
            "type": "string",
            "enum": ["business_current", "business_current_multicurrency"]
          },
          "payment_approval_threshold": {
            "type": "number",
            "format": "decimal",
            "minimum": 0,
            "description": "GBP amount above which payments require dual authorisation."
          },
          "authorised_users": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": ["email", "name", "role"],
              "properties": {
                "email": {
                  "type": "string",
                  "format": "email"
                },
                "name": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": ["sole_authoriser", "dual_authoriser", "payment_initiator", "view_only", "admin"]
                }
              }
            }
          },
          "payment_rails_enabled": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["bacs", "fps", "chaps", "sepa"]
            }
          },
          "daily_payment_limit": {
            "type": "number",
            "format": "decimal",
            "minimum": 0,
            "description": "Aggregate daily outbound payment limit in GBP."
          }
        }
      },
      "CreateBusinessAccountResponse": {
        "type": "object",
        "properties": {
          "business_account_id": {
            "type": "string",
            "format": "uuid"
          },
          "business_customer_id": {
            "type": "string",
            "format": "uuid"
          },
          "account_number": {
            "type": "string",
            "pattern": "^[0-9]{8}$",
            "description": "8-digit UK account number from the commercial banking range."
          },
          "sort_code": {
            "type": "string",
            "pattern": "^[0-9]{2}-[0-9]{2}-[0-9]{2}$",
            "description": "6-digit sort code in XX-XX-XX format."
          },
          "iban": {
            "type": "string",
            "pattern": "^GB[0-9]{2}[A-Z]{4}[0-9]{14}$",
            "description": "22-character UK IBAN."
          },
          "bic": {
            "type": "string",
            "description": "ISO 9362 BIC (8 or 11 characters)."
          },
          "account_type": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["active"]
          },
          "opened_date": {
            "type": "string",
            "format": "date"
          },
          "payment_approval_threshold": {
            "type": "number"
          },
          "payment_rails_enabled": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "daily_payment_limit": {
            "type": "number"
          },
          "fscs_eligible": {
            "type": "boolean",
            "description": "False for limited companies. True for sole traders meeting FSCS eligible depositor criteria."
          },
          "authorised_users_count": {
            "type": "integer"
          }
        }
      },
      "BusinessAccountResponse": {
        "type": "object",
        "properties": {
          "business_account_id": {
            "type": "string",
            "format": "uuid"
          },
          "business_customer_id": {
            "type": "string",
            "format": "uuid"
          },
          "account_number": {
            "type": "string"
          },
          "sort_code": {
            "type": "string"
          },
          "iban": {
            "type": "string"
          },
          "bic": {
            "type": "string"
          },
          "account_type": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "active", "dormant", "closed", "frozen"]
          },
          "opened_date": {
            "type": "string",
            "format": "date"
          },
          "payment_approval_threshold": {
            "type": "number"
          },
          "payment_rails_enabled": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "daily_payment_limit": {
            "type": "number"
          },
          "fscs_eligible": {
            "type": "boolean"
          },
          "authorised_users_count": {
            "type": "integer",
            "description": "Count only — use GET /business-accounts/{id}/authorised-users for the full list."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error_code", "message"],
        "properties": {
          "error_code": {
            "type": "string",
            "description": "Machine-readable error code. Examples: INVALID_ENTITY_TYPE, DUPLICATE_APPLICATION, COMPANY_NOT_FOUND, APPLICATION_NOT_APPROVED."
          },
          "message": {
            "type": "string",
            "description": "Human-readable error description (for internal consumers — not customer-facing)."
          },
          "details": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "issue": {
                  "type": "string"
                }
              }
            }
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "description": "Trace ID for correlation with SVC-103 audit logs."
          }
        }
      }
    }
  }
}
