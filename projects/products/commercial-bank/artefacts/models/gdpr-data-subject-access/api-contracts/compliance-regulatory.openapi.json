{
  "openapi": "3.1.0",
  "info": {
    "title": "Compliance & Regulatory — GDPR SAR API",
    "description": "Subject Access Request (SAR) submission and tracking API exposed by SVC-015 (Compliance Core) for JRN-021. UK GDPR Article 15 compliance. Consumed by SVC-017 (Digital Channels) on behalf of authenticated customers. Requires compliance:read and compliance:write scopes.",
    "version": "1.0.0",
    "x-service-id": "SVC-015",
    "x-capability-id": "CAP-005",
    "x-journey-ids": ["JRN-021"]
  },
  "servers": [{"url": "https://api.bank.internal/compliance/v1", "description": "Internal — production"}],
  "security": [{"BearerAuth": []}],
  "paths": {
    "/sar": {
      "post": {
        "operationId": "submitSar",
        "summary": "Submit a Subject Access Request",
        "description": "Creates a SarCase. Requires SCA-validated customer session. 30-day clock starts from receipt timestamp. Publishes SarCaseOpened (EVT-159). Returns case reference and deadline date.",
        "tags": ["Data Subject Rights"],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SubmitSarRequest"}}}},
        "responses": {
          "201": {"description": "SAR received", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SarSubmissionResponse"}}}},
          "400": {"description": "Validation error — missing required fields"},
          "401": {"description": "Unauthenticated"}
        }
      }
    },
    "/sar/{sar_case_id}": {
      "get": {
        "operationId": "getSarCase",
        "summary": "Get SAR case status",
        "description": "Returns current status of the SAR case including days remaining until deadline and download link (if response is ready).",
        "tags": ["Data Subject Rights"],
        "parameters": [{"name": "sar_case_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
        "responses": {
          "200": {"description": "SAR case detail", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SarCaseDetail"}}}},
          "404": {"description": "SAR case not found or customer does not own this case"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SubmitSarRequest": {
        "type": "object",
        "required": ["sca_assertion_ref"],
        "properties": {
          "sca_assertion_ref": {"type": "string", "description": "SCA assertion reference proving customer identity"},
          "additional_context": {"type": "string", "nullable": true, "description": "Optional: customer may specify date ranges or specific data categories to assist compilation"}
        }
      },
      "SarSubmissionResponse": {
        "type": "object",
        "properties": {
          "sar_case_id": {"type": "string", "format": "uuid"},
          "received_at": {"type": "string", "format": "date-time"},
          "deadline_date": {"type": "string", "format": "date", "description": "30-day deadline (UK GDPR Article 12(3))"},
          "status": {"type": "string", "enum": ["received"]}
        }
      },
      "SarCaseDetail": {
        "type": "object",
        "properties": {
          "sar_case_id": {"type": "string", "format": "uuid"},
          "status": {"type": "string", "enum": ["received", "under_review", "response_ready", "closed"]},
          "received_at": {"type": "string", "format": "date-time"},
          "deadline_date": {"type": "string", "format": "date"},
          "days_remaining": {"type": "integer", "description": "Calendar days remaining until response deadline"},
          "response_download_link": {"type": "string", "nullable": true, "description": "Secure download URL for response pack — populated when status = response_ready or closed"},
          "response_download_expires_at": {"type": "string", "format": "date-time", "nullable": true}
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}
    }
  }
}
