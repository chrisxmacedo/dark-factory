{
  "openapi": "3.1.0",
  "info": {
    "title": "Compliance & Regulatory — Correspondent Banking API",
    "description": "Correspondent banking relationship management API exposed by SVC-015 (Compliance Core) for JRN-023. MLR 2017 Regulation 34 compliance. Internal API consumed by compliance and treasury teams. Requires compliance:write scope.",
    "version": "1.0.0",
    "x-service-id": "SVC-015",
    "x-capability-id": "CAP-005",
    "x-journey-ids": ["JRN-023"]
  },
  "servers": [{"url": "https://api.bank.internal/compliance/v1", "description": "Internal — production"}],
  "security": [{"BearerAuth": []}],
  "paths": {
    "/correspondent-relationships": {
      "post": {
        "operationId": "createCorrespondentRelationship",
        "summary": "Initiate correspondent bank relationship onboarding",
        "description": "Creates a CorrespondentRelationship in status = under_assessment. Triggers EDD assessment and sanctions screening (SVC-014 intra-capability).",
        "tags": ["Correspondent Banking"],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateRelationshipRequest"}}}},
        "responses": {
          "201": {"description": "Relationship created — EDD in progress", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RelationshipSummary"}}}},
          "400": {"description": "Validation error"},
          "403": {"description": "Insufficient permissions"}
        }
      }
    },
    "/correspondent-relationships/{relationship_id}/approve": {
      "post": {
        "operationId": "approveCorrespondentRelationship",
        "summary": "Record Senior Management approval per MLR 2017 R34",
        "description": "SMF holder records approval of the correspondent relationship. Requires SMF attestation reference. Updates status to approved. Publishes CorrespondentEddCompleted (EVT-163).",
        "tags": ["Correspondent Banking"],
        "parameters": [{"name": "relationship_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApproveRelationshipRequest"}}}},
        "responses": {
          "200": {"description": "Relationship approved", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RelationshipSummary"}}}},
          "409": {"description": "Sanctions hit detected — cannot approve"}
        }
      }
    },
    "/correspondent-relationships/{relationship_id}": {
      "get": {
        "operationId": "getCorrespondentRelationship",
        "summary": "Get correspondent relationship status and EDD details",
        "description": "Returns current status of the correspondent relationship.",
        "tags": ["Correspondent Banking"],
        "parameters": [{"name": "relationship_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
        "responses": {
          "200": {"description": "Relationship detail", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RelationshipDetail"}}}},
          "404": {"description": "Not found"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateRelationshipRequest": {
        "type": "object",
        "required": ["correspondent_bank_name", "correspondent_bic", "correspondent_jurisdiction", "currency_corridor"],
        "properties": {
          "correspondent_bank_name": {"type": "string"},
          "correspondent_bic": {"type": "string", "pattern": "^[A-Z]{6}[A-Z2-9][A-NP-Z0-9]([A-Z0-9]{3})?$"},
          "correspondent_jurisdiction": {"type": "string", "minLength": 2, "maxLength": 2},
          "currency_corridor": {"type": "string", "description": "e.g. GBP-KES"}
        }
      },
      "ApproveRelationshipRequest": {
        "type": "object",
        "required": ["sm_attestation_ref"],
        "properties": {
          "sm_attestation_ref": {"type": "string", "description": "SMF holder attestation reference — required per MLR 2017 R34"}
        }
      },
      "RelationshipSummary": {
        "type": "object",
        "properties": {
          "relationship_id": {"type": "string", "format": "uuid"},
          "correspondent_bank_name": {"type": "string"},
          "correspondent_bic": {"type": "string"},
          "currency_corridor": {"type": "string"},
          "status": {"type": "string"},
          "fatf_risk_rating": {"type": "string", "nullable": true},
          "sanctions_hit": {"type": "boolean", "nullable": true}
        }
      },
      "RelationshipDetail": {
        "type": "object",
        "properties": {
          "relationship_id": {"type": "string", "format": "uuid"},
          "correspondent_bank_name": {"type": "string"},
          "correspondent_bic": {"type": "string"},
          "correspondent_jurisdiction": {"type": "string"},
          "currency_corridor": {"type": "string"},
          "status": {"type": "string"},
          "fatf_risk_rating": {"type": "string", "nullable": true},
          "sanctions_hit": {"type": "boolean"},
          "edd_completed_at": {"type": "string", "format": "date-time", "nullable": true},
          "sm_approved_at": {"type": "string", "format": "date-time", "nullable": true},
          "onboarded_at": {"type": "string", "format": "date-time", "nullable": true},
          "annual_review_due_date": {"type": "string", "format": "date", "nullable": true}
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}
    }
  }
}
