{
  "openapi": "3.1.0",
  "info": {
    "title": "Risk Management — Stress Test API",
    "description": "Stress test exercise management API exposed by SVC-012 (Risk Engine) for JRN-022. Internal API consumed by Risk Management team dashboards and SVC-015 (Compliance Core). Requires risk:write and risk:read scopes. Not customer-facing.",
    "version": "1.0.0",
    "x-service-id": "SVC-012",
    "x-capability-id": "CAP-004",
    "x-journey-ids": ["JRN-022"]
  },
  "servers": [{"url": "https://api.bank.internal/risk/v1", "description": "Internal — production"}],
  "security": [{"BearerAuth": []}],
  "paths": {
    "/stress-tests": {
      "post": {
        "operationId": "createStressTestExercise",
        "summary": "Create a new stress test exercise",
        "description": "Initiates a PRA stress test exercise. Loads scenarios and creates StressTestExercise record. Publishes StressTestExerciseStarted (EVT-161). Restricted to privileged internal users (CRO, Risk team).",
        "tags": ["Stress Testing"],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateStressTestRequest"}}}},
        "responses": {
          "201": {"description": "Stress test exercise created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StressTestExerciseSummary"}}}},
          "400": {"description": "Validation error"},
          "403": {"description": "Insufficient permissions — requires risk:write scope"}
        }
      }
    },
    "/stress-tests/{exercise_id}": {
      "get": {
        "operationId": "getStressTestExercise",
        "summary": "Get stress test exercise status and projected outputs",
        "description": "Returns current status of the stress test exercise including projected CET1 trajectories once computed.",
        "tags": ["Stress Testing"],
        "parameters": [{"name": "exercise_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
        "responses": {
          "200": {"description": "Stress test detail", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StressTestExerciseDetail"}}}},
          "404": {"description": "Exercise not found"}
        }
      }
    },
    "/stress-tests/{exercise_id}/confirm-submission": {
      "post": {
        "operationId": "confirmStressTestSubmission",
        "summary": "Confirm PRA submission and record submission reference",
        "description": "CRO confirms that the stress test data package has been submitted to PRA via BEEDS portal. Records pra_submission_ref. Publishes StressTestSubmitted (EVT-162). Updates StressTestExercise status to submitted.",
        "tags": ["Stress Testing"],
        "parameters": [{"name": "exercise_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ConfirmSubmissionRequest"}}}},
        "responses": {
          "200": {"description": "Submission confirmed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StressTestExerciseSummary"}}}},
          "409": {"description": "Already submitted or not in approved_for_submission status"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateStressTestRequest": {
        "type": "object",
        "required": ["exercise_year", "pra_scenario_version", "scenario_type", "pra_deadline"],
        "properties": {
          "exercise_year": {"type": "integer"},
          "pra_scenario_version": {"type": "string"},
          "scenario_type": {"type": "string", "enum": ["severe_adverse", "adverse", "baseline"]},
          "pra_deadline": {"type": "string", "format": "date"}
        }
      },
      "StressTestExerciseSummary": {
        "type": "object",
        "properties": {
          "exercise_id": {"type": "string", "format": "uuid"},
          "exercise_year": {"type": "integer"},
          "status": {"type": "string"},
          "pra_deadline": {"type": "string", "format": "date"},
          "pra_submission_ref": {"type": "string", "nullable": true}
        }
      },
      "StressTestExerciseDetail": {
        "type": "object",
        "properties": {
          "exercise_id": {"type": "string", "format": "uuid"},
          "exercise_year": {"type": "integer"},
          "pra_scenario_version": {"type": "string"},
          "scenario_type": {"type": "string"},
          "status": {"type": "string"},
          "pra_deadline": {"type": "string", "format": "date"},
          "projected_stressed_cet1_y1": {"type": "string", "nullable": true},
          "projected_stressed_cet1_y2": {"type": "string", "nullable": true},
          "projected_stressed_cet1_y3": {"type": "string", "nullable": true},
          "model_validation_sign_off_ref": {"type": "string", "nullable": true},
          "board_approved_at": {"type": "string", "format": "date-time", "nullable": true},
          "submitted_at": {"type": "string", "format": "date-time", "nullable": true}
        }
      },
      "ConfirmSubmissionRequest": {
        "type": "object",
        "required": ["pra_submission_ref", "cro_attestation_ref"],
        "properties": {
          "pra_submission_ref": {"type": "string", "description": "PRA BEEDS portal confirmation reference"},
          "cro_attestation_ref": {"type": "string", "description": "CRO personal attestation reference for the submission"}
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}
    }
  }
}
