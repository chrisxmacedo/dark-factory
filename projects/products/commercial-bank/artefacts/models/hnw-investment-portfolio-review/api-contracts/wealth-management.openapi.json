{
  "openapi": "3.1.0",
  "info": {
    "title": "Wealth Management Capability API",
    "version": "1.0.0",
    "description": "REST API surface published by CAP-006 (Wealth Management / SVC-016) for channel consumption. Covers the HNW portfolio review lifecycle introduced by JRN-015. All endpoints require SM&CR-verified advisor authentication (internal channels) or SCA-authenticated client session (client-facing channel). Internal service routing from the capability API to SVC-016 modules is an L3 concern not documented here.",
    "contact": {
      "name": "Wealth Management Capability Owner"
    }
  },
  "servers": [
    {
      "url": "https://api.bank.internal/wealth/v1",
      "description": "Internal capability API — advisor portal and wealth platform integration"
    }
  ],
  "security": [
    {"BearerAuth": []}
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT issued by SVC-100 (IAM). Scope 'wealth:advisor' required for write operations. Scope 'wealth:client:read' for client-facing read operations. SM&CR fca_register_ref claim must be present for advisor tokens."
      }
    },
    "schemas": {
      "PortfolioReviewRecord": {
        "type": "object",
        "description": "Aggregate root for one portfolio review cycle (ENT-046). Projected view excludes internal advisor notes.",
        "properties": {
          "review_id": {"type": "string", "format": "uuid"},
          "client_id": {"type": "string", "format": "uuid"},
          "advisor_id": {"type": "string"},
          "review_type": {"type": "string", "enum": ["annual", "material_change_triggered", "ad_hoc_client_request"]},
          "scheduled_at": {"type": "string", "format": "date-time"},
          "status": {"type": "string", "enum": ["scheduled", "in_progress", "suitability_pending", "awaiting_client_instruction", "execution_in_progress", "reporting", "completed", "overdue", "cancelled"]},
          "next_review_date": {"type": "string", "format": "date", "nullable": true},
          "review_completed_at": {"type": "string", "format": "date-time", "nullable": true}
        },
        "required": ["review_id", "client_id", "advisor_id", "review_type", "scheduled_at", "status"]
      },
      "SuitabilityAssessmentRequest": {
        "type": "object",
        "description": "Questionnaire responses submitted by the client or captured by the advisor during PH-072.",
        "properties": {
          "questionnaire_version": {"type": "string"},
          "questionnaire_responses": {
            "type": "object",
            "description": "Key-value map of question ID to scored response. Schema validated against questionnaire_version.",
            "additionalProperties": true
          },
          "sustainability_preferences": {
            "type": "object",
            "nullable": true,
            "description": "FCA SDR preference flags: esg_preference_level (none|consider|require), excluded_sectors (array), preferred_labels (array of SDR label IDs)"
          }
        },
        "required": ["questionnaire_version", "questionnaire_responses"]
      },
      "SuitabilityAssessmentResponse": {
        "type": "object",
        "description": "Projected view of SuitabilityAssessment (ENT-047). Advisor scope: full view. Client scope: excludes advisor_notes, head_of_suitability_signoff_notes, suitability_gap_flags, internal_risk_band_mapping.",
        "properties": {
          "assessment_id": {"type": "string", "format": "uuid"},
          "review_id": {"type": "string", "format": "uuid"},
          "updated_risk_profile_score": {"type": "integer", "minimum": 1, "maximum": 10},
          "risk_profile_changed": {"type": "boolean"},
          "status": {"type": "string", "enum": ["in_progress", "gap_analysis_complete", "pending_hofs_signoff", "report_generated", "issued", "acknowledged", "archived"]},
          "suitability_gap_flags": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Advisor-only: instruments no longer suitable. Omitted from client-facing projections.",
            "x-projection": "advisor_only"
          },
          "advisor_notes": {
            "type": "string",
            "nullable": true,
            "description": "Advisor-only internal notes. Omitted from client-facing projections.",
            "x-projection": "advisor_only"
          },
          "ex_post_costs_charges": {"type": "object", "description": "MiFID II ex-post costs and charges disclosure"},
          "ex_ante_costs_charges": {"type": "object", "nullable": true, "description": "MiFID II ex-ante costs for proposed portfolio; populated at PH-074"},
          "suitability_report_document_ref": {"type": "string", "nullable": true, "description": "S3 URI for PDF suitability report; available once status = report_generated"},
          "client_acknowledged_at": {"type": "string", "format": "date-time", "nullable": true},
          "issued_at": {"type": "string", "format": "date-time", "nullable": true}
        }
      },
      "RebalancingRecommendationResponse": {
        "type": "object",
        "description": "Projected view of RebalancingRecommendation (ENT-048). model_weights and investment_committee_override_notes excluded from all projections (encrypted, proprietary).",
        "properties": {
          "recommendation_id": {"type": "string", "format": "uuid"},
          "review_id": {"type": "string", "format": "uuid"},
          "proposed_trades": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "instrument_id": {"type": "string"},
                "instrument_name": {"type": "string"},
                "action": {"type": "string", "enum": ["buy", "sell", "hold"]},
                "amount_gbp": {"type": "number"},
                "target_weight_pct": {"type": "number"},
                "sddr_label": {"type": "string", "nullable": true, "description": "FCA SDR sustainability label if applicable"}
              }
            }
          },
          "target_allocation": {"type": "object", "description": "Asset class target allocation percentages"},
          "current_allocation": {"type": "object", "description": "Current asset class allocation percentages"},
          "performance_vs_benchmark": {"type": "object", "description": "1yr and 3yr return vs benchmark"},
          "ex_post_costs_charges": {"type": "object"},
          "ex_ante_costs_charges": {"type": "object", "nullable": true},
          "client_decision": {"type": "string", "enum": ["pending", "approved", "declined", "partial_approved"]},
          "cash_balance_gbp": {"type": "number", "nullable": true, "description": "Cash balance from CAP-001 if ALT-002 was invoked"}
        }
      },
      "InvestmentInstructionRequest": {
        "type": "object",
        "description": "Client's formal instruction submitted at PH-074.",
        "properties": {
          "instruction_type": {"type": "string", "enum": ["proceed_full", "proceed_partial", "decline"]},
          "partial_trades_approved": {
            "type": "array",
            "items": {"type": "string"},
            "description": "List of instrument_ids approved for execution if instruction_type = proceed_partial. Omit for proceed_full or decline.",
            "nullable": true
          },
          "client_decline_reason": {
            "type": "string",
            "nullable": true,
            "description": "Required if instruction_type = decline. Documents client's stated rationale per COBS 9A."
          }
        },
        "required": ["instruction_type"]
      },
      "PortfolioSnapshotResponse": {
        "type": "object",
        "description": "Projected view of PortfolioSnapshot (ENT-050). Client scope: total_market_value_gbp, asset_allocation, positions (without closing_price detail for advisory), ex_post_total_costs_pct. Advisor scope: full view.",
        "properties": {
          "snapshot_id": {"type": "string", "format": "uuid"},
          "snapshot_type": {"type": "string", "enum": ["pre_review", "post_rebalancing", "intra_review"]},
          "snapshot_at": {"type": "string", "format": "date-time"},
          "total_market_value_gbp": {"type": "number"},
          "asset_allocation": {"type": "object"},
          "positions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "instrument_id": {"type": "string"},
                "instrument_name": {"type": "string"},
                "isin": {"type": "string"},
                "asset_class": {"type": "string"},
                "market_value_gbp": {"type": "number"},
                "weight_pct": {"type": "number"},
                "sddr_label": {"type": "string", "nullable": true}
              }
            }
          },
          "performance_1yr_pct": {"type": "number", "nullable": true},
          "benchmark_return_1yr_pct": {"type": "number", "nullable": true},
          "ex_post_total_costs_pct": {"type": "number", "nullable": true}
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error_code": {"type": "string"},
          "message": {"type": "string"},
          "detail": {"type": "string", "nullable": true},
          "timestamp": {"type": "string", "format": "date-time"}
        },
        "required": ["error_code", "message", "timestamp"]
      }
    }
  },
  "paths": {
    "/portfolio-reviews": {
      "post": {
        "summary": "Create a new portfolio review record",
        "operationId": "createPortfolioReview",
        "description": "PH-071: Wealth Advisor initiates a portfolio review for a client. Creates ENT-046 (PortfolioReviewRecord) and publishes EVT-099 (PortfolioReviewScheduled). Requires scope 'wealth:advisor'.",
        "tags": ["Portfolio Reviews"],
        "security": [{"BearerAuth": ["wealth:advisor"]}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "client_id": {"type": "string", "format": "uuid"},
                  "review_type": {"type": "string", "enum": ["annual", "material_change_triggered", "ad_hoc_client_request"]},
                  "scheduled_at": {"type": "string", "format": "date-time"}
                },
                "required": ["client_id", "review_type", "scheduled_at"]
              },
              "example": {
                "client_id": "a3f4b2c1-0000-4abc-8def-123456789000",
                "review_type": "annual",
                "scheduled_at": "2026-04-22T10:00:00Z"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Portfolio review record created",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/PortfolioReviewRecord"},
                "example": {
                  "review_id": "d1e2f3a4-1111-4bcd-9012-abcdef012345",
                  "client_id": "a3f4b2c1-0000-4abc-8def-123456789000",
                  "advisor_id": "adv-0057",
                  "review_type": "annual",
                  "scheduled_at": "2026-04-22T10:00:00Z",
                  "status": "scheduled",
                  "next_review_date": null,
                  "review_completed_at": null
                }
              }
            }
          },
          "400": {"description": "Invalid request (missing fields, invalid client_id)", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "403": {"description": "Insufficient scope — requires wealth:advisor"},
          "404": {"description": "Client not found"},
          "422": {"description": "Precondition failed — KYC not current for client_id", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}, "example": {"error_code": "KYC_NOT_CURRENT", "message": "Client KYC clearance has lapsed. Review scheduling suspended.", "timestamp": "2026-04-15T09:01:00Z"}}}}
        }
      }
    },
    "/portfolio-reviews/{review_id}": {
      "get": {
        "summary": "Get portfolio review record",
        "operationId": "getPortfolioReview",
        "description": "Retrieve full state of a portfolio review record. Advisor scope returns full record. Client scope (wealth:client:read) returns projected view excluding advisor_notes and compliance flags.",
        "tags": ["Portfolio Reviews"],
        "parameters": [
          {"name": "review_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}
        ],
        "responses": {
          "200": {"description": "Portfolio review record", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PortfolioReviewRecord"}}}},
          "404": {"description": "Review not found"}
        }
      }
    },
    "/portfolio-reviews/client/{client_id}": {
      "get": {
        "summary": "List all portfolio reviews for a client",
        "operationId": "listClientPortfolioReviews",
        "description": "Returns paginated list of portfolio review records for the client. Used by the advisor to view the client's review history and confirm the prior review date for COBS 9A compliance.",
        "tags": ["Portfolio Reviews"],
        "parameters": [
          {"name": "client_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
          {"name": "status", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "default": 10}},
          {"name": "offset", "in": "query", "required": false, "schema": {"type": "integer", "default": 0}}
        ],
        "responses": {
          "200": {"description": "List of portfolio review records", "content": {"application/json": {"schema": {"type": "object", "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/PortfolioReviewRecord"}}, "total": {"type": "integer"}}}}}}
        }
      }
    },
    "/portfolio-reviews/{review_id}/suitability-assessment": {
      "post": {
        "summary": "Submit suitability questionnaire responses",
        "operationId": "submitSuitabilityAssessment",
        "description": "PH-072: Create or update the suitability assessment for the review. Triggers risk profile scoring and gap analysis. Publishes EVT-100 (SuitabilityAssessmentUpdated).",
        "tags": ["Suitability"],
        "parameters": [
          {"name": "review_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/SuitabilityAssessmentRequest"},
              "example": {
                "questionnaire_version": "v3.2",
                "questionnaire_responses": {
                  "loss_tolerance": 7,
                  "investment_horizon": 10,
                  "investment_knowledge": 8,
                  "financial_situation_stability": 9
                },
                "sustainability_preferences": {
                  "esg_preference_level": "consider",
                  "excluded_sectors": ["weapons", "tobacco"],
                  "preferred_labels": ["sustainability_focus", "sustainability_improvers"]
                }
              }
            }
          }
        },
        "responses": {
          "201": {"description": "Suitability assessment created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SuitabilityAssessmentResponse"}}}},
          "400": {"description": "Invalid questionnaire responses"},
          "409": {"description": "Suitability assessment already in issued state — cannot modify"}
        }
      },
      "get": {
        "summary": "Get suitability assessment",
        "operationId": "getSuitabilityAssessment",
        "description": "Retrieve suitability assessment. Advisor scope: full view including gap flags and advisor notes. Client scope: projected view per participant-interaction.json entitlements.",
        "tags": ["Suitability"],
        "parameters": [
          {"name": "review_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}
        ],
        "responses": {
          "200": {"description": "Suitability assessment", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SuitabilityAssessmentResponse"}}}},
          "404": {"description": "No suitability assessment found for review_id"}
        }
      }
    },
    "/portfolio-reviews/{review_id}/suitability-assessment/issue": {
      "post": {
        "summary": "Issue the suitability report to the client",
        "operationId": "issueSuitabilityReport",
        "description": "PH-074: Generates the MiFID II suitability report PDF, marks status = issued, delivers the report to the client portal, and publishes EVT-103 (SuitabilityReportIssued) cross-capability to CAP-005. Blocked if head_of_suitability_signoff_ref is null when required. Publishes EVT-102 (SuitabilityReportGenerated) before delivery.",
        "tags": ["Suitability"],
        "parameters": [
          {"name": "review_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "head_of_suitability_signoff_ref": {"type": "string", "nullable": true, "description": "Required if head_of_suitability_required = true on the assessment"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Suitability report issued", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SuitabilityAssessmentResponse"}}}},
          "409": {
            "description": "Cannot issue — precondition failed",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}, "example": {"error_code": "HOFS_SIGNOFF_REQUIRED", "message": "Head of Suitability sign-off required before report can be issued. Provide head_of_suitability_signoff_ref.", "timestamp": "2026-04-22T11:30:00Z"}}}
          }
        }
      }
    },
    "/portfolio-reviews/{review_id}/suitability-assessment/acknowledge": {
      "post": {
        "summary": "Record client acknowledgement of the suitability report",
        "operationId": "acknowledgeSuitabilityReport",
        "description": "PH-074: Client acknowledges they have read the suitability report. Sets client_acknowledged_at and updates status = acknowledged. Required before trade execution can proceed.",
        "tags": ["Suitability"],
        "security": [{"BearerAuth": ["wealth:client:write"]}],
        "parameters": [
          {"name": "review_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}
        ],
        "responses": {
          "200": {"description": "Acknowledgement recorded", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SuitabilityAssessmentResponse"}}}},
          "409": {"description": "Report not yet issued — cannot acknowledge"}
        }
      }
    },
    "/portfolio-reviews/{review_id}/rebalancing-recommendation": {
      "post": {
        "summary": "Generate rebalancing recommendation",
        "operationId": "createRebalancingRecommendation",
        "description": "PH-073: Advisor triggers generation of the rebalancing recommendation. The system runs the portfolio optimisation model and returns the draft recommendation. Publishes EVT-101 (ClientAccountDataRequested) if cash_balance_requested = true (ALT-002).",
        "tags": ["Recommendations"],
        "parameters": [
          {"name": "review_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cash_balance_requested": {"type": "boolean", "default": false, "description": "If true, triggers ALT-002: async request to CAP-001 for client cash balance. Response is async — recommendation returns with cash_balance_gbp = null initially."}
                }
              }
            }
          }
        },
        "responses": {
          "201": {"description": "Rebalancing recommendation generated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RebalancingRecommendationResponse"}}}},
          "409": {"description": "Suitability assessment not complete — cannot generate recommendation"}
        }
      },
      "get": {
        "summary": "Get rebalancing recommendation",
        "operationId": "getRebalancingRecommendation",
        "description": "Returns current state of the rebalancing recommendation. Client scope excludes model_weights and IC override notes.",
        "tags": ["Recommendations"],
        "parameters": [
          {"name": "review_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}
        ],
        "responses": {
          "200": {"description": "Rebalancing recommendation", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RebalancingRecommendationResponse"}}}},
          "404": {"description": "No recommendation found"}
        }
      }
    },
    "/portfolio-reviews/{review_id}/investment-instruction": {
      "post": {
        "summary": "Submit client investment instruction",
        "operationId": "submitInvestmentInstruction",
        "description": "PH-074: Client submits formal instruction to proceed with (full or partial) rebalancing or to decline. Creates ENT-049 (InvestmentInstruction). Blocked if suitability report not acknowledged. Publishes EVT-104 (InvestmentInstructionReceived). If proceed: triggers PH-075 trade execution asynchronously.",
        "tags": ["Instructions"],
        "security": [{"BearerAuth": ["wealth:client:write"]}],
        "parameters": [
          {"name": "review_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/InvestmentInstructionRequest"},
              "example": {
                "instruction_type": "proceed_full"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Instruction received; trade execution initiated asynchronously if instruction_type != decline",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "instruction_id": {"type": "string", "format": "uuid"},
                    "instruction_type": {"type": "string"},
                    "instructions_given_at": {"type": "string", "format": "date-time"},
                    "execution_status": {"type": "string"}
                  }
                }
              }
            }
          },
          "409": {"description": "Suitability report not acknowledged — cannot accept instruction", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}, "example": {"error_code": "SUITABILITY_NOT_ACKNOWLEDGED", "message": "Client must acknowledge the suitability report before submitting an investment instruction.", "timestamp": "2026-04-22T11:45:00Z"}}}}
        }
      },
      "get": {
        "summary": "Get investment instruction and execution status",
        "operationId": "getInvestmentInstruction",
        "description": "Returns the investment instruction and current execution status. Polls order statuses from custody platform. Advisor scope: full order detail with custody_order_ref and MiFIR transaction refs. Client scope: execution summary only.",
        "tags": ["Instructions"],
        "parameters": [
          {"name": "review_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}
        ],
        "responses": {
          "200": {"description": "Investment instruction with execution status"},
          "404": {"description": "No instruction found for review_id"}
        }
      }
    },
    "/portfolio-reviews/{review_id}/portfolio-snapshot": {
      "get": {
        "summary": "Get portfolio snapshot(s) for the review",
        "operationId": "getPortfolioSnapshot",
        "description": "Returns portfolio snapshots for the review. Without query params: returns latest snapshot. With snapshot_type filter: returns specific snapshot.",
        "tags": ["Portfolio"],
        "parameters": [
          {"name": "review_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
          {"name": "snapshot_type", "in": "query", "required": false, "schema": {"type": "string", "enum": ["pre_review", "post_rebalancing", "intra_review"]}}
        ],
        "responses": {
          "200": {"description": "Portfolio snapshot", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PortfolioSnapshotResponse"}}}},
          "404": {"description": "No snapshot found"}
        }
      }
    },
    "/portfolio-reviews/{review_id}/consumer-duty-evidence": {
      "get": {
        "summary": "Get Consumer Duty evidence record",
        "operationId": "getConsumerDutyEvidence",
        "description": "PH-076: Returns the Consumer Duty fair value evidence record. Advisor and compliance scope: full record. Client scope: service_activities_summary only (fair_value_assessment_score is internal).",
        "tags": ["Compliance"],
        "parameters": [
          {"name": "review_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}
        ],
        "responses": {
          "200": {"description": "Consumer Duty evidence record"},
          "404": {"description": "Evidence record not yet created (PH-076 not complete)"}
        }
      }
    },
    "/portfolio-reviews/{review_id}/complete": {
      "post": {
        "summary": "Mark the portfolio review complete",
        "operationId": "completePortfolioReview",
        "description": "PH-076: Advisor finalises the review. Sets PortfolioReviewRecord.status = completed, creates ConsumerDutyEvidenceRecord (ENT-051), publishes EVT-105 (PortfolioReviewCompleted) and EVT-106 (ConsumerDutyEvidenceCompleted) cross-capability to CAP-005.",
        "tags": ["Portfolio Reviews"],
        "parameters": [
          {"name": "review_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}
        ],
        "responses": {
          "200": {"description": "Review marked complete; post-review report dispatched"},
          "409": {"description": "Review cannot be completed — execution_in_progress or suitability_pending", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
        }
      }
    }
  }
}
