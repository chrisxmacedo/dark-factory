{
  "openapi": "3.1.0",
  "info": {
    "title": "Compliance & Regulatory Capability API — JRN-015 Extension",
    "version": "1.0.0",
    "description": "Extension to the CAP-005 (Compliance & Regulatory / SVC-014) published REST API surface for JRN-015. Adds suitability record query endpoints consumed by the compliance team and regulators. These endpoints expose the lightweight SuitabilityRecord maintained by SVC-014 (not the full SuitabilityAssessment owned by SVC-016). SVC-014 receives suitability data via async events (EVT-103, EVT-106) from SVC-016 — it does not call SVC-016 synchronously.",
    "contact": {
      "name": "Compliance Capability Owner"
    }
  },
  "servers": [
    {
      "url": "https://api.bank.internal/compliance/v1",
      "description": "Internal compliance capability API"
    }
  ],
  "security": [
    {"BearerAuth": []}
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT issued by SVC-100. Scope 'compliance:suitability:read' required for suitability record queries."
      }
    },
    "schemas": {
      "SuitabilityRecord": {
        "type": "object",
        "description": "Lightweight MiFID II suitability record maintained by SVC-014 for compliance audit purposes. Populated from EVT-103 (SuitabilityReportIssued) published by SVC-016. Does NOT contain the full questionnaire data — only the compliance-relevant summary.",
        "properties": {
          "record_id": {"type": "string", "format": "uuid"},
          "assessment_id": {"type": "string", "format": "uuid", "description": "Reference to ENT-047 (SuitabilityAssessment) in SVC-016"},
          "review_id": {"type": "string", "format": "uuid", "description": "Reference to ENT-046 (PortfolioReviewRecord) in SVC-016"},
          "client_id": {"type": "string", "format": "uuid"},
          "advisor_fca_register_ref": {"type": "string", "description": "SM&CR Certified Function reference for accountability"},
          "review_type": {"type": "string", "enum": ["annual", "material_change_triggered", "ad_hoc_client_request"]},
          "risk_profile_score": {"type": "integer", "minimum": 1, "maximum": 10},
          "issued_at": {"type": "string", "format": "date-time"},
          "client_acknowledged_at": {"type": "string", "format": "date-time", "nullable": true},
          "status": {"type": "string", "enum": ["issued", "acknowledged", "archived"]},
          "created_at": {"type": "string", "format": "date-time"}
        },
        "required": ["record_id", "assessment_id", "review_id", "client_id", "advisor_fca_register_ref", "review_type", "risk_profile_score", "issued_at", "status", "created_at"]
      },
      "ConsumerDutyComplianceRecord": {
        "type": "object",
        "description": "Consumer Duty fair value compliance record maintained by SVC-014. Populated from EVT-106 (ConsumerDutyEvidenceCompleted) published by SVC-016. Used for portfolio-level FCA fair value reporting.",
        "properties": {
          "record_id": {"type": "string", "format": "uuid"},
          "evidence_id": {"type": "string", "format": "uuid", "description": "Reference to ENT-051 (ConsumerDutyEvidenceRecord) in SVC-016"},
          "client_id": {"type": "string", "format": "uuid"},
          "period_start": {"type": "string", "format": "date"},
          "period_end": {"type": "string", "format": "date"},
          "fair_value_assessment_score": {"type": "string", "enum": ["fair_value_met", "fair_value_borderline", "fair_value_gap"]},
          "remediation_required": {"type": "boolean"},
          "created_at": {"type": "string", "format": "date-time"}
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error_code": {"type": "string"},
          "message": {"type": "string"},
          "timestamp": {"type": "string", "format": "date-time"}
        }
      }
    }
  },
  "paths": {
    "/suitability-records": {
      "get": {
        "summary": "List suitability records",
        "operationId": "listSuitabilityRecords",
        "description": "Query suitability records maintained by SVC-014 for compliance audit. Supports filtering by client_id, advisor_fca_register_ref, date range, and status. Used by Head of Suitability and compliance team for FCA supervisory response.",
        "tags": ["Suitability Records"],
        "security": [{"BearerAuth": ["compliance:suitability:read"]}],
        "parameters": [
          {"name": "client_id", "in": "query", "required": false, "schema": {"type": "string", "format": "uuid"}},
          {"name": "advisor_fca_register_ref", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "issued_from", "in": "query", "required": false, "schema": {"type": "string", "format": "date"}},
          {"name": "issued_to", "in": "query", "required": false, "schema": {"type": "string", "format": "date"}},
          {"name": "status", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "default": 20}},
          {"name": "offset", "in": "query", "required": false, "schema": {"type": "integer", "default": 0}}
        ],
        "responses": {
          "200": {
            "description": "List of suitability records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {"type": "array", "items": {"$ref": "#/components/schemas/SuitabilityRecord"}},
                    "total": {"type": "integer"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/suitability-records/{record_id}": {
      "get": {
        "summary": "Get a suitability record by ID",
        "operationId": "getSuitabilityRecord",
        "description": "Returns the compliance suitability record for the given ID. Note: this is the CAP-005 compliance copy, not the full SuitabilityAssessment in SVC-016.",
        "tags": ["Suitability Records"],
        "parameters": [
          {"name": "record_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}
        ],
        "responses": {
          "200": {"description": "Suitability record", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SuitabilityRecord"}}}},
          "404": {"description": "Record not found"}
        }
      }
    },
    "/suitability-records/client/{client_id}": {
      "get": {
        "summary": "Get all suitability records for a client",
        "operationId": "getClientSuitabilityHistory",
        "description": "Returns the full suitability review history for a client. Used to verify the COBS 9A 5-year audit trail and confirm annual review compliance. Ordered by issued_at descending.",
        "tags": ["Suitability Records"],
        "parameters": [
          {"name": "client_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
          {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "default": 10}}
        ],
        "responses": {
          "200": {
            "description": "Client suitability history",
            "content": {
              "application/json": {
                "example": {
                  "client_id": "a3f4b2c1-0000-4abc-8def-123456789000",
                  "items": [
                    {
                      "record_id": "c9d8e7f6-2222-4cde-0123-fedcba654321",
                      "assessment_id": "b8c7d6e5-3333-4def-1234-edcba9876543",
                      "review_id": "d1e2f3a4-1111-4bcd-9012-abcdef012345",
                      "client_id": "a3f4b2c1-0000-4abc-8def-123456789000",
                      "advisor_fca_register_ref": "IND654321",
                      "review_type": "annual",
                      "risk_profile_score": 7,
                      "issued_at": "2026-04-22T11:55:00Z",
                      "client_acknowledged_at": "2026-04-22T12:10:00Z",
                      "status": "acknowledged",
                      "created_at": "2026-04-22T11:55:05Z"
                    }
                  ],
                  "total": 1
                }
              }
            }
          }
        }
      }
    },
    "/consumer-duty-records": {
      "get": {
        "summary": "List Consumer Duty fair value compliance records",
        "operationId": "listConsumerDutyRecords",
        "description": "Query Consumer Duty fair value evidence records for portfolio-level compliance reporting. Used by Head of Compliance and Consumer Duty Board Champion for FCA annual fair value assessment submission.",
        "tags": ["Consumer Duty"],
        "parameters": [
          {"name": "client_id", "in": "query", "required": false, "schema": {"type": "string", "format": "uuid"}},
          {"name": "remediation_required", "in": "query", "required": false, "schema": {"type": "boolean"}},
          {"name": "period_from", "in": "query", "required": false, "schema": {"type": "string", "format": "date"}},
          {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "default": 20}}
        ],
        "responses": {
          "200": {
            "description": "Consumer Duty records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {"type": "array", "items": {"$ref": "#/components/schemas/ConsumerDutyComplianceRecord"}},
                    "total": {"type": "integer"}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
