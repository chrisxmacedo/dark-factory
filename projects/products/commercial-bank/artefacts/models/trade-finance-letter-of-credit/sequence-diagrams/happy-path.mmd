sequenceDiagram
    autonumber
    participant PER002 as PER-002<br/>Business Owner
    participant PER050 as PER-050<br/>Relationship Manager
    participant PER059 as PER-059<br/>Trade Finance Ops
    participant SVC006 as SVC-006<br/>Trade Finance Service<br/>(CAP-002)
    participant SVC005 as SVC-005<br/>Commercial Banking Core<br/>(CAP-002)
    participant SVC102 as SVC-102<br/>Event Bus
    participant SVC051 as SVC-051<br/>Sanctions Screening<br/>(CAP-005)
    participant SVC010 as SVC-010<br/>International Payments<br/>(CAP-003)
    participant SVC053 as SVC-053<br/>Notification Service

    rect rgb(230, 245, 255)
        Note over PER002,SVC053: PH-052: LC Application
        PER002->>SVC006: POST /trade-finance/lc-applications<br/>{business_customer_id, lc_type: sight, currency: USD,<br/>amount: 250000, beneficiary: Shanghai Export Trading Co.,<br/>country: CN, BIC: ICBKCNBJXXX,<br/>hs_codes: [846240, 846291], incoterms: CIF,<br/>expiry: 2026-07-21}
        SVC006->>SVC005: GET /business-customers/{id}<br/>(same-capability — validates applicant status)
        SVC005-->>SVC006: 200 OK {status: active}
        SVC006->>SVC006: Creates ENT-036 (LetterOfCredit)<br/>status=application_submitted<br/>credit_status=pending, compliance_status=not_started
        SVC006-)SVC102: EVT-075: LCApplicationSubmitted<br/>topic: commercial.trade-finance
        SVC006-->>PER002: 201 Created {lc_id, lc_reference: LCIMPORT-2026-089}
        SVC102-)SVC053: Delivers EVT-075 → application acknowledgement to PER-002
    end

    rect rgb(255, 248, 220)
        Note over SVC006,SVC005: PH-053: Credit Assessment (same-capability within CAP-002)
        SVC006->>SVC005: GET /business-accounts/{id}<br/>(same-capability — reads facility headroom)
        SVC005-->>SVC006: 200 OK {available_lc_limit: 500000 USD, headroom: 500000 ≥ 250000 ✓}
        SVC006->>SVC006: LetterOfCredit.credit_status = facility_confirmed
    end

    rect rgb(255, 235, 235)
        Note over SVC006,SVC051: PH-054: Compliance Screening (CAP-002/CAP-005 boundary — async only)
        SVC006-)SVC102: EVT-076: LCComplianceScreeningRequested [CROSS-CAPABILITY ▶]<br/>topic: compliance.sanctions-screening<br/>{beneficiary: Shanghai Export Trading Co., country: CN,<br/>hs_codes: [846240, 846291]}
        SVC006->>SVC006: compliance_status = screening_requested<br/>LC suspended — awaiting EVT-077
        SVC102-)SVC051: Delivers EVT-076 [◀ CROSS-CAPABILITY received by CAP-005]
        SVC051->>SVC051: OFSI ✓ OFAC ✓ UN ✓<br/>HS 846240/846291 export control ✓ CLEAR<br/>TBML typology ✓ LOW risk
        SVC051-)SVC102: EVT-077: LCComplianceCleared [CROSS-CAPABILITY ▶]<br/>topic: compliance.sanctions-screening<br/>{screening_result: clear}
        SVC102-)SVC006: Delivers EVT-077 [◀ CROSS-CAPABILITY received by CAP-002]
        SVC006->>SVC006: compliance_status = cleared<br/>Proceeds to PH-055 (LC Issuance)
    end

    rect rgb(240, 255, 240)
        Note over SVC006,SVC010: PH-055: LC Issuance — SWIFT MT700 (CAP-002/CAP-003 boundary — async only)
        SVC006->>SVC006: Formats LC terms per UCP 600 + SWIFT MT700<br/>status=issued, swift_reference=LCIMPORT-2026-089<br/>issue_date=2026-04-15
        SVC006-)SVC102: EVT-078: LCIssued [CROSS-CAPABILITY ▶]<br/>topic: commercial.trade-finance<br/>{advising_bank_bic: ICBKCNBJXXX, amount: USD 250000,<br/>issuance_channel: swift_mt700}
        SVC102-)SVC010: Delivers EVT-078 [◀ CROSS-CAPABILITY received by CAP-003]
        SVC010->>SVC010: Transmits SWIFT MT700 to ICBKCNBJXXX<br/>SWIFT ACK received — MT700 delivered
        SVC102-)SVC053: Delivers EVT-078 → LC issuance confirmation to PER-002
    end

    rect rgb(248, 230, 255)
        Note over PER059,SVC053: PH-056: Document Presentation (8 Jul 2026 — within 21-day limit)
        PER059->>SVC006: POST /trade-finance/lc-applications/{id}/presentations<br/>{presentation_date: 2026-07-08, bl_date: 2026-06-25,<br/>drawing_amount: 250000, channel: physical_courier,<br/>documents: [invoice, BL×3, packing_list, insurance, cert_of_origin]}
        SVC006->>SVC006: Creates ENT-038 (TradeDocument)<br/>presented_on_time=true<br/>examination_deadline=2026-07-15 (5 banking days)
        SVC006-)SVC102: EVT-079: DocumentPresented<br/>topic: commercial.trade-finance {examination_deadline: 2026-07-15}
        SVC006-->>PER059: 201 Created {presentation_id, examination_deadline: 2026-07-15}
        SVC102-)SVC053: Delivers EVT-079 → Trade Finance Ops alert: examination required by 2026-07-15
    end

    rect rgb(230, 255, 245)
        Note over PER059,SVC053: PH-057: Document Examination (completed 2026-07-11 — within 5-banking-day UCP 600 deadline)
        PER059->>PER059: Examines all documents against LC terms:<br/>✓ Invoice: amount USD 250,000, goods description match<br/>✓ BL: full set 3/3, shipped on board 2026-06-25,<br/>  consignee to order, blank endorsed, Felixstowe discharge<br/>✓ Insurance: USD 275,000 (110% CIF), ICC(A), blank endorsed<br/>✓ Cert of origin: Chinese origin, authorised issuer<br/>✓ Packing list: consistent with invoice<br/>RESULT: COMPLIANT
        PER059->>SVC006: POST /presentations/{id}/examination<br/>{examiner_id, examination_result: compliant,<br/>document_findings: [all compliant, 0 discrepancies]}
        SVC006->>SVC006: Creates ENT-039 (DocumentExamination)<br/>result=compliant, discrepancy_count=0
        SVC006-)SVC102: EVT-080: DocumentExamined<br/>topic: commercial.trade-finance {result: compliant}
        SVC006-->>PER059: 201 Created {examination_id, result: compliant, next_action: Settlement proceeding}
        SVC102-)SVC053: Delivers EVT-080 → PER-002 notified: documents accepted, payment follows
    end

    rect rgb(255, 245, 220)
        Note over SVC006,SVC053: PH-058: Settlement — account debit (same-capability) then SWIFT reimbursement (cross-capability)
        SVC006->>SVC005: POST /business-accounts/{id}/debit<br/>{amount: 250000, currency: USD, ref: LCIMPORT-2026-089}<br/>(same-capability — must succeed before SWIFT event)
        SVC005->>SVC005: Debits BusinessAccount (ENT-080)<br/>Creates debit transaction TXN-2026-LC-089
        SVC005-->>SVC006: 200 OK {debit_reference: TXN-2026-LC-089, settlement_confirmed: true}
        SVC006->>SVC006: LetterOfCredit.status = settled<br/>settlement_date=2026-07-11, settlement_amount=250000 USD
        SVC006-)SVC102: EVT-081: LCSettled [CROSS-CAPABILITY ▶]<br/>topic: commercial.trade-finance<br/>{settlement_amount: 250000 USD, advising_bank_bic: ICBKCNBJXXX,<br/>debit_reference: TXN-2026-LC-089}
        SVC102-)SVC010: Delivers EVT-081 [◀ CROSS-CAPABILITY received by CAP-003]
        SVC010->>SVC010: Transmits SWIFT MT202 to ICBKCNBJXXX<br/>USD 250,000 reimbursement — delivery confirmed
        SVC102-)SVC053: Delivers EVT-081 → settlement confirmation to PER-002<br/>(amount debited, beneficiary paid)
    end
