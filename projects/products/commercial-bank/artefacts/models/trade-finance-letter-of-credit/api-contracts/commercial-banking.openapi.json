{
  "openapi": "3.1.0",
  "info": {
    "title": "Commercial Banking — Trade Finance API",
    "description": "SVC-006 (Trade Finance Service) API surface within CAP-002 (Commercial Banking). Exposes endpoints for Letter of Credit application, lifecycle management, document presentation, and examination. This API contract covers the CAP-002 Trade Finance capability — it is NOT a per-service contract. The SVC-006 Trade Finance API is namespaced under the commercial banking API gateway (SVC-101) at /commercial/v1/trade-finance/. All endpoints require Bearer JWT issued by SVC-100 (IAM) with scope commercial.trade-finance. Cross-capability integrations (CAP-005 sanctions, CAP-003 SWIFT) are exclusively async events via SVC-102 — those capability boundaries are NOT exposed as API endpoints.",
    "version": "1.0.0",
    "contact": {
      "name": "Trade Finance Operations Team",
      "email": "trade-finance@bank.internal"
    }
  },
  "servers": [
    {
      "url": "https://api.internal.bank/commercial/v1",
      "description": "Internal API Gateway (SVC-101) — commercial banking namespace"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Letters of Credit",
      "description": "LC application, issuance, and lifecycle management"
    },
    {
      "name": "LC Amendments",
      "description": "Post-issuance LC amendment management"
    },
    {
      "name": "Document Presentations",
      "description": "Document presentation receipt and management"
    },
    {
      "name": "Document Examinations",
      "description": "UCP 600 document examination results and discrepancy management"
    }
  ],
  "paths": {
    "/trade-finance/lc-applications": {
      "post": {
        "operationId": "submitLCApplication",
        "summary": "Submit a new Letter of Credit application",
        "description": "PH-052: Creates a LetterOfCredit (ENT-036) with status = application_submitted. Validates completeness of required fields: beneficiary, goods description, HS codes, Incoterms, shipment/expiry dates, and required document list. Publishes EVT-075 (LCApplicationSubmitted) to topic commercial.trade-finance. Returns the lc_id and lc_reference. Requires the business_customer_id to reference an active BusinessCustomer (ENT-079) created in JRN-004.",
        "tags": ["Letters of Credit"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLCApplicationRequest"
              },
              "example": {
                "business_customer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                "account_id": "b2c3d4e5-f6a7-8901-bcde-f01234567891",
                "lc_type": "sight",
                "currency_iso3": "USD",
                "lc_amount": 250000.00,
                "beneficiary_name": "Shanghai Export Trading Co. Ltd",
                "beneficiary_address": "123 Pudong Avenue, Shanghai, 200120, China",
                "beneficiary_country_iso2": "CN",
                "advising_bank_swift_bic": "ICBKCNBJXXX",
                "advising_bank_name": "Industrial and Commercial Bank of China",
                "goods_description": "Industrial machinery components: CNC lathe spindle assemblies, model XP-2400, as per pro-forma invoice PI-2024-089",
                "hs_tariff_codes": ["846240", "846291"],
                "incoterms_rule": "CIF",
                "port_of_loading": "Shanghai, China",
                "port_of_discharge": "Felixstowe, United Kingdom",
                "latest_shipment_date": "2026-06-30",
                "expiry_date": "2026-07-21",
                "expiry_place": "London, United Kingdom",
                "presentation_period_days": 21,
                "partial_shipments_permitted": false,
                "transshipment_permitted": false,
                "required_documents": [
                  { "document_type": "commercial_invoice", "copies_required": 3, "originals_required": 1, "special_conditions": "Invoice must evidence CIF price including freight and insurance" },
                  { "document_type": "full_set_clean_onboard_bills_of_lading", "copies_required": 0, "originals_required": 3, "special_conditions": "Made out to order of shipper, blank endorsed, notify applicant. Shipped on board notation required. Charter party BL not acceptable." },
                  { "document_type": "packing_list", "copies_required": 2, "originals_required": 1, "special_conditions": "" },
                  { "document_type": "insurance_certificate", "copies_required": 0, "originals_required": 2, "special_conditions": "Covering minimum 110% CIF value, Institute Cargo Clauses (A), endorsed in blank" },
                  { "document_type": "certificate_of_origin", "copies_required": 1, "originals_required": 1, "special_conditions": "Issued by authorised body, certifying goods of Chinese origin" }
                ],
                "channel": "portal",
                "etda_compliant_platform": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "LC application created. EVT-075 published. LC moves to PH-053 credit check.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LCApplicationCreatedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error — missing required fields, invalid HS code format, expiry_date before latest_shipment_date, or required_documents empty.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "404": {
            "description": "BusinessCustomer or BusinessAccount not found or not in active/open status.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "422": {
            "description": "Business rule violation — facility not present, customer not trade-finance enabled, or currency not supported.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/trade-finance/lc-applications/{lc_id}": {
      "get": {
        "operationId": "getLCApplication",
        "summary": "Retrieve an LC application or issued LC by ID",
        "description": "Returns the full LetterOfCredit (ENT-036) record including current status, compliance_status, credit_status, swift_reference (if issued), and lifecycle timestamps. Used by the trade finance portal, RM tools, and Trade Finance Operations.",
        "tags": ["Letters of Credit"],
        "parameters": [
          {
            "name": "lc_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "description": "LetterOfCredit entity identifier"
          }
        ],
        "responses": {
          "200": {
            "description": "LC record returned.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LetterOfCreditResponse" } } }
          },
          "404": {
            "description": "LC not found.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/trade-finance/lc-applications/{lc_id}/discrepancy-waiver": {
      "post": {
        "operationId": "submitDiscrepancyWaiver",
        "summary": "Applicant waives discrepancies identified in document examination",
        "description": "ALT-003: Applicant (PER-002) formally waives discrepancies identified in a DocumentExamination (ENT-039) with result = discrepant. Must be submitted before the UCP 600 5-banking-day examination deadline. On receipt, SVC-006 records the waiver in ENT-039 (applicant_waiver_obtained = true, waiver_received_at populated) and proceeds to PH-058 settlement. Request is idempotent — repeated waivers for the same examination_id are accepted.",
        "tags": ["Letters of Credit"],
        "parameters": [
          {
            "name": "lc_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DiscrepancyWaiverRequest"
              },
              "example": {
                "examination_id": "e9f0a1b2-c3d4-5678-90ef-a1b2c3d4e5f6",
                "waiver_reason": "Goods have been received and are satisfactory. We authorise payment notwithstanding the discrepancy regarding the late shipment date notation.",
                "authorised_by_user_id": "rm-uuid-5678-1234-abcd-ef9876543210"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Waiver recorded. Settlement proceeds. DocumentExamination.applicant_waiver_obtained = true.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WaiverResponse" } } }
          },
          "404": {
            "description": "LC or examination not found.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "409": {
            "description": "Examination result is not discrepant, examination deadline has passed, or LC is not in a waivable status.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/trade-finance/lc-applications/{lc_id}/amendments": {
      "post": {
        "operationId": "createLCAmendment",
        "summary": "Create an LC amendment instruction",
        "description": "ALT-004: Creates an LCAmendment (ENT-037) for an issued LC. The amendment is validated for business rules (e.g. amount_decrease cannot reduce below drawings already made). If the amendment changes beneficiary_name, beneficiary_country, or hs_tariff_codes, compliance_rescreening_required is set to true and EVT-076 is re-published to trigger PH-054 re-screening before the amendment is transmitted. On compliance clearance, SWIFT MT707 is transmitted to advising bank via SVC-010.",
        "tags": ["LC Amendments"],
        "parameters": [
          {
            "name": "lc_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateAmendmentRequest" },
              "example": {
                "amendment_type": ["expiry_extension", "latest_shipment_extension"],
                "amended_fields": {
                  "expiry_date": { "old_value": "2026-07-21", "new_value": "2026-08-21" },
                  "latest_shipment_date": { "old_value": "2026-06-30", "new_value": "2026-07-31" }
                },
                "applicant_instruction_date": "2026-06-15",
                "amendment_justification": "Manufacturer advised 4-week production delay. Extending shipment and expiry dates by 31 days."
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Amendment created. If compliance rescreening required: amendment_status = compliance_screening. If no rescreening required: amendment_status = issued (pending beneficiary acceptance).",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AmendmentCreatedResponse" } } }
          },
          "404": {
            "description": "LC not found or not in issued status.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "409": {
            "description": "Business rule violation — expired LC, amount reduction below existing drawing, or conflicting outstanding amendment.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "get": {
        "operationId": "listLCAmendments",
        "summary": "List all amendments for an LC",
        "description": "Returns all LCAmendment (ENT-037) records for the specified LC, ordered by amendment_number ascending.",
        "tags": ["LC Amendments"],
        "parameters": [
          {
            "name": "lc_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of amendments.",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/LCAmendmentSummary" } } } }
          },
          "404": {
            "description": "LC not found.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/trade-finance/lc-applications/{lc_id}/presentations": {
      "post": {
        "operationId": "registerDocumentPresentation",
        "summary": "Register a document presentation under an issued LC",
        "description": "PH-056: Trade Finance Operations (PER-059) registers receipt of a document set presented under the LC. Creates TradeDocument (ENT-038) with status = received. Publishes EVT-079 (DocumentPresented). Starts the UCP 600 Article 14(b) 5-banking-day examination clock. Validates: presentation_date <= presentation_deadline (calculated from bill_of_lading_date + presentation_period_days, not exceeding expiry_date). For ETDA e-presentations, the document references are provided directly; for physical presentations, SVC-054 storage references are pre-populated by Trade Finance Operations.",
        "tags": ["Document Presentations"],
        "parameters": [
          {
            "name": "lc_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterPresentationRequest" },
              "example": {
                "presentation_date": "2026-07-08",
                "bill_of_lading_date": "2026-06-25",
                "drawing_amount": 250000.00,
                "currency_iso3": "USD",
                "presentation_channel": "physical_courier",
                "documents": [
                  { "document_type": "commercial_invoice", "copies_received": 3, "originals_received": 1, "document_reference": "INV-2026-089", "document_date": "2026-06-22", "issuer": "Shanghai Export Trading Co. Ltd", "storage_reference": "svc054-doc-abc123" },
                  { "document_type": "full_set_clean_onboard_bills_of_lading", "copies_received": 0, "originals_received": 3, "document_reference": "BL-MSC-2026-044", "document_date": "2026-06-25", "issuer": "MSC Mediterranean Shipping Company", "storage_reference": "svc054-doc-abc124" }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Presentation registered. EVT-079 published. 5-banking-day examination clock started.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PresentationRegisteredResponse" } } }
          },
          "404": {
            "description": "LC not found.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "409": {
            "description": "LC not in issued status, presentation received after expiry_date, or drawing_amount exceeds remaining LC balance.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "get": {
        "operationId": "listPresentations",
        "summary": "List all document presentations for an LC",
        "description": "Returns all TradeDocument (ENT-038) presentation records for the LC, ordered by presentation_date ascending.",
        "tags": ["Document Presentations"],
        "parameters": [
          {
            "name": "lc_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of presentations.",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/TradeDocumentSummary" } } } }
          },
          "404": {
            "description": "LC not found.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/trade-finance/lc-applications/{lc_id}/presentations/{presentation_id}/examination": {
      "post": {
        "operationId": "recordDocumentExamination",
        "summary": "Record the UCP 600 document examination result",
        "description": "PH-057: Trade Finance Operations (PER-059) submits the examination result for a document presentation. Creates or updates DocumentExamination (ENT-039). Must be submitted before the examination_deadline (5 banking days from presentation_date). Publishes EVT-080 (DocumentExamined) with examination_result = compliant or discrepant. If deadline has already passed at submission time, examination_result = deadline_missed is forced and a compliance incident is triggered (UCP 600 Article 16(f) preclusion). Examiner_id must hold the required CDCS qualification on file.",
        "tags": ["Document Examinations"],
        "parameters": [
          {
            "name": "lc_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "presentation_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RecordExaminationRequest" },
              "example": {
                "examiner_id": "staff-uuid-pex-001",
                "examination_result": "compliant",
                "document_findings": [
                  { "document_type": "commercial_invoice", "compliant": true, "discrepancies": [] },
                  { "document_type": "full_set_clean_onboard_bills_of_lading", "compliant": true, "discrepancies": [] },
                  { "document_type": "insurance_certificate", "compliant": true, "discrepancies": [] }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Examination recorded. EVT-080 published. If compliant: LC proceeds to PH-058 settlement. If discrepant: applicant notified for waiver decision.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExaminationRecordedResponse" } } }
          },
          "400": {
            "description": "Validation error — examiner not qualified, document_findings incomplete, or result inconsistent with findings.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "404": {
            "description": "LC or presentation not found.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "409": {
            "description": "Examination already recorded for this presentation_id (idempotency violation).",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "get": {
        "operationId": "getDocumentExamination",
        "summary": "Retrieve the examination result for a presentation",
        "description": "Returns the DocumentExamination (ENT-039) record for a specific presentation, including per-document findings and any discrepancy codes with UCP 600 article references.",
        "tags": ["Document Examinations"],
        "parameters": [
          {
            "name": "lc_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "presentation_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Examination record returned.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DocumentExaminationResponse" } } }
          },
          "404": {
            "description": "LC, presentation, or examination not found.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT issued by SVC-100 (IAM). Required scope: commercial.trade-finance. Role-based: PER-002 (applicant — read/submit own LCs), PER-050 (RM — read/submit for customer), PER-059 (examiner — record examinations). MFA enforced for settlement-related mutations per PSR 2017 SCA."
      }
    },
    "schemas": {
      "CreateLCApplicationRequest": {
        "type": "object",
        "required": ["business_customer_id", "account_id", "lc_type", "currency_iso3", "lc_amount", "beneficiary_name", "beneficiary_address", "beneficiary_country_iso2", "advising_bank_swift_bic", "advising_bank_name", "goods_description", "hs_tariff_codes", "incoterms_rule", "port_of_loading", "port_of_discharge", "latest_shipment_date", "expiry_date", "expiry_place", "presentation_period_days", "partial_shipments_permitted", "transshipment_permitted", "required_documents", "channel", "etda_compliant_platform"],
        "properties": {
          "business_customer_id": { "type": "string", "format": "uuid" },
          "account_id": { "type": "string", "format": "uuid" },
          "lc_type": { "type": "string", "enum": ["sight", "usance", "standby", "revolving"] },
          "currency_iso3": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "lc_amount": { "type": "number", "minimum": 1000, "description": "Minimum LC amount £/$/€ 1,000" },
          "tolerance_pct": { "type": "number", "minimum": 0, "maximum": 10, "default": 5 },
          "beneficiary_name": { "type": "string", "maxLength": 140 },
          "beneficiary_address": { "type": "string", "maxLength": 280 },
          "beneficiary_country_iso2": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "advising_bank_swift_bic": { "type": "string", "pattern": "^[A-Z]{6}[A-Z0-9]{2}([A-Z0-9]{3})?$" },
          "advising_bank_name": { "type": "string", "maxLength": 140 },
          "goods_description": { "type": "string", "maxLength": 2000 },
          "hs_tariff_codes": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{6}$" }, "minItems": 1, "maxItems": 20 },
          "incoterms_rule": { "type": "string", "enum": ["EXW", "FCA", "CPT", "CIP", "DAP", "DPU", "DDP", "FAS", "FOB", "CFR", "CIF"] },
          "port_of_loading": { "type": "string", "maxLength": 140 },
          "port_of_discharge": { "type": "string", "maxLength": 140 },
          "latest_shipment_date": { "type": "string", "format": "date" },
          "expiry_date": { "type": "string", "format": "date" },
          "expiry_place": { "type": "string", "maxLength": 140 },
          "presentation_period_days": { "type": "integer", "minimum": 1, "maximum": 21, "default": 21 },
          "usance_period_days": { "type": "integer", "minimum": 1, "description": "Required when lc_type = usance" },
          "partial_shipments_permitted": { "type": "boolean", "default": false },
          "transshipment_permitted": { "type": "boolean", "default": false },
          "required_documents": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["document_type", "copies_required", "originals_required"],
              "properties": {
                "document_type": { "type": "string" },
                "copies_required": { "type": "integer", "minimum": 0 },
                "originals_required": { "type": "integer", "minimum": 0 },
                "special_conditions": { "type": "string", "maxLength": 500 }
              }
            }
          },
          "channel": { "type": "string", "enum": ["portal", "rm_assisted", "api"] },
          "etda_compliant_platform": { "type": "boolean" }
        }
      },
      "LCApplicationCreatedResponse": {
        "type": "object",
        "properties": {
          "lc_id": { "type": "string", "format": "uuid" },
          "lc_reference": { "type": "string", "maxLength": 16 },
          "status": { "type": "string", "enum": ["application_submitted"] },
          "created_at": { "type": "string", "format": "date-time" },
          "next_step": { "type": "string", "example": "Credit assessment — facility headroom check in progress" }
        }
      },
      "LetterOfCreditResponse": {
        "type": "object",
        "properties": {
          "lc_id": { "type": "string", "format": "uuid" },
          "lc_reference": { "type": "string" },
          "business_customer_id": { "type": "string", "format": "uuid" },
          "lc_type": { "type": "string" },
          "status": { "type": "string" },
          "credit_status": { "type": "string" },
          "compliance_status": { "type": "string" },
          "currency_iso3": { "type": "string" },
          "lc_amount": { "type": "number" },
          "beneficiary_name": { "type": "string" },
          "beneficiary_country_iso2": { "type": "string" },
          "advising_bank_swift_bic": { "type": "string" },
          "issue_date": { "type": "string", "format": "date" },
          "expiry_date": { "type": "string", "format": "date" },
          "latest_shipment_date": { "type": "string", "format": "date" },
          "swift_reference": { "type": "string" },
          "settlement_date": { "type": "string", "format": "date" },
          "settlement_amount": { "type": "number" },
          "etda_compliant_platform": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "DiscrepancyWaiverRequest": {
        "type": "object",
        "required": ["examination_id", "waiver_reason", "authorised_by_user_id"],
        "properties": {
          "examination_id": { "type": "string", "format": "uuid" },
          "waiver_reason": { "type": "string", "maxLength": 2000 },
          "authorised_by_user_id": { "type": "string", "format": "uuid" }
        }
      },
      "WaiverResponse": {
        "type": "object",
        "properties": {
          "examination_id": { "type": "string", "format": "uuid" },
          "lc_id": { "type": "string", "format": "uuid" },
          "applicant_waiver_obtained": { "type": "boolean", "example": true },
          "waiver_received_at": { "type": "string", "format": "date-time" },
          "settlement_proceeding": { "type": "boolean", "example": true }
        }
      },
      "CreateAmendmentRequest": {
        "type": "object",
        "required": ["amendment_type", "amended_fields", "applicant_instruction_date"],
        "properties": {
          "amendment_type": {
            "type": "array",
            "items": { "type": "string", "enum": ["amount_increase", "amount_decrease", "expiry_extension", "expiry_reduction", "latest_shipment_extension", "document_change", "beneficiary_change", "terms_change"] }
          },
          "amended_fields": {
            "type": "object",
            "description": "Key-value map of LC fields being amended. Each key is a field name from ENT-036; value is {old_value, new_value}.",
            "additionalProperties": {
              "type": "object",
              "required": ["old_value", "new_value"],
              "properties": {
                "old_value": { "type": "string" },
                "new_value": { "type": "string" }
              }
            }
          },
          "applicant_instruction_date": { "type": "string", "format": "date" },
          "amendment_justification": { "type": "string", "maxLength": 1000 }
        }
      },
      "AmendmentCreatedResponse": {
        "type": "object",
        "properties": {
          "amendment_id": { "type": "string", "format": "uuid" },
          "lc_id": { "type": "string", "format": "uuid" },
          "amendment_number": { "type": "integer" },
          "status": { "type": "string" },
          "compliance_rescreening_required": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "LCAmendmentSummary": {
        "type": "object",
        "properties": {
          "amendment_id": { "type": "string", "format": "uuid" },
          "amendment_number": { "type": "integer" },
          "amendment_type": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string" },
          "applicant_instruction_date": { "type": "string", "format": "date" },
          "issued_date": { "type": "string", "format": "date" },
          "beneficiary_acceptance_date": { "type": "string", "format": "date" }
        }
      },
      "RegisterPresentationRequest": {
        "type": "object",
        "required": ["presentation_date", "bill_of_lading_date", "drawing_amount", "currency_iso3", "presentation_channel", "documents"],
        "properties": {
          "presentation_date": { "type": "string", "format": "date" },
          "bill_of_lading_date": { "type": "string", "format": "date" },
          "drawing_amount": { "type": "number", "minimum": 0.01 },
          "currency_iso3": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "presentation_channel": { "type": "string", "enum": ["physical_courier", "swift_mt750_forwarded", "etda_electronic"] },
          "documents": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["document_type", "copies_received", "originals_received", "document_reference", "document_date", "issuer", "storage_reference"],
              "properties": {
                "document_type": { "type": "string" },
                "copies_received": { "type": "integer", "minimum": 0 },
                "originals_received": { "type": "integer", "minimum": 0 },
                "document_reference": { "type": "string" },
                "document_date": { "type": "string", "format": "date" },
                "issuer": { "type": "string" },
                "storage_reference": { "type": "string", "description": "SVC-054 document identifier for the stored document image/PDF" }
              }
            }
          }
        }
      },
      "PresentationRegisteredResponse": {
        "type": "object",
        "properties": {
          "presentation_id": { "type": "string", "format": "uuid" },
          "lc_id": { "type": "string", "format": "uuid" },
          "presentation_date": { "type": "string", "format": "date" },
          "examination_deadline": { "type": "string", "format": "date", "description": "UCP 600 Article 14(b) deadline — 5 banking days from presentation_date" },
          "presented_on_time": { "type": "boolean" },
          "status": { "type": "string", "example": "received" }
        }
      },
      "TradeDocumentSummary": {
        "type": "object",
        "properties": {
          "presentation_id": { "type": "string", "format": "uuid" },
          "presentation_date": { "type": "string", "format": "date" },
          "drawing_amount": { "type": "number" },
          "currency_iso3": { "type": "string" },
          "status": { "type": "string" },
          "bill_of_lading_date": { "type": "string", "format": "date" }
        }
      },
      "RecordExaminationRequest": {
        "type": "object",
        "required": ["examiner_id", "examination_result", "document_findings"],
        "properties": {
          "examiner_id": { "type": "string", "format": "uuid" },
          "examination_result": { "type": "string", "enum": ["compliant", "discrepant"] },
          "document_findings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["document_type", "compliant"],
              "properties": {
                "document_type": { "type": "string" },
                "compliant": { "type": "boolean" },
                "discrepancies": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["discrepancy_code", "ucp_article", "description"],
                    "properties": {
                      "discrepancy_code": { "type": "string", "description": "Bank-defined discrepancy reference code (e.g. D001-LATE-SHIPMENT)" },
                      "ucp_article": { "type": "string", "description": "UCP 600 Article reference (e.g. UCP600-Art14c)" },
                      "isbp_paragraph": { "type": "string", "description": "ISBP 745 paragraph reference if applicable" },
                      "description": { "type": "string", "maxLength": 500 }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ExaminationRecordedResponse": {
        "type": "object",
        "properties": {
          "examination_id": { "type": "string", "format": "uuid" },
          "presentation_id": { "type": "string", "format": "uuid" },
          "lc_id": { "type": "string", "format": "uuid" },
          "examination_result": { "type": "string" },
          "discrepancy_count": { "type": "integer" },
          "examination_deadline": { "type": "string", "format": "date" },
          "examination_completed_at": { "type": "string", "format": "date-time" },
          "next_action": { "type": "string", "description": "e.g. 'Settlement proceeding' or 'Applicant waiver decision required by {deadline}'" }
        }
      },
      "DocumentExaminationResponse": {
        "type": "object",
        "properties": {
          "examination_id": { "type": "string", "format": "uuid" },
          "presentation_id": { "type": "string", "format": "uuid" },
          "lc_id": { "type": "string", "format": "uuid" },
          "examiner_id": { "type": "string", "format": "uuid" },
          "examination_started_at": { "type": "string", "format": "date-time" },
          "examination_deadline": { "type": "string", "format": "date" },
          "examination_completed_at": { "type": "string", "format": "date-time" },
          "examination_result": { "type": "string" },
          "document_findings": { "type": "array", "items": { "type": "object" } },
          "applicant_waiver_obtained": { "type": "boolean" },
          "waiver_received_at": { "type": "string", "format": "date-time" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error_code", "message"],
        "properties": {
          "error_code": { "type": "string" },
          "message": { "type": "string" },
          "field_errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": { "type": "string" },
                "issue": { "type": "string" }
              }
            }
          },
          "trace_id": { "type": "string", "format": "uuid" }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Bearer token missing or expired.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "Forbidden": {
        "description": "Authenticated user lacks the required scope (commercial.trade-finance) or role for this operation.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "InternalServerError": {
        "description": "Unexpected server error. trace_id is included for SVC-107 (Distributed Tracing) correlation.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      }
    }
  }
}
