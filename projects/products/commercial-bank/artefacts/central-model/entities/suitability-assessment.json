{
  "entity_id": "ENT-047",
  "name": "SuitabilityAssessment",
  "description": "Full MiFID II suitability assessment for one review cycle: questionnaire responses, risk profile scoring, sustainability preferences, gap analysis, and suitability report. Introduced by JRN-015.",
  "owning_service": "SVC-016",
  "owning_capability": "CAP-006",
  "source_journey": "JRN-015",
  "fields": [
    {"name": "assessment_id", "type": "UUID", "validation": "globally unique, immutable"},
    {"name": "review_id", "type": "UUID", "validation": "FK to ENT-046; not null"},
    {"name": "client_id", "type": "UUID", "validation": "FK to ENT-001 (CAP-001); not null"},
    {"name": "questionnaire_version", "type": "string", "validation": "not null"},
    {"name": "questionnaire_responses", "type": "JSON object", "validation": "schema validated; not null"},
    {"name": "updated_risk_profile_score", "type": "integer", "validation": "1..10; computed from questionnaire_responses"},
    {"name": "risk_profile_changed", "type": "boolean", "validation": "computed"},
    {"name": "sustainability_preferences", "type": "JSON object", "validation": "nullable"},
    {"name": "suitability_gap_flags", "type": "JSON array", "validation": "may be empty"},
    {"name": "head_of_suitability_required", "type": "boolean"},
    {"name": "advisor_notes", "type": "string (encrypted)", "validation": "advisor-only; not projected to client"},
    {"name": "suitability_report_document_ref", "type": "string (URI)", "validation": "not null when status=issued"},
    {"name": "client_acknowledged_at", "type": "ISO 8601 UTC datetime", "validation": "nullable"},
    {"name": "status", "type": "enum", "validation": "in_progress | gap_analysis_complete | pending_hofs_signoff | report_generated | issued | acknowledged | archived"},
    {"name": "issued_at", "type": "ISO 8601 UTC datetime", "validation": "nullable"}
  ],
  "relationships": [
    {"entity_id": "ENT-046", "type": "belongs-to"},
    {"entity_id": "ENT-048", "type": "one-to-one"}
  ]
}
