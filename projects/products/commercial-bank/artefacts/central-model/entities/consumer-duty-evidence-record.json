{
  "entity_id": "ENT-051",
  "name": "ConsumerDutyEvidenceRecord",
  "description": "Annual Consumer Duty fair value evidence record for one client review cycle. Documents service activities delivered for fees charged, fair value assessment outcome, and any remediation actions. Required by FCA Consumer Duty (PS22/9). Introduced by JRN-015.",
  "owning_service": "SVC-016",
  "owning_capability": "CAP-006",
  "source_journey": "JRN-015",
  "fields": [
    {
      "name": "evidence_id",
      "type": "UUID",
      "validation": "globally unique, immutable"
    },
    {
      "name": "review_id",
      "type": "UUID",
      "validation": "FK to ENT-046; not null"
    },
    {
      "name": "client_id",
      "type": "UUID",
      "validation": "FK to ENT-001 (CAP-001); not null"
    },
    {
      "name": "period_start",
      "type": "ISO 8601 date",
      "validation": "not null"
    },
    {
      "name": "period_end",
      "type": "ISO 8601 date",
      "validation": "not null"
    },
    {
      "name": "total_fee_charged_gbp",
      "type": "decimal",
      "validation": "not null"
    },
    {
      "name": "fee_basis_pct",
      "type": "decimal",
      "validation": "computed"
    },
    {
      "name": "service_activities_delivered",
      "type": "JSON array",
      "validation": "min 1 item"
    },
    {
      "name": "service_activities_summary",
      "type": "string",
      "validation": "consumer-facing summary; not null"
    },
    {
      "name": "fair_value_assessment_score",
      "type": "enum (encrypted)",
      "validation": "fair_value_met | fair_value_borderline | fair_value_gap; internal only"
    },
    {
      "name": "remediation_required",
      "type": "boolean",
      "validation": "true if fair_value_assessment_score = fair_value_gap"
    },
    {
      "name": "created_at",
      "type": "ISO 8601 UTC datetime",
      "validation": "not null; immutable"
    }
  ],
  "relationships": [
    {
      "entity_id": "ENT-046",
      "type": "belongs-to"
    }
  ],
  "source_journeys": [
    "unknown \u2014 added retroactively"
  ]
}