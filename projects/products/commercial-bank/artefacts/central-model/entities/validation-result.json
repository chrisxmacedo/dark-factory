{
  "id": "ENT-057",
  "name": "ValidationResult",
  "description": "Records the outcome of a validation run against a COREP return. Multiple validation results may exist per return (e.g., initial validation fails, return is corrected, re-validation passes). Each result captures the XBRL validation outcome, variance analysis, and GL reconciliation status.",
  "owning_service": "SVC-015",
  "fields": [
    {
      "name": "validation_id",
      "type": "string",
      "format": "UUID",
      "description": "Unique identifier for this validation run",
      "validation": "Required. UUID v4.",
      "source": "System-generated"
    },
    {
      "name": "return_id",
      "type": "string",
      "description": "Reference to the COREPReturn being validated",
      "validation": "Required. Must reference a valid COREPReturn.",
      "source": "SVC-015 workflow"
    },
    {
      "name": "validation_timestamp",
      "type": "datetime",
      "format": "ISO 8601",
      "description": "When the validation was executed",
      "validation": "Required.",
      "source": "System clock"
    },
    {
      "name": "xbrl_validation_outcome",
      "type": "enum",
      "values": [
        "PASS",
        "FAIL"
      ],
      "description": "Overall XBRL validation result",
      "validation": "Required.",
      "source": "SVC-015 XBRL validation engine"
    },
    {
      "name": "xbrl_error_count",
      "type": "integer",
      "description": "Number of XBRL validation errors",
      "validation": "Required. 0 when outcome is PASS.",
      "source": "SVC-015 XBRL validation engine"
    },
    {
      "name": "xbrl_errors",
      "type": "array",
      "description": "List of XBRL validation errors",
      "items": {
        "template_code": "string",
        "cell_reference": "string",
        "error_type": "string",
        "error_description": "string"
      },
      "source": "SVC-015 XBRL validation engine"
    },
    {
      "name": "variance_analysis",
      "type": "array",
      "description": "Quarter-on-quarter variance analysis per template area",
      "items": {
        "template_code": "string",
        "prior_quarter_value": "decimal",
        "current_quarter_value": "decimal",
        "variance_percentage": "decimal",
        "material_flag": "boolean (true if >10%)",
        "explanation": "string (required if material_flag is true)",
        "approved_by": "string (CRO identity if material)"
      },
      "source": "SVC-015 variance analysis"
    },
    {
      "name": "gl_reconciliation_status",
      "type": "enum",
      "values": [
        "RECONCILED",
        "UNRECONCILED",
        "RECONCILED_WITH_EXCEPTIONS"
      ],
      "description": "GL reconciliation outcome",
      "validation": "Required.",
      "source": "SVC-015 GL reconciliation"
    },
    {
      "name": "gl_reconciliation_differences",
      "type": "array",
      "description": "List of GL reconciliation differences (if any)",
      "items": {
        "item": "string",
        "corep_value": "decimal",
        "gl_value": "decimal",
        "difference": "decimal",
        "explanation": "string"
      },
      "source": "SVC-015 GL reconciliation"
    },
    {
      "name": "independent_review",
      "type": "object",
      "description": "Finance team independent review record",
      "fields": [
        {
          "name": "reviewer_identity",
          "type": "string"
        },
        {
          "name": "review_date",
          "type": "date"
        },
        {
          "name": "outcome",
          "type": "enum",
          "values": [
            "APPROVED",
            "REJECTED",
            "APPROVED_WITH_COMMENTS"
          ]
        },
        {
          "name": "comments",
          "type": "string"
        }
      ],
      "source": "SVC-015 review workflow"
    },
    {
      "name": "overall_outcome",
      "type": "enum",
      "values": [
        "PASS",
        "PASS_WITH_EXCEPTIONS",
        "FAIL"
      ],
      "description": "Combined validation outcome across all checks",
      "validation": "Required.",
      "source": "SVC-015 validation engine"
    }
  ],
  "relationships": [
    {
      "target_entity": "ENT-056",
      "relationship_type": "belongs_to",
      "description": "Each ValidationResult belongs to one COREPReturn"
    }
  ],
  "design_decisions": [],
  "source_journeys": [
    "JRN-017"
  ]
}