{
  "id": "ENT-068",
  "name": "LoanAgreement",
  "description": "The executed consumer credit agreement. Created when customer accepts the loan offer and signs electronically. Contains the legally binding terms. Owned by SVC-001.",
  "owning_service": "SVC-001",
  "fields": [
    {
      "name": "agreement_id",
      "type": "UUID",
      "required": true,
      "description": "Primary key"
    },
    {
      "name": "application_id",
      "type": "UUID",
      "required": true,
      "description": "FK \u2192 LoanApplication (ENT-067)"
    },
    {
      "name": "customer_id",
      "type": "UUID",
      "required": true,
      "description": "FK \u2192 Customer (ENT-001)"
    },
    {
      "name": "loan_account_id",
      "type": "UUID",
      "required": false,
      "description": "FK \u2192 LoanAccount (ENT-069) \u2014 set when drawdown occurs"
    },
    {
      "name": "loan_amount",
      "type": "decimal(10,2)",
      "required": true,
      "description": "Agreed loan amount"
    },
    {
      "name": "term_months",
      "type": "integer",
      "required": true,
      "description": "Agreed term in months"
    },
    {
      "name": "apr",
      "type": "decimal(6,4)",
      "required": true,
      "description": "Final agreed APR \u2014 contractually binding"
    },
    {
      "name": "monthly_repayment",
      "type": "decimal(8,2)",
      "required": true,
      "description": "Contractual monthly repayment amount"
    },
    {
      "name": "total_repayable",
      "type": "decimal(10,2)",
      "required": true,
      "description": "Total amount repayable over the term"
    },
    {
      "name": "first_repayment_date",
      "type": "date",
      "required": true,
      "description": "Date of first repayment (typically 30-31 days after drawdown)"
    },
    {
      "name": "status",
      "type": "enum",
      "required": true,
      "enum_values": [
        "executed",
        "withdrawn",
        "active",
        "settled",
        "defaulted"
      ],
      "description": "Agreement status"
    },
    {
      "name": "withdrawal_deadline",
      "type": "date",
      "required": true,
      "description": "14-day withdrawal right deadline (CCA 1974 s.66A)"
    },
    {
      "name": "sca_assertion_ref",
      "type": "string",
      "required": true,
      "description": "SCA assertion reference for electronic signature \u2014 proves customer authenticated the agreement"
    },
    {
      "name": "agreement_date",
      "type": "date",
      "required": true,
      "description": "Date agreement was executed"
    },
    {
      "name": "repayment_schedule",
      "type": "array",
      "required": true,
      "description": "Full repayment schedule: [{instalment_number, due_date, principal, interest, balance}]"
    }
  ],
  "relationships": [
    {
      "related_entity": "ENT-067",
      "relationship_type": "one_to_one",
      "description": "One LoanAgreement per LoanApplication"
    },
    {
      "related_entity": "ENT-069",
      "relationship_type": "one_to_one",
      "description": "One LoanAgreement produces one LoanAccount on drawdown"
    }
  ],
  "design_decisions": [],
  "source_journeys": [
    "JRN-027"
  ]
}