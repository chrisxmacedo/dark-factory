starter-api/.claude/worktrees/
*/.claude/worktrees/

# Python bytecode from running capability-team scripts
__pycache__/
*.pyc

# macOS
.DS_Store

# Audit logs written by pipeline scripts when a template is run in place
_audit.jsonl

# Machine-local Claude permissions never belong in a starter (one leaked a token)
starter-*/.claude/settings.local.json

# Chief of staff, if the template is exercised in place
teams/chief-of-staff/config/ara.env
teams/chief-of-staff/config/positions.md
teams/chief-of-staff/config/holidays.txt
teams/chief-of-staff/outputs/**
!teams/chief-of-staff/outputs/.gitkeep
teams/chief-of-staff/drafts/**
!teams/chief-of-staff/drafts/.gitkeep
