{
  "openapi": "3.1.0",
  "info": {
    "title": "Customer Onboarding Service API",
    "description": "SVC-050 — Customer Onboarding Service. Orchestrates digital identity verification for JRN-001 (Personal Current Account Opening) and all other onboarding journeys (CAP-002 Commercial Banking, CAP-006 Wealth). This is a cross-cutting shared service (SSC-001) owned by CAP-005 (Compliance & Regulatory).\n\nSVC-050 coordinates with the identity verification vendor (Onfido/Jumio) to perform document authentication, biometric liveness checking, and address verification. It owns the IdentityVerification entity (ENT-002) and publishes the IdentityVerificationCompleted domain event to SVC-102 (Event Bus).\n\nRegulatory context: Identity verification is the first component of Customer Due Diligence (CDD) under MLR 2017 Regulation 27. CDD records must be retained for 5 years (MLR 2017 Regulation 40). Biometric data is Special Category data under UK GDPR Article 9 — biometric templates are never stored; only the verification outcome is persisted. FCA/NCA requests for identity verification records must be satisfied within 2 business days.",
    "version": "1.0.0",
    "contact": {
      "name": "Customer Onboarding Service Team",
      "email": "svc-050-team@bank.internal"
    }
  },
  "servers": [
    {
      "url": "https://api.bank.internal/customer-onboarding/v1",
      "description": "Internal production"
    },
    {
      "url": "https://api.staging.bank.internal/customer-onboarding/v1",
      "description": "Staging"
    }
  ],
  "security": [
    { "BearerAuth": [] }
  ],
  "tags": [
    {
      "name": "IdentityVerifications",
      "description": "Digital identity verification lifecycle. Orchestrates document authentication, biometric liveness check, and address verification via the identity verification vendor (Onfido/Jumio). Owns ENT-002 (IdentityVerification)."
    }
  ],
  "paths": {
    "/identity-verifications": {
      "post": {
        "operationId": "initiateIdentityVerification",
        "summary": "Initiate identity verification",
        "description": "Creates a new IdentityVerification record (ENT-002) and initiates the identity verification workflow with the vendor (Onfido/Jumio). Called by SVC-001 (or the channel orchestrator SVC-017) after ApplicationStarted is received.\n\nThe response includes a vendor_session_token that the client-side SDK (mobile/web) uses to present the document capture and liveness check UI directly to the customer via the vendor's SDK. The SDK communicates directly with the vendor; SVC-050 receives the result via a vendor webhook.\n\nPhase: PH-002 (Identity Verification)\nGovernance: MLR 2017 Reg 27, UK GDPR Article 9, GOV-005-R01.",
        "tags": ["IdentityVerifications"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/InitiateVerificationRequest" },
              "examples": {
                "mobile_passport": {
                  "summary": "Initiate passport verification via mobile app",
                  "value": {
                    "application_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                    "customer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                    "channel": "mobile_app",
                    "document_type": "passport",
                    "verification_provider_preference": "onfido",
                    "customer_name": {
                      "first_name": "Amara",
                      "last_name": "Okonkwo"
                    },
                    "date_of_birth": "1992-07-15",
                    "residential_address": {
                      "line1": "14 Thornfield Road",
                      "city": "Manchester",
                      "postcode": "M14 7PJ",
                      "country_code": "GB"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Identity verification initiated. Returns vendor SDK session token for client-side document capture and liveness check.",
            "headers": {
              "Location": {
                "description": "URL of the created identity verification resource.",
                "schema": { "type": "string", "format": "uri" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InitiateVerificationResponse" },
                "examples": {
                  "initiated": {
                    "value": {
                      "verification_id": "f1e2d3c4-b5a6-7890-1234-567890abcdef",
                      "application_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "customer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                      "status": "pending",
                      "document_type": "passport",
                      "verification_provider": "onfido",
                      "vendor_sdk_token": "eyJhbGciOiJFUzI1NiJ9.eyJleHAiOjE3MTMxNjk5OTksInBheWxvYWQiOnsiYXBwIjoiam9iLWlkIn19.EXAMPLE",
                      "vendor_sdk_token_expires_at": "2026-04-15T10:12:01Z",
                      "retry_count": 0,
                      "max_retries": 2,
                      "created_at": "2026-04-15T09:12:01Z"
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": {
            "description": "Conflict. An active identity verification already exists for this application.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "already_exists": {
                    "value": {
                      "error_code": "VERIFICATION_ALREADY_ACTIVE",
                      "message": "An active identity verification already exists for this application.",
                      "detail": "Use GET /identity-verifications/{id} to check the current status, or POST /identity-verifications/{id}/retry if the verification failed.",
                      "correlation_id": "req-abc-123"
                    }
                  }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/identity-verifications/{id}": {
      "get": {
        "operationId": "getIdentityVerification",
        "summary": "Get identity verification result",
        "description": "Returns the current state of an IdentityVerification record (ENT-002). Polled by SVC-001 and SVC-017 to determine whether identity verification has completed before allowing progression to PH-003. The IdentityVerificationCompleted event on SVC-102 is the preferred signal for event-driven consumers; this endpoint is for polling fallback and compliance record retrieval.\n\nSensitive fields (document_number, biometric_match_score, vendor_fraud_signals) are access-controlled: only services with the scope `identity-verification:compliance:read` (i.e. MLRO tooling) receive those fields. Standard consumers receive the outcome and public metadata only.",
        "tags": ["IdentityVerifications"],
        "parameters": [
          { "$ref": "#/components/parameters/VerificationId" }
        ],
        "responses": {
          "200": {
            "description": "Identity verification found.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IdentityVerificationResponse" },
                "examples": {
                  "pass": {
                    "summary": "Verification passed",
                    "value": {
                      "verification_id": "f1e2d3c4-b5a6-7890-1234-567890abcdef",
                      "application_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "customer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                      "status": "completed",
                      "outcome": "pass",
                      "document_type": "passport",
                      "document_expiry": "2030-07-14",
                      "address_verification_result": "confirmed",
                      "verification_provider": "onfido",
                      "verification_timestamp": "2026-04-15T09:12:45Z",
                      "retry_count": 0,
                      "branch_staff_id": null,
                      "created_at": "2026-04-15T09:12:01Z",
                      "updated_at": "2026-04-15T09:12:45Z"
                    }
                  },
                  "pending": {
                    "summary": "Verification in progress",
                    "value": {
                      "verification_id": "f1e2d3c4-b5a6-7890-1234-567890abcdef",
                      "application_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "customer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                      "status": "pending",
                      "outcome": null,
                      "document_type": "passport",
                      "document_expiry": null,
                      "address_verification_result": null,
                      "verification_provider": "onfido",
                      "verification_timestamp": null,
                      "retry_count": 0,
                      "created_at": "2026-04-15T09:12:01Z",
                      "updated_at": "2026-04-15T09:12:01Z"
                    }
                  },
                  "fail": {
                    "summary": "Verification failed (retry available)",
                    "value": {
                      "verification_id": "f1e2d3c4-b5a6-7890-1234-567890abcdef",
                      "application_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "customer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                      "status": "failed",
                      "outcome": "fail",
                      "document_type": "uk_driving_licence",
                      "document_expiry": null,
                      "address_verification_result": "unconfirmed",
                      "verification_provider": "onfido",
                      "verification_timestamp": "2026-04-15T09:14:00Z",
                      "retry_count": 1,
                      "max_retries": 2,
                      "retry_available": true,
                      "created_at": "2026-04-15T09:12:01Z",
                      "updated_at": "2026-04-15T09:14:00Z"
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/identity-verifications/{id}/retry": {
      "post": {
        "operationId": "retryIdentityVerification",
        "summary": "Retry failed identity verification",
        "description": "Creates a new verification attempt for a failed IdentityVerification. The customer may retry up to 2 times (retry_count max = 2, set per participant-interaction.json PH-002 entitlements). A new vendor SDK token is issued for the retry attempt. The customer may optionally switch to a different document type for the retry.\n\nIf retry_count has reached the maximum (2), this endpoint returns 422 and the application must be referred to the branch fallback path or EX-003.\n\nPhase: PH-002 retry\nGovernance: MLR 2017 Reg 27.",
        "tags": ["IdentityVerifications"],
        "parameters": [
          { "$ref": "#/components/parameters/VerificationId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RetryVerificationRequest" },
              "examples": {
                "retry_with_alternative_doc": {
                  "summary": "Retry with passport instead of driving licence",
                  "value": {
                    "document_type": "passport",
                    "retry_reason": "previous_document_unclear"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Retry initiated. New vendor SDK token issued.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InitiateVerificationResponse" },
                "examples": {
                  "retry_initiated": {
                    "value": {
                      "verification_id": "f1e2d3c4-b5a6-7890-1234-567890abcdef",
                      "application_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "customer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                      "status": "pending",
                      "document_type": "passport",
                      "verification_provider": "onfido",
                      "vendor_sdk_token": "eyJhbGciOiJFUzI1NiJ9.RETRY.EXAMPLE",
                      "vendor_sdk_token_expires_at": "2026-04-15T10:14:30Z",
                      "retry_count": 2,
                      "max_retries": 2,
                      "created_at": "2026-04-15T09:12:01Z"
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "Conflict. The verification is not in a retryable state (e.g. already passed, or fraud_detected).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "not_retryable": {
                    "value": {
                      "error_code": "VERIFICATION_NOT_RETRYABLE",
                      "message": "This verification cannot be retried.",
                      "detail": "Verification outcome is 'fraud_detected'. Retry is not permitted. Application suspended per EX-003 path.",
                      "correlation_id": "req-bcd-234"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity. Maximum retry count reached.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "max_retries": {
                    "value": {
                      "error_code": "MAX_RETRIES_EXCEEDED",
                      "message": "Maximum retry attempts (2) have been exhausted for this verification.",
                      "detail": "Customer should be directed to branch fallback or contact support.",
                      "correlation_id": "req-cde-345"
                    }
                  }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Service-to-service JWT issued by SVC-100 (Identity & Access Management). Required scopes per endpoint: POST /identity-verifications requires `identity-verification:write`; GET requires `identity-verification:read`; POST /retry requires `identity-verification:write`."
      }
    },
    "parameters": {
      "VerificationId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "RFC 4122 UUID v4 identifier of the IdentityVerification (ENT-002).",
        "schema": { "type": "string", "format": "uuid" },
        "example": "f1e2d3c4-b5a6-7890-1234-567890abcdef"
      }
    },
    "schemas": {
      "InitiateVerificationRequest": {
        "type": "object",
        "required": ["application_id", "customer_id", "channel", "document_type", "customer_name", "date_of_birth", "residential_address"],
        "properties": {
          "application_id": { "type": "string", "format": "uuid" },
          "customer_id": { "type": "string", "format": "uuid" },
          "channel": {
            "type": "string",
            "enum": ["mobile_app", "web_portal", "branch"]
          },
          "document_type": {
            "type": "string",
            "enum": ["passport", "uk_driving_licence", "national_identity_card"],
            "description": "Identity document type selected by customer. Maps to IdentityVerification.document_type (ENT-002)."
          },
          "verification_provider_preference": {
            "type": "string",
            "enum": ["onfido", "jumio"],
            "nullable": true,
            "description": "Optional preferred vendor. SVC-050 may override based on vendor availability and routing rules."
          },
          "customer_name": {
            "type": "object",
            "required": ["first_name", "last_name"],
            "properties": {
              "first_name": { "type": "string", "maxLength": 100 },
              "last_name": { "type": "string", "maxLength": 100 }
            }
          },
          "date_of_birth": {
            "type": "string",
            "format": "date",
            "description": "ISO 8601. Used as a CDD matching field against the document."
          },
          "residential_address": {
            "$ref": "#/components/schemas/AddressBrief",
            "description": "Customer's declared residential address. Used for address verification against electoral roll/credit bureau."
          }
        }
      },
      "InitiateVerificationResponse": {
        "type": "object",
        "properties": {
          "verification_id": { "type": "string", "format": "uuid" },
          "application_id": { "type": "string", "format": "uuid" },
          "customer_id": { "type": "string", "format": "uuid" },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "completed", "failed"],
            "description": "Current status of the verification workflow."
          },
          "document_type": { "type": "string" },
          "verification_provider": {
            "type": "string",
            "enum": ["onfido", "jumio", "manual_branch"]
          },
          "vendor_sdk_token": {
            "type": "string",
            "description": "JWT SDK token for the client-side Onfido/Jumio SDK. Used by the mobile app or web SDK to present the document capture and liveness check UI. Not logged — short-lived (1 hour)."
          },
          "vendor_sdk_token_expires_at": { "type": "string", "format": "date-time" },
          "retry_count": { "type": "integer", "minimum": 0, "maximum": 2 },
          "max_retries": { "type": "integer", "default": 2 },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "IdentityVerificationResponse": {
        "type": "object",
        "description": "IdentityVerification record (ENT-002). Biometric templates and document images are not included. Sensitive fields (biometric_match_score, document_number) returned only to compliance-scoped callers.",
        "properties": {
          "verification_id": { "type": "string", "format": "uuid" },
          "application_id": { "type": "string", "format": "uuid" },
          "customer_id": { "type": "string", "format": "uuid" },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "completed", "failed", "suspended"]
          },
          "outcome": {
            "type": "string",
            "enum": ["pass", "refer", "fail", "fraud_detected"],
            "nullable": true,
            "description": "Terminal outcome. null if status is not completed or failed. 'fraud_detected' triggers EX-003."
          },
          "document_type": {
            "type": "string",
            "enum": ["passport", "uk_driving_licence", "national_identity_card"]
          },
          "document_expiry": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "Document expiry date from OCR. null if not yet completed."
          },
          "address_verification_result": {
            "type": "string",
            "enum": ["confirmed", "unconfirmed", "manual_required"],
            "nullable": true
          },
          "verification_provider": {
            "type": "string",
            "enum": ["onfido", "jumio", "manual_branch"]
          },
          "verification_timestamp": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Timestamp of the vendor's result. Immutable once set."
          },
          "retry_count": { "type": "integer", "minimum": 0, "maximum": 2 },
          "max_retries": { "type": "integer" },
          "retry_available": {
            "type": "boolean",
            "description": "True if retry_count < max_retries and outcome is 'fail' (not 'fraud_detected')."
          },
          "branch_staff_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Populated only for manual_branch verification_provider."
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "RetryVerificationRequest": {
        "type": "object",
        "required": ["document_type"],
        "properties": {
          "document_type": {
            "type": "string",
            "enum": ["passport", "uk_driving_licence", "national_identity_card"],
            "description": "Document type for the retry attempt. May differ from the original attempt."
          },
          "retry_reason": {
            "type": "string",
            "enum": ["previous_document_unclear", "wrong_document_type", "liveness_check_failed", "camera_issue"],
            "nullable": true,
            "description": "Reason for retry. Used for audit and vendor analytics."
          }
        }
      },
      "AddressBrief": {
        "type": "object",
        "required": ["line1", "city", "postcode", "country_code"],
        "properties": {
          "line1": { "type": "string", "maxLength": 100 },
          "city": { "type": "string", "maxLength": 100 },
          "postcode": { "type": "string" },
          "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error_code", "message", "correlation_id"],
        "properties": {
          "error_code": { "type": "string" },
          "message": { "type": "string" },
          "detail": { "type": "string", "nullable": true },
          "correlation_id": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad Request.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Forbidden": {
        "description": "Forbidden.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "NotFound": {
        "description": "Not Found.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "InternalServerError": {
        "description": "Internal Server Error.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    }
  }
}
