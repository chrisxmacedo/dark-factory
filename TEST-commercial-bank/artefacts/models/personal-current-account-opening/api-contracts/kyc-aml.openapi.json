{
  "openapi": "3.1.0",
  "info": {
    "title": "KYC/AML Service API",
    "description": "SVC-014 — KYC/AML Service. Initiates and manages Customer Due Diligence (CDD) assessments for JRN-001 (Personal Current Account Opening). Owns the KycAssessment entity (ENT-003) and is the MLRO's system of record for all CDD data.\n\nSVC-014 orchestrates: PEP screening (against ComplyAdvantage/Refinitiv World-Check), adverse media screening, automated risk scoring, and EDD referral for high-risk applicants. Sanctions screening is delegated to SVC-051 (Sanctions Screening Service) which is called synchronously from SVC-014's initiation flow. The sanctions result is persisted within KycAssessment.\n\nRegulatory context: MLR 2017 Regulations 27–35 govern CDD requirements. Regulation 33 requires EDD for PEPs. CDD records retained for 5 years (Regulation 40). No account may be provisioned without a KYCClearanceGranted event from SVC-014. The Starling Bank FCA fine (£29m, October 2024) for incomplete screening coverage establishes a direct enforcement precedent — 100% applicant coverage is mandatory.",
    "version": "1.0.0",
    "contact": {
      "name": "KYC/AML Service Team",
      "email": "svc-014-team@bank.internal"
    }
  },
  "servers": [
    {
      "url": "https://api.bank.internal/kyc-aml/v1",
      "description": "Internal production"
    },
    {
      "url": "https://api.staging.bank.internal/kyc-aml/v1",
      "description": "Staging"
    }
  ],
  "security": [
    { "BearerAuth": [] }
  ],
  "tags": [
    {
      "name": "KYCAssessments",
      "description": "CDD assessment lifecycle. Manages PEP screening, adverse media screening, risk scoring, and EDD escalation. Owns ENT-003 (KycAssessment). Sanctions screening is synchronously delegated to SVC-051."
    }
  ],
  "paths": {
    "/kyc-assessments": {
      "post": {
        "operationId": "initiateKycAssessment",
        "summary": "Initiate CDD assessment",
        "description": "Creates a new KycAssessment record (ENT-003) and initiates the full CDD workflow: (1) sanctions screening via SVC-051 (synchronous, hard 3,000ms limit per nfr.json GOV-005-R02), (2) PEP screening via ComplyAdvantage/Refinitiv World-Check, (3) adverse media screening, (4) automated risk scoring. Triggered by receipt of the IdentityVerificationCompleted event from SVC-050, or called directly by integration tests.\n\nThe assessment may be completed synchronously if all checks pass quickly (rare) or proceed asynchronously — poll GET /kyc-assessments/{id} or subscribe to KYCClearanceGranted / KYCReferralRaised / SanctionsHitDetected events on SVC-102.\n\nPhase: PH-003 (KYC/CDD Assessment)\nGovernance: MLR 2017 Regs 27–35, GOV-005-R01, GOV-005-R02.",
        "tags": ["KYCAssessments"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/InitiateKycAssessmentRequest" },
              "examples": {
                "standard_cdd": {
                  "summary": "Standard CDD assessment for UK national",
                  "value": {
                    "application_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                    "customer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                    "identity_verification_id": "f1e2d3c4-b5a6-7890-1234-567890abcdef",
                    "verified_identity": {
                      "first_name": "Amara",
                      "last_name": "Okonkwo",
                      "date_of_birth": "1992-07-15",
                      "nationality": ["GB"],
                      "tax_residency": ["GB"],
                      "residential_address": {
                        "line1": "14 Thornfield Road",
                        "city": "Manchester",
                        "postcode": "M14 7PJ",
                        "country_code": "GB"
                      }
                    },
                    "occupation": "Software Engineer",
                    "source_of_funds": "employment",
                    "account_type": "standard_current"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "KYC assessment accepted and in progress. The assessment may complete asynchronously. Subscribe to KYCClearanceGranted, KYCReferralRaised, or SanctionsHitDetected events on SVC-102 for the outcome, or poll GET /kyc-assessments/{id}.",
            "headers": {
              "Location": {
                "description": "URL of the created KYC assessment resource.",
                "schema": { "type": "string", "format": "uri" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/KycAssessmentResponse" },
                "examples": {
                  "in_progress": {
                    "value": {
                      "assessment_id": "9c8b7a65-4321-fedc-ba98-765432109876",
                      "application_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "customer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                      "status": "in_progress",
                      "sanctions_screening_status": "in_progress",
                      "pep_screening_status": "in_progress",
                      "adverse_media_status": "in_progress",
                      "risk_score": null,
                      "risk_category": null,
                      "edd_required": false,
                      "mlro_referral": false,
                      "assessor": "automated",
                      "assessment_date": null,
                      "next_review_date": null,
                      "created_at": "2026-04-15T09:12:46Z",
                      "updated_at": "2026-04-15T09:12:46Z"
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": {
            "description": "Conflict. A KYC assessment already exists for this application.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "already_exists": {
                    "value": {
                      "error_code": "ASSESSMENT_ALREADY_EXISTS",
                      "message": "A KYC assessment already exists for application 3fa85f64-5717-4562-b3fc-2c963f66afa6.",
                      "correlation_id": "req-efg-567"
                    }
                  }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/kyc-assessments/{id}": {
      "get": {
        "operationId": "getKycAssessment",
        "summary": "Get CDD assessment result",
        "description": "Returns the current state of a KycAssessment record (ENT-003). This is the authoritative CDD record for the customer at onboarding — consumed by SVC-001 (to gate account provisioning), compliance tooling (MLRO access), and pKYC monitoring systems.\n\nAccess control: Fields pep_screening_result.match_detail, sanctions_screening_result.match_detail, and mlro_referral details are restricted to callers with the `kyc-assessment:compliance:read` scope (MLRO/compliance tooling only). Standard consumers (SVC-001, SVC-017) receive outcome summary fields only. This design enforces the tipping-off prohibition (POCA 2002 s333A) at the API layer.",
        "tags": ["KYCAssessments"],
        "parameters": [
          { "$ref": "#/components/parameters/AssessmentId" }
        ],
        "responses": {
          "200": {
            "description": "KYC assessment found.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/KycAssessmentResponse" },
                "examples": {
                  "cleared": {
                    "summary": "Assessment complete — KYCClearanceGranted",
                    "value": {
                      "assessment_id": "9c8b7a65-4321-fedc-ba98-765432109876",
                      "application_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "customer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                      "status": "cleared",
                      "sanctions_screening_status": "clear",
                      "pep_screening_status": "clear",
                      "adverse_media_status": "clear",
                      "risk_score": 22,
                      "risk_category": "simplified",
                      "edd_required": false,
                      "mlro_referral": false,
                      "assessor": "automated",
                      "assessment_date": "2026-04-15",
                      "next_review_date": "2031-04-15",
                      "created_at": "2026-04-15T09:12:46Z",
                      "updated_at": "2026-04-15T09:13:10Z"
                    }
                  },
                  "referred_pep": {
                    "summary": "Assessment referred — PEP identified, EDD required",
                    "value": {
                      "assessment_id": "c3d4e5f6-2222-3333-4444-555566667777",
                      "application_id": "a1a2a3a4-0000-1111-2222-333344445555",
                      "customer_id": "b2b3b4b5-1111-2222-3333-444455556666",
                      "status": "referred",
                      "sanctions_screening_status": "clear",
                      "pep_screening_status": "match",
                      "adverse_media_status": "clear",
                      "risk_score": 74,
                      "risk_category": "enhanced",
                      "edd_required": true,
                      "mlro_referral": true,
                      "referral_reason": "pep_identified",
                      "assessor": "automated",
                      "assessment_date": "2026-04-15",
                      "next_review_date": "2027-04-15",
                      "created_at": "2026-04-15T09:12:46Z",
                      "updated_at": "2026-04-15T09:13:15Z"
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/kyc-assessments/{id}/edd-referral": {
      "post": {
        "operationId": "escalateToEdd",
        "summary": "Escalate assessment to Enhanced Due Diligence",
        "description": "Escalates a KycAssessment to Enhanced Due Diligence (EDD) under AP-001 (Manual Referral — EDD Required). This endpoint is called by: (a) the automated risk engine when risk_category = enhanced or pep_screening_result.status = match (system-initiated EDD), or (b) MLRO tooling when the compliance officer decides manual escalation is required.\n\nSets edd_required = true and mlro_referral = true on the KycAssessment. Publishes KYCReferralRaised event to SVC-102. The application is suspended pending EDD completion. MLRO sign-off is required before KYCClearanceGranted can be published.\n\nPhase: AP-001 (EDD escalation)\nGovernance: MLR 2017 Regulation 33 (EDD for PEPs and high-risk customers), GOV-005-R06.",
        "tags": ["KYCAssessments"],
        "parameters": [
          { "$ref": "#/components/parameters/AssessmentId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EddReferralRequest" },
              "examples": {
                "pep_referral": {
                  "summary": "EDD referral — PEP identified",
                  "value": {
                    "referral_reason": "pep_identified",
                    "referral_notes": "Applicant matched against ComplyAdvantage World-Check PEP database. Position: Former Member of Parliament, Country: GB. EDD required per MLR 2017 Regulation 33.",
                    "initiated_by": "automated",
                    "initiated_at": "2026-04-15T09:13:15Z"
                  }
                },
                "high_risk_manual": {
                  "summary": "EDD referral — high risk score, manual escalation by compliance officer",
                  "value": {
                    "referral_reason": "high_risk_score",
                    "referral_notes": "Risk score 78/100. Multiple high-risk nationality flags and source of funds marked as business income without supporting documentation. Manual EDD referral per compliance officer review.",
                    "initiated_by": "staff_c3d4e5f6-2222-3333-4444-555566667777",
                    "initiated_at": "2026-04-15T11:30:00Z"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "EDD escalation recorded. KYCReferralRaised event published. MLRO notified. Application suspended pending EDD review (SLA: 3 business days).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EddReferralResponse" },
                "examples": {
                  "referred": {
                    "value": {
                      "assessment_id": "c3d4e5f6-2222-3333-4444-555566667777",
                      "status": "referred",
                      "edd_required": true,
                      "mlro_referral": true,
                      "referral_reason": "pep_identified",
                      "estimated_review_sla_days": 3,
                      "updated_at": "2026-04-15T09:13:15Z"
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "Conflict. Assessment is already in a referred or blocked state.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "already_referred": {
                    "value": {
                      "error_code": "ASSESSMENT_ALREADY_REFERRED",
                      "message": "This assessment has already been escalated to EDD.",
                      "correlation_id": "req-hij-890"
                    }
                  }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Service-to-service JWT. Scopes: `kyc-assessment:write` for POST endpoints; `kyc-assessment:read` for GET (standard fields only); `kyc-assessment:compliance:read` for full compliance fields (restricted to MLRO tooling). EDD escalation (`/edd-referral`) requires `kyc-assessment:edd:write`."
      }
    },
    "parameters": {
      "AssessmentId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "RFC 4122 UUID v4 identifier of the KycAssessment (ENT-003).",
        "schema": { "type": "string", "format": "uuid" },
        "example": "9c8b7a65-4321-fedc-ba98-765432109876"
      }
    },
    "schemas": {
      "InitiateKycAssessmentRequest": {
        "type": "object",
        "required": ["application_id", "customer_id", "identity_verification_id", "verified_identity"],
        "properties": {
          "application_id": { "type": "string", "format": "uuid" },
          "customer_id": { "type": "string", "format": "uuid" },
          "identity_verification_id": {
            "type": "string",
            "format": "uuid",
            "description": "ID of the completed IdentityVerification (ENT-002) with outcome = pass."
          },
          "verified_identity": {
            "$ref": "#/components/schemas/VerifiedIdentity"
          },
          "occupation": {
            "type": "string",
            "nullable": true,
            "description": "Customer's declared occupation. Input to risk scoring."
          },
          "source_of_funds": {
            "type": "string",
            "enum": ["employment", "self_employment", "savings", "investment", "inheritance", "pension", "other"],
            "nullable": true,
            "description": "Customer's declared source of funds. CDD input for risk scoring."
          },
          "account_type": {
            "type": "string",
            "enum": ["standard_current", "packaged"]
          }
        }
      },
      "VerifiedIdentity": {
        "type": "object",
        "required": ["first_name", "last_name", "date_of_birth", "nationality", "residential_address"],
        "description": "Verified identity data from SVC-050 IdentityVerification. Used as inputs to PEP/sanctions/adverse media screening.",
        "properties": {
          "first_name": { "type": "string" },
          "last_name": { "type": "string" },
          "date_of_birth": { "type": "string", "format": "date" },
          "nationality": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Z]{2}$" }
          },
          "tax_residency": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Z]{2}$" },
            "nullable": true
          },
          "residential_address": {
            "type": "object",
            "required": ["line1", "city", "postcode", "country_code"],
            "properties": {
              "line1": { "type": "string" },
              "city": { "type": "string" },
              "postcode": { "type": "string" },
              "country_code": { "type": "string" }
            }
          }
        }
      },
      "KycAssessmentResponse": {
        "type": "object",
        "description": "KycAssessment record (ENT-003). Complete CDD record of authority. Sensitive match details omitted for non-compliance callers.",
        "properties": {
          "assessment_id": { "type": "string", "format": "uuid" },
          "application_id": { "type": "string", "format": "uuid" },
          "customer_id": { "type": "string", "format": "uuid" },
          "status": {
            "type": "string",
            "enum": ["in_progress", "cleared", "referred", "blocked", "failed"],
            "description": "'cleared' = KYCClearanceGranted published. 'referred' = KYCReferralRaised published (EDD path). 'blocked' = SanctionsHitDetected published (EX-002)."
          },
          "sanctions_screening_status": {
            "type": "string",
            "enum": ["in_progress", "clear", "blocked", "pending_review"],
            "description": "Sanctions screening result from SVC-051. 'blocked' triggers EX-002 immediately."
          },
          "pep_screening_status": {
            "type": "string",
            "enum": ["in_progress", "clear", "match", "pending_review"]
          },
          "adverse_media_status": {
            "type": "string",
            "enum": ["in_progress", "clear", "flagged", "pending_review"]
          },
          "risk_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "nullable": true,
            "description": "0–100. Bands: 0–30 = simplified; 31–60 = standard; 61–100 = enhanced. Not surfaced to PER-001."
          },
          "risk_category": {
            "type": "string",
            "enum": ["simplified", "standard", "enhanced"],
            "nullable": true,
            "description": "Derived from risk_score band. 'enhanced' requires EDD (MLR 2017 Reg 33)."
          },
          "edd_required": { "type": "boolean", "default": false },
          "mlro_referral": { "type": "boolean", "default": false },
          "referral_reason": {
            "type": "string",
            "enum": ["pep_identified", "high_risk_score", "adverse_media", "edd_required"],
            "nullable": true
          },
          "assessor": {
            "type": "string",
            "enum": ["automated", "manual"]
          },
          "mlro_sign_off_by": { "type": "string", "format": "uuid", "nullable": true },
          "mlro_sign_off_at": { "type": "string", "format": "date-time", "nullable": true },
          "assessment_date": { "type": "string", "format": "date", "nullable": true },
          "next_review_date": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "Calculated: simplified +5yr, standard +3yr, enhanced +1yr from assessment_date."
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "EddReferralRequest": {
        "type": "object",
        "required": ["referral_reason", "initiated_by", "initiated_at"],
        "properties": {
          "referral_reason": {
            "type": "string",
            "enum": ["pep_identified", "high_risk_score", "adverse_media", "edd_required"]
          },
          "referral_notes": {
            "type": "string",
            "maxLength": 2000,
            "nullable": true,
            "description": "Compliance officer or automated engine notes. Stored as EDD evidence. Access restricted to compliance scope."
          },
          "initiated_by": {
            "type": "string",
            "description": "'automated' for system-triggered EDD; staff UUID prefixed with 'staff_' for manual escalation by PER-052."
          },
          "initiated_at": { "type": "string", "format": "date-time" }
        }
      },
      "EddReferralResponse": {
        "type": "object",
        "properties": {
          "assessment_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string" },
          "edd_required": { "type": "boolean" },
          "mlro_referral": { "type": "boolean" },
          "referral_reason": { "type": "string" },
          "estimated_review_sla_days": {
            "type": "integer",
            "description": "Target SLA for EDD review (3 business days per AP-001)."
          },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error_code", "message", "correlation_id"],
        "properties": {
          "error_code": { "type": "string" },
          "message": { "type": "string" },
          "detail": { "type": "string", "nullable": true },
          "correlation_id": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad Request.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "Unauthorized": {
        "description": "Unauthorized.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "Forbidden": {
        "description": "Forbidden.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "NotFound": {
        "description": "Not Found.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "InternalServerError": {
        "description": "Internal Server Error.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      }
    }
  }
}
