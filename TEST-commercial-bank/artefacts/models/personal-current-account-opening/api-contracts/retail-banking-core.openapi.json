{
  "openapi": "3.1.0",
  "info": {
    "title": "Retail Banking Core API",
    "description": "SVC-001 — Retail Banking Core. Exposes account opening application lifecycle and account provisioning endpoints for JRN-001 (Personal Current Account Opening). This service is the authoritative ledger for Customer, Account, ApplicationRecord, and CardIssuance entities. All mutations to account-related state must flow through this API. Downstream consumers must not write directly to SVC-001 data stores.\n\nRegulatory context: ApplicationRecord decisions are Consumer Duty evidence (retained 6–7 years). Account records feed the FSCS Single Customer View (SCV) which must be producible within 24 hours of a payout trigger. All endpoints are UK-data-residency only.",
    "version": "1.0.0",
    "contact": {
      "name": "Retail Banking Core Team",
      "email": "svc-001-team@bank.internal"
    }
  },
  "servers": [
    {
      "url": "https://api.bank.internal/retail-core/v1",
      "description": "Internal production"
    },
    {
      "url": "https://api.staging.bank.internal/retail-core/v1",
      "description": "Staging"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Applications",
      "description": "Account opening application lifecycle. ApplicationRecord is owned by SVC-001 and is the Consumer Duty evidence record for all account opening decisions."
    },
    {
      "name": "Accounts",
      "description": "Account provisioning and retrieval. Account is an ENT-004 entity owned by SVC-001 and is part of the FSCS Single Customer View."
    }
  ],
  "paths": {
    "/applications": {
      "post": {
        "operationId": "createApplication",
        "summary": "Start account opening application",
        "description": "Creates a new ApplicationRecord (ENT-007) and Customer prospect record (ENT-001) for a personal current account opening request. Publishes ApplicationStarted domain event to the event bus (SVC-102) on successful creation. Performs preliminary eligibility checks: age >= 18, UK residency, deduplication against existing active accounts.\n\nPhase: PH-001 (Application Initiation)\nGovernance: GOV-001-R01, GOV-005-R04, Consumer Duty PS22/9.",
        "tags": ["Applications"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApplicationRequest"
              },
              "examples": {
                "standard_current_account": {
                  "summary": "Standard current account — new UK customer",
                  "value": {
                    "account_type": "standard_current",
                    "channel": "mobile_app",
                    "applicant": {
                      "title": "Ms",
                      "first_name": "Amara",
                      "last_name": "Okonkwo",
                      "date_of_birth": "1992-07-15",
                      "nationality": ["GB"],
                      "tax_residency": ["GB"],
                      "email": "amara.okonkwo@example.com",
                      "phone": "+447700900123",
                      "addresses": [
                        {
                          "line1": "14 Thornfield Road",
                          "line2": null,
                          "city": "Manchester",
                          "county": "Greater Manchester",
                          "postcode": "M14 7PJ",
                          "country_code": "GB",
                          "address_type": "residential",
                          "valid_from": "2021-03-01",
                          "valid_to": null
                        }
                      ]
                    },
                    "switching": false,
                    "consent": {
                      "terms_accepted": true,
                      "terms_version": "v2.4",
                      "accepted_at": "2026-04-15T09:12:00Z",
                      "marketing_opt_in": false
                    }
                  }
                },
                "switching_application": {
                  "summary": "CASS switching application",
                  "value": {
                    "account_type": "standard_current",
                    "channel": "web_portal",
                    "applicant": {
                      "title": "Mr",
                      "first_name": "James",
                      "last_name": "Patel",
                      "date_of_birth": "1985-11-03",
                      "nationality": ["GB"],
                      "tax_residency": ["GB"],
                      "email": "james.patel@example.com",
                      "phone": "+447911123456",
                      "addresses": [
                        {
                          "line1": "22 Birchwood Avenue",
                          "city": "Bristol",
                          "postcode": "BS8 2TQ",
                          "country_code": "GB",
                          "address_type": "residential",
                          "valid_from": "2019-06-15",
                          "valid_to": null
                        }
                      ]
                    },
                    "switching": true,
                    "cass_switch": {
                      "intended_switch_date": "2026-04-24",
                      "previous_bank_name": "Barclays Bank plc",
                      "previous_sort_code": "20-00-00",
                      "previous_account_number": "12345678"
                    },
                    "consent": {
                      "terms_accepted": true,
                      "terms_version": "v2.4",
                      "accepted_at": "2026-04-15T14:00:00Z",
                      "marketing_opt_in": false
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Application created. ApplicationStarted event published. Customer directed to identity verification (PH-002).",
            "headers": {
              "Location": {
                "description": "URL of the created application resource.",
                "schema": { "type": "string", "format": "uri" }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationResponse"
                },
                "examples": {
                  "created": {
                    "value": {
                      "application_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "application_ref": "APP-2026-0042391",
                      "customer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                      "status": "in_progress",
                      "current_phase": "PH-002",
                      "account_type": "standard_current",
                      "channel": "mobile_app",
                      "switching": false,
                      "created_at": "2026-04-15T09:12:01Z",
                      "updated_at": "2026-04-15T09:12:01Z",
                      "next_action": {
                        "phase": "PH-002",
                        "description": "Complete identity verification",
                        "url": "/identity-verifications"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": {
            "description": "Conflict. An active application or account already exists for this identity (deduplication check failed).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "duplicate": {
                    "value": {
                      "error_code": "DUPLICATE_APPLICATION",
                      "message": "An active application or account already exists for this identity.",
                      "detail": "Deduplication check detected an existing record. Customer should use account recovery journey.",
                      "correlation_id": "req-abc-123"
                    }
                  },
                  "under_eighteen": {
                    "value": {
                      "error_code": "ELIGIBILITY_UNDER_18",
                      "message": "Applicant must be aged 18 or over.",
                      "detail": "Date of birth indicates applicant is under 18. Redirect to junior account journey (EX-004).",
                      "correlation_id": "req-abc-124"
                    }
                  }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/applications/{id}": {
      "get": {
        "operationId": "getApplication",
        "summary": "Get application status",
        "description": "Returns the current state of an ApplicationRecord (ENT-007). Consumers include: SVC-017 (to drive the customer-facing application journey state machine), SVC-050 (to confirm application context before identity verification), and compliance tooling for audit trail retrieval.\n\nNote: The response does not include sensitive fields such as decline_reason or decision_basis_ref when called by channel-layer consumers (SVC-017). Access to those fields is restricted to compliance roles.",
        "tags": ["Applications"],
        "parameters": [
          { "$ref": "#/components/parameters/ApplicationId" }
        ],
        "responses": {
          "200": {
            "description": "Application found.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApplicationResponse" },
                "examples": {
                  "in_progress": {
                    "value": {
                      "application_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "application_ref": "APP-2026-0042391",
                      "customer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                      "status": "in_progress",
                      "current_phase": "PH-003",
                      "account_type": "standard_current",
                      "channel": "mobile_app",
                      "switching": false,
                      "created_at": "2026-04-15T09:12:01Z",
                      "updated_at": "2026-04-15T09:12:45Z"
                    }
                  },
                  "approved": {
                    "value": {
                      "application_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "application_ref": "APP-2026-0042391",
                      "customer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                      "status": "approved",
                      "current_phase": "PH-005",
                      "account_type": "standard_current",
                      "channel": "mobile_app",
                      "switching": false,
                      "decided_at": "2026-04-15T09:14:22Z",
                      "created_at": "2026-04-15T09:12:01Z",
                      "updated_at": "2026-04-15T09:14:22Z"
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/applications/{id}/decision": {
      "post": {
        "operationId": "recordApplicationDecision",
        "summary": "Record approve / decline / refer decision",
        "description": "Records the account opening decision for an ApplicationRecord (ENT-007). Called by the automated decision engine (internal to SVC-001) or, for AP-001 (EDD) path, by the MLRO compliance tooling. Publishing ApplicationDecisionMade domain event is a side-effect of this operation.\n\nPermissions: Only services with the `decision:write` scope may call this endpoint. Channel-layer services (SVC-017) may not call this endpoint directly — the decision is produced by SVC-001 internally or via MLRO tooling.\n\nPhase: PH-004 (Account Decision)\nGovernance: Consumer Duty PS22/9, GOV-005-R01.",
        "tags": ["Applications"],
        "parameters": [
          { "$ref": "#/components/parameters/ApplicationId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ApplicationDecisionRequest" },
              "examples": {
                "approve": {
                  "summary": "Automated approval",
                  "value": {
                    "decision_outcome": "approved",
                    "decision_basis_ref": "AUTO-DECISION-20260415-0042391",
                    "kyc_assessment_id": "9c8b7a65-4321-fedc-ba98-765432109876",
                    "identity_verification_id": "f1e2d3c4-b5a6-7890-1234-567890abcdef",
                    "assessor": "automated",
                    "decided_at": "2026-04-15T09:14:22Z"
                  }
                },
                "decline": {
                  "summary": "Decline — KYC failure (internal reason not disclosed to customer)",
                  "value": {
                    "decision_outcome": "declined",
                    "decision_basis_ref": "AUTO-DECISION-20260415-0042400",
                    "kyc_assessment_id": "a1b2c3d4-0000-1111-2222-333344445555",
                    "identity_verification_id": "b2c3d4e5-1111-2222-3333-444455556666",
                    "assessor": "automated",
                    "decline_reason": "kyc_failure",
                    "customer_facing_reason": "We are unable to open an account for you at this time.",
                    "decided_at": "2026-04-15T09:15:01Z"
                  }
                },
                "refer": {
                  "summary": "Refer — EDD required (PEP identified)",
                  "value": {
                    "decision_outcome": "referred",
                    "decision_basis_ref": "AUTO-DECISION-20260415-0042410",
                    "kyc_assessment_id": "c3d4e5f6-2222-3333-4444-555566667777",
                    "identity_verification_id": "d4e5f6a7-3333-4444-5555-666677778888",
                    "assessor": "automated",
                    "referral_reason": "pep_identified",
                    "decided_at": "2026-04-15T09:15:30Z"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decision recorded. ApplicationDecisionMade event published.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApplicationDecisionResponse" },
                "examples": {
                  "approved": {
                    "value": {
                      "application_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "status": "approved",
                      "decision_outcome": "approved",
                      "decided_at": "2026-04-15T09:14:22Z",
                      "next_action": {
                        "phase": "PH-005",
                        "description": "Proceed to account provisioning",
                        "url": "/accounts"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "Conflict. A decision has already been recorded for this application.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "already_decided": {
                    "value": {
                      "error_code": "DECISION_ALREADY_RECORDED",
                      "message": "A decision has already been recorded for application APP-2026-0042391.",
                      "correlation_id": "req-def-456"
                    }
                  }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/accounts": {
      "post": {
        "operationId": "provisionAccount",
        "summary": "Provision account",
        "description": "Creates an Account record (ENT-004) in SVC-001 following an approved ApplicationRecord. Assigns a sort code and account number from the bank's allocated range, initialises the opening balance to zero, creates the FSCS SCV record, triggers CASS registration with Pay.UK, and issues a CardIssuanceTriggered event to the card processor (SVC-011/Marqeta/Thredd). Publishes AccountOpened and AccountProvisioned domain events.\n\nThis endpoint may only be called after a KYCClearanceGranted event has been received by SVC-001 for the corresponding application. Calling without prior KYC clearance will return 403.\n\nPhase: PH-005 (Account Provisioning)\nGovernance: GOV-001-R02, GOV-005-R01, PRA Depositor Protection.",
        "tags": ["Accounts"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProvisionAccountRequest" },
              "examples": {
                "standard": {
                  "summary": "Provision standard current account",
                  "value": {
                    "application_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                    "customer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                    "account_type": "standard_current",
                    "kyc_assessment_id": "9c8b7a65-4321-fedc-ba98-765432109876",
                    "card_delivery_address": {
                      "line1": "14 Thornfield Road",
                      "city": "Manchester",
                      "postcode": "M14 7PJ",
                      "country_code": "GB"
                    },
                    "cass_switch": null
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account provisioned. AccountOpened and AccountProvisioned events published. CardIssuanceTriggered event published to card processor.",
            "headers": {
              "Location": {
                "description": "URL of the created account resource.",
                "schema": { "type": "string", "format": "uri" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AccountResponse" },
                "examples": {
                  "provisioned": {
                    "value": {
                      "account_id": "b2c3d4e5-1234-5678-9abc-def012345678",
                      "customer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                      "application_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "account_type": "standard_current",
                      "sort_code": "40-47-84",
                      "account_number": "87654321",
                      "iban": "GB29BARC40478487654321",
                      "bic": "BARCGB22",
                      "status": "active",
                      "opening_balance": 0.00,
                      "currency": "GBP",
                      "overdraft_limit": 0.00,
                      "fscs_eligible": true,
                      "fscs_protection_amount": 85000.00,
                      "cass_registered": false,
                      "cass_registration_initiated_at": null,
                      "card_id": "c3d4e5f6-2345-6789-abcd-ef0123456789",
                      "opened_date": "2026-04-15",
                      "created_at": "2026-04-15T09:14:35Z",
                      "updated_at": "2026-04-15T09:14:35Z"
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": {
            "description": "Forbidden. KYC clearance has not been granted for this application, or the application is not in an approved state.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "no_kyc_clearance": {
                    "value": {
                      "error_code": "KYC_CLEARANCE_REQUIRED",
                      "message": "Account provisioning requires a KYCClearanceGranted event for this application.",
                      "detail": "MLR 2017 Regulation 27: no account may be opened before CDD is complete.",
                      "correlation_id": "req-ghi-789"
                    }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "Conflict. An account has already been provisioned for this application.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "duplicate_account": {
                    "value": {
                      "error_code": "ACCOUNT_ALREADY_PROVISIONED",
                      "message": "An account has already been provisioned for application 3fa85f64-5717-4562-b3fc-2c963f66afa6.",
                      "correlation_id": "req-jkl-012"
                    }
                  }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/accounts/{id}": {
      "get": {
        "operationId": "getAccount",
        "summary": "Get account details",
        "description": "Returns the Account record (ENT-004) for a given account_id. Used by SVC-017 (Digital Channels) to populate the customer dashboard, by SVC-053 (Notifications) to retrieve account context for communications, and by FSCS SCV tooling.\n\nBalance data returned here is the current ledger balance as of the time of the call. This endpoint does not return transaction history — use the Payments/Transactions API for that.",
        "tags": ["Accounts"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" }
        ],
        "responses": {
          "200": {
            "description": "Account found.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AccountResponse" },
                "examples": {
                  "active_account": {
                    "value": {
                      "account_id": "b2c3d4e5-1234-5678-9abc-def012345678",
                      "customer_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                      "application_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "account_type": "standard_current",
                      "sort_code": "40-47-84",
                      "account_number": "87654321",
                      "iban": "GB29BARC40478487654321",
                      "bic": "BARCGB22",
                      "status": "active",
                      "opening_balance": 0.00,
                      "currency": "GBP",
                      "overdraft_limit": 0.00,
                      "fscs_eligible": true,
                      "fscs_protection_amount": 85000.00,
                      "cass_registered": true,
                      "cass_registration_initiated_at": "2026-04-15T09:14:35Z",
                      "card_id": "c3d4e5f6-2345-6789-abcd-ef0123456789",
                      "opened_date": "2026-04-15",
                      "created_at": "2026-04-15T09:14:35Z",
                      "updated_at": "2026-04-15T09:14:38Z"
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Service-to-service JWT issued by SVC-100 (Identity & Access Management). Claims must include: sub (calling service ID), scope (required scopes listed per endpoint), iat, exp (max 3600s). All service tokens are validated against the SVC-100 JWKS endpoint. No customer-scoped tokens are accepted by this API — it is an internal service API only."
      }
    },
    "parameters": {
      "ApplicationId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "RFC 4122 UUID v4 identifier of the ApplicationRecord (ENT-007).",
        "schema": { "type": "string", "format": "uuid" },
        "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
      },
      "AccountId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "RFC 4122 UUID v4 identifier of the Account (ENT-004).",
        "schema": { "type": "string", "format": "uuid" },
        "example": "b2c3d4e5-1234-5678-9abc-def012345678"
      }
    },
    "schemas": {
      "CreateApplicationRequest": {
        "type": "object",
        "required": ["account_type", "channel", "applicant", "consent"],
        "properties": {
          "account_type": {
            "type": "string",
            "enum": ["standard_current", "packaged"],
            "description": "Type of personal current account being applied for."
          },
          "channel": {
            "type": "string",
            "enum": ["mobile_app", "web_portal", "branch"],
            "description": "Channel through which the application is being submitted (CH-001 = web_portal, CH-002 = mobile_app, CH-004 = branch)."
          },
          "applicant": {
            "$ref": "#/components/schemas/ApplicantDetails"
          },
          "switching": {
            "type": "boolean",
            "default": false,
            "description": "Whether the customer intends to use CASS to switch from another bank (AP-003)."
          },
          "cass_switch": {
            "$ref": "#/components/schemas/CassSwitchRequest",
            "nullable": true,
            "description": "CASS switching details. Required if switching = true."
          },
          "consent": {
            "$ref": "#/components/schemas/ConsentRecord"
          }
        }
      },
      "ApplicantDetails": {
        "type": "object",
        "required": ["first_name", "last_name", "date_of_birth", "nationality", "tax_residency", "email", "phone", "addresses"],
        "description": "Personal details of the applicant. Maps to ENT-001 (Customer) fields.",
        "properties": {
          "title": {
            "type": "string",
            "enum": ["Mr", "Mrs", "Ms", "Miss", "Dr", "Prof", "Mx", "Other"],
            "nullable": true
          },
          "first_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Required. Unicode letters, hyphens, and apostrophes permitted. GOV-001-R01."
          },
          "last_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Required. Unicode letters, hyphens, and apostrophes permitted. GOV-001-R01."
          },
          "date_of_birth": {
            "type": "string",
            "format": "date",
            "description": "Required. ISO 8601 YYYY-MM-DD. Applicant must be >= 18 years old at application date. GOV-005-R04."
          },
          "nationality": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Z]{2}$" },
            "minItems": 1,
            "description": "Required. ISO 3166-1 alpha-2 country codes. CDD input for risk scoring. GOV-005-R01."
          },
          "tax_residency": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Z]{2}$" },
            "minItems": 1,
            "description": "Required. ISO 3166-1 alpha-2 country codes. Required for HMRC FATCA/CRS reporting. GOV-005-R01."
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "description": "Required. RFC 5321. Must be unique across active customer records."
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+[1-9]\\d{1,14}$",
            "description": "Required. E.164 format including country code."
          },
          "addresses": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Address" },
            "minItems": 1,
            "description": "Required. At least one residential address with country_code = GB for UK residency check."
          }
        }
      },
      "Address": {
        "type": "object",
        "required": ["line1", "city", "postcode", "country_code", "address_type"],
        "properties": {
          "line1": { "type": "string", "maxLength": 100 },
          "line2": { "type": "string", "maxLength": 100, "nullable": true },
          "city": { "type": "string", "maxLength": 100 },
          "county": { "type": "string", "nullable": true },
          "postcode": {
            "type": "string",
            "description": "UK postcode format validated against Royal Mail PAF pattern."
          },
          "country_code": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "ISO 3166-1 alpha-2."
          },
          "address_type": {
            "type": "string",
            "enum": ["residential", "correspondence", "previous"]
          },
          "valid_from": { "type": "string", "format": "date", "nullable": true },
          "valid_to": { "type": "string", "format": "date", "nullable": true }
        }
      },
      "CassSwitchRequest": {
        "type": "object",
        "required": ["intended_switch_date", "previous_bank_name", "previous_sort_code", "previous_account_number"],
        "description": "CASS switch details for AP-003 (Account Switching via CASS).",
        "properties": {
          "intended_switch_date": {
            "type": "string",
            "format": "date",
            "description": "The intended Switch Date. Must be at least 7 working days from today per CASS guarantee."
          },
          "previous_bank_name": { "type": "string", "maxLength": 200 },
          "previous_sort_code": {
            "type": "string",
            "pattern": "^\\d{2}-\\d{2}-\\d{2}$",
            "description": "6-digit sort code in XX-XX-XX format."
          },
          "previous_account_number": {
            "type": "string",
            "pattern": "^\\d{8}$",
            "description": "8-digit account number."
          }
        }
      },
      "ConsentRecord": {
        "type": "object",
        "required": ["terms_accepted", "terms_version", "accepted_at"],
        "properties": {
          "terms_accepted": { "type": "boolean" },
          "terms_version": { "type": "string" },
          "accepted_at": { "type": "string", "format": "date-time" },
          "marketing_opt_in": { "type": "boolean", "default": false }
        }
      },
      "ApplicationResponse": {
        "type": "object",
        "properties": {
          "application_id": { "type": "string", "format": "uuid" },
          "application_ref": {
            "type": "string",
            "description": "Human-readable application reference shown to the customer (e.g. APP-2026-0042391)."
          },
          "customer_id": { "type": "string", "format": "uuid" },
          "status": {
            "type": "string",
            "enum": ["in_progress", "approved", "declined", "referred", "cancelled"],
            "description": "Current status of the ApplicationRecord (ENT-007)."
          },
          "current_phase": {
            "type": "string",
            "enum": ["PH-001", "PH-002", "PH-003", "PH-004", "PH-005", "PH-006", "PH-007", "AP-001", "EX-001", "EX-002"],
            "description": "Current phase of the journey."
          },
          "account_type": {
            "type": "string",
            "enum": ["standard_current", "packaged"]
          },
          "channel": {
            "type": "string",
            "enum": ["mobile_app", "web_portal", "branch"]
          },
          "switching": { "type": "boolean" },
          "decided_at": { "type": "string", "format": "date-time", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "next_action": {
            "$ref": "#/components/schemas/NextAction",
            "nullable": true
          }
        }
      },
      "ApplicationDecisionRequest": {
        "type": "object",
        "required": ["decision_outcome", "decision_basis_ref", "kyc_assessment_id", "identity_verification_id", "assessor", "decided_at"],
        "description": "Decision payload for recording the account opening outcome. Consumer Duty evidence record — retained for 6–7 years.",
        "properties": {
          "decision_outcome": {
            "type": "string",
            "enum": ["approved", "declined", "referred"],
            "description": "The automated or MLRO-reviewed decision outcome."
          },
          "decision_basis_ref": {
            "type": "string",
            "description": "Reference to the decision engine audit record. Retained for Consumer Duty evidence."
          },
          "kyc_assessment_id": { "type": "string", "format": "uuid" },
          "identity_verification_id": { "type": "string", "format": "uuid" },
          "assessor": {
            "type": "string",
            "enum": ["automated", "manual"],
            "description": "'manual' applies for AP-001 (EDD) path with MLRO sign-off."
          },
          "decline_reason": {
            "type": "string",
            "enum": ["kyc_failure", "sanctions_hit", "identity_fraud", "policy_exclusion", "age_ineligible"],
            "nullable": true,
            "description": "Internal decline reason. Not surfaced to customer (tipping-off prohibition applies for sanctions/KYC failures)."
          },
          "customer_facing_reason": {
            "type": "string",
            "nullable": true,
            "description": "Sanitised decline message for customer communication. Must comply with Consumer Duty PS22/9 consumer understanding outcome."
          },
          "referral_reason": {
            "type": "string",
            "enum": ["pep_identified", "high_risk_score", "adverse_media", "edd_required"],
            "nullable": true,
            "description": "Referral reason for AP-001 path."
          },
          "mlro_sign_off_by": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Staff ID of MLRO who signed off (for manual assessor = 'manual' path)."
          },
          "mlro_sign_off_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "decided_at": { "type": "string", "format": "date-time" }
        }
      },
      "ApplicationDecisionResponse": {
        "type": "object",
        "properties": {
          "application_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string" },
          "decision_outcome": { "type": "string" },
          "decided_at": { "type": "string", "format": "date-time" },
          "next_action": { "$ref": "#/components/schemas/NextAction", "nullable": true }
        }
      },
      "ProvisionAccountRequest": {
        "type": "object",
        "required": ["application_id", "customer_id", "account_type", "kyc_assessment_id"],
        "description": "Request to provision an Account (ENT-004) following an approved ApplicationRecord. Requires prior KYCClearanceGranted event. PH-005.",
        "properties": {
          "application_id": { "type": "string", "format": "uuid" },
          "customer_id": { "type": "string", "format": "uuid" },
          "account_type": {
            "type": "string",
            "enum": ["standard_current", "packaged"]
          },
          "kyc_assessment_id": { "type": "string", "format": "uuid" },
          "card_delivery_address": {
            "$ref": "#/components/schemas/Address",
            "description": "Delivery address for the debit card. Defaults to customer residential address if omitted."
          },
          "cass_switch": {
            "$ref": "#/components/schemas/CassSwitchRequest",
            "nullable": true,
            "description": "Populated if AP-003 (CASS switching) is active."
          }
        }
      },
      "AccountResponse": {
        "type": "object",
        "description": "Account record (ENT-004). Part of the FSCS Single Customer View.",
        "properties": {
          "account_id": { "type": "string", "format": "uuid" },
          "customer_id": { "type": "string", "format": "uuid" },
          "application_id": { "type": "string", "format": "uuid" },
          "account_type": { "type": "string", "enum": ["standard_current", "packaged"] },
          "sort_code": { "type": "string", "pattern": "^\\d{2}-\\d{2}-\\d{2}$" },
          "account_number": { "type": "string", "pattern": "^\\d{8}$" },
          "iban": { "type": "string" },
          "bic": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pending", "active", "suspended", "closed"],
            "description": "Account lifecycle status. Account is 'pending' between AccountOpened and AccountProvisioned events."
          },
          "opening_balance": { "type": "number", "format": "double" },
          "currency": { "type": "string", "default": "GBP" },
          "overdraft_limit": { "type": "number", "format": "double", "description": "Initially nil (0.00) at account opening." },
          "fscs_eligible": { "type": "boolean" },
          "fscs_protection_amount": { "type": "number", "format": "double" },
          "cass_registered": { "type": "boolean" },
          "cass_registration_initiated_at": { "type": "string", "format": "date-time", "nullable": true },
          "card_id": { "type": "string", "format": "uuid", "nullable": true },
          "opened_date": { "type": "string", "format": "date" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "NextAction": {
        "type": "object",
        "properties": {
          "phase": { "type": "string" },
          "description": { "type": "string" },
          "url": { "type": "string" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error_code", "message", "correlation_id"],
        "properties": {
          "error_code": { "type": "string", "description": "Machine-readable error code." },
          "message": { "type": "string", "description": "Human-readable error message." },
          "detail": { "type": "string", "nullable": true },
          "correlation_id": { "type": "string", "description": "Request correlation ID for log tracing." },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad Request. The request body or parameters failed validation.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "examples": {
              "validation_failure": {
                "value": {
                  "error_code": "VALIDATION_ERROR",
                  "message": "Request body validation failed.",
                  "detail": "date_of_birth: must be a valid ISO 8601 date; email: must be a valid email address.",
                  "correlation_id": "req-mno-345"
                }
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized. No valid Bearer token present or token is expired.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "examples": {
              "missing_token": {
                "value": {
                  "error_code": "UNAUTHORIZED",
                  "message": "A valid Bearer token is required.",
                  "correlation_id": "req-pqr-678"
                }
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "Forbidden. The calling service does not have the required scope for this operation.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "examples": {
              "insufficient_scope": {
                "value": {
                  "error_code": "FORBIDDEN",
                  "message": "Calling service does not have the required scope for this operation.",
                  "correlation_id": "req-stu-901"
                }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Not Found. The specified resource does not exist.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "examples": {
              "not_found": {
                "value": {
                  "error_code": "NOT_FOUND",
                  "message": "The requested resource was not found.",
                  "correlation_id": "req-vwx-234"
                }
              }
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Internal Server Error. An unexpected error occurred. The request may be retried after a short delay. If the problem persists, contact the SVC-001 team and quote the correlation_id.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "examples": {
              "internal_error": {
                "value": {
                  "error_code": "INTERNAL_SERVER_ERROR",
                  "message": "An unexpected error occurred.",
                  "correlation_id": "req-yza-567"
                }
              }
            }
          }
        }
      }
    }
  }
}
