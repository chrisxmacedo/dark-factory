sequenceDiagram
    autonumber
    participant PER003 as PER-003<br/>Corporate Client
    participant PER053 as PER-053<br/>Treasury Dealer
    participant SVC007 as SVC-007<br/>Treasury Services<br/>(CAP-002)
    participant SVC005 as SVC-005<br/>Commercial Banking Core<br/>(CAP-002)
    participant SVC102 as SVC-102<br/>Event Bus
    participant SVC051 as SVC-051<br/>Sanctions Screening<br/>(CAP-005)
    participant SVC010 as SVC-010<br/>International Payments<br/>(CAP-003)
    participant SVC053 as SVC-053<br/>Notification Service
    participant BLOOMBERG as Bloomberg FXGO<br/>Rate Feed (External)

    rect rgb(230, 245, 255)
        Note over PER003,BLOOMBERG: PH-059: Trade Enquiry
        PER003->>SVC007: POST /treasury/fx-trades/enquiry<br/>{client_id, sell_currency: GBP, buy_currency: USD,<br/>sell_amount: 500000, value_date: 2026-04-17 (T+2)}
        SVC007->>SVC005: GET /business-customers/{client_id}<br/>(same-capability — validates client status)
        SVC005-->>SVC007: 200 OK {status: active, legal_name: "Apex Industrial Ltd"}
        SVC007->>BLOOMBERG: GET FX rate stream — GBP/USD mid-rate
        BLOOMBERG-->>SVC007: 1.263450 (mid-rate, latency: 85ms)
        SVC007->>SVC007: Creates ENT-040 (FXTrade)<br/>status=enquiry, indicative_rate=1.261450<br/>(mid-rate 1.263450 minus 200 pip mark-up)
        SVC007-)SVC102: EVT-083: FXQuoteRequested<br/>topic: commercial.treasury
        SVC007-->>PER053: 201 Created {trade_id, indicative_rate: 1.261450, disclaimer: "Indicative only — not a firm price"}
        PER053-->>PER003: Relays indicative rate (portal or phone)
        SVC102-)SVC053: Delivers EVT-083 → enquiry acknowledgement to PER-003 portal
    end

    rect rgb(255, 248, 220)
        Note over PER053,SVC007: PH-060: Price Quotation (firm 30-second quote)
        PER003->>SVC007: POST /treasury/fx-trades/{trade_id}/quote<br/>{confirm_indicative: true}
        SVC007->>BLOOMBERG: GET FX rate stream — GBP/USD current mid-rate
        BLOOMBERG-->>SVC007: 1.263520 (mid-rate refresh, latency: 92ms)
        SVC007->>SVC007: Creates ENT-041 (FXQuote)<br/>indicative_rate=1.261450, firm_rate=1.261520<br/>spread=0.002000 (200 pips), valid_until=now+30s<br/>status=quoted
        SVC007-)SVC102: EVT-084: FXQuoteProvided<br/>topic: commercial.treasury<br/>{quote_id, firm_rate: 1.261520, valid_until, spread: 0.002000}
        SVC007-->>PER003: 201 Created {quote_id, firm_rate: 1.261520,<br/>sell_amount: 500000 GBP, buy_amount: 630760 USD,<br/>valid_until: 2026-04-15T10:15:30Z [30s countdown]}
        SVC102-)SVC053: Delivers EVT-084 → quote displayed on portal with countdown timer
    end

    rect rgb(255, 235, 235)
        Note over PER003,SVC051: PH-061: Trade Execution (client accepts within 22s)
        PER003->>SVC007: POST /treasury/fx-trades/{trade_id}/accept<br/>{quote_id, client_confirmation: true} [T+22s — within validity window]
        SVC007->>SVC007: Validates valid_until > now ✓
        SVC007->>SVC005: GET /business-accounts/{account_id}<br/>(same-capability — verifies GBP balance ≥ 500,000)
        SVC005-->>SVC007: 200 OK {available_balance: 2,150,000 GBP ✓}
        SVC007->>SVC007: FXQuote.status = accepted<br/>FXTrade.status = booked<br/>buy_amount = 630,760 USD (500,000 × 1.261520)<br/>rate = 1.261520, dealt_at = 2026-04-15T10:15:22Z<br/>value_date = 2026-04-17 (T+2)<br/>mifir_transaction_ref = UTI-2026-000089241
        SVC007-)SVC102: EVT-085: FXTradeExecuted<br/>topic: commercial.treasury<br/>{trade_id, sell: 500000 GBP, buy: 630760 USD,<br/>rate: 1.261520, value_date: 2026-04-17, dealt_at}
        SVC007-)SVC102: EVT-089: FXCounterpartySanctionsScreened [CROSS-CAPABILITY ▶]<br/>topic: compliance.sanctions-screening<br/>{trade_id, client_id, client_legal_name: "Apex Industrial Ltd",<br/>sell_amount: 500000, screening_request_id}
        SVC007-->>PER003: 200 OK {trade_id, status: booked,<br/>buy: 630,760 USD, rate: 1.261520, value_date: 2026-04-17}
        SVC102-)SVC051: Delivers EVT-089 [◀ CROSS-CAPABILITY received by CAP-005]
        SVC051->>SVC051: OFSI ✓ OFAC ✓ UN SC ✓<br/>HM Treasury ✓ — Apex Industrial Ltd: CLEAR
        Note over SVC051,SVC102: No hit detected — settlement proceeds
        SVC102-)SVC007: (No sanctions hit event received within SLA window — settlement gates clear)
    end

    rect rgb(240, 255, 240)
        Note over SVC007,SVC053: PH-062: Confirmation — SWIFT MT300 dispatch
        SVC007->>SVC007: FXTrade.status = confirmed<br/>FXTrade.confirmation_sent = true<br/>MiFIR report queued for FCA trade repository
        SVC007-)SVC102: EVT-086: FXTradeConfirmed [CROSS-CAPABILITY ▶]<br/>topic: commercial.treasury<br/>{trade_id, sell: 500000 GBP, buy: 630760 USD,<br/>rate: 1.261520, value_date: 2026-04-17, swift_type: MT300}
        SVC102-)SVC010: Delivers EVT-086 [◀ CROSS-CAPABILITY received by CAP-003]
        SVC010->>SVC010: Formats and transmits SWIFT MT300<br/>to Apex Industrial Ltd + correspondent bank SWIFT BIC
        SVC010-->>SVC102: MT300 SWIFT ACK received ✓
        SVC102-)SVC053: Delivers EVT-086 → email + portal confirmation to PER-003
        SVC007->>SVC007: MiFIR report submitted to FCA trade repository<br/>UTI: UTI-2026-000089241, submitted at 10:16 UTC
    end

    rect rgb(248, 230, 255)
        Note over SVC007,SVC010: PH-063: Settlement — T+2 (2026-04-17) value date
        Note over SVC007,SVC010: [2 business days later — 2026-04-17 09:30 UTC]
        SVC007->>SVC005: POST /business-accounts/{gbp_account_id}/debit<br/>{amount: 500000, currency: GBP, reference: trade_id}<br/>(same-capability — settlement debit sell leg)
        SVC005-->>SVC007: 200 OK {transaction_id, new_balance: 1,650,000 GBP}
        SVC007->>SVC005: POST /business-accounts/{usd_account_id}/credit<br/>{amount: 630760, currency: USD, reference: trade_id}<br/>(same-capability — settlement credit buy leg)
        SVC005-->>SVC007: 200 OK {transaction_id, new_balance: 630,760 USD}
        SVC007->>SVC007: Creates ENT-042 (FXSettlement)<br/>settlement_status=initiated<br/>buy_leg_nostro: CHASUS33XXX (USD nostro JP Morgan NY)<br/>sell_leg_nostro: BARCGB22XXX (GBP nostro Barclays)
        SVC007-)SVC102: EVT-087: FXSettlementInitiated [CROSS-CAPABILITY ▶]<br/>topic: commercial.treasury<br/>{settlement_id, trade_id, buy_leg_nostro: CHASUS33XXX,<br/>sell_leg_nostro: BARCGB22XXX, buy: 630760 USD, sell: 500000 GBP,<br/>value_date: 2026-04-17}
        SVC102-)SVC010: Delivers EVT-087 [◀ CROSS-CAPABILITY received by CAP-003]
        SVC010->>SVC010: Instructs SWIFT MT300 settlement<br/>Sell leg: BARCGB22XXX sends GBP 500,000 to counterparty nostro<br/>Buy leg: CHASUS33XXX credits GBP nostro USD 630,760<br/>Nostro confirmations received ✓
        SVC010-)SVC102: EVT-088: FXSettlementCompleted [CROSS-CAPABILITY ▶]<br/>topic: commercial.treasury<br/>{settlement_id, status: settled, settled_at: 2026-04-17T09:45:00Z,<br/>swift_settlement_ref: SWFT20260417-89241, buy_leg_confirmed: true,<br/>sell_leg_confirmed: true}
        SVC102-)SVC007: Delivers EVT-088 [◀ CROSS-CAPABILITY received by CAP-002]
        SVC007->>SVC007: FXSettlement.settlement_status = settled<br/>FXSettlement.settled_at = 2026-04-17T09:45:00Z<br/>FXTrade.status = settled<br/>FX P&L mark recorded
        SVC102-)SVC053: Delivers EVT-088 → settlement completion notification to PER-003 + PER-053
    end
